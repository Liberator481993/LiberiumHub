    tab.Btn = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 42), BackgroundTransparency = 1,
        BackgroundColor3 = UI.Violet, Text = "", AutoButtonColor = false,
        LayoutOrder = #self.Tabs + 1, Parent = self.Side,
    })
    uiCorner(tab.Btn, 10)
    tab.ActiveMark = create("Frame", {
        Name = "ActiveMark", Position = UDim2.fromOffset(0, 8),
        Size = UDim2.fromOffset(3, 26), BackgroundColor3 = UI.Cyan,
        BorderSizePixel = 0, Visible = false, Parent = tab.Btn,
    })
    uiCorner(tab.ActiveMark, 3)
    tab.Icon = uiText(tab.Btn, icon or "•", 15, UI.Muted, Enum.Font.GothamBold)
    tab.Icon.TextXAlignment = Enum.TextXAlignment.Center
    tab.Icon.Position = UDim2.fromOffset(6, 0)
    tab.Icon.Size = UDim2.fromOffset(26, 42)
    tab.Lbl = uiText(tab.Btn, name, 12, UI.Muted, Enum.Font.GothamSemibold)
    tab.Lbl.Position = UDim2.fromOffset(38, 0)
    tab.Lbl.Size = UDim2.new(1, -44, 1, 0)
    tab.Btn.MouseEnter:Connect(function()
        if self.Active ~= tab then tween(tab.Btn, FAST, {BackgroundTransparency = 0.9}) end
    end)
    tab.Btn.MouseLeave:Connect(function()
        if self.Active ~= tab then tween(tab.Btn, FAST, {BackgroundTransparency = 1}) end
    end)
    tab.Btn.Activated:Connect(function() self:_Select(tab) end)

    tab.Cont = create("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        Visible = false, Parent = self.Content,
    })
    tab.SubBar = create("ScrollingFrame", {
        Name = "SubTabs", Size = UDim2.new(1, 0, 0, 42),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 0, ScrollingDirection = Enum.ScrollingDirection.X,
        AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(),
        Parent = tab.Cont,
    }, {
        create("UIPadding", {PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 5)}),
        create("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder}),
    })
    tab.PageHolder = create("Frame", {
        Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 1, -44),
        BackgroundTransparency = 1, Parent = tab.Cont,
    })
    table.insert(self.Tabs, tab)
    if #self.Tabs == 1 then self:_Select(tab) end
    return tab
end

function Win:Destroy()
    if self.Destroyed then return end
    self.Destroyed = true
    if self.CameraConnection then pcall(function() self.CameraConnection:Disconnect() end); self.CameraConnection = nil end
    for _, connection in ipairs(self.Conns or {}) do pcall(function() connection:Disconnect() end) end
    table.clear(self.Conns or {})
    if self.Gui then pcall(function() self.Gui:Destroy() end); self.Gui = nil end
end

function Tab:_SelectSub(sub)
    if self.ActiveSub == sub then return end
    self.ActiveSub = sub
    for _, item in ipairs(self.Subs) do
        local active = item == sub
        tween(item.Btn, FAST, {
            BackgroundTransparency = active and 0.76 or 0.94,
            TextColor3 = active and UI.Text or UI.Muted,
        })
        if item.Mark then item.Mark.Visible = active end
        if not active then item.Page.Visible = false end
    end
    sub.Page.Visible = true
end


function Library:_SelectTab(tab)
    self.ActiveTab = tab self.PageTitle.Text = tab.Name
    for _, t in ipairs(self.Tabs) do
        local active = t == tab
        Tween(t.Button, 0.18, { BackgroundTransparency = active and 0 or 1, TextColor3 = active and Theme.White or Theme.Muted })
        Tween(t.Stroke, 0.18, {Transparency = active and 0.05 or 1})
    end
    ClearGui(self.SubTabBar)
    ClearGui(self.PageHolder)

    for _, sub in ipairs(tab.SubTabs) do
        local b = MakeButton(self.SubTabBar, sub.Name, UDim2.fromOffset(94, 34))
        b.TextSize = 11 b.BackgroundColor3 = Theme.Card
        local st = Stroke(b, Theme.Green, 1, 1)
        sub.Button = b sub.Stroke = st
        b.Activated:Connect(function() self:_SelectSub(tab, sub) end)

        local page = New("ScrollingFrame", { Name = sub.Name .. "Page", BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(10, 8), Size = UDim2.new(1, -20, 1, -16), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Green, Visible = false }, self.PageHolder)

    function CH:SetSize(pixels) if self._destroyed then return end pixels = math.max(pixels, 2) self._size = pixels self._gap = math.floor(pixels * 0.4) self._length = math.max(math.floor(pixels * 0.6), 2) if not self._flashing then self:_applyLayout() end end

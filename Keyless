-- Liberium Hub | v13 | Slate Methods Auto-Detect
local player = game:GetService("Players").LocalPlayer
local pg = player:WaitForChild("PlayerGui")

local function showErr(msg)
    pcall(function()
        local old = pg:FindFirstChild("LiberiumErr") if old then old:Destroy() end
        local sg = Instance.new("ScreenGui") sg.Name="LiberiumErr" sg.ResetOnSpawn=false sg.DisplayOrder=999 sg.Parent=pg
        local f = Instance.new("Frame", sg) f.Size=UDim2.new(1,-20,0,120) f.Position=UDim2.new(0,10,0,40)
        f.BackgroundColor3=Color3.fromRGB(50,0,0) f.BorderSizePixel=0
        local t = Instance.new("TextLabel", f) t.Size=UDim2.new(1,-20,1,-20) t.Position=UDim2.new(0,10,0,10)
        t.BackgroundTransparency=1 t.TextColor3=Color3.fromRGB(255,100,100) t.Font=Enum.Font.Code t.TextSize=13
        t.TextWrapped=true t.TextXAlignment=Enum.TextXAlignment.Left t.Text="[Liberium Error]\n"..tostring(msg)
    end)
end

local function fetch(url)
    if game.HttpGet then
        local ok, res = pcall(game.HttpGet, game, url)
        if ok and type(res) == "string" and #res > 0 then return res end
    end
    if request then
        local ok, res = pcall(request, {Url = url, Method = "GET"})
        if ok and res and res.Body then return res.Body end
    end
    return nil
end

local SOURCES = {
    "https://cdn.jsdelivr.net/gh/PulseZax/Slate@main/.lua",
    "https://raw.githubusercontent.com/PulseZax/Slate/refs/heads/main/.lua",
    "https://raw.gitmirror.com/PulseZax/Slate/main/.lua"
}

local src = nil
for _, url in ipairs(SOURCES) do
    src = fetch(url)
    if src then break end
end

if not src then showErr("Slate не скачался.") return end
local LS = loadstring or load
local fn, perr = LS(src)
if not fn then showErr("Slate parse: "..tostring(perr)) return end
local ok, Slate = pcall(fn)
if not ok or type(Slate) ~= "table" or not Slate.CreateWindow then showErr("Slate init: "..tostring(Slate)) return end

local okWin, Window = pcall(function()
    return Slate:CreateWindow({ Name = "Liberium Hub", Subtitle = "MM2 | Stable", Icon = "shield", Logo = true, Size = UDim2.fromOffset(550, 380), ToggleKey = Enum.KeyCode.RightShift })
end)
if not okWin or not Window or not Window.root then showErr("CreateWindow: "..tostring(Window)) return end

-- Масштабирование
pcall(function()
    local uiscale = Instance.new("UIScale", Window.root)
    local function updateScale() 
        local cam = workspace.CurrentCamera
        if cam then uiscale.Scale = math.min(1, cam.ViewportSize.X / 600, cam.ViewportSize.Y / 420) end 
    end
    updateScale()
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
end)

-- ============== УМНЫЙ АДАПТЕР МЕТОДОВ ==============
local function getKeys(t)
    local keys = {}
    if type(t) == "table" then
        for k in pairs(t) do table.insert(keys, tostring(k)) end
        local mt = getmetatable(t)
        if mt and mt.__index and type(mt.__index) == "table" then
            for k in pairs(mt.__index) do table.insert(keys, tostring(k)) end
        end
    end
    return table.concat(keys, ", ")
end

local function safeAdd(sec, tab, methodNames, opts)
    for _, name in ipairs(methodNames) do
        if type(sec[name]) == "function" then
            pcall(sec[name], sec, opts)
            return
        elseif type(tab[name]) == "function" then
            pcall(tab[name], tab, opts)
            return
        end
    end
    -- Если ничего не нашли - выводим ошибку со списком доступных методов
    showErr("Не найден метод для "..opts.Name..".\nДоступные методы: "..getKeys(sec))
end

local toggleMethods = {"AddToggle", "CreateToggle", "Toggle", "NewToggle", "AddToggleBox"}
local sliderMethods = {"AddSlider", "CreateSlider", "Slider", "NewSlider"}

-- ============== ЛОГИКА ==============
local okAll, allErr = pcall(function()
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local Workspace = game:GetService("Workspace")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local VirtualUser = game:GetService("VirtualUser")

    local CFG = {
        MaxSpeed = 20, Gain = 3, ForcePerMass = 1500,
        MaxCoins = 50, AutoReset = false, AutoFarm = false, ESP = false, Noclip = false, AntiAFK = false,
        AvoidRadius = 5, Debug = false,
    }

    local collectedCount = 0
    local Blacklist = setmetatable({}, { __mode = "k" })
    local currentChar = nil
    local originalCollide = setmetatable({}, { __mode = "k" })
    local roles = {}

    local TabVisuals = Window:CreateTab({ Name = "Visuals", Icon = "eye" })
    local TabFarm = Window:CreateTab({ Name = "Farm", Icon = "coins" })
    local TabMisc = Window:CreateTab({ Name = "Misc", Icon = "settings" })

    -- Роли
    task.spawn(function()
        while task.wait(1) do
            pcall(function()
                local getData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
                if getData and getData:IsA("RemoteFunction") then
                    local ok, data = pcall(function() return getData:InvokeServer() end)
                    if ok and type(data) == "table" then roles = data end
                end
            end)
        end
    end)

    local function getRoleColor(plr)
        local rData = roles[plr.Name]
        if rData and rData.Role then
            local r = rData.Role
            if r == "Murderer" or r == "Zombie" then return Color3.fromRGB(255, 50, 50) end
            if r == "Sheriff" then return Color3.fromRGB(50, 120, 255) end
            if r == "Survivor" then return Color3.fromRGB(255, 165, 0) end
        end
        return Color3.fromRGB(50, 255, 100)
    end

    local function canCollect()
        local c = currentChar
        if not c or not c.root or not c.root.Parent then return false end
        if not c.humanoid or c.humanoid.Health <= 0 then return false end
        return true
    end

    -- ESP
    task.spawn(function()
        while task.wait(0.5) do
            if CFG.ESP then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= player and p.Character then
                        local hl = p.Character:FindFirstChild("LibESP") or Instance.new("Highlight")
                        hl.Name = "LibESP" hl.OutlineTransparency = 0
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop hl.Parent = p.Character
                        local c = getRoleColor(p) hl.FillColor = c hl.OutlineColor = c
                    end
                end
            else
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character then
                        local hl = p.Character:FindFirstChild("LibESP")
                        if hl then hl:Destroy() end
                    end
                end
            end
        end
    end)

    -- Физика
    local function bindCharacter(character)
        currentChar = nil
        local root = character:WaitForChild("HumanoidRootPart", 10)
        local humanoid = character:WaitForChild("Humanoid", 10)
        if not (root and humanoid) or player.Character ~= character then return end
        collectedCount = 0 table.clear(Blacklist)
        pcall(function() humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false) end)
        pcall(function() humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false) end)
        local oldBv = root:FindFirstChildOfClass("BodyVelocity")
        local oldBg = root:FindFirstChildOfClass("BodyGyro")
        if oldBv then oldBv:Destroy() end
        if oldBg then oldBg:Destroy() end
        local bv = Instance.new("BodyVelocity") bv.MaxForce = Vector3.zero bv.Velocity = Vector3.zero bv.P = 3000 bv.Parent = root
        local bg = Instance.new("BodyGyro") bg.MaxTorque = Vector3.zero bg.P = 6000 bg.D = 500 bg.CFrame = root.CFrame bg.Parent = root
        currentChar = { character = character, root = root, humanoid = humanoid, bv = bv, bg = bg }
    end

    player.CharacterAdded:Connect(bindCharacter)
    if player.Character then task.spawn(bindCharacter, player.Character) end

    RunService.Stepped:Connect(function()
        if (CFG.Noclip or CFG.AutoFarm) and player.Character then
            for _, d in ipairs(player.Character:GetDescendants()) do
                if d:IsA("BasePart") then
                    if originalCollide[d] == nil then originalCollide[d] = d.CanCollide end
                    d.CanCollide = false
                end
            end
        elseif not CFG.Noclip and not CFG.AutoFarm then
            for p, c in pairs(originalCollide) do pcall(function() if p and p.Parent then p.CanCollide = c end end) end
            table.clear(originalCollide)
        end
    end)

    -- Поиск конфет
    local COIN_PRIMARY = "Coin_Server"
    local COIN_FALLBACK = { Coin = true, Candy = true, Sweet = true }
    local coinCache, coinCacheTime, coinContainer = {}, 0, nil

    local function findCoinContainer()
        return Workspace:FindFirstChild("CoinContainer", true) or Workspace:FindFirstChild("Coins", true) or Workspace:FindFirstChild("CoinFolder", true)
    end

    local function isCoinName(name)
        if name == COIN_PRIMARY then return true end
        if COIN_FALLBACK[name] then return true end
        if name == "CoinVisual" then return false end
        local n = string.lower(name)
        return string.find(n, "coin", 1, true) ~= nil or string.find(n, "candy", 1, true) ~= nil or string.find(n, "sweet", 1, true) ~= nil
    end

    local function isCoinAlive(c, container)
        if not c or not c.Parent then return false end
        if not c:IsDescendantOf(Workspace) then return false end
        if container and not c:IsDescendantOf(container) then return false end
        local vis = c:FindFirstChild("CoinVisual")
        if vis and vis:IsA("BasePart") and vis.Transparency >= 0.99 then return false end
        return true
    end

    local function refreshCoinCache()
        local t = os.clock()
        if t - coinCacheTime < 1 then return end
        coinCacheTime = t coinCache = {} coinContainer = findCoinContainer()
        if coinContainer then
            for _, c in ipairs(coinContainer:GetChildren()) do
                if c:IsA("BasePart") and isCoinName(c.Name) then
                    if not Blacklist[c] and isCoinAlive(c, coinContainer) then
                        coinCache[#coinCache+1] = c
                    elseif not isCoinAlive(c, coinContainer) then Blacklist[c] = true end
                end
            end
        end
        if #coinCache == 0 then
            for _, d in ipairs(Workspace:GetDescendants()) do
                if d:IsA("BasePart") and isCoinName(d.Name) and not Blacklist[d] and isCoinAlive(d, nil) then coinCache[#coinCache+1] = d end
            end
        end
    end

    local function isCoinGuarded(pos)
        local r = CFG.AvoidRadius
        if r <= 0 then return false end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character then
                local pRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                if pRoot and (pRoot.Position - pos).Magnitude < r then return true end
            end
        end
        return false
    end

    local function nearestPart()
        if not currentChar then return nil end
        refreshCoinCache()
        local best, bestDist = nil, math.huge
        local pos = currentChar.root.Position
        for _, c in ipairs(coinCache) do
            if c and c.Parent and not Blacklist[c] then
                local d = (c.Position - pos).Magnitude
                if d < bestDist and not isCoinGuarded(c.Position) then best, bestDist = c, d end
            else Blacklist[c] = true end
        end
        return best
    end

    local function flyTo(target)
        local c = currentChar
        if not c or not canCollect() or not target or not target.Parent then return false end
        local origAR, origPS = c.humanoid.AutoRotate, c.humanoid.PlatformStand
        local arrived, startTime = false, os.clock()
        local ok, err = pcall(function()
            c.humanoid.AutoRotate = false c.humanoid.PlatformStand = true
            local mass = math.max(1, c.root.AssemblyMass)
            local f = mass * CFG.ForcePerMass
            c.bv.MaxForce = Vector3.new(f, f, f) c.bg.MaxTorque = Vector3.new(4e5, 4e5, 4e5)
            while c.humanoid.Health > 0 and c.root.Parent do
                RunService.Heartbeat:Wait()
                if not target.Parent or not target:IsDescendantOf(Workspace) or os.clock() - startTime > 4.0 then Blacklist[target] = true break end
                if not canCollect() then break end
                local offset = target.Position - c.root.Position
                local dist = offset.Magnitude
                if dist <= 3 then arrived = true break end
                c.bv.Velocity = offset.Unit * math.min(CFG.MaxSpeed, dist * CFG.Gain)
                local flat = Vector3.new(offset.X, 0, offset.Z)
                if flat.Magnitude > 0.5 then c.bg.CFrame = CFrame.lookAt(c.root.Position, c.root.Position + flat) end
            end
        end)
        if not ok then warn("[Liberium flyTo]", err) end
        c.bv.MaxForce = Vector3.zero c.bv.Velocity = Vector3.zero c.bg.MaxTorque = Vector3.zero
        if c.root.Parent then
            c.root.AssemblyLinearVelocity = Vector3.zero c.root.AssemblyAngularVelocity = Vector3.zero
            local _, yaw = c.root.CFrame:ToOrientation() c.root.CFrame = CFrame.new(c.root.Position) * CFrame.Angles(0, yaw, 0)
        end
        if c.humanoid.Parent and c.humanoid.Health > 0 then
            c.humanoid.AutoRotate = origAR c.humanoid.PlatformStand = origPS c.humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        return arrived
    end

    local function collectTarget(target)
        local c = currentChar
        if not c or not target.Parent then return end
        Blacklist[target] = true collectedCount += 1
        pcall(function()
            if typeof(firetouchinterest) == "function" then firetouchinterest(c.root, target, 0) firetouchinterest(c.root, target, 1) end
            local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt and prompt.Enabled and typeof(fireproximityprompt) == "function" then fireproximityprompt(prompt) end
        end)
    end

    local function collectSession()
        while CFG.AutoFarm and canCollect() do
            if CFG.AutoReset and collectedCount >= CFG.MaxCoins then
                if currentChar and currentChar.humanoid then currentChar.humanoid.Health = 0 end
                break
            end
            local target = nearestPart()
            if not target then break end
            if flyTo(target) then collectTarget(target) task.wait(0.1) else break end
        end
    end

    task.spawn(function()
        while true do
            if CFG.AutoFarm and canCollect() then collectSession() end
            task.wait(1)
        end
    end)

    player.Idled:Connect(function()
        if CFG.AntiAFK then VirtualUser:CaptureController() VirtualUser:ClickButton2(Vector2.new()) end
    end)

    -- ============== НАПОЛНЕНИЕ UI (ЧЕРЕЗ АДАПТЕР) ==============
    local secVisuals = TabVisuals:CreateSection({ Name = "ESP Settings" })
    safeAdd(secVisuals, TabVisuals, toggleMethods, { Name = "Player ESP (Roles)", Default = false, Callback = function(v) CFG.ESP = v end })

    local secFarm = TabFarm:CreateSection({ Name = "Automation" })
    safeAdd(secFarm, TabFarm, toggleMethods, { Name = "Auto Farm (Coins)", Default = false, Callback = function(v)
        CFG.AutoFarm = v
        if v then collectedCount = 0 table.clear(Blacklist) coinCacheTime = 0 end
    end })
    safeAdd(secFarm, TabFarm, sliderMethods, { Name = "Farm Speed", Min = 10, Max = 24, Default = 20, Callback = function(v) CFG.MaxSpeed = v end })
    safeAdd(secFarm, TabFarm, toggleMethods, { Name = "Auto Reset (Full Bag)", Default = false, Callback = function(v) CFG.AutoReset = v end })
    safeAdd(secFarm, TabFarm, sliderMethods, { Name = "Max Coins", Min = 40, Max = 50, Default = 50, Callback = function(v) CFG.MaxCoins = v end })
    safeAdd(secFarm, TabFarm, sliderMethods, { Name = "Avoid Players radius", Min = 0, Max = 10, Default = 5, Callback = function(v) CFG.AvoidRadius = v end })

    local secMisc = TabMisc:CreateSection({ Name = "Miscellaneous" })
    safeAdd(secMisc, TabMisc, toggleMethods, { Name = "Anti-AFK", Default = false, Callback = function(v) CFG.AntiAFK = v end })
    safeAdd(secMisc, TabMisc, toggleMethods, { Name = "Noclip", Default = false, Callback = function(v) CFG.Noclip = v end })
    safeAdd(secMisc, TabMisc, toggleMethods, { Name = "Debug (console)", Default = false, Callback = function(v) CFG.Debug = v end })
end)

if not okAll then
    showErr("Runtime error: " .. tostring(allErr))
end

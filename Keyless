local function createToggle(page, text, order, default, callback)
	local row = create("Frame", { Name = text .. "Toggle", Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = Theme.Panel, BorderSizePixel = 0, LayoutOrder = order }, page)
	addCorner(row, 10)
	addStroke(row, Theme.PanelLight, 1)
	create("TextLabel", { Size = UDim2.new(1, -80, 1, 0), Position = UDim2.fromOffset(14, 0), BackgroundTransparency = 1, Text = text, TextColor3 = Theme.Text, Font = Enum.Font.GothamMedium, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left }, row)
	local track = create("TextButton", { Size = UDim2.fromOffset(48, 26), Position = UDim2.new(1, -62, 0.5, -13), BackgroundColor3 = Theme.PanelLight, Text = "", AutoButtonColor = false }, row)
	addCorner(track, 13)
	local knob = create("Frame", { Size = UDim2.fromOffset(20, 20), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = Theme.Text, BorderSizePixel = 0 }, track)
	addCorner(knob, 10)
	local enabled = default == true
	local function render(animate)
		local trackColor = enabled and Theme.Accent or Theme.PanelLight
		local knobPos = enabled and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3)
		if animate then tween(track, { BackgroundColor3 = trackColor }); tween(knob, { Position = knobPos }) else track.BackgroundColor3 = trackColor; knob.Position = knobPos end
	end
	render(false)
	track.MouseButton1Click:Connect(function() enabled = not enabled; render(true); if callback then safe(callback, enabled) end end)
	return row
end

local function createSlider(page, text, order, minValue, maxValue, default, callback)
	local row = create("Frame", { Name = text .. "Slider", Size = UDim2.new(1, 0, 0, 64), BackgroundColor3 = Theme.Panel, BorderSizePixel = 0, LayoutOrder = order }, page)
	addCorner(row, 10)
	addStroke(row, Theme.PanelLight, 1)
	create("TextLabel", { Size = UDim2.new(1, -90, 0, 24), Position = UDim2.fromOffset(14, 6), BackgroundTransparency = 1, Text = text, TextColor3 = Theme.Text, Font = Enum.Font.GothamMedium, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left }, row)
	local valueLabel = create("TextLabel", { Size = UDim2.fromOffset(70, 24), Position = UDim2.new(1, -84, 0, 6), BackgroundTransparency = 1, Text = tostring(default), TextColor3 = Theme.Accent, Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Right }, row)
	local bar = create("TextButton", { Size = UDim2.new(1, -28, 0, 8), Position = UDim2.new(0, 14, 0, 44), BackgroundColor3 = Theme.PanelLight, Text = "", AutoButtonColor = false }, row)
	addCorner(bar, 4)
	local initialAlpha = math.clamp((default - minValue) / (maxValue - minValue), 0, 1)
	local fill = create("Frame", { Size = UDim2.fromScale(initialAlpha, 1), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0 }, bar)
	addCorner(fill, 4)
	local knob = create("Frame", { Size = UDim2.fromOffset(20, 20), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = Theme.Text, BorderSizePixel = 0, ZIndex = 2 }, fill)
	addCorner(knob, 10)
	addStroke(knob, Theme.Accent, 2)
	local dragging = false
	local activeInput = nil
	local lastValue = default
	local function updateFromX(x)
		local width = bar.AbsoluteSize.X
		if width <= 0 then return end
		local alpha = math.clamp((x - bar.AbsolutePosition.X) / width, 0, 1)
		local value = math.floor(minValue + (maxValue - minValue) * alpha + 0.5)
		fill.Size = UDim2.fromScale(alpha, 1)
		valueLabel.Text = tostring(value)
		if value ~= lastValue then lastValue = value; if callback then safe(callback, value) end end
	end
	bar.InputBegan:Connect(function(input) if isPress(input) then dragging = true; activeInput = input; page.ScrollingEnabled = false; updateFromX(input.Position.X) end end)
	UserInputService.InputChanged:Connect(function(input) if dragging and isMove(input) and (input == activeInput or input.UserInputType == Enum.UserInputType.MouseMovement) then updateFromX(input.Position.X) end end)
	UserInputService.InputEnded:Connect(function(input) if dragging and (input == activeInput or isPress(input)) then dragging = false; activeInput = nil; page.ScrollingEnabled = true end end)
	return row
end

local function makeDraggable(handle, target, scaleObject)
	local dragging, activeInput, dragStart, startPos, moved = false, nil, Vector2.zero, target.Position, false
	handle.InputBegan:Connect(function(input) if isPress(input) then dragging = true; activeInput = input; moved = false; dragStart = Vector2.new(input.Position.X, input.Position.Y); startPos = target.Position end end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging or not isMove(input) then return end
		if input.UserInputType == Enum.UserInputType.Touch and input ~= activeInput then return end
		safe(function()
			local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
			if delta.Magnitude > 6 then moved = true end
			if moved then local scale = math.max(scaleObject.Scale, 0.01); target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X / scale, startPos.Y.Scale, startPos.Y.Offset + delta.Y / scale) end
		end)
	end)
	UserInputService.InputEnded:Connect(function(input) if dragging and (input == activeInput or isPress(input)) then dragging = false; activeInput = nil end end)
	return { get moved() return moved end, set moved(v) moved = v end }
end


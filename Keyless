local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local LP = Players.LocalPlayer
local isFarming = false
local blacklist = {}

-- Удаляем старое окно
local oldGui = LP.PlayerGui:FindFirstChild("FarmTestGui")
if oldGui then oldGui:Destroy() end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FarmTestGui"
ScreenGui.Parent = LP:WaitForChild("PlayerGui")

local Btn = Instance.new("TextButton")
Btn.Size = UDim2.new(0, 150, 0, 50)
Btn.AnchorPoint = Vector2.new(0.5, 0.5)
Btn.Position = UDim2.new(0.5, 0, 0.4, 0)
Btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
Btn.Font = Enum.Font.GothamBold
Btn.TextSize = 18
Btn.Text = "FARM: OFF"
Btn.Parent = ScreenGui

local StatusText = Instance.new("TextLabel")
StatusText.Size = UDim2.new(0, 300, 0, 40)
StatusText.AnchorPoint = Vector2.new(0.5, 0.5)
StatusText.Position = UDim2.new(0.5, 0, 0.4, 60)
StatusText.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
StatusText.BackgroundTransparency = 0.4
StatusText.TextColor3 = Color3.fromRGB(0, 255, 0)
StatusText.Font = Enum.Font.Code
StatusText.TextSize = 16
StatusText.Text = "Ожидание..."
StatusText.Parent = ScreenGui

local function getContainer()
    return Workspace:FindFirstChild("CoinContainer", true)
end

local function getClosestCoin()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local container = getContainer()
    if not container then return nil end

    local closest, minDist = nil, math.huge
    for _, coin in ipairs(container:GetChildren()) do
        if coin.Name == "Coin_Server" and coin:IsA("BasePart") and not blacklist[coin] then
            local dist = (coin.Position - hrp.Position).Magnitude
            if dist < minDist then
                minDist = dist
                closest = coin
            end
        end
    end
    return closest, minDist
end

local function teleportAndCollect(coin)
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    blacklist[coin] = true

    -- Телепорт на 3 стада выше монеты
    char:PivotTo(CFrame.new(coin.Position + Vector3.new(0, 3, 0)))
    
    pcall(function()
        firetouchinterest(hrp, coin, 0)
        firetouchinterest(hrp, coin, 1)
    end)
    
    for _, prompt in ipairs(coin:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            pcall(function() fireproximityprompt(prompt) end)
        end
    end
end

-- Главный цикл (пошаговый, без резких прыжков)
task.spawn(function()
    while task.wait(0.1) do
        if isFarming then
            local char = LP.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            if not char or not hum or hum.Health <= 0 then
                StatusText.Text = "Мертв..."
                continue
            end

            local coin, dist = getClosestCoin()
            if coin then
                StatusText.Text = "Летим к монете (" .. math.floor(dist) .. " st)"
                teleportAndCollect(coin)
                
                -- Ждем, пока сервер удалит монету
                local timeout = 0
                while coin.Parent and timeout < 0.4 do
                    task.wait(0.05)
                    timeout += 0.05
                end
                
                -- Если монета не удалилась, скипаем
                if coin.Parent then
                    blacklist[coin] = true
                end
                
                -- Пауза чтобы античит не спалил
                task.wait(0.15)
            else
                StatusText.Text = "Все монеты собраны (ждем)"
            end
        end
    end
end)

-- Очистка черного списка
task.spawn(function()
    while task.wait(5) do
        for coin in pairs(blacklist) do
            if not coin.Parent then
                blacklist[coin] = nil
            end
        end
    end
end)

Btn.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        Btn.Text = "FARM: ON"
        Btn.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
    else
        Btn.Text = "FARM: OFF"
        Btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        StatusText.Text = "Ожидание..."
    end
end)

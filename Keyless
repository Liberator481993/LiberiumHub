    b.MouseEnter:Connect(function() if self.ActiveTab ~= tab then Tween(b, 0.15, { BackgroundTransparency = 0.4, TextColor3 = Theme.White }) end end)
    b.MouseLeave:Connect(function() if self.ActiveTab ~= tab then Tween(b, 0.15, { BackgroundTransparency = 1, TextColor3 = Theme.Muted }) end end)
    b.Activated:Connect(function() self:_SelectTab(tab) end) if not self.ActiveTab then self:_SelectTab(tab) end
    

    local function updateScale() 
        local cam = workspace.CurrentCamera
        if cam then uiscale.Scale = math.min(1, cam.ViewportSize.X / 600, cam.ViewportSize.Y / 420) end 
    end
    updateScale()
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
end)

local function findMethod(obj, keyword)
    local mt = getmetatable(obj)
    if mt and mt.__index then
        if type(mt.__index) == "table" then
            for k, v in pairs(mt.__index) do
                if type(v) == "function" and string.find(string.lower(tostring(k)), keyword) then return k end
            end
        end
    end
    for k, v in pairs(obj) do
        if type(v) == "function" and string.find(string.lower(tostring(k)), keyword) then return k end
    end
    local defaults = {"AddToggle", "CreateToggle", "Toggle", "NewToggle", "AddSlider", "CreateSlider", "Slider", "NewSlider"}
    for _, name in ipairs(defaults) do
        if string.find(string.lower(name), keyword) then
            local ok, res = pcall(function() return obj[name] end)
            if ok and res then return name end
        end
    end
    return nil
end

local function addElement(sec, tab, win, opts, keyword)
    local method = findMethod(sec, keyword) or findMethod(tab, keyword) or findMethod(win, keyword)
    if method then
        local target = (findMethod(sec, keyword) and sec) or (findMethod(tab, keyword) and tab) or win
        pcall(target[method], target, opts)
    end
end

-- ============== ЛОГИКА ==============
local okAll, allErr = pcall(function()
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local Workspace = game:GetService("Workspace")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local VirtualUser = game:GetService("VirtualUser")

    local CFG = {
        MaxSpeed = 20, Gain = 3, ForcePerMass = 1500,
        MaxCoins = 50, AutoReset = false, AutoFarm = false, ESP = false, Noclip = false, AntiAFK = false,
        AvoidRadius = 5, Debug = false,
    }

    local collectedCount = 0
    local Blacklist = setmetatable({}, { __mode = "k" })
    local originalCollide = setmetatable({}, { __mode = "k" })
    local roles = {}
    local canFarmNow = false
    
    -- Переменная сессии из кода Клода
    local currentSession = nil 

    local TabVisuals = Window:CreateTab({ Name = "Visuals", Icon = "eye" })
    local TabFarm = Window:CreateTab({ Name = "Farm", Icon = "coins" })
    local TabMisc = Window:CreateTab({ Name = "Misc", Icon = "settings" })

    task.spawn(function()
        while task.wait(0.5) do
            pcall(function()
                local getData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
                if getData and getData:IsA("RemoteFunction") then
                    local ok, data = pcall(function() return getData:InvokeServer() end)
                    if ok and type(data) == "table" then roles = data end
                end
            end)
        end
    end)

    local function getRoleColor(plr)
        local rData = roles[plr.Name]
        if rData and rData.Role then
            local r = rData.Role
            if r == "Murderer" or r == "Zombie" then return Color3.fromRGB(255, 50, 50) end
            if r == "Sheriff" then return Color3.fromRGB(50, 120, 255) end
            if r == "Survivor" then return Color3.fromRGB(255, 165, 0) end
        end
        return Color3.fromRGB(50, 255, 100)
    end

    local function canCollect()
        if not canFarmNow then return false end
        local s = currentSession
        if not s or s.destroyed or s.humanoid.Health <= 0 then return false end
        
        local myData = roles[player.Name]
        if myData then
            if myData.Dead then return false end
            local r = myData.Role
            if not r or r == "Spectator" or r == "Lobby" then return false end
        end

        local container = Workspace:FindFirstChild("CoinContainer", true)
        if not container or #container:GetChildren() == 0 then return false end
        
        return true
    end

    -- ESP Фикс
    task.spawn(function()
        while task.wait(0.3) do
            if CFG.ESP then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= player and p.Character then
                        local myData = roles[p.Name]
                        local isDead = myData and myData.Dead
                        local hl = p.Character:FindFirstChild("LibESP")
                        
                        if isDead then
                            if hl then hl:Destroy() end
                        else
                            if not hl then
                                hl = Instance.new("Highlight")
                                hl.Name = "LibESP"
                                hl.Parent = p.Character
                            end
                            hl.Adornee = p.Character
                            hl.OutlineTransparency = 0
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            local c = getRoleColor(p) 
                            hl.FillColor = c 
                            hl.OutlineColor = c
                        end
                    end
                end
            else
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character then
                        local hl = p.Character:FindFirstChild("LibESP")
                        if hl then hl:Destroy() end
                    end
                end
            end
        end
    end)

    -- ================= ФИЗИКА (ОТ КЛОДА) =================
    local function releaseForces(s)
        s.bv.MaxForce = Vector3.zero
        s.bv.Velocity = Vector3.zero
        s.bg.MaxTorque = Vector3.zero
    end

    local function resetHumanoid(s)
        local hum = s.humanoid
        if not hum.Parent then return end
        hum.PlatformStand = s.origPlatformStand
        hum.AutoRotate = s.origAutoRotate
        if hum.Health > 0 and s.root.Parent then
            local _, yaw = s.root.CFrame:ToOrientation()
            s.root.CFrame = CFrame.new(s.root.Position) * CFrame.Angles(0, yaw, 0)
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end

    local function teardown(s)
        if not s or s.destroyed then return end
        s.destroyed = true
        
        for _, conn in s.conns do conn:Disconnect() end
        table.clear(s.conns)
        
        releaseForces(s)
        
        if s.root.Parent then
            s.root.AssemblyLinearVelocity = Vector3.zero
            s.root.AssemblyAngularVelocity = Vector3.zero
        end
        
        resetHumanoid(s)
        s.bv:Destroy()
        s.bg:Destroy()
        
        if currentSession == s then currentSession = nil end
    end

    local function bindCharacter(character)
        if currentSession then teardown(currentSession) end
        canFarmNow = false
        collectedCount = 0 
        table.clear(Blacklist)

        local root = character:WaitForChild("HumanoidRootPart", 10)
        local humanoid = character:WaitForChild("Humanoid", 10)
        if not (root and humanoid) or player.Character ~= character then return end

        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.zero
        bv.Velocity = Vector3.zero
        bv.P = 3000
        bv.Parent = root

        local bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.zero
        bg.P = 6000
        bg.D = 500
        bg.CFrame = root.CFrame
        bg.Parent = root

        local s = {
            character = character,
            root = root,
            humanoid = humanoid,
            bv = bv,
            bg = bg,
            conns = {},
            destroyed = false,
            origPlatformStand = humanoid.PlatformStand,
            origAutoRotate = humanoid.AutoRotate,
        }
        currentSession = s

        table.insert(s.conns, humanoid.Died:Connect(function() teardown(s) end))
        table.insert(s.conns, character.AncestryChanged:Connect(function(_, parent)
            if parent == nil then teardown(s) end
        end))

        if humanoid.Health <= 0 then teardown(s) end

        -- Ждем 3 секунды перед фармом (фикс лобби)
        task.wait(3)
        canFarmNow = true
    end

    player.CharacterAdded:Connect(bindCharacter)
    player.CharacterRemoving:Connect(function(character)
        if currentSession and currentSession.character == character then teardown(currentSession) end
    end)
    if player.Character then task.spawn(bindCharacter, player.Character) end

    RunService.Stepped:Connect(function()
        if (CFG.Noclip or CFG.AutoFarm) and player.Character and currentSession and not currentSession.destroyed then
            for _, d in ipairs(player.Character:GetDescendants()) do
                if d:IsA("BasePart") then
                    if originalCollide[d] == nil then originalCollide[d] = d.CanCollide end
                    d.CanCollide = false
                end
            end
        elseif not CFG.Noclip and not CFG.AutoFarm then
            for p, c in pairs(originalCollide) do pcall(function() if p and p.Parent then p.CanCollide = c end end) end
            table.clear(originalCollide)
        end
    end)

    local function flyTo(target)
        local s = currentSession
        if not s or s.destroyed or s.humanoid.Health <= 0 or not target.Parent then return false end

        local arrived = false
        local startTime = os.clock()

        local ok, err = pcall(function()
            s.humanoid.AutoRotate = false
            s.humanoid.PlatformStand = true

            local f = s.root.AssemblyMass * CFG.ForcePerMass
            s.bv.MaxForce = Vector3.new(f, f, f)
            s.bg.MaxTorque = Vector3.new(4e5, 4e5, 4e5)

            while not s.destroyed and s.humanoid.Health > 0 and target.Parent do
                RunService.Heartbeat:Wait()
                if s.destroyed then break end
                
                if not target:IsDescendantOf(Workspace) or os.clock() - startTime > 4.0 then Blacklist[target] = true break end
                if not canCollect() then break end

                local pos = s.root.Position
                local offset = target.Position - pos
                local dist = offset.Magnitude
                
                if dist <= 3 then
                    arrived = true
                    break
                end

                s.bv.Velocity = offset.Unit * math.min(CFG.MaxSpeed, dist * CFG.Gain)
                local flat = Vector3.new(offset.X, 0, offset.Z)
                if flat.Magnitude > 0.5 then
                    s.bg.CFrame = CFrame.lookAt(pos, pos + flat)
                end
            end
        end)
        if not ok then warn("flyTo error:", err) end

        if not s.destroyed then
            releaseForces(s)
            s.root.AssemblyLinearVelocity = Vector3.zero
            s.root.AssemblyAngularVelocity = Vector3.zero
            resetHumanoid(s)
        end
        return arrived
    end

    -- Поиск конфет
    local COIN_PRIMARY = "Coin_Server"
    local COIN_FALLBACK = { Coin = true, Candy = true, Sweet = true }
    local coinCache, coinCacheTime, coinContainer = {}, 0, nil

    local function findCoinContainer()
        return Workspace:FindFirstChild("CoinContainer", true) or Workspace:FindFirstChild("Coins", true) or Workspace:FindFirstChild("CoinFolder", true)
    end

    local function isCoinName(name)
        if name == COIN_PRIMARY then return true end
        if COIN_FALLBACK[name] then return true end
        if name == "CoinVisual" then return false end
        local n = string.lower(name)
        return string.find(n, "coin", 1, true) ~= nil or string.find(n, "candy", 1, true) ~= nil or string.find(n, "sweet", 1, true) ~= nil
    end

    local function isCoinAlive(c, container)
        if not c or not c.Parent then return false end
        if not c:IsDescendantOf(Workspace) then return false end
        if container and not c:IsDescendantOf(container) then return false end
        local vis = c:FindFirstChild("CoinVisual")
        if vis and vis:IsA("BasePart") and vis.Transparency >= 0.99 then return false end
        return true
    end

    local function refreshCoinCache()
        local t = os.clock()
        if t - coinCacheTime < 1 then return end
        coinCacheTime = t coinCache = {} coinContainer = findCoinContainer()
        if coinContainer then
            for _, c in ipairs(coinContainer:GetChildren()) do
                if c:IsA("BasePart") and isCoinName(c.Name) then
                    if not Blacklist[c] and isCoinAlive(c, coinContainer) then
                        coinCache[#coinCache+1] = c
                    elseif not isCoinAlive(c, coinContainer) then Blacklist[c] = true end
                end
            end
        end
        if #coinCache == 0 then
            for _, d in ipairs(Workspace:GetDescendants()) do
                if d:IsA("BasePart") and isCoinName(d.Name) and not Blacklist[d] and isCoinAlive(d, nil) then coinCache[#coinCache+1] = d end
            end
        end
    end

    local function isCoinGuarded(pos)
        local r = CFG.AvoidRadius
        if r <= 0 then return false end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character then
                local pRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                if pRoot and (pRoot.Position - pos).Magnitude < r then return true end
            end
        end
        return false
    end

    local function nearestPart()
        local s = currentSession
        if not s or s.destroyed then return nil end
        refreshCoinCache()
        local best, bestDist = nil, math.huge
        local pos = s.root.Position
        for _, c in ipairs(coinCache) do
            if c and c.Parent and not Blacklist[c] then
                local d = (c.Position - pos).Magnitude
                if d < bestDist and not isCoinGuarded(c.Position) then best, bestDist = c, d end
            else Blacklist[c] = true end
        end
        return best
    end

    local function collectTarget(target)
        local s = currentSession
        if not s or s.destroyed or not target.Parent then return end
        Blacklist[target] = true collectedCount += 1
        pcall(function()
            if typeof(firetouchinterest) == "function" then firetouchinterest(s.root, target, 0) firetouchinterest(s.root, target, 1) end
            local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt and prompt.Enabled and typeof(fireproximityprompt) == "function" then fireproximityprompt(prompt) end
        end)
    end

    local function collectSession()
        while CFG.AutoFarm and canCollect() do
            if CFG.AutoReset and collectedCount >= CFG.MaxCoins then
                if currentSession and currentSession.humanoid then currentSession.humanoid.Health = 0 end
                break
            end
            local target = nearestPart()
            if not target then break end
            if flyTo(target) then collectTarget(target) task.wait(0.1) else break end
        end
    end

    task.spawn(function()
        while true do
            if CFG.AutoFarm and canCollect() then collectSession() end
            task.wait(1)
        end
    end)

    player.Idled:Connect(function()
        if CFG.AntiAFK then VirtualUser:CaptureController() VirtualUser:ClickButton2(Vector2.new()) end
    end)

    local secVisuals = TabVisuals:CreateSection({ Name = "ESP Settings" })
    addElement(secVisuals, TabVisuals, Window, { Name = "Player ESP (Roles)", Default = false, Callback = function(v) CFG.ESP = v end }, "toggle")

    local secFarm = TabFarm:CreateSection({ Name = "Automation" })
    addElement(secFarm, TabFarm, Window, { Name = "Auto Farm (Coins)", Default = false, Callback = function(v)
        CFG.AutoFarm = v
        if v then collectedCount = 0 table.clear(Blacklist) coinCacheTime = 0 end
    end }, "toggle")
    
    addElement(secFarm, TabFarm, Window, { Name = "Farm Speed", Min = 10, Max = 24, Default = 20, Callback = function(v) CFG.MaxSpeed = v end }, "slider")
    addElement(secFarm, TabFarm, Window, { Name = "Auto Reset (Full Bag)", Default = false, Callback = function(v) CFG.AutoReset = v end }, "toggle")
    addElement(secFarm, TabFarm, Window, { Name = "Max Coins", Min = 40, Max = 50, Default = 50, Callback = function(v) CFG.MaxCoins = v end }, "slider")
    addElement(secFarm, TabFarm, Window, { Name = "Avoid Players radius", Min = 0, Max = 10, Default = 5, Callback = function(v) CFG.AvoidRadius = v end }, "slider")

    local secMisc = TabMisc:CreateSection({ Name = "Miscellaneous" })
    addElement(secMisc, TabMisc, Window, { Name = "Anti-AFK", Default = false, Callback = function(v) CFG.AntiAFK = v end }, "toggle")
    addElement(secMisc, TabMisc, Window, { Name = "Noclip", Default = false, Callback = function(v) CFG.Noclip = v end }, "toggle")
end)

if not okAll then
    showErr("Runtime error: " .. tostring(allErr))
end

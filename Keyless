    self.HeaderSearch:GetPropertyChangedSignal("Text"):Connect(function() self:FilterTabs(self.HeaderSearch.Text) end)
    self.SideSearch:GetPropertyChangedSignal("Text"):Connect(function() self:FilterTabs(self.SideSearch.Text) end)

    -- ЖЕСТКИЙ ФИКС РАЗМЕРА ПОД ТЕЛЕФОН
    local function responsive()
        local camera = workspace.CurrentCamera if not camera then return end
        local viewport = camera.ViewportSize
        local width, height = viewport.X, viewport.Y
        
        -- Базовый размер окна всегда 580x380
        -- Считаем, насколько его нужно уменьшить, чтобы влезло с отступами
        local scaleX = (width * 0.90) / 580
        local scaleY = (height * 0.80) / 380
        self.Scale.Scale = math.min(scaleX, scaleY, 1.2) 
        
        if width < 700 then
            -- Мобильная раскладка (сворачиваем сайдбар в иконки)
            self.Sidebar.Position = UDim2.new(0, 7, 0, 8) self.Sidebar.Size = UDim2.new(0, 61, 1, -16) self.SideSearch.Visible = false
            self.Nav.Position = UDim2.new(0, 5, 0, 9) self.Nav.Size = UDim2.new(1, -10, 1, -18)
            self.Content.Position = UDim2.new(0, 76, 0, 8) self.Content.Size = UDim2.new(1, -84, 1, -16)
            self.HeaderSearch.Visible = false self.TitleLabel.Size = UDim2.new(1, -125, 0, 24) self.TitleLabel.TextSize = 14 self.Subtitle.Visible = false
        else
            -- ПК раскладка
            self.Sidebar.Position = UDim2.new(0, 12, 0, 12) self.Sidebar.Size = UDim2.new(0, 165, 1, -24) self.SideSearch.Visible = true
            self.Nav.Position = UDim2.new(0, 8, 0, 55) self.Nav.Size = UDim2.new(1, -16, 1, -66)
            self.Content.Position = UDim2.new(0, 189, 0, 12) self.Content.Size = UDim2.new(1, -201, 1, -24)
            self.HeaderSearch.Visible = true self.TitleLabel.Size = UDim2.new(0, 210, 0, 24) self.TitleLabel.TextSize = 17 self.Subtitle.Visible = true
        end
    end
    self._responsive = responsive responsive()
    if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(responsive) end
    return setmetatable(self, Window)
end

function Window:FilterTabs(query) query = string.lower(query or "") for _, tab in ipairs(self.Tabs) do local match = query == "" or string.find(string.lower(tab.Name), query, 1, true) ~= nil or string.find(string.lower(tab.Icon), query, 1, true) ~= nil tab.Button.Visible = match end end
function Window:ClearContent() for _, child in ipairs(self.Content:GetChildren()) do if child:IsA("GuiObject") and child ~= self.ContentLayout then child:Destroy() end end end
function Window:SelectTab(tab)
    if not tab then return end self.ActiveTab = tab
    for _, item in ipairs(self.Tabs) do local selected = item == tab makeTween(item.Button, 0.16, { BackgroundColor3 = selected and Color3.fromRGB(23, 48, 29) or Theme.Panel }) item.Accent.BackgroundTransparency = selected and 0 or 1 item.Label.TextColor3 = selected and Theme.Green or Theme.Muted end
    self:ClearContent()
    for _, section in ipairs(tab.Sections) do section:Render(self.Content) end
    for _, playerList in ipairs(tab.PlayerLists) do playerList:Render(self.Content) end
    self.Content.CanvasPosition = Vector2.zero
end
function Window:AddTab(name, icon)
    local tab = setmetatable({ Window = self, Name = name, Icon = icon or "◈", Sections = {}, PlayerLists = {} }, Tab)
    local button = makeButton(self.Nav, "", UDim2.new(1, 0, 0, 42), Theme.Panel, Theme.Text)
    button.Name = name .. "Tab" button.LayoutOrder = #self.Tabs + 1 addCorner(button, 10)
    local accent = create("Frame", { Name = "Accent", Position = UDim2.new(0, 0, 0, 8), Size = UDim2.new(0, 3, 1, -16), BackgroundColor3 = Theme.Green, BackgroundTransparency = 1, BorderSizePixel = 0 }, button) addCorner(accent, 3)
    local iconLabel = makeLabel(button, tab.Icon, 17, Theme.Muted, Enum.Font.GothamBold, Enum.TextXAlignment.Center) iconLabel.Position = UDim2.new(0, 4, 0, 0) iconLabel.Size = UDim2.new(0, 32, 1, 0)
    local textLabel = makeLabel(button, name, 11, Theme.Muted, Enum.Font.GothamSemibold) textLabel.Name = "TabLabel" textLabel.Position = UDim2.new(0, 38, 0, 0) textLabel.Size = UDim2.new(1, -44, 1, 0)
    tab.Button, tab.Accent, tab.Label = button, accent, textLabel
    button.Activated:Connect(function() self:SelectTab(tab) end)
    connectHover(button, Theme.Panel, Theme.CardHover)
    table.insert(self.Tabs, tab)
    if not self.ActiveTab then self:SelectTab(tab) end
    if self._responsive then self._responsive() end
    return tab
end
function Window:Close()
    if self.Closed then return end self.Closed = true
    makeTween(self.Main, 0.2, { BackgroundTransparency = 1, Position = UDim2.new(0.5, 0, 0.53, 10) })
    makeTween(self.Backdrop, 0.2, { BackgroundTransparency = 1 })
    task.delay(0.21, function() self.Main.Visible = false self.Backdrop.Visible = false self.OpenButton.Visible = true if self.Blur then self.Blur.Enabled = false end end)
end
function Window:Open()
    self.Closed = false self.Main.Visible = true self.Backdrop.Visible = true
    self.Main.Position = UDim2.new(0.5, 0, 0.53, 10) self.Main.BackgroundTransparency = 1 self.Backdrop.BackgroundTransparency = 1 self.OpenButton.Visible = false
    if self.Blur then self.Blur.Enabled = true end
    makeTween(self.Main, 0.24, { BackgroundTransparency = 0.04, Position = UDim2.fromScale(0.5, 0.5) })
    makeTween(self.Backdrop, 0.24, { BackgroundTransparency = 0.48 })
end
function Tab:AddSection(name) local section = setmetatable({ Tab = self, Name = name, Items = {} }, Section) table.insert(self.Sections, section) if self.Window.ActiveTab == self then self.Window:SelectTab(self) end return section end
function Tab:AddPlayerList(name) local list = setmetatable({ Tab = self, Name = name or "Players", Players = {}, Search = "", SelectedPlayer = nil }, PlayerList) table.insert(self.PlayerLists, list) if self.Window.ActiveTab == self then self.Window:SelectTab(self) end return list end
function Section:AddToggle(name, defaultState, callback) local item = { Type = "Toggle", Name = name, Value = defaultState == true, Callback = callback } table.insert(self.Items, item) if self.Tab.Window.ActiveTab == self.Tab then self.Tab.Window:SelectTab(self.Tab) end return item end
function Section:AddSlider(name, minimum, maximum, defaultValue, callback) local item = { Type = "Slider", Name = name, Min = minimum, Max = maximum, Value = math.clamp(defaultValue or minimum, minimum, maximum), Callback = callback } table.insert(self.Items, item) if self.Tab.Window.ActiveTab == self.Tab then self.Tab.Window:SelectTab(self.Tab) end return item end
function Section:AddButton(name, callback) local item = { Type = "Button", Name = name, Callback = callback } table.insert(self.Items, item) if self.Tab.Window.ActiveTab == self.Tab then self.Tab.Window:SelectTab(self.Tab) end return item end

function Section:Render(parent)
    local container = create("Frame", { Name = self.Name .. "Section", Size = UDim2.new(1, 0, 0, 50), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.Card, BackgroundTransparency = 0.16, BorderSizePixel = 0 }, parent)
    addCorner(container, 13) addStroke(container, Theme.Line, 0.48, 1) addGradient(container, Color3.fromRGB(29, 31, 30), Color3.fromRGB(20, 22, 22), 90)
    create("UIPadding", { PaddingTop = UDim.new(0, 11), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, container)
    create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, container)
    local title = makeLabel(container, string.upper(self.Name), 9, Theme.Muted, Enum.Font.GothamBold) title.Size = UDim2.new(1, 0, 0, 18) title.LayoutOrder = 0

    for index, item in ipairs(self.Items) do
        if item.Type == "Toggle" then
            local row = create("Frame", { Name = item.Name, Size = UDim2.new(1, 0, 0, 47), BackgroundTransparency = 1, LayoutOrder = index }, container)
            local titleLabel = makeLabel(row, item.Name, 12, Theme.Text, Enum.Font.GothamSemibold) titleLabel.Size = UDim2.new(1, -75, 1, 0)
            local switch = makeButton(row, "", UDim2.fromOffset(42, 23), item.Value and Theme.Green or Color3.fromRGB(60, 64, 61), Theme.Text)
            switch.Name = "Switch" switch.AnchorPoint = Vector2.new(1, 0.5) switch.Position = UDim2.new(1, -2, 0.5, 0) addCorner(switch, 20)
            local switchStroke = addStroke(switch, item.Value and Theme.Green or Theme.Line, 0.25, 1)
            local thumb = create("Frame", { Name = "Thumb", Position = item.Value and UDim2.new(1, -20, 0.5, -8) or UDim2.new(0, 4, 0.5, -8), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Theme.White, BorderSizePixel = 0 }, switch) addCorner(thumb, 20)
            switch.Activated:Connect(function()
                item.Value = not item.Value makeTween(switch, 0.16, { BackgroundColor3 = item.Value and Theme.Green or Color3.fromRGB(60, 64, 61) })
                makeTween(switchStroke, 0.16, { Color = item.Value and Theme.Green or Theme.Line })
                makeTween(thumb, 0.16, { Position = item.Value and UDim2.new(1, -20, 0.5, -8) or UDim2.new(0, 4, 0.5, -8) })
                if item.Callback then task.spawn(item.Callback, item.Value) end
            end)
        elseif item.Type == "Slider" then
            local row = create("Frame", { Name = item.Name, Size = UDim2.new(1, 0, 0, 62), BackgroundTransparency = 1, LayoutOrder = index }, container)
            local titleLabel = makeLabel(row, item.Name, 12, Theme.Text, Enum.Font.GothamSemibold) titleLabel.Position = UDim2.new(0, 0, 0, 0) titleLabel.Size = UDim2.new(0.75, 0, 0, 22)
            local valueLabel = makeLabel(row, tostring(item.Value), 11, Theme.Green, Enum.Font.GothamBold, Enum.TextXAlignment.Right) valueLabel.Position = UDim2.new(0.75, 0, 0, 0) valueLabel.Size = UDim2.new(0.25, 0, 0, 22)
            local track = create("Frame", { Name = "Track", Position = UDim2.new(0, 0, 0, 38), Size = UDim2.new(1, -2, 0, 4), BackgroundColor3 = Color3.fromRGB(61, 67, 63), BorderSizePixel = 0 }, row) addCorner(track, 5)
            local percent = (item.Value - item.Min) / (item.Max - item.Min)
            local fill = create("Frame", { Size = UDim2.new(percent, 0, 1, 0), BackgroundColor3 = Theme.Green, BorderSizePixel = 0 }, track) addCorner(fill, 5)
            local thumb = create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(percent, 0, 0.5, 0), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = Theme.White, BorderSizePixel = 0 }, track) addCorner(thumb, 20) addStroke(thumb, Theme.Green, 0.35, 1)
            local hit = makeButton(track, "", UDim2.new(1, 0, 0, 28), Theme.Panel, Theme.Text) hit.Position = UDim2.new(0, 0, 0.5, -14) hit.BackgroundTransparency = 1 hit.ZIndex = 4
            local dragging = false
            local function setFromX(x)
                local p = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
                local value = math.floor(item.Min + (item.Max - item.Min) * p + 0.5) item.Value = value valueLabel.Text = tostring(value)
                makeTween(fill, 0.05, { Size = UDim2.new(p, 0, 1, 0) }, Enum.EasingStyle.Linear) makeTween(thumb, 0.05, { Position = UDim2.new(p, 0, 0.5, 0) }, Enum.EasingStyle.Linear)
                if item.Callback then task.spawn(item.Callback, value) end
            end
            hit.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true setFromX(input.Position.X) end end)
            UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then setFromX(input.Position.X) end end)
            UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
        elseif item.Type == "Button" then
            local btn = makeButton(container, item.Name, UDim2.new(1, 0, 0, 36), Theme.Panel, Theme.Text) btn.LayoutOrder = index addCorner(btn, 8)
            btn.Activated:Connect(function() makeTween(btn, 0.1, { BackgroundColor3 = Theme.GreenDark }) task.delay(0.15, function() makeTween(btn, 0.2, { BackgroundColor3 = Theme.Panel }) end) if item.Callback then task.spawn(item.Callback) end end)
        end
    end
end

function PlayerList:UpdatePlayers() self.Players = Players:GetPlayers() if self.Tab.Window.ActiveTab == self.Tab then self.Tab.Window:SelectTab(self.Tab) end end
function PlayerList:Render(parent)
    local container = create("Frame", { Name = self.Name:gsub("%s+", "") .. "PlayerList", Size = UDim2.new(1, 0, 0, 220), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.Card, BackgroundTransparency = 0.16, BorderSizePixel = 0 }, parent) addCorner(container, 13) addStroke(container, Theme.Line, 0.48, 1)

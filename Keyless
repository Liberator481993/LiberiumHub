local player = game.Players.LocalPlayer
local Workspace = game:GetService("Workspace")

local gui = Instance.new("ScreenGui", player.PlayerGui)
gui.Name = "CandyScanner"
gui.DisplayOrder = 999

local frame = Instance.new("ScrollingFrame", gui)
frame.Size = UDim2.new(0.9, 0, 0.8, 0)
frame.Position = UDim2.new(0.05, 0, 0.1, 0)
frame.BackgroundColor3 = Color3.new(0, 0, 0)
frame.BorderSizePixel = 2
frame.BorderColor3 = Color3.new(1, 0.5, 0)

local txt = Instance.new("TextLabel", frame)
txt.Size = UDim2.new(1, 0, 1, 0)
txt.BackgroundTransparency = 1
txt.TextColor3 = Color3.new(1, 1, 1)
txt.Font = Enum.Font.Code
txt.TextSize = 14
txt.TextWrapped = true
txt.TextXAlignment = Enum.TextXAlignment.Left
txt.TextYAlignment = Enum.TextYAlignment.Top
txt.Text = "Ищу объекты вокруг...\n"

local btn = Instance.new("TextButton", gui)
btn.Size = UDim2.new(0.9, 0, 0.06, 0)
btn.Position = UDim2.new(0.05, 0, 0.92, 0)
btn.BackgroundColor3 = Color3.new(0.5, 0, 1)
btn.TextColor3 = Color3.new(1, 1, 1)
btn.Font = Enum.Font.GothamBold
btn.Text = "СКОПИРОВАТЬ"
btn.TextSize = 18

local logs = {}
local function addLog(text)
    table.insert(logs, text)
    txt.Text = table.concat(logs, "\n")
end

task.spawn(function()
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then addLog("Нет персонажа!") return end

    addLog("=== ПОИСК КОНФЕТ ===")
    
    -- Ищем всё, что находится в радиусе 30 стадов от тебя
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
            local dist = (pos - hrp.Position).Magnitude
            
            if dist < 30 then
                local name = string.lower(obj.Name)
                -- Ищем всё, что похоже на конфету, или просто странные объекты
                if name:find("candy") or name:find("sweet") or name:find("lolli") or name:find("drop") or name:find("bag") or name:find("coin") then
                    addLog("Имя: " .. obj.Name)
                    addLog("Класс: " .. obj.ClassName)
                    addLog("Родитель: " .. obj.Parent.Name)
                    addLog("Дистанция: " .. math.floor(dist) .. " стадов")
                    addLog("-----------------")
                end
            end
        end
    end
    
    if #logs == 1 then
        addLog("Ничего не найдено. Подойди ближе к конфете!")
    else
        addLog("=== КОНЕЦ СПИСКА ===")
    end
end)

btn.MouseButton1Click:Connect(function()
    local finalText = table.concat(logs, "\n")
    pcall(function()
        if setclipboard then setclipboard(finalText) end
        if toclipboard then toclipboard(finalText) end
        if syn and syn.write_clipboard then syn.write_clipboard(finalText) end
    end)
    btn.Text = "СКОПИРОВАНО!"
    btn.BackgroundColor3 = Color3.new(0, 1, 0)
end)

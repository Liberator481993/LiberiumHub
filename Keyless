-- ==========================================
-- РОЛИ И ESP
-- ==========================================
local roles = {}
task.spawn(function()
    while task.wait(1) do
        pcall(function()
            local getData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
            if getData and getData:IsA("RemoteFunction") then
                local success, data = getData:InvokeServer()
                if success and type(data) == "table" then roles = data end
            end
        end)
    end
end)

local function getRoleColor(plr)
    local rData = roles[plr.Name]
    if rData and rData.Role then
        local r = rData.Role
        if r == "Murderer" or r == "Zombie" then return Color3.fromRGB(255, 50, 50) end
        if r == "Sheriff" then return Color3.fromRGB(50, 120, 255) end
        if r == "Survivor" then return Color3.fromRGB(255, 165, 0) end
    end
    return Color3.fromRGB(50, 255, 100)
end

RunService.RenderStepped:Connect(function()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local char = p.Character
            local ourHighlight = nil
            local toDestroy = {}
            
            for _, child in ipairs(char:GetChildren()) do
                if child:IsA("Highlight") then
                    if child.Name == "LibESP" and not ourHighlight then
                        ourHighlight = child
                    else
                        table.insert(toDestroy, child)
                    end
                end
            end
            for _, hl in ipairs(toDestroy) do hl:Destroy() end
            
            if CFG.ESP then
                if not ourHighlight then
                    ourHighlight = Instance.new("Highlight")
                    ourHighlight.Name = "LibESP"
                    ourHighlight.OutlineTransparency = 0
                    ourHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    ourHighlight.Parent = char
                end
                local c = getRoleColor(p)
                ourHighlight.FillColor = c
                ourHighlight.OutlineColor = c
            end
        end
    end
end)

-- ==========================================
-- MOVEMENT & NOCLIP
-- ==========================================
local originalCollide = setmetatable({}, {__mode = "k"})
RunService.Stepped:Connect(function()
    if (CFG.Noclip or CFG.AutoFarm) and LP.Character then
        for _, d in ipairs(LP.Character:GetDescendants()) do
            if d:IsA("BasePart") then
                if originalCollide[d] == nil then originalCollide[d] = d.CanCollide end
                d.CanCollide = false
            end
        end
    elseif not CFG.Noclip and not CFG.AutoFarm then
        for p, c in pairs(originalCollide) do 
            pcall(function() if p and p.Parent then p.CanCollide = c end end) 
        end
        table.clear(originalCollide)
    end
end)

RunService.Heartbeat:Connect(function()
    if LP.Character then
        local hum = LP.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.WalkSpeed ~= CFG.WalkSpeed and not CFG.AutoFarm then 
            hum.WalkSpeed = CFG.WalkSpeed 
        end
    end
end)

-- ==========================================
-- AUTO FARM (ALIGN POSITION - ИДЕАЛЬНЫЙ ПОЛЕТ)
-- ==========================================
local currentTarget = nil
local blacklist = {}
local alignPos = nil
local alignOri = nil

local function setupPhysics(hrp)
    if alignPos then alignPos:Destroy() end
    if alignOri then alignOri:Destroy() end
    
    local att = hrp:FindFirstChild("RootAttachment") or Instance.new("Attachment", hrp)
    
    alignPos = Instance.new("AlignPosition")
    alignPos.Mode = Enum.PositionAlignmentMode.OneAttachment
    alignPos.Attachment0 = att
    alignPos.MaxForce = math.huge
    alignPos.Responsiveness = 100
    alignPos.Position = hrp.Position
    alignPos.Parent = hrp
    
    alignOri = Instance.new("AlignOrientation")
    alignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment
    alignOri.Attachment0 = att
    alignOri.MaxTorque = math.huge
    alignOri.Responsiveness = 100
    alignOri.Parent = hrp
end

local function destroyPhysics()
    if alignPos then alignPos:Destroy(); alignPos = nil end
    if alignOri then alignOri:Destroy(); alignOri = nil end
end

local function findNearest()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local container = Workspace:FindFirstChild("CoinContainer", true)
    if not container then return nil end
    
    local closest, minDist = nil, math.huge
    for _, obj in ipairs(container:GetChildren()) do
        if obj.Name == "Coin_Server" and obj:IsA("BasePart") and not blacklist[obj] then
            local dist = (obj.Position - hrp.Position).Magnitude
            if dist < minDist then
                minDist = dist
                closest = obj
            end
        end
    end
    return closest
end

RunService.Heartbeat:Connect(function()
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if CFG.AutoFarm then
        -- Включаем физику
        if not alignPos or alignPos.Parent ~= hrp then
            setupPhysics(hrp)
        end
        
        -- ОГРАНИЧЕНИЕ СКОРОСТИ (Чтобы не кикало 267)
        alignPos.MaxVelocity = CFG.FarmSpeed 

        if currentTarget and not currentTarget.Parent then
            currentTarget = nil
        end

        if not currentTarget then
            currentTarget = findNearest()
        end

        if currentTarget then
            local targetPos = currentTarget.Position
            local distance = (hrp.Position - targetPos).Magnitude

            if distance < 3.5 then
                blacklist[currentTarget] = true
                pcall(function()
                    firetouchinterest(hrp, currentTarget, 0)
                    firetouchinterest(hrp, currentTarget, 1)
                end)
                for _, prompt in ipairs(currentTarget:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        pcall(function() fireproximityprompt(prompt) end)
                    end
                end
                currentTarget = nil
                task.wait(0.1)
            else
                -- Тянем к цели (безопасно, без CFrame)
                alignPos.Position = targetPos + Vector3.new(0, 2, 0)
                alignOri.CFrame = CFrame.new(hrp.Position, targetPos)
            end
        else
            -- Если цели нет, держим на месте (не падаем)
            alignPos.Position = hrp.Position
        end
    else
        if alignPos then destroyPhysics() end
    end
end)

task.spawn(function()
    while task.wait(5) do
        for obj in pairs(blacklist) do
            if not obj.Parent then blacklist[obj] = nil end
        end
    end
end)


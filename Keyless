local function getClosestMurderer(pos) local cr, cd = nil, math.huge for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer and p.Character then local r = roles[p.UserId] or roles[p.Name] if r and (r.Role == "Murderer" or r.Role == "Zombie" or r.Role == "Killer") then local pr = p.Character:FindFirstChild("HumanoidRootPart") if pr then local d = (pr.Position - pos).Magnitude if d < cd then cr, cd = pr, d end end end end end return cr, cd end
local function FlingTarget(tr) local s = currentSession if not s or s.destroyed or s.humanoid.Health<=0 or not tr then return end local mr = s.root local oc = mr.CFrame local oa = mr.Anchored mr.Anchored=true pcall(function() if setnetworkowner then pcall(setnetworkowner, tr, LocalPlayer) end mr.CFrame = tr.CFrame local sp = Instance.new("BodyAngularVelocity") sp.AngularVelocity=Vector3.new(1e5,1e5,1e5) sp.MaxTorque=Vector3.new(1e9,1e9,1e9) sp.Parent=tr local pu = Instance.new("BodyVelocity") pu.Velocity=Vector3.new(1e5,1e5,1e5) pu.MaxForce=Vector3.new(1e9,1e9,1e9) pu.Parent=tr task.wait(0.1) sp:Destroy() pu:Destroy() end) mr.CFrame=oc mr.Anchored=oa end
task.spawn(function() while task.wait(0.5) and isRunning do if CFG.AutoFling and currentSession and not currentSession.destroyed then local m, d = getClosestMurderer(currentSession.root.Position) if m and d < 50 then FlingTarget(m) task.wait(2) end end end end)


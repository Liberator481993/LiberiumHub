local PulseHub = (function()
    local C = {
        Background = Color3.fromHex("080A09"), Sidebar = Color3.fromHex("0E1210"), Section = Color3.fromHex("131816"), 
        Input = Color3.fromHex("1A211E"), Button = Color3.fromHex("1F2824"), Stroke = Color3.fromHex("2A3B32"),
        Track = Color3.fromHex("2A3B32"), ToggleOff = Color3.fromHex("2A3B32"), Accent = Color3.fromHex("00FF41"), 
        Text = Color3.fromRGB(235, 235, 235), Muted = Color3.fromRGB(130, 150, 140), White = Color3.fromRGB(255, 255, 255),
    }
    local WIDTH, HEIGHT = 600, 380
    local HEADER_H, SIDEBAR_W = 44, 160
    local FONT, FONT_BOLD = Enum.Font.Gotham, Enum.Font.GothamBold

    local function create(class, props, parent) local inst = Instance.new(class) for k, v in pairs(props) do inst[k] = v end if parent then inst.Parent = parent end return inst end
    local function corner(inst, radius) return create("UICorner", { CornerRadius = UDim.new(0, radius) }, inst) end
    local function stroke(inst, color) return create("UIStroke", { Color = color or C.Stroke, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, inst) end
    local function tween(inst, props, t) pcall(function() TweenService:Create(inst, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play() end) end
    local function safeCall(fn, ...) if typeof(fn) == "function" then pcall(fn, ...) end end
    local function isPress(input) return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch end
    local function matches(name, query) return query == "" or string.find(string.lower(name), query, 1, true) ~= nil end

    local Window, Tab, Section, PulseHubClass = {}, {}, {}, {}
    Window.__index, Tab.__index, Section.__index = Window, Tab, Section

    function PulseHubClass.new(opts)
        opts = opts or {}
        local self = setmetatable({}, Window)
        self.Tabs, self.Sections, self.Connections = {}, {}, {}
        self.Query, self.Selected, self.Opts = "", nil, opts

        local gui = create("ScreenGui", { Name = "PulseHub", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 100, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))
        self.Gui = gui

        local floatBtn = create("ImageButton", { Name = "Open", Image = "rbxassetid://93999324301796", ImageColor3 = Color3.new(1,1,1), ScaleType = Enum.ScaleType.Crop, BackgroundColor3 = C.Background, AutoButtonColor = false, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 16, 0.5, 0), Size = UDim2.fromOffset(56, 56), Visible = false }, gui)
        corner(floatBtn, 28) local fs = stroke(floatBtn, C.Accent) fs.Thickness = 2
        local fallbackTxt = create("TextLabel", { Size = UDim2.fromScale(1,1), BackgroundTransparency = 1, Text = "LIB", Font = FONT_BOLD, TextSize = 16, TextColor3 = C.Accent, ZIndex = 0 }, floatBtn)
        
        local fDrag, fStart, fPos = false, nil, nil
        floatBtn.InputBegan:Connect(function(i) if isPress(i) then fDrag, fStart, fPos = true, i.Position, floatBtn.Position end end)
        UIS.InputChanged:Connect(function(i) if fDrag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then local d = i.Position - fStart floatBtn.Position = UDim2.new(fPos.X.Scale, fPos.X.Offset + d.X, fPos.Y.Scale, fPos.Y.Offset + d.Y) end end)
        UIS.InputEnded:Connect(function(i) if isPress(i) then fDrag = false end end)

        local main = create("Frame", { Name = "Main", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(WIDTH, HEIGHT), BackgroundColor3 = C.Background, BorderSizePixel = 0, ClipsDescendants = true }, gui)
        corner(main, 12) stroke(main) self.Main = main

        local uiScale = create("UIScale", {}, main)
        local function updateScale() local cam = workspace.CurrentCamera local vp = cam and cam.ViewportSize or Vector2.new(1280, 720) uiScale.Scale = math.clamp(math.min(vp.X * 0.94 / WIDTH, vp.Y * 0.94 / HEIGHT), 0.5, 1) end
        updateScale() if workspace.CurrentCamera then table.insert(self.Connections, workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)) end

        local header = create("Frame", { Name = "Header", Size = UDim2.new(1, 0, 0, HEADER_H), BackgroundColor3 = C.Background, BorderSizePixel = 0 }, main)
        create("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = C.Accent, BackgroundTransparency = 0.7 }, header)
        create("TextLabel", { Position = UDim2.fromOffset(16, 0), Size = UDim2.new(1, -180, 1, 0), BackgroundTransparency = 1, Text = opts.Title or "Liberium Hub", Font = FONT_BOLD, TextSize = 16, TextColor3 = C.Accent, TextXAlignment = Enum.TextXAlignment.Left }, header)

        local right = create("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0, 160, 0, 32), BackgroundTransparency = 1 }, header)
        create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }, right)

        local headerSearch = create("TextBox", { LayoutOrder = 1, Size = UDim2.new(0, 110, 0, 32), BackgroundColor3 = C.Input, BorderSizePixel = 0, Text = "", PlaceholderText = "Search...", PlaceholderColor3 = C.Muted, TextColor3 = C.Text, Font = FONT, TextSize = 13, ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left }, right)
        corner(headerSearch, 6) stroke(headerSearch) create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, headerSearch)

        local closeBtn = create("TextButton", { LayoutOrder = 2, Size = UDim2.new(0, 32, 0, 32), BackgroundColor3 = C.Input, BorderSizePixel = 0, AutoButtonColor = false, Text = "" }, right)
        corner(closeBtn, 6) stroke(closeBtn)
        local x1 = create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 12, 0, 2), BackgroundColor3 = C.Muted, BorderSizePixel = 0, Rotation = 45 }, closeBtn)
        local x2 = create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 12, 0, 2), BackgroundColor3 = C.Muted, BorderSizePixel = 0, Rotation = -45 }, closeBtn)
        closeBtn.MouseEnter:Connect(function() tween(x1, {BackgroundColor3 = C.White}) tween(x2, {BackgroundColor3 = C.White}) end)
        closeBtn.MouseLeave:Connect(function() tween(x1, {BackgroundColor3 = C.Muted}) tween(x2, {BackgroundColor3 = C.Muted}) end)

        local dragging, dragInput, startInput, startPos = false, nil, nil, nil
        header.InputBegan:Connect(function(input) if isPress(input) then dragging, dragInput = true, input; startInput, startPos = input.Position, main.Position; input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end) end end)
        table.insert(self.Connections, UIS.InputChanged:Connect(function(input) if dragging and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement) then local d = (input.Position - startInput) / uiScale.Scale main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y) end end))

        local sidebar = create("Frame", { Name = "Sidebar", Position = UDim2.fromOffset(0, HEADER_H), Size = UDim2.new(0, SIDEBAR_W, 1, -HEADER_H), BackgroundColor3 = C.Sidebar, BorderSizePixel = 0 }, main)
        local tabList = create("ScrollingFrame", { Position = UDim2.fromOffset(0, 10), Size = UDim2.new(1, 0, 1, -10), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y }, sidebar)
        create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }, tabList)
        create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, tabList)
        self.TabList = tabList
        self.Content = create("Frame", { Name = "Content", Position = UDim2.fromOffset(SIDEBAR_W, HEADER_H), Size = UDim2.new(1, -SIDEBAR_W, 1, -HEADER_H), BackgroundTransparency = 1 }, main)

        headerSearch:GetPropertyChangedSignal("Text"):Connect(function() self.Query = string.lower(headerSearch.Text) self:_applyFilter() end)
        closeBtn.Activated:Connect(function() self:SetVisible(false) end)
        floatBtn.Activated:Connect(function() self:SetVisible(true) end)
        table.insert(self.Connections, UIS.InputBegan:Connect(function(input, processed) if not processed and input.KeyCode == (opts.ToggleKey or Enum.KeyCode.RightShift) then self:SetVisible(not main.Visible) end end))
        return self
    end

    function Window:SetVisible(state) self.Main.Visible = state; if self.Gui:FindFirstChild("Open") then self.Gui.Open.Visible = not state end end
    function Window:Destroy() for _, c in ipairs(self.Connections) do c:Disconnect() end self.Gui:Destroy() end
    function Window:_applyFilter() local q = self.Query for _, section in ipairs(self.Sections) do local sectionHit = matches(section.Title, q) local any = false for _, el in ipairs(section.Elements) do local show = sectionHit or matches(el.Name, q) el.Frame.Visible = show any = any or show end section.Frame.Visible = any or q == "" end end

    function Window:AddTab(name, iconType)
        local tab = setmetatable({ Name = name, Window = self, Sections = {}, _order = 0 }, Tab)
        local btn = create("TextButton", { LayoutOrder = #self.Tabs + 1, Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = C.Section, BackgroundTransparency = 1, BorderSizePixel = 0, AutoButtonColor = false, Text = "" }, self.TabList)
        corner(btn, 6)
        local bar = create("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(0, 4, 0.6, 0), BackgroundColor3 = C.Accent, BackgroundTransparency = 1, BorderSizePixel = 0 }, btn)
        corner(bar, 2)
        
        local iconHolder = create("Frame", { Position = UDim2.fromOffset(14, 10), Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1 }, btn)
        if iconType == "eye" then
            local c = create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1 }, iconHolder)
            corner(c, 8) stroke(c, C.Text) create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(6, 6), BackgroundColor3 = C.Text }, c)
        elseif iconType == "coins" then
            local s = create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = C.Text, Rotation = 45 }, iconHolder)
            corner(s, 3)
        elseif iconType == "settings" then
            local c = create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1 }, iconHolder)
            corner(c, 8) stroke(c, C.Text) create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(4, 4), BackgroundColor3 = C.Text }, c)
        end

        local label = create("TextLabel", { Position = UDim2.fromOffset(44, 0), Size = UDim2.new(1, -50, 1, 0), BackgroundTransparency = 1, Text = name, Font = FONT_BOLD, TextSize = 14, TextColor3 = C.Muted, TextXAlignment = Enum.TextXAlignment.Left }, btn)
        local page = create("ScrollingFrame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = C.Accent, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y, Visible = false }, self.Content)
        create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10) }, page)
        create("UIPadding", { PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, page)
        tab.Button, tab.Bar, tab.Label, tab.Page = btn, bar, label, page
        table.insert(self.Tabs, tab)
        btn.Activated:Connect(function() self:SelectTab(tab) end)
        if not self.Selected then self:SelectTab(tab) end
        return tab
    end

    function Window:SelectTab(target) self.Selected = target for _, tab in ipairs(self.Tabs) do local on = (tab == target) tab.Page.Visible = on tween(tab.Bar, { BackgroundTransparency = on and 0 or 1 }) tween(tab.Button, { BackgroundColor3 = on and C.Section or C.Sidebar, BackgroundTransparency = on and 0 or 1 }) tween(tab.Label, { TextColor3 = on and C.White or C.Muted }) end end
    function Tab:AddSection(title)
        local win = self.Window self._order += 1
        local frame = create("Frame", { LayoutOrder = self._order, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = C.Section, BorderSizePixel = 0 }, self.Page)
        corner(frame, 8) stroke(frame, C.Stroke)
        create("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, frame)
        create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }, frame)
        create("TextLabel", { LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = string.upper(title), Font = FONT_BOLD, TextSize = 12, TextColor3 = C.Accent, TextXAlignment = Enum.TextXAlignment.Left }, frame)
        local section = setmetatable({ Title = title, Frame = frame, Page = self.Page, Elements = {}, _order = 0 }, Section)
        table.insert(win.Sections, section) return section
    end
    function Section:_row(name, height) self._order += 1 local row = create("Frame", { LayoutOrder = self._order, Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 1 }, self.Frame) table.insert(self.Elements, { Name = name, Frame = row }) return row end

    function Section:AddToggle(name, default, callback)
        local row = self:_row(name, 36) local state = default == true
        create("TextLabel", { Size = UDim2.new(1, -52, 1, 0), BackgroundTransparency = 1, Text = name, Font = FONT, TextSize = 14, TextColor3 = C.Text, TextXAlignment = Enum.TextXAlignment.Left }, row)
        local pill = create("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(40, 20), BackgroundColor3 = state and C.Accent or C.ToggleOff, BorderSizePixel = 0 }, row)
        corner(pill, 10)
        local knob = create("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = state and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = C.White, BorderSizePixel = 0 }, pill)
        corner(knob, 8)
        local hit = create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 2 }, row)
        local obj = {}
        local function render() tween(pill, { BackgroundColor3 = state and C.Accent or C.ToggleOff }) tween(knob, { Position = state and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0) }) end
        function obj:Set(v, silent) state = v == true render() if not silent then safeCall(callback, state) end end
        hit.Activated:Connect(function() obj:Set(not state) end)
        if default then safeCall(callback, state) end
        return obj
    end

    function Section:AddSlider(name, min, max, default, callback, step)
        step = step or 1 local row = self:_row(name, 50) local value = math.clamp(default or min, min, max)
        create("TextLabel", { Size = UDim2.new(1, -60, 0, 24), BackgroundTransparency = 1, Text = name, Font = FONT, TextSize = 14, TextColor3 = C.Text, TextXAlignment = Enum.TextXAlignment.Left }, row)
        local valueLabel = create("TextLabel", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 56, 0, 24), BackgroundTransparency = 1, Text = tostring(value), Font = FONT_BOLD, TextSize = 13, TextColor3 = C.Accent, TextXAlignment = Enum.TextXAlignment.Right }, row)
        local track = create("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0, 36), Size = UDim2.new(1, 0, 0, 4), BackgroundColor3 = C.Track, BorderSizePixel = 0 }, row)
        corner(track, 2) local fill = create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.Accent, BorderSizePixel = 0 }, track) corner(fill, 2)
        local thumb = create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = C.White, BorderSizePixel = 0, ZIndex = 2 }, track) corner(thumb, 7)
        local hit = create("TextButton", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0, 36), Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, Text = "", ZIndex = 3 }, row)
        local obj = {}
        local function render() local a = (max == min) and 0 or (value - min) / (max - min) fill.Size = UDim2.fromScale(a, 1) thumb.Position = UDim2.new(a, 0, 0.5, 0) valueLabel.Text = tostring(value) end
        function obj:Set(v, silent) v = math.clamp(math.floor((v - min) / step + 0.5) * step + min, min, max) if v ~= value then value = v render() if not silent then safeCall(callback, value) end end end
        local function fromX(x) local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1) obj:Set(min + (max - min) * a) end
        local dragging, dragInput = false, nil
        hit.InputBegan:Connect(function(input) if isPress(input) then dragging, dragInput = true, input self.Page.ScrollingEnabled = false fromX(input.Position.X) input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false self.Page.ScrollingEnabled = true end end) end end)
        UIS.InputChanged:Connect(function(input) if dragging and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement) then fromX(input.Position.X) end end)
        render() if default then safeCall(callback, value) end
        return obj
    end

    function Section:AddButton(name, callback)
        local row = self:_row(name, 36)
        local btn = create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Button, BorderSizePixel = 0, AutoButtonColor = false, Text = name, Font = FONT_BOLD, TextSize = 14, TextColor3 = C.Text }, row)
        corner(btn, 6)
        btn.Activated:Connect(function() 
            tween(btn, { BackgroundColor3 = C.Accent }, 0.08) 
            task.delay(0.12, function() tween(btn, { BackgroundColor3 = C.Button }, 0.2) end) 
            safeCall(callback) 
        end)
        return btn
    end
    return PulseHubClass
end)()


local function getContainer()
    local gameW = Workspace:FindFirstChild("Game")
    if gameW and gameW:FindFirstChild("CoinContainer") then
        return gameW.CoinContainer
    end
    return Workspace:FindFirstChild("CoinContainer", true)
end

local function findNearest()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local container = getContainer()
    if not container then return nil end
    
    local closest, minDist = nil, math.huge
    for _, obj in ipairs(container:GetChildren()) do
        if obj.Name == "Coin_Server" and obj:IsA("BasePart") and not blacklist[obj] then
            local dist = (obj.Position - hrp.Position).Magnitude
            if dist < minDist then
                minDist = dist
                closest = obj
            end
        end
    end
    return closest
end

-- Основная логика полета через Tween
local function flyTo(coin)
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    isMoving = true
    blacklist[coin] = true

    -- Отключаем физику на время полета
    hrp.Anchored = true
    hum.PlatformStand = true
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end

    local targetPos = coin.Position + Vector3.new(0, 2, 0)
    local distance = (hrp.Position - targetPos).Magnitude
    local duration = distance / tweenSpeed

    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = CFrame.new(targetPos) })
    tween:Play()
    tween.Completed:Wait()

    -- Сбор
    pcall(function()
        firetouchinterest(hrp, coin, 0)
        firetouchinterest(hrp, coin, 1)
    end)
    for _, prompt in ipairs(coin:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            pcall(function() fireproximityprompt(prompt) end)
        end
    end

    -- Пауза, чтобы сервер удалил монету
    task.wait(0.2)

    -- Возвращаем физику
    hrp.Anchored = false
    hum.PlatformStand = false
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = true end
    end
    isMoving = false
end

-- Главный цикл
task.spawn(function()
    while task.wait(0.1) do
        if isFarming and not isMoving then
            local char = LP.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not char or not hum or hum.Health <= 0 then
                StatusText.Text = "Мертв..."
                continue
            end
            local coin = findNearest()
            if coin then
                StatusText.Text = "Летим к монете!"
                flyTo(coin)
            else
                StatusText.Text = "Монет нет (ждем)"
            end
        end
    end
end)

-- Управление слайдером
SliderBg.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local function update(x)
            local percent = math.clamp((x - SliderBg.AbsolutePosition.X) / SliderBg.AbsoluteSize.X, 0, 1)
            tweenSpeed = math.floor(percent * 50) + 5
            SliderFill.Size = UDim2.new(percent, 0, 1, 0)
            StatusText.Text = "Скорость: " .. tweenSpeed
        end
        update(input.Position.X)
        
        local moveConn
        moveConn = game:GetService("UserInputService").InputChanged:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
                update(i.Position.X)
            end
        end)
        game:GetService("UserInputService").InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                if moveConn then moveConn:Disconnect() end
            end
        end)
    end
end)

Btn.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        Btn.Text = "FARM: ON"
        Btn.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
    else
        Btn.Text = "FARM: OFF"
        Btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        StatusText.Text = "Скорость: " .. tweenSpeed
    end
end)


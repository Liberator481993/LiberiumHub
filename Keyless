        local dragging = false
        local function setValue(value)
            item.Value = math.clamp(value, item.Min, item.Max) local range = math.max(1, item.Max - item.Min) local pct = (item.Value - item.Min) / range
            Tween(fill, 0.08, { Size = UDim2.new(pct, 0, 1, 0) }) Tween(thumb, 0.08, { Position = UDim2.new(pct, 0, 0.5, 0) }) valueLabel.Text = tostring(math.floor(item.Value + 0.5))

end)

-- ==========================================
-- AUTO FARM (PULSE HUB PHYSICS)
-- ==========================================
local TARGET_NAME = "Coin_Server"
local STOP_DISTANCE = 2.5
local SCAN_INTERVAL = 0.2

local flying = false
local collecting = false
local Blacklist = {}
local candidates = {}
local lastScan = 0
local currentTarget = nil
local targetSince = 0
local attachment, alignPos, alignOri = nil, nil, nil
local heartbeatConn = nil
local collectedCount = 0

local function getHumanoid() local c = player.Character; return c and c:FindFirstChildOfClass("Humanoid") end
local function getRoot() local c = player.Character; return c and c:FindFirstChild("HumanoidRootPart") end

local function setFlightState(active)
    pcall(function()
        local hum = getHumanoid(); if not hum then return end
        if active then hum.PlatformStand = true; hum:ChangeState(Enum.HumanoidStateType.Physics)
        else hum.PlatformStand = false; hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end)
end

local function destroyAligns()
    for _, obj in ipairs({ alignPos, alignOri, attachment }) do pcall(function() obj:Destroy() end) end
    alignPos, alignOri, attachment = nil, nil, nil
end

-- Физика как в Пульсе (Responsiveness 200, MaxVelocity)
local function createAligns(root)
    destroyAligns()
    pcall(function()
        attachment = Instance.new("Attachment"); attachment.Parent = root
        alignPos = Instance.new("AlignPosition")
        alignPos.Mode = Enum.PositionAlignmentMode.OneAttachment
        alignPos.Attachment0 = attachment
        alignPos.MaxForce = math.huge
        alignPos.Responsiveness = 200 -- Высокая отзывчивость для плавности
        alignPos.MaxVelocity = CFG.FarmSpeed
        alignPos.Position = root.Position
        alignPos.Parent = root
        
        alignOri = Instance.new("AlignOrientation")
        alignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment
        alignOri.Attachment0 = attachment
        alignOri.MaxTorque = math.huge
        alignOri.Responsiveness = 50
        alignOri.CFrame = root.CFrame
        alignOri.Parent = root
    end)
end

local function rescan()
    local list = {}
    pcall(function()
        local container = Workspace:FindFirstChild("CoinContainer", true)
        if container then
            for _, d in ipairs(container:GetChildren()) do
                if d.Name == TARGET_NAME and d:IsA("BasePart") then table.insert(list, d) end
            end
        end
    end)
    candidates = list
end

local function findNearest(fromPos)
    local best, bestDist = nil, math.huge
    for _, part in ipairs(candidates) do
        if part.Parent and not Blacklist[part] then
            local dist = (part.Position - fromPos).Magnitude
            if dist < bestDist then best, bestDist = part, dist end
        end
    end
    return best
end

-- Сбор БЕЗ ТЕЛЕПОРТА
local function collect(target)
    collecting = true
    pcall(function()
        local root = getRoot()
        if root and target then
            -- Подлетаем вплотную физикой и вызываем тач
            alignPos.Position = target.Position 
            alignPos.MaxVelocity = 50 -- На секунду ускоряемся, чтобы точно влететь
            task.wait(0.1) 
            
            if typeof(firetouchinterest) == "function" then
                firetouchinterest(root, target, 0)
                firetouchinterest(root, target, 1)
            end
            local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt and prompt.Enabled and typeof(fireproximityprompt) == "function" then fireproximityprompt(prompt) end
        end
        task.wait(0.1)
    end)
    Blacklist[target] = true
    collectedCount += 1
    currentTarget = nil
    collecting = false
end

local function flyStep(root, now)
    if now - lastScan >= SCAN_INTERVAL then 
        lastScan = now 
        rescan() 
        -- ОЧИСТКА ПАМЯТИ (фикс краша)
        for obj in pairs(Blacklist) do
            if not obj.Parent then Blacklist[obj] = nil end
        end
    end
    
    local target = findNearest(root.Position)

    -- Динамическая смена цели
    if target and target ~= currentTarget then
        currentTarget = target
        targetSince = now
        if alignPos then alignPos.Position = currentTarget.Position end
    end

    if not target and not currentTarget then
        if alignPos then destroyAligns(); setFlightState(false) end
        return
    end

    if not alignPos or alignPos.Parent ~= root then createAligns(root); setFlightState(true) end
    if not currentTarget then return end

    if now - targetSince > 3 then Blacklist[currentTarget] = true; currentTarget = nil; return end

    local distance = (currentTarget.Position - root.Position).Magnitude
    if distance < STOP_DISTANCE then
        task.spawn(collect, currentTarget)
        return
    end

    -- Обновляем позицию и скорость (Пульс-стайл)
    alignPos.MaxVelocity = CFG.FarmSpeed
    alignPos.Position = currentTarget.Position
    alignOri.CFrame = CFrame.lookAt(root.Position, Vector3.new(currentTarget.Position.X, root.Position.Y, currentTarget.Position.Z))
end

local function stopFlight()
    flying = false; collecting = false; currentTarget = nil
    if heartbeatConn then heartbeatConn:Disconnect(); heartbeatConn = nil end
    destroyAligns(); setFlightState(false)
end

local function startFlight()
    if flying then return end
    local root = getRoot(); if not root then return end
    flying = true; table.clear(Blacklist); currentTarget = nil; lastScan = 0; collectedCount = 0
    createAligns(root); setFlightState(true)
    
    heartbeatConn = RunService.Heartbeat:Connect(function()
        if not flying or collecting then return end
        pcall(function()
            local r = getRoot(); local hum = getHumanoid()
            if not r or not hum then return end
            
            if CFG.AutoReset and collectedCount >= CFG.MaxCoins then
                stopFlight()
                hum.Health = 0
                task.wait(4)
                if CFG.AutoFarm then startFlight() end
                return
            end

            if not alignPos or alignPos.Parent ~= r then createAligns(r); setFlightState(true) end
            flyStep(r, os.clock())
        end)
    end)
end


-- ==========================================
-- AUTO FARM (FLIGHT ENGINE)
-- ==========================================
local TARGET_NAME = "Coin_Server"
local RESPONSIVENESS = 200
local STOP_DISTANCE = 1.5
local TARGET_TIMEOUT = 3
local SCAN_INTERVAL = 0.2

local flying = false
local collecting = false
local Blacklist = {}
local candidates = {}
local lastScan = 0
local currentTarget = nil
local targetSince = 0
local attachment, alignPos, alignOri = nil, nil, nil
local heartbeatConn = nil
local collectedCount = 0

local function getHumanoid()
    local ok, r = pcall(function() local c = player.Character; return c and c:FindFirstChildOfClass("Humanoid") end)
    return ok and r or nil
end

local function getRoot()
    local ok, r = pcall(function() local c = player.Character; return c and c:FindFirstChild("HumanoidRootPart") end)
    if ok and r and r:IsA("BasePart") then return r end
    return nil
end

local function setCharacterCollision(disabled)
    pcall(function()
        local char = player.Character; if not char then return end
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then
                if disabled then
                    if originalCollide[d] == nil then originalCollide[d] = d.CanCollide end
                    d.CanCollide = false
                elseif originalCollide[d] ~= nil then d.CanCollide = originalCollide[d] end
            end
        end
    end)
    if not disabled then table.clear(originalCollide) end
end

local function setFlightHumanoidState(active)
    pcall(function()
        local hum = getHumanoid(); if not hum then return end
        if active then
            hum.PlatformStand = true
            hum:ChangeState(Enum.HumanoidStateType.Physics)
        else
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end)
end

local function destroyAligns()
    for _, obj in ipairs({ alignPos, alignOri, attachment }) do pcall(function() obj:Destroy() end) end
    alignPos, alignOri, attachment = nil, nil, nil
end

local function createAligns(root)
    destroyAligns()
    pcall(function()
        attachment = Instance.new("Attachment"); attachment.Parent = root
        alignPos = Instance.new("AlignPosition"); alignPos.Mode = Enum.PositionAlignmentMode.OneAttachment; alignPos.Attachment0 = attachment; alignPos.MaxForce = math.huge; alignPos.Responsiveness = RESPONSIVENESS; alignPos.MaxVelocity = CFG.FarmSpeed; alignPos.Position = root.Position; alignPos.Parent = root
        alignOri = Instance.new("AlignOrientation"); alignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment; alignOri.Attachment0 = attachment; alignOri.MaxTorque = math.huge; alignOri.Responsiveness = 50; alignOri.CFrame = root.CFrame; alignOri.Parent = root
    end)
end

local function rescan()
    local list = {}
    pcall(function()
        for _, d in ipairs(Workspace:GetDescendants()) do
            if d.Name == TARGET_NAME and d:IsA("BasePart") and d.Parent then
                -- Игнорируем фантомов (летим только если есть визуал)
                if d:FindFirstChild("CoinVisual") then
                    table.insert(list, d)
                end
            end
        end
    end)
    candidates = list
end

local function findNearest(fromPos)
    local best, bestDist = nil, math.huge
    for _, part in ipairs(candidates) do
        if part.Parent and not Blacklist[part] then
            local dist = (part.Position - fromPos).Magnitude
            if dist < bestDist then best, bestDist = part, dist end
        end
    end
    return best
end

local function collect(target)
    collecting = true
    pcall(function()
        local root = getRoot()
        if root and target then
            -- Жесткий телепорт в монету
            root.CFrame = CFrame.new(target.Position)
            firetouchinterest(root, target, 0)
            firetouchinterest(root, target, 1)
            local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt and prompt.Enabled then fireproximityprompt(prompt) end
        end
        task.wait(0.1)
    end)
    Blacklist[target] = true
    collectedCount += 1
    currentTarget = nil
    collecting = false
end

local function flyStep(root, now)
    if now - lastScan >= SCAN_INTERVAL then lastScan = now; rescan() end
    
    local target = findNearest(root.Position)

    -- Динамическая смена цели: если новая ближе, летим к ней
    if target and target ~= currentTarget then
        local currentDist = currentTarget and (currentTarget.Position - root.Position).Magnitude or math.huge
        local newDist = (target.Position - root.Position).Magnitude
        if newDist < currentDist then
            currentTarget = target
            targetSince = now
        end
    end

    if not target and not currentTarget then
        if alignPos then 
            destroyAligns()
            setFlightHumanoidState(false)
            setCharacterCollision(false)
        end
        return
    end

    if not alignPos or alignPos.Parent ~= root then
        createAligns(root)
        setFlightHumanoidState(true)
        setCharacterCollision(true)
    end

    if not currentTarget then return end

    if now - targetSince > TARGET_TIMEOUT then
        Blacklist[currentTarget] = true
        currentTarget = nil
        return
    end

    local distance = (currentTarget.Position - root.Position).Magnitude
    if distance < STOP_DISTANCE then
        alignPos.Position = root.Position 
        task.spawn(collect, currentTarget)
        return
    end

    alignPos.MaxVelocity = CFG.FarmSpeed
    alignPos.Position = currentTarget.Position
    alignOri.CFrame = CFrame.lookAt(root.Position, Vector3.new(currentTarget.Position.X, root.Position.Y, currentTarget.Position.Z))
end

local function stopFlight()
    flying = false; collecting = false; currentTarget = nil
    if heartbeatConn then heartbeatConn:Disconnect(); heartbeatConn = nil end
    destroyAligns(); setCharacterCollision(false); setFlightHumanoidState(false)
end

local function startFlight()
    if flying then return end
    local root = getRoot(); if not root then return end
    flying = true; table.clear(Blacklist); currentTarget = nil; lastScan = 0; collectedCount = 0
    createAligns(root); setFlightHumanoidState(true)
    
    heartbeatConn = RunService.Heartbeat:Connect(function()
        if not flying or collecting then return end
        pcall(function()
            local r = getRoot(); local hum = getHumanoid()
            if not r or not hum then return end
            
            -- АВТО-РЕСЕТ
            if CFG.AutoReset and collectedCount >= CFG.MaxCoins then
                stopFlight()
                hum.Health = 0 -- Убиваем персонажа
                task.wait(3) -- Ждем респавна
                if CFG.AutoFarm then startFlight() end -- Перезапускаем
                return
            end

            if not alignPos or alignPos.Parent ~= r then createAligns(r); setFlightHumanoidState(true) end
            setCharacterCollision(true)
            flyStep(r, os.clock())
        end)
    end)
end


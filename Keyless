-- ============ БЕЗОПАСНЫЙ ПОИСК ЦЕЛЕЙ ============
local function getTargets()
    local targets = {}
    
    -- Ищем монеты в GUI
    if CFG.AutoCoin then
        pcall(function()
            local main = LP.PlayerGui:FindFirstChild("MainGUI")
            if main then
                local bags = main:FindFirstChild("CoinBags") or (main:FindFirstChild("Lobby") and main.Lobby:FindFirstChild("CoinBags")) or (main:FindFirstChild("Game") and main.Game:FindFirstChild("CoinBags"))
                if bags then
                    for _, bag in ipairs(bags:GetChildren()) do
                        if bag:IsA("BasePart") or bag:IsA("Model") then
                            table.insert(targets, bag)
                        end
                    end
                end
            end
        end)
    end

    -- Ищем конфеты (Только в Workspace, чтобы не лагало)
    if CFG.AutoCandy then
        pcall(function()
            -- В MM2 конфеты часто лежат в папке Game или прямо в Workspace
            local map = workspace:FindFirstChild("Game") or workspace
            for _, obj in ipairs(map:GetDescendants()) do
                if obj:IsA("BasePart") or obj:IsA("Model") then
                    local name = string.lower(obj.Name)
                    if string.find(name, "candy") or string.find(name, "sweet") then
                        table.insert(targets, obj)
                    end
                end
            end
        end)
    end
    
    return targets
end

-- Получение позиции
local function getPos(obj)
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then
        local ok, pivot = pcall(function() return obj:GetPivot().Position end)
        return ok and pivot or nil
    end
    return nil
end

-- ============ ESP ============
local espCache = {}
RunService.RenderStepped:Connect(function()
    if not CFG.ItemESP then
        for _, hl in pairs(espCache) do pcall(function() hl:Destroy() end) end
        table.clear(espCache)
        return
    end
    
    -- Собираем всё для ESP (независимо от того, включен ли фарм)
    local allItems = {}
    -- Монеты
    pcall(function()
        local main = LP.PlayerGui:FindFirstChild("MainGUI")
        if main then
            local bags = main:FindFirstChild("CoinBags") or (main:FindFirstChild("Lobby") and main.Lobby:FindFirstChild("CoinBags")) or (main:FindFirstChild("Game") and main.Game:FindFirstChild("CoinBags"))
            if bags then for _, bag in ipairs(bags:GetChildren()) do table.insert(allItems, bag) end end
        end
    end)
    -- Конфеты
    pcall(function()
        local map = workspace:FindFirstChild("Game") or workspace
        for _, obj in ipairs(map:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Model") then
                local name = string.lower(obj.Name)
                if string.find(name, "candy") or string.find(name, "sweet") then
                    table.insert(allItems, obj)
                end
            end
        end
    end)

    for _, obj in ipairs(allItems) do
        if not espCache[obj] then
            local hl = Instance.new("Highlight")
            hl.FillColor = Color3.fromRGB(255, 255, 0)
            hl.FillTransparency = 0.5
            hl.OutlineColor = Color3.fromRGB(255, 255, 0)
            hl.Parent = obj
            espCache[obj] = hl
        end
    end
end)

-- ============ AUTO FARM (ФИЗИЧЕСКИЙ ПОЛЕТ) ============
task.spawn(function()
    while task.wait(0.5) do -- Проверка раз в 0.5 сек (без лагов)
        if CFG.AutoCandy or CFG.AutoCoin then
            local char = LP.Character
            if not char then continue end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then continue end

            -- Создаем физику полета, если ее нет
            if not farmBV then
                farmBV = Instance.new("BodyVelocity")
                farmBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
                farmBV.Velocity = Vector3.zero
                farmBV.Parent = hrp
                farmBG = Instance.new("BodyGyro")
                farmBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
                farmBG.P = 1000
                farmBG.Parent = hrp
            end

            local targets = getTargets()
            if #targets > 0 then
                local target = targets[1]
                local pos = getPos(target)
                
                if pos then
                    -- Летим к цели
                    farmBV.Velocity = (pos - hrp.Position).Unit * 45
                    farmBG.CFrame = CFrame.new(hrp.Position, pos)
                    
                    -- Если близко, активируем промпт
                    local dist = (pos - hrp.Position).Magnitude
                    if dist < 10 then
                        for _, prompt in ipairs(target:GetDescendants()) do
                            if prompt:IsA("ProximityPrompt") then
                                pcall(function() fireproximityprompt(prompt) end)
                            end
                        end
                        task.wait(0.2)
                    end
                end
            else
                -- Если целей нет, останавливаемся
                if farmBV then farmBV.Velocity = Vector3.zero end
            end
        else
            -- Если фарм выключен, удаляем физику
            if farmBV then farmBV:Destroy(); farmBV = nil end
            if farmBG then farmBG:Destroy(); farmBG = nil end
        end
    end
end)


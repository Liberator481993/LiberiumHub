local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local LP = Players.LocalPlayer
local isFarming = false

-- Кнопка и текст для дебага
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Parent = LP:WaitForChild("PlayerGui")

local Btn = Instance.new("TextButton")
Btn.Size = UDim2.new(0, 150, 0, 50)
Btn.Position = UDim2.new(0, 20, 0.4, 0)
Btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
Btn.Font = Enum.Font.GothamBold
Btn.TextSize = 16
Btn.Text = "FARM: OFF"
Btn.Parent = ScreenGui

local StatusText = Instance.new("TextLabel")
StatusText.Size = UDim2.new(0, 250, 0, 30)
StatusText.Position = UDim2.new(0, 20, 0.4, 60)
StatusText.BackgroundTransparency = 1
StatusText.TextColor3 = Color3.fromRGB(255, 255, 0)
StatusText.Font = Enum.Font.Code
StatusText.TextSize = 14
StatusText.Text = "Ожидание..."
StatusText.TextXAlignment = Enum.TextXAlignment.Left
StatusText.Parent = ScreenGui

local coinContainer = nil

local function getContainer()
    if coinContainer and coinContainer.Parent then return coinContainer end
    -- Ищем CoinContainer по всей игре
    local cc = Workspace:FindFirstChild("CoinContainer", true)
    if cc then
        coinContainer = cc
        return cc
    end
    return nil
end

local function getCoins()
    local container = getContainer()
    if not container then return {} end
    local coins = {}
    for _, obj in ipairs(container:GetChildren()) do
        if obj.Name == "Coin_Server" and obj:IsA("BasePart") then
            table.insert(coins, obj)
        end
    end
    return coins
end

local function teleportToCoin(coin)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp then return end

    -- Отключаем физику на мгновение
    if hum then hum.PlatformStand = true end
    
    -- Телепорт ровно на конфету
    hrp.CFrame = CFrame.new(coin.Position + Vector3.new(0, 3, 0))
    
    -- Сбор
    pcall(function()
        firetouchinterest(hrp, coin, 0)
        firetouchinterest(hrp, coin, 1)
    end)
    
    for _, prompt in ipairs(coin:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            pcall(function() fireproximityprompt(prompt) end)
        end
    end
    
    -- Возвращаем управление
    task.wait(0.15)
    if hum then hum.PlatformStand = false end
end

task.spawn(function()
    while task.wait(0.1) do
        if isFarming then
            local coins = getCoins()
            StatusText.Text = "Монет найдено: " .. #coins
            
            if #coins > 0 then
                local char = LP.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local closest, minDist = nil, math.huge
                    for _, c in ipairs(coins) do
                        local d = (c.Position - hrp.Position).Magnitude
                        if d < minDist then minDist = d; closest = c end
                    end
                    if closest then
                        StatusText.Text = "Телепорт к монете (Дист: " .. math.floor(minDist) .. ")"
                        teleportToCoin(closest)
                    end
                end
            else
                if getContainer() then
                    StatusText.Text = "Папка есть, но монет нет (Ждем спавн)"
                else
                    StatusText.Text = "Папка CoinContainer не найдена!"
                end
            end
        end
    end
end)

Btn.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        Btn.Text = "FARM: ON"
        Btn.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
    else
        Btn.Text = "FARM: OFF"
        Btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        StatusText.Text = "Ожидание..."
        local char = LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
        end
    end
end)

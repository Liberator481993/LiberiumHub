-- ============== КАСТОМНЫЕ TOGGLE/SLIDER (в стиле Slate) ==============
local UIS = game:GetService("UserInputService")
local Tween = game:GetService("TweenService")

local function crn(p, r)
    local c = Instance.new("UICorner", p)
    c.CornerRadius = UDim.new(0, r)
end

local function addToggle(parent, opts)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, 0, 0, 36)
    row.BackgroundColor3 = C.row
    row.BorderSizePixel = 0
    crn(row, 6)

    local label = Instance.new("TextLabel", row)
    label.Size = UDim2.new(1, -70, 1, 0)
    label.Position = UDim2.fromOffset(12, 0)
    label.BackgroundTransparency = 1
    label.Text = opts.Name
    label.TextColor3 = C.txt
    label.TextSize = 13
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left

    local state = opts.Default or false
    local sw = Instance.new("Frame", row)
    sw.Size = UDim2.fromOffset(38, 20)
    sw.Position = UDim2.new(1, -50, 0.5, -10)
    sw.BackgroundColor3 = state and C.acc or C.off
    sw.BorderSizePixel = 0
    crn(sw, 10)

    local knob = Instance.new("Frame", sw)
    knob.Size = UDim2.fromOffset(16, 16)
    knob.Position = UDim2.new(0, state and 20 or 2, 0, 2)
    knob.BackgroundColor3 = C.knob
    knob.BorderSizePixel = 0
    crn(knob, 8)

    local hit = Instance.new("TextButton", row)
    hit.Size = UDim2.new(1, 0, 1, 0)
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.MouseButton1Click:Connect(function()
        state = not state
        sw.BackgroundColor3 = state and C.acc or C.off
        Tween:Create(knob, TweenInfo.new(0.15), {
            Position = UDim2.new(0, state and 20 or 2, 0, 2)
        }):Play()
        pcall(opts.Callback, state)
    end)
end

local function addSlider(parent, opts)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, 0, 0, 50)
    row.BackgroundColor3 = C.row
    row.BorderSizePixel = 0
    crn(row, 6)

    local mn, mx = opts.Min or 0, opts.Max or 100
    local cur = opts.Default or mn

    local label = Instance.new("TextLabel", row)
    label.Size = UDim2.new(1, -20, 0, 20)
    label.Position = UDim2.fromOffset(12, 4)
    label.BackgroundTransparency = 1
    label.Text = opts.Name .. "  :  " .. cur
    label.TextColor3 = C.txt
    label.TextSize = 13
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left

    local track = Instance.new("Frame", row)
    track.Size = UDim2.new(1, -24, 0, 6)
    track.Position = UDim2.new(0, 12, 1, -16)
    track.BackgroundColor3 = C.off
    track.BorderSizePixel = 0
    crn(track, 3)

    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((cur - mn) / (mx - mn), 0, 1, 0)
    fill.BackgroundColor3 = C.acc
    fill.BorderSizePixel = 0
    crn(fill, 3)

    local hit = Instance.new("TextButton", row)
    hit.Size = UDim2.new(1, 0, 1, 0)
    hit.BackgroundTransparency = 1
    hit.Text = ""

    local dragging = false
    local function set(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
        cur = math.floor(mn + rel * (mx - mn) + 0.5)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        label.Text = opts.Name .. "  :  " .. cur
        pcall(opts.Callback, cur)
    end

    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            set(i.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            set(i.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end


local Dropdown = (function()
    local TweenService = game:GetService("TweenService") local UserInputService = game:GetService("UserInputService")
    local Theme = { Surface = Color3.fromHex("#15151b"), SurfaceHover = Color3.fromHex("#1d1d26"), Glass = Color3.fromHex("#17171f"), Background = Color3.fromHex("#0c0c0f"), Accent = Color3.fromHex("#8c64ff"), Stroke = Color3.fromHex("#2a2a36"), Text = Color3.fromHex("#f0f0f5"), TextDim = Color3.fromHex("#b4b4c3"), SubText = Color3.fromHex("#7d7d8f"), Font = Enum.Font.GothamMedium, TextSize = 13 }
    local OP = TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out) local CL = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In) local FA = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local function create(c, p, ch) local i = Instance.new(c) local pa = p.Parent for k, v in p do if k~="Parent" then i[k]=v end end if ch then for _, x in ch do x.Parent = i end end i.Parent = pa return i end
    local function tween(i, inf, g) local t = TweenService:Create(i, inf, g) t:Play() return t end
    local function bindF(g, fn) local h = false g.InputBegan:Connect(function(inp) local t = inp.UserInputType if t == Enum.UserInputType.MouseMovement then h=true fn("hover") elseif t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then fn("press") end end) g.InputEnded:Connect(function(inp) local t = inp.UserInputType if t == Enum.UserInputType.MouseMovement then h=false fn("idle") elseif t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then fn(h and "hover" or "idle") end end) end
    local layers = setmetatable({}, {__mode="k"})
    local function getRoot(gui) local e = layers[gui] if e and e.Parent then return e end local h = gui.Parent if not h then return nil end local l = Instance.new("ScreenGui") l.Name="DropLayer" l.ResetOnSpawn=false l.ScreenInsets=gui.ScreenInsets l.DisplayOrder=gui.DisplayOrder+100 l.ZIndexBehavior=Enum.ZIndexBehavior.Sibling l.Enabled=gui.Enabled local r = create("Frame",{Name="Root",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,BorderSizePixel=0,Parent=l}) l.Parent=h gui:GetPropertyChangedSignal("Enabled"):Connect(function() l.Enabled=gui.Enabled end) gui.Destroying:Connect(function() l:Destroy() end) layers[gui]=r return r end
    local D = {} D.__index = D
    function D.new(parent, name, opts, def, cb)
        local s = setmetatable({}, D) s.Name=name s.Callback=cb s.Value=nil s.IsOpen=false s._opts={} s._btns={} s._selIdx=nil s._openConns={} s._token=0 s._touch=UserInputService.TouchEnabled s._itemH=s._touch and 38 or 30 s._headH=s._touch and 40 or 34
        s.Frame = create("Frame", {Name="DD_"..name,Size=UDim2.new(1,0,0,s._headH),BackgroundTransparency=1,Parent=parent})
        s.Label = create("TextLabel", {Name="Label",Size=UDim2.new(0.42,-6,1,0),BackgroundTransparency=1,Font=Theme.Font,TextSize=Theme.TextSize,TextColor3=Theme.Text,TextXAlignment=Enum.TextXAlignment.Left,Text=name,Parent=s.Frame})
        s.Header = create("TextButton", {Name="Header",AnchorPoint=Vector2.new(1,0),Position=UDim2.fromScale(1,0),Size=UDim2.new(0.58,0,1,0),BackgroundColor3=Theme.Surface,BorderSizePixel=0,Text="",Parent=s.Frame})
        create("UICorner", {CornerRadius=UDim.new(0,6),Parent=s.Header}) s._stroke = create("UIStroke",{Color=Theme.Stroke,Thickness=1,Parent=s.Header})
        s.ValLabel = create("TextLabel", {Name="Value",Position=UDim2.fromOffset(10,0),Size=UDim2.new(1,-34,1,0),BackgroundTransparency=1,Font=Theme.Font,TextSize=Theme.TextSize,TextColor3=Theme.SubText,TextXAlignment=Enum.TextXAlignment.Left,Text="Select...",Parent=s.Header})
        s.Chevron = create("TextLabel", {Name="Chevron",AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-10,0.5,0),Size=UDim2.fromOffset(12,12),BackgroundTransparency=1,Font=Theme.Font,TextSize=9,TextColor3=Theme.SubText,Text="▼",Parent=s.Header})
        bindF(s.Header, function(st) s:_paintHead(st) end)
        s._blocker = create("TextButton", {Name="Blocker",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text="",ZIndex=1}) s._blocker.Activated:Connect(function() s:Close() end)
        s._list = create("CanvasGroup", {Name="List",BackgroundColor3=Color3.new(1,1,1),BackgroundTransparency=0.04,GroupTransparency=1,Size=UDim2.fromOffset(0,0),ZIndex=2})
        create("UICorner", {CornerRadius=UDim.new(0,8),Parent=s._list}) create("UIStroke", {Color=Theme.Accent,Transparency=0.55,Thickness=1,Parent=s._list}) create("UIGradient", {Color=ColorSequence.new(Theme.Glass,Theme.Background),Rotation=90,Parent=s._list})
        s._scroll = create("ScrollingFrame", {Name="Scroll",BackgroundTransparency=1,Active=true,ScrollingDirection=Enum.ScrollingDirection.Y,ScrollBarThickness=s._touch and 4 or 3,ScrollBarImageColor3=Theme.Accent,CanvasSize=UDim2.new(),Parent=s._list})
        create("UIListLayout", {Padding=UDim.new(0,2),SortOrder=Enum.SortOrder.LayoutOrder,Parent=s._scroll})
        create("UIPadding", {PaddingTop=UDim.new(0,4),PaddingBottom=UDim.new(0,4),PaddingLeft=UDim.new(0,4),PaddingRight=UDim.new(0,8),Parent=s._scroll})
        s:SetOptions(opts or {}) if def ~= nil then s:Set(def, true) end
        s.Header.Activated:Connect(function() s:Toggle() end)
        s.Frame.Destroying:Connect(function() s:Destroy() end)
        return s
    end
    function D:_paintHead(st) local op = self.IsOpen local ac = op or st~="idle" tween(self.Header, FA, {BackgroundColor3=(st=="idle") and Theme.Surface or Theme.SurfaceHover}) tween(self._stroke, FA, {Color=ac and Theme.Accent or Theme.Stroke, Transparency=op and 0.15 or (ac and 0.5 or 0)}) end
    function D:_paintOpt(idx, st, inst) local b = self._btns[idx] if not b then return end local sel = idx == self._selIdx local tr if st=="press" then tr=0.7 elseif st=="hover" then tr=sel and 0.78 or 0.93 else tr=sel and 0.85 or 1 end local tc = sel and Theme.Accent or (st=="idle" and Theme.TextDim or Theme.Text) if inst then b.BackgroundTransparency=tr b.TextColor3=tc else tween(b,FA,{BackgroundTransparency=tr,TextColor3=tc}) end end
    function D:_refreshOpts() for i in self._btns do self:_paintOpt(i, "idle", true) end end
    function D:_updateHead() if self.Value ~= nil then self.ValLabel.Text=tostring(self.Value) self.ValLabel.TextColor3=Theme.Text else self.ValLabel.Text="Select..." self.ValLabel.TextColor3=Theme.SubText end end
    function D:_select(idx) self._selIdx=idx self.Value=self._opts[idx] self:_updateHead() self:_refreshOpts() end
    function D:_fire(val) if typeof(self.Callback)~="function" then return end task.spawn(function() local ok, err = pcall(self.Callback, val) if not ok then warn("Dropdown err:", err) end end) end
    function D:Set(val, sil) local idx = table.find(self._opts, val) if not idx then return false end self:_select(idx) if not sil then self:_fire(self.Value) end return true end
    function D:SetOptions(opts, keep)
        if self.IsOpen then self:Close(true) end
        for _, b in self._btns do b:Destroy() end table.clear(self._btns)
        self._opts = table.clone(opts or {})
        for i, o in self._opts do
            local b = create("TextButton", {Name="O_"..i,LayoutOrder=i,Size=UDim2.new(1,0,0,self._itemH),BackgroundColor3=Theme.Accent,BackgroundTransparency=1,Text=tostring(o),TextColor3=Theme.TextDim,TextXAlignment=Enum.TextXAlignment.Left,Parent=self._scroll})
            create("UICorner", {CornerRadius=UDim.new(0,5),Parent=b}) create("UIPadding", {PaddingLeft=UDim.new(0,10),PaddingRight=UDim.new(0,10),Parent=b})
            bindF(b, function(st) self:_paintOpt(i, st) end)
            b.Activated:Connect(function() self:_select(i) self:Close() self:_fire(self.Value) end)
            self._btns[i] = b
        end
        self._selIdx = (keep~=false and self.Value~=nil) and table.find(self._opts, self.Value) or nil if not self._selIdx then self.Value=nil end
        self:_updateHead() self:_refreshOpts()
    end
    function D:Open()
        if self.IsOpen or #self._opts==0 then return end
        local gui = self.Header:FindFirstAncestorWhichIsA("ScreenGui") local root = gui and getRoot(gui) if not root then return end
        self.IsOpen=true self._token+=1
        local hPos = self.Header.AbsolutePosition - root.AbsolutePosition local hSize = self.Header.AbsoluteSize
        local ch = #self._opts*self._itemH + math.max(#self._opts-1,0)*2 + 8
        local capped = math.min(ch, 6*self._itemH + 5*2 + 8)
        local spaceB = root.AbsoluteSize.Y - (hPos.Y + hSize.Y) - 4 - 8
        local spaceA = hPos.Y - 4 - 8
        local up = capped > spaceB and spaceA > spaceB
        local h = math.min(capped, math.max(up and spaceA or spaceB, self._itemH+8))
        local w = math.min(hSize.X, root.AbsoluteSize.X - 16)
        local x = math.clamp(hPos.X, 8, math.max(8, root.AbsoluteSize.X - w - 8))
        local y = up and (hPos.Y - 4) or (hPos.Y + hSize.Y + 4)
        self._list.AnchorPoint=Vector2.new(0, up and 1 or 0) self._list.Position=UDim2.fromOffset(x,y) self._list.Size=UDim2.fromOffset(w,0) self._list.GroupTransparency=1
        self._scroll.AnchorPoint=Vector2.new(0, up and 1 or 0) self._scroll.Position=UDim2.fromScale(0, up and 1 or 0) self._scroll.Size=UDim2.new(1,0,0,h) self._scroll.CanvasSize=UDim2.fromOffset(0,ch)
        self._blocker.Parent=root self._list.Parent=root
        tween(self._list, OP, {Size=UDim2.fromOffset(w,h),GroupTransparency=0}) tween(self.Chevron, OP, {Rotation=180}) self:_paintHead("idle")
    end
    function D:Close(inst)
        if not self.IsOpen then return end
        self.IsOpen=false self._token+=1 local tk = self._token
        self._blocker.Parent=nil tween(self.Chevron, CL, {Rotation=0}) self:_paintHead("idle")
        if inst then self._list.Parent=nil return end
        local tw = tween(self._list, CL, {Size=UDim2.fromOffset(self._list.Size.X.Offset,0),GroupTransparency=1})
        tw.Completed:Connect(function() if self._token==tk then self._list.Parent=nil end end)
    end
    function D:Toggle() if self.IsOpen then self:Close() else self:Open() end end
    function D:Destroy() self:Close(true) self._blocker:Destroy() self._list:Destroy() self.Frame:Destroy() end
    return D
end)()


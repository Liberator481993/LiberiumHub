function Library:_CreatePage(sub)
    if sub.Page then return end
    local page = New("ScrollingFrame", { Name = sub.Name .. "Page", BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(10, 8), Size = UDim2.new(1, -20, 1, -16), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Accent, Visible = false }, self.PageHolder)
    New("UIListLayout", { Padding = UDim.new(0, 13), SortOrder = Enum.SortOrder.LayoutOrder }, page) New("UIPadding", { PaddingBottom = UDim.new(0, 10), PaddingRight = UDim.new(0, 4) }, page)
    sub.Page = page for _, section in ipairs(sub.Sections) do self:_BuildSection(section) end
end
function Library:_BuildSubButton(tab, sub)
    if sub.Button then return end
    local b = MakeButton(self.SubTabBar, sub.Name, UDim2.fromOffset(94, 34)) b.TextSize = 11 b.BackgroundColor3 = Theme.Card
    local st = Outline(b, Theme.Accent, 1, 1) sub.Button = b sub.Stroke = st
    b.Activated:Connect(function() self:_SelectSub(tab, sub) end)
end
function Library:_SelectSub(tab, sub)
    tab.ActiveSub = sub
    for _, s in ipairs(tab.SubTabs) do
        if s.Button then local active = s == sub Tween(s.Button, 0.18, { BackgroundColor3 = active and Theme.AccentDark or Theme.Card, TextColor3 = active and Theme.White or Theme.Muted }) Tween(s.Stroke, 0.18, { Transparency = active and 0 or 1 }) end
        if s.Page then s.Page.Visible = s == sub end
    end
end
function Library:_SelectTab(tab)
    self.ActiveTab = tab self.PageTitle.Text = tab.Name
    for _, t in ipairs(self.Tabs) do local active = t == tab Tween(t.Button, 0.18, { BackgroundTransparency = active and 0 or 1, TextColor3 = active and Theme.White or Theme.Muted }) Tween(t.Stroke, 0.18, {Transparency = active and 0.05 or 1}) t.Gradient.Enabled = active end
    for _, sub in ipairs(tab.SubTabs) do self:_BuildSubButton(tab, sub) self:_CreatePage(sub) end
    if tab.ActiveSub then self:_SelectSub(tab, tab.ActiveSub) elseif tab.SubTabs[1] then self:_SelectSub(tab, tab.SubTabs[1]) end
end
function Library:AddTab(name, icon)
    local tab = { Window = self, Name = name, Icon = icon or "•", SubTabs = {} }
    local b = MakeButton(self.Nav, (icon or "•") .. "    " .. name, UDim2.new(1, 0, 0, 40))
    b.LayoutOrder = #self.Tabs + 1 b.TextXAlignment = Enum.TextXAlignment.Left b.TextSize = 13 b.BackgroundTransparency = 1 b.TextColor3 = Theme.Muted
    New("UIPadding", { PaddingLeft = UDim.new(0, 12) }, b)
    local st = Outline(b, Theme.Accent, 1, 1) local grad = Gradient(b, Theme.AccentDark, Theme.BG, 0) grad.Enabled = false
    tab.Button, tab.Stroke, tab.Gradient = b, st, grad table.insert(self.Tabs, tab)
    b.MouseEnter:Connect(function() if self.ActiveTab ~= tab then Tween(b, 0.15, { BackgroundTransparency = 0.4, TextColor3 = Theme.White }) end end)
    b.MouseLeave:Connect(function() if self.ActiveTab ~= tab then Tween(b, 0.15, { BackgroundTransparency = 1, TextColor3 = Theme.Muted }) end end)
    b.Activated:Connect(function() self:_SelectTab(tab) end) if not self.ActiveTab then self:_SelectTab(tab) end
    
    -- Фикс сбора суб-табов и секций (один раз создаем)
    return setmetatable(tab, {__index = {
        AddSubTab = function(t, subName)
            local sub = { Tab = t, Name = subName, Sections = {} }
            table.insert(t.SubTabs, sub)
            return setmetatable(sub, {__index = {
                AddSection = function(s, sectionName)
                    local section = { Sub = s, Name = sectionName, Items = {} }
                    table.insert(s.Sections, section)
                    return setmetatable(section, {__index = {
                        AddToggle = function(sec, title, default, callback, description) return self:_AddItem(sec, { Kind = "Toggle", Title = title, Value = default == true, Callback = callback, Description = description or "" }) end,
                        AddSlider = function(sec, title, min, max, default, callback, description) return self:_AddItem(sec, { Kind = "Slider", Title = title, Min = min, Max = max, Value = math.clamp(default, min, max), Callback = callback, Description = description or "" }) end,
                        AddButton = function(sec, title, callback, description) return self:_AddItem(sec, { Kind = "Button", Title = title, Callback = callback, Description = description or "" }) end,
                    }})
                end,
            }})
        end,
    }})
end

function Library:_AddItem(section, item)
    table.insert(section.Items, item) return item
end
function Library:_UpdateSectionSize(section)
    if not section.Frame then return end
    local count = #section.Items local rows = math.ceil(count / 2)
    section.ItemsFrame.Size = UDim2.new(1, 0, 0, rows * 63) section.Frame.Size = UDim2.new(1, 0, 0, 25 + rows * 63)
end
function Library:_BuildSection(section)
    if section.Frame then return end
    local page = section.Sub.Page if not page then return end
    local holder = New("Frame", { Name = section.Name, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 25) }, page) section.Frame = holder
    local heading = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 19) }, holder)
    local headingWidth = math.max(65, #section.Name * 7)
    local headingText = Text(heading, string.upper(section.Name), 10, Theme.White, Enum.Font.GothamBold) headingText.Size = UDim2.new(0, headingWidth, 1, 0)
    local line = New("Frame", { BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.2, Position = UDim2.new(0, headingWidth + 8, 0, 9), Size = UDim2.new(1, -headingWidth - 16, 0, 1), BorderSizePixel = 0 }, heading)
    Gradient(line, Theme.Accent, Theme.AccentDark)
    section.ItemsFrame = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 25), Size = UDim2.new(1, 0, 0, 0) }, holder)
    New("UIGridLayout", { CellSize = UDim2.new(0.5, -6, 0, 54), CellPadding = UDim2.fromOffset(12, 9), SortOrder = Enum.SortOrder.LayoutOrder }, section.ItemsFrame)
    for _, item in ipairs(section.Items) do self:_BuildItem(item, section.ItemsFrame) end
    self:_UpdateSectionSize(section)
end

function Library:_BuildItem(item, parent)
    local isSlider = item.Kind == "Slider"
    local isButton = item.Kind == "Button"
    local height = isSlider and 76 or (isButton and 38 or 54)

    local card = New("Frame", { BackgroundColor3 = Theme.Card, BorderSizePixel = 0, Size = UDim2.new(0.5, -6, 0, height) }, parent)
    Round(card, 10) local cardStroke = Outline(card, Theme.Border, 0.25, 1) 
    
    if not isButton then
        card.MouseEnter:Connect(function() Tween(card, 0.15, {BackgroundColor3 = Theme.Hover}) Tween(cardStroke, 0.15, {Transparency = 0.05}) end)
        card.MouseLeave:Connect(function() Tween(card, 0.15, {BackgroundColor3 = Theme.Card}) Tween(cardStroke, 0.15, {Transparency = 0.25}) end)
    end

    local title = Text(card, item.Title, 11, Theme.White, Enum.Font.GothamMedium) title.Position = UDim2.fromOffset(12, 5) title.Size = UDim2.new(1, isSlider and -60 or -70, 0, 17)
    if item.Description ~= "" and not isButton then
        local desc = Text(card, item.Description, 9, Theme.Muted) desc.Position = UDim2.fromOffset(12, 23) desc.Size = UDim2.new(1, -22, 0, 14)
    end

    if item.Kind == "Toggle" then
        local track = New("Frame", { BackgroundColor3 = item.Value and Theme.Accent or Theme.Track, Position = UDim2.new(1, -53, 0, 15), Size = UDim2.fromOffset(40, 22), BorderSizePixel = 0 }, card) Round(track, 15)
        local trackStroke = Outline(track, item.Value and Theme.Accent or Color3.fromRGB(95, 107, 99), 0.1, 1)
        local thumb = New("Frame", { BackgroundColor3 = Theme.White, Position = UDim2.fromOffset(item.Value and 21 or 3, 3), Size = UDim2.fromOffset(16, 16), BorderSizePixel = 0 }, track) Round(thumb, 12)
        local hit = New("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.fromScale(1, 1) }, track)
        local function setState(value)
            item.Value = value
            Tween(track, 0.18, { BackgroundColor3 = value and Theme.Accent or Theme.Track })
            Tween(trackStroke, 0.18, { Color = value and Theme.Accent or Color3.fromRGB(95, 107, 99) })
            Tween(thumb, 0.18, { Position = UDim2.fromOffset(value and 21 or 3, 3) })
            if item.Callback then task.spawn(item.Callback, value) end
        end
        hit.Activated:Connect(function() setState(not item.Value) end) item.Set = setState
    elseif item.Kind == "Slider" then
        local valueLabel = Text(card, "", 10, Theme.White, Enum.Font.GothamMedium) valueLabel.Position = UDim2.new(1, -45, 0, 23) valueLabel.Size = UDim2.fromOffset(33, 17) valueLabel.TextXAlignment = Enum.TextXAlignment.Right
        local track = New("Frame", { BackgroundColor3 = Theme.Track, Position = UDim2.new(0, 12, 0, 53), Size = UDim2.new(1, -60, 0, 4), BorderSizePixel = 0 }, card) Round(track, 5)
        local fill = New("Frame", { BackgroundColor3 = Theme.Accent, Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0 }, track) Round(fill, 5) 
        local thumb = New("Frame", { BackgroundColor3 = Theme.White, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14), BorderSizePixel = 0 }, track) Round(thumb, 10) Outline(thumb, Theme.White, 0.35, 1)
        local hit = New("TextButton", { BackgroundTransparency = 1, Text = "", Position = UDim2.new(0, -5, 0, -12), Size = UDim2.new(1, 10, 0, 28) }, track)
        local dragging = false
        local function setValue(value)
            item.Value = math.clamp(value, item.Min, item.Max)
            local range = math.max(1, item.Max - item.Min) local pct = (item.Value - item.Min) / range
            Tween(fill, 0.08, { Size = UDim2.new(pct, 0, 1, 0) }) Tween(thumb, 0.08, { Position = UDim2.new(pct, 0, 0.5, 0) })
            valueLabel.Text = tostring(math.floor(item.Value + 0.5))
            if item.Callback then task.spawn(item.Callback, item.Value) end
        end
        local function updateFromX(x) local pct = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1) setValue(item.Min + (item.Max - item.Min) * pct) end
        hit.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true updateFromX(input.Position.X) end end)
        table.insert(self.Connections, UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then updateFromX(input.Position.X) end end))
        table.insert(self.Connections, UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end))
        setValue(item.Value) item.Set = setValue
    elseif item.Kind == "Button" then
        local btn = New("TextButton", { BackgroundColor3 = Theme.Card, Text = item.Title, TextColor3 = Theme.White, TextSize = 12, Font = Enum.Font.GothamBold, Size = UDim2.new(1, 0, 1, 0), AutoButtonColor = false }, card)
        btn.Activated:Connect(function()
            Tween(card, 0.1, { BackgroundColor3 = Theme.AccentDark })
            task.delay(0.15, function() Tween(card, 0.2, { BackgroundColor3 = Theme.Card }) end)
            if item.Callback then task.spawn(item.Callback) end
        end)
    end
end


-- ============ AUTO SHOOT ============
local autoShootConn = nil
local function toggleAutoShoot(on)
    if autoShootConn then autoShootConn:Disconnect(); autoShootConn = nil end
    if on then
        autoShootConn = RunService.Heartbeat:Connect(function()
            local tool = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
            if tool and tool.Name == "Gun" then
                local mouse = LP:GetMouse()
                if mouse.Target and mouse.Target.Parent then
                    local targetHum = mouse.Target.Parent:FindFirstChildOfClass("Humanoid")
                    if targetHum and targetHum.Health > 0 and targetHum.Parent ~= LP.Character then
                        tool:Activate()
                    end
                end
            end
        end)
    end
end

-- ============ KILL ALL ============
local function KillAll()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                pcall(function() hum.Health = 0 end)
                task.wait(0.1)
            end
        end
    end
end


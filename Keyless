local function CreateToggle(text, default, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 45)
    btn.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
    btn.Text = "  " .. text
    btn.TextColor3 = Color3.fromRGB(240, 240, 240)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 14
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.BorderSizePixel = 0
    btn.Parent = Content
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 8); c.Parent = btn
    
    local isOn = default
    local ind = Instance.new("Frame")
    ind.Size = UDim2.new(0, 40, 0, 20)
    ind.Position = UDim2.new(1, -50, 0.5, -10)
    ind.BackgroundColor3 = isOn and Color3.fromRGB(150, 50, 255) or Color3.fromRGB(15, 15, 18)
    ind.Parent = btn
    local indC = Instance.new("UICorner"); indC.CornerRadius = UDim.new(1, 0); indC.Parent = ind
    
    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0, 16, 0, 16)
    circle.Position = isOn and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
    circle.BackgroundColor3 = Color3.new(1,1,1)
    circle.Parent = ind
    local cc = Instance.new("UICorner"); cc.CornerRadius = UDim.new(1, 0); cc.Parent = circle
    
    btn.MouseButton1Click:Connect(function()
        isOn = not isOn
        TweenService:Create(ind, TweenInfo.new(0.2), {BackgroundColor3 = isOn and Color3.fromRGB(150, 50, 255) or Color3.fromRGB(15, 15, 18)}):Play()
        TweenService:Create(circle, TweenInfo.new(0.2), {Position = isOn and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)}):Play()
        callback(isOn)
    end)
end

CreateToggle("Silent Aim (Camera)", CFG.SilentAim, function(v) CFG.SilentAim = v end)
CreateToggle("Player ESP", CFG.ESP, function(v) CFG.ESP = v end)
CreateToggle("Noclip", CFG.Noclip, function(v) CFG.Noclip = v; setNoclip(v) end)
CreateToggle("Speed Hack", CFG.Speed, function(v) CFG.Speed = v end)

-- Перетаскивание окна
local dragging, dragStart, startPos
Title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = Main.Position
    end
end)
UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
end)

IconBtn.MouseButton1Click:Connect(function()
    Main.Visible = not Main.Visible
end)

print("[Liberium] UI Loaded successfully!")

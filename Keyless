local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LP = Players.LocalPlayer
local isFarming = false

-- Кнопка
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Parent = LP:WaitForChild("PlayerGui")
local Btn = Instance.new("TextButton")
Btn.Size = UDim2.new(0, 120, 0, 50)
Btn.Position = UDim2.new(0, 20, 0.5, 0)
Btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
Btn.Font = Enum.Font.GothamBold
Btn.TextSize = 18
Btn.Text = "FARM: OFF"
Btn.Parent = ScreenGui

-- Кэш и черный список
local coinContainer = nil
local ignoredCoins = {}

local function getCoinContainer()
    if coinContainer and coinContainer.Parent then return coinContainer end
    local gameFolder = Workspace:FindFirstChild("Game")
    if gameFolder and gameFolder:FindFirstChild("CoinContainer") then
        coinContainer = gameFolder.CoinContainer
        return coinContainer
    end
    return nil
end

local function findNearestCoin()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local container = getCoinContainer()
    if not container then return nil end
    
    local closest, minDist = nil, math.huge
    -- Ищем ТОЛЬКО внутри CoinContainer (это мгновенно)
    for _, coin in ipairs(container:GetChildren()) do
        if coin.Name == "Coin_Server" and coin:IsA("BasePart") and not ignoredCoins[coin] then
            local dist = (coin.Position - hrp.Position).Magnitude
            if dist < minDist then
                minDist = dist
                closest = coin
            end
        end
    end
    return closest
end

-- Мгновенный телепорт и сбор
local function grabCoin(coin)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    ignoredCoins[coin] = true
    
    -- 1. Жесткий телепорт прямо к конфете (чуть выше, чтобы не застрять)
    hrp.CFrame = CFrame.new(coin.Position + Vector3.new(0, 2, 0))
    
    -- 2. Мгновенный сбор
    pcall(function()
        firetouchinterest(hrp, coin, 0)
        firetouchinterest(hrp, coin, 1)
    end)
    
    for _, prompt in ipairs(coin:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            pcall(function() fireproximityprompt(prompt) end)
        end
    end
end

-- Главный цикл
task.spawn(function()
    while task.wait(0.05) do -- Очень быстро (20 раз в секунду)
        if isFarming then
            local coin = findNearestCoin()
            if coin then
                grabCoin(coin)
                task.wait(0.1) -- Небольшая пауза, чтобы сервер успел обработать
            end
        end
    end
end)

-- Очистка черного списка от удаленных монет (чтобы не забивать память)
task.spawn(function()
    while task.wait(5) do
        for coin in pairs(ignoredCoins) do
            if not coin.Parent then
                ignoredCoins[coin] = nil
            end
        end
    end
end)

-- Включение/выключение
Btn.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        Btn.Text = "FARM: ON"
        Btn.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
    else
        Btn.Text = "FARM: OFF"
        Btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    end
end)

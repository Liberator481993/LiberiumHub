        sub.Page = page
        for _, section in ipairs(sub.Sections) do self:_BuildSection(section, page) end
    end
    
    if tab.SubTabs[1] then self:_SelectSub(tab, tab.SubTabs[1]) end
end
function Library:_SelectSub(tab, sub)
    tab.ActiveSub = sub
    for _, s in ipairs(tab.SubTabs) do
        if s.Button then local active = s == sub Tween(s.Button, 0.18, { BackgroundColor3 = active and Theme.GreenDark or Theme.Card, TextColor3 = active and Theme.White or Theme.Muted }) Tween(s.Stroke, 0.18, { Transparency = active and 0 or 1 }) end
        if s.Page then s.Page.Visible = s == sub end
    end
end

        AddSubTab = function(t, subName)
            local sub = { Tab = t, Name = subName, Sections = {} }
            table.insert(t.SubTabs, sub)
            return setmetatable(sub, {__index = {
                AddSection = function(s, sectionName)
                    local section = { Sub = s, Name = sectionName, Items = {} }
                    table.insert(s.Sections, section)
                    return setmetatable(section, {__index = {
                        AddToggle = function(sec, title, default, callback, description) return self:_AddItem(sec, { Kind = "Toggle", Title = title, Value = default == true, Callback = callback, Description = description or "" }) end,

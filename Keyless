local T = Slate.Theme and Slate.Theme.tokens and Slate.Theme.tokens() or {}
local C = {
    row    = T.SurfaceAlt or Color3.fromRGB(25, 26, 29),
    txt    = T.Text or Color3.fromRGB(236, 238, 240),
    dim    = T.Muted or Color3.fromRGB(128, 133, 140),
    acc    = T.Accent or Color3.fromRGB(168, 186, 200),

local function createToggle(parent, text, order, callback)
	local row = create("Frame", {
		Size = UDim2.new(1, 0, 0, 42),
		BackgroundColor3 = COLOR_PANEL,
		BorderSizePixel = 0,
		LayoutOrder = order,
	}, parent)
	corner(row, 8)

	create("TextLabel", {
		Size = UDim2.new(1, -80, 1, 0),
		Position = UDim2.fromOffset(12, 0),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = COLOR_TEXT,
		Font = Enum.Font.Gotham,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)

	local switch = create("TextButton", {
		Size = UDim2.fromOffset(46, 24),
		Position = UDim2.new(1, -58, 0.5, -12),
		BackgroundColor3 = COLOR_MUTED,
		Text = "",
		AutoButtonColor = false,
	}, row)
	corner(switch, 12)

	local knob = create("Frame", {
		Size = UDim2.fromOffset(18, 18),
		Position = UDim2.fromOffset(3, 3),
		BackgroundColor3 = COLOR_TEXT,
		BorderSizePixel = 0,
	}, switch)
	corner(knob, 9)

	local enabled = false
	local function setState(value, silent)
		enabled = value
		local info = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(switch, info, {
			BackgroundColor3 = enabled and COLOR_ACCENT or COLOR_MUTED,
		}):Play()
		TweenService:Create(knob, info, {
			Position = enabled and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3),
		}):Play()
		if not silent then
			local ok, err = pcall(callback, enabled)
			if not ok then
				warn("[TestFramework] Toggle error (" .. text .. "): " .. tostring(err))
			end
		end
	end

	switch.MouseButton1Click:Connect(function()
		setState(not enabled)
	end)
	return row
end

local function createSlider(parent, text, order, minValue, maxValue, initial, callback)
	local row = create("Frame", {
		Size = UDim2.new(1, 0, 0, 62),
		BackgroundColor3 = COLOR_PANEL,
		BorderSizePixel = 0,
		LayoutOrder = order,
	}, parent)
	corner(row, 8)

	local label = create("TextLabel", {
		Size = UDim2.new(1, -24, 0, 24),
		Position = UDim2.fromOffset(12, 6),
		BackgroundTransparency = 1,
		Text = text .. ": " .. tostring(initial),
		TextColor3 = COLOR_TEXT,
		Font = Enum.Font.Gotham,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)

	local bar = create("TextButton", {
		Size = UDim2.new(1, -24, 0, 10),
		Position = UDim2.new(0, 12, 0, 40),
		BackgroundColor3 = COLOR_BG,
		Text = "",
		AutoButtonColor = false,
	}, row)
	corner(bar, 5)

	local fill = create("Frame", {
		Size = UDim2.fromScale((initial - minValue) / (maxValue - minValue), 1),
		BackgroundColor3 = COLOR_ACCENT,
		BorderSizePixel = 0,
	}, bar)
	corner(fill, 5)

	local knob = create("Frame", {
		Size = UDim2.fromOffset(18, 18),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		BackgroundColor3 = COLOR_TEXT,
		BorderSizePixel = 0,
	}, fill)
	corner(knob, 9)

	local dragging = false

	local function updateFromX(x)
		local width = bar.AbsoluteSize.X
		if width <= 0 then
			return
		end
		local alpha = math.clamp((x - bar.AbsolutePosition.X) / width, 0, 1)
		local value = math.floor(minValue + (maxValue - minValue) * alpha + 0.5)
		fill.Size = UDim2.fromScale(alpha, 1)
		label.Text = text .. ": " .. tostring(value)
		local ok, err = pcall(callback, value)
		if not ok then
			warn("[TestFramework] Slider error (" .. text .. "): " .. tostring(err))
		end
	end

	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateFromX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	return row
end

-- ========== Перетаскивание (UserInputService) ==========
local function makeDraggable(handle, target, scaleObject)
	local dragging = false
	local dragStart = Vector3.zero
	local startPos = target.Position
	local info = { moved = false }

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			info.moved = false
			dragStart = input.Position
			startPos = target.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			if delta.Magnitude > 6 then
				info.moved = true
			end
			local scale = math.max(scaleObject.Scale, 0.01)
			target.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X / scale,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y / scale
			)
		end
	end)

	return info
end


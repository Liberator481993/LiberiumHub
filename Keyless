local function predictAimPosition(targetRoot, shooterPos, projectileSpeed)
    local targetPos = targetRoot.Position
    local velocity = targetRoot.AssemblyLinearVelocity
    local d = targetPos - shooterPos
    local a = velocity:Dot(velocity) - projectileSpeed * projectileSpeed
    local b = 2 * d:Dot(velocity)
    local c = d:Dot(d)
    local t
    if math.abs(a) < 1e-6 then
        if math.abs(b) > 1e-6 then
            local candidate = -c / b
            if candidate > 0 then t = candidate end
        end
    else
        local disc = b * b - 4 * a * c
        if disc >= 0 then
            local sqrtDisc = math.sqrt(disc)
            local inv = 1 / (2 * a)
            local t1 = (-b - sqrtDisc) * inv
            local t2 = (-b + sqrtDisc) * inv
            if t1 > 0 and t2 > 0 then t = math.min(t1, t2)
            elseif t1 > 0 then t = t1
            elseif t2 > 0 then t = t2 end
        end
    end
    if not t then return nil, nil end
    return targetPos + velocity * t, t
end

local function startAntiFling(threshold)
    local limitSq = (threshold or 1000) ^ 2
    RunService.Heartbeat:Connect(function()
        if not CFG.AntiFling then return end
        local character = Player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local lin = root.AssemblyLinearVelocity
        local ang = root.AssemblyAngularVelocity
        if lin:Dot(lin) > limitSq or ang:Dot(ang) > limitSq then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end

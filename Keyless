function Library:ChangeTheme(themeName)
    local t = Themes[themeName] if not t then return end
    Theme.Green = t.Green Theme.GreenDark = t.GreenDark Theme.Border = t.Border
    for _, obj in ipairs(self.Gui:GetDescendants()) do
        if obj:IsA("UIStroke") then
            if obj.Color == Color3.fromRGB(0, 255, 65) or obj.Color == Color3.fromRGB(170, 0, 255) or obj.Color == Color3.fromRGB(255, 40, 40) or obj.Color == Color3.fromRGB(0, 170, 255) then
                Tween(obj, 0.3, {Color = Theme.Green})
            end
        elseif obj:IsA("Frame") and (obj.Name == "Fill" or obj.Name == "Track") then
            Tween(obj, 0.3, {BackgroundColor3 = Theme.Green})
        elseif obj:IsA("TextLabel") and (obj.TextColor3 == Color3.fromRGB(0, 255, 65) or obj.TextColor3 == Color3.fromRGB(170, 0, 255) or obj.TextColor3 == Color3.fromRGB(255, 40, 40) or obj.TextColor3 == Color3.fromRGB(0, 170, 255)) then
            Tween(obj, 0.3, {TextColor3 = Theme.Green})
        end
    end
end

    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.LayoutOrder = layoutOrder
    btn.AutoButtonColor = false
    btn.Parent = TabHolder
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 4); c.Parent = btn
    
    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 2
    page.ScrollBarImageColor3 = Color3.fromRGB(50, 50, 50)
    page.Visible = false
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Parent = PageHolder
    
    local UIGrid = Instance.new("UIGridLayout", page)
    UIGrid.CellSize = UDim2.new(0.5, -5, 0, 30)
    UIGrid.CellPadding = UDim2.new(0, 10, 0, 10)
    
    Pages[name] = { Button = btn, Page = page, Title = titleText }
    
    btn.MouseButton1Click:Connect(function()
        for _, p in pairs(Pages) do
            p.Page.Visible = false
            TweenService:Create(p.Button, TweenInfo.new(0.1), {TextColor3 = Color3.fromRGB(120, 120, 120), BackgroundTransparency = 1}):Play()
        end
        page.Visible = true
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.BackgroundTransparency = 0
        TitleText.Text = titleText
        ActiveTab = name
    end)
    
    if not ActiveTab then
        ActiveTab = name
        page.Visible = true
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.BackgroundTransparency = 0
        TitleText.Text = titleText
    end
end

-- Квадратный чекбокс (как на фото)
local function CreateCheckbox(parent, text, default, callback)
    local isOn = default
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 30)
    btn.BackgroundTransparency = 1
    btn.Text = "     " .. text
    btn.TextColor3 = isOn and Color3.fromRGB(200, 200, 200) or Color3.fromRGB(100, 100, 100)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.Parent = parent
    
    local box = Instance.new("Frame")
    box.Size = UDim2.new(0, 14, 0, 14)
    box.Position = UDim2.new(0, 5, 0.5, -7)
    box.BackgroundColor3 = isOn and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(30, 30, 30)
    box.Parent = btn
    local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0, 3); bc.Parent = box
    
    local tick = Instance.new("TextLabel")
    tick.Size = UDim2.new(1, 0, 1, 0)
    tick.BackgroundTransparency = 1
    tick.Text = "✓"
    tick.TextColor3 = Color3.fromRGB(10, 10, 10)
    tick.Font = Enum.Font.GothamBlack
    tick.TextSize = 12
    tick.Visible = isOn
    tick.Parent = box
    
    btn.MouseButton1Click:Connect(function()
        isOn = not isOn
        tick.Visible = isOn
        TweenService:Create(box, TweenInfo.new(0.1), {BackgroundColor3 = isOn and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(30, 30, 30)}):Play()
        btn.TextColor3 = isOn and Color3.fromRGB(200, 200, 200) or Color3.fromRGB(100, 100, 100)
        callback(isOn)
    end)
end


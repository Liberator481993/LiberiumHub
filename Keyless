-- 3. ЛОГИКА ПОИСКА И СБОРА
local function getContainer()
    return Workspace:FindFirstChild("CoinContainer", true)
end

local function findNearest()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local container = getContainer()
    if not container then return nil end
    
    local closest, minDist = nil, math.huge
    for _, coin in ipairs(container:GetChildren()) do
        if coin.Name == "Coin_Server" and coin:IsA("BasePart") and not blacklist[coin] then
            local dist = (coin.Position - hrp.Position).Magnitude
            if dist < minDist then
                minDist = dist
                closest = coin
            end
        end
    end
    return closest
end

-- 4. ФИЗИКА И ПОЛЕТ
RunService.Heartbeat:Connect(function()
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if isFarming then
        -- Noclip (сквозь стены)
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end

        if not hum.PlatformStand then hum.PlatformStand = true end

        -- Создаем физику (или обновляем, если ее нет)
        if not bv or bv.Parent ~= hrp then
            if bv then bv:Destroy() end
            if bg then bg:Destroy() end
            bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.P = 1250
            bv.Parent = hrp
            bg = Instance.new("BodyGyro")
            bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bg.P = 1000
            bg.Parent = hrp
        end

        if currentTarget and not currentTarget.Parent then
            currentTarget = nil
        end

        if not currentTarget then
            currentTarget = findNearest()
        end

        if currentTarget then
            local targetPos = currentTarget.Position
            local distance = (hrp.Position - targetPos).Magnitude

            -- Если мы близко (меньше 3 стадов)
            if distance < 3 then
                -- ЖЕСТКО СТАВИМ НА МОНЕТУ (без инерции)
                bv.Velocity = Vector3.zero
                hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
                
                blacklist[currentTarget] = true
                
                -- Сбор
                pcall(function()
                    firetouchinterest(hrp, currentTarget, 0)
                    firetouchinterest(hrp, currentTarget, 1)
                end)
                for _, prompt in ipairs(currentTarget:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        pcall(function() fireproximityprompt(prompt) end)
                    end
                end

                -- Ждем удаления монеты
                local timeout = 0
                while currentTarget.Parent and timeout < 0.3 do
                    task.wait(0.05)
                    timeout += 0.05
                end
                currentTarget = nil
                task.wait(0.1)
            else
                -- Летим физикой
                local dir = (targetPos - hrp.Position).Unit
                bv.Velocity = dir * farmSpeed
                bg.CFrame = CFrame.new(hrp.Position, targetPos)
            end
        else
            bv.Velocity = Vector3.zero
        end
    else
        -- Выключено
        if bv then bv:Destroy(); bv = nil end
        if bg then bg:Destroy(); bg = nil end
        if hum.PlatformStand then hum.PlatformStand = false end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end
end)

-- 5. ОЧИСТКА ПРИ СМЕРТИ / РЕСПАВНЕ (Фикс бага в лобби)
LP.CharacterAdded:Connect(function(newChar)
    currentTarget = nil
    if bv then bv:Destroy(); bv = nil end
    if bg then bg:Destroy(); bg = nil end
    local hum = newChar:WaitForChild("Humanoid", 5)
    if hum then hum.PlatformStand = false end
end)

-- 6. УПРАВЛЕНИЕ
SliderBg.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local function update(x)
            local percent = math.clamp((x - SliderBg.AbsolutePosition.X) / SliderBg.AbsoluteSize.X, 0, 1)
            farmSpeed = math.floor(percent * 24) + 1
            SliderFill.Size = UDim2.new(percent, 0, 1, 0)
            StatusText.Text = "Скорость: " .. farmSpeed
        end
        update(input.Position.X)
        
        local moveConn
        moveConn = game:GetService("UserInputService").InputChanged:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
                update(i.Position.X)
            end
        end)
        game:GetService("UserInputService").InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                if moveConn then moveConn:Disconnect() end
            end
        end)
    end
end)

Btn.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        Btn.Text = "FARM: ON"
        Btn.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
    else
        Btn.Text = "FARM: OFF"
        Btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        StatusText.Text = "Скорость: " .. farmSpeed
    end
end)

task.spawn(function()
    while task.wait(5) do
        for coin in pairs(blacklist) do
            if not coin.Parent then blacklist[coin] = nil end
        end
    end
end)

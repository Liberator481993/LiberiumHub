-- ФУНКЦИЯ СМЕНЫ ТЕМЫ
function Library:ChangeTheme(themeName)
    local t = Themes[themeName]
    if not t then return end
    Theme.Accent = t.Accent
    Theme.AccentDark = t.AccentDark
    Theme.Border = t.Border

    for _, stroke in ipairs(UIElements.Strokes) do
        if stroke.Color == Themes.Green.Accent or stroke.Color == Themes.Purple.Accent or stroke.Color == Themes.Red.Accent or stroke.Color == Themes.Blue.Accent or stroke.Color == Themes.Green.Border then
            Tween(stroke, 0.3, {Color = Theme.Accent})
        end
    end
    for _, grad in ipairs(UIElements.Gradients) do
        -- Пропускаем градиенты, чтобы не ломать визуал
    end
end

-- ФУНКЦИЯ СМЕНЫ ФОНА
function Library:ChangeBackground(idx)
    if Backgrounds[idx] then
        Tween(self.BgImage, 0.4, {ImageTransparency = 1})
        task.wait(0.4)
        self.BgImage.Image = Backgrounds[idx]
        Tween(self.BgImage, 0.4, {ImageTransparency = 0.85})
    end
end


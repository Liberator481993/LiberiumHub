-- 1. CONFIG MANAGER
local ConfigManager = (function()
    local DEFAULT_FOLDER = "DashboardConfig" local DEFAULT_FILE = "settings"
    local ConfigManager = {} ConfigManager.__index = ConfigManager
    local function hasFunction(name) local ok, v = pcall(function() return getfenv()[name] end) return ok and typeof(v) == "function" end
    local function callGlobal(name, ...) return getfenv()[name](...) end
    local function isFiniteNumber(n) return n == n and n ~= math.huge and n ~= -math.huge end
    local function isArray(t) local count = 0 for key in pairs(t) do if type(key) ~= "number" or key < 1 or key % 1 ~= 0 then return false end count += 1 end return count == #t end
    local function sanitize(value, depth, seen)
        local vType = typeof(value)
        if vType == "string" or vType == "boolean" then return value
        elseif vType == "number" then return isFiniteNumber(value) and value or nil
        elseif vType == "Color3" then return { __type = "Color3", R = value.R, G = value.G, B = value.B }
        elseif vType == "Vector2" then return { __type = "Vector2", X = value.X, Y = value.Y }
        elseif vType == "table" then
            if depth >= 32 or seen[value] then return nil end
            seen[value] = true local res = {}
            if isArray(value) then for i = 1, #value do res[i] = sanitize(value[i], depth + 1, seen) or false end
            else for k, v in pairs(value) do if type(k) == "string" or type(k) == "number" then local c = sanitize(v, depth + 1, seen) if c ~= nil then res[tostring(k)] = c end end end end
            seen[value] = nil return res
        end return nil
    end
    local function restore(value, depth)
        if type(value) ~= "table" or depth >= 32 then return value end
        if value.__type == "Color3" then return Color3.new(value.R, value.G, value.B)
        elseif value.__type == "Vector2" then return Vector2.new(value.X, value.Y) end
        local res = {} for k, v in pairs(value) do res[k] = restore(v, depth + 1) end return res
    end
    function ConfigManager.new() local self = setmetatable({}, ConfigManager) self._folder = DEFAULT_FOLDER self._memory = {} self._canWrite = hasFunction("writefile") self._canRead = hasFunction("readfile") self._canMakeFolder = hasFunction("makefolder") self._canCheckFolder = hasFunction("isfolder") return self end
    function ConfigManager:_normalizeName(fileName) local name = type(fileName) == "string" and fileName or DEFAULT_FILE name = name:gsub("[^%w_%-%.]", "_") if name == "" or name == "." or name == ".." then name = DEFAULT_FILE end if name:sub(-5):lower() ~= ".json" then name ..= ".json" end return name end
    function ConfigManager:_path(name) return self._folder .. "/" .. name end
    function ConfigManager:_ensureFolder() if not self._canMakeFolder then return end pcall(function() if not (hasFunction("isfolder") and callGlobal("isfolder", self._folder)) then callGlobal("makefolder", self._folder) end end) end
    function ConfigManager:Save(tbl, fileName)
        local clean = sanitize(tbl, 0, {}) if not clean then return false end
        local ok, json = pcall(HttpService.JSONEncode, HttpService, clean) if not ok then return false end
        local name = self:_normalizeName(fileName) self._memory[name] = json
        if not self._canWrite then return false end self:_ensureFolder()
        local okW = pcall(function() callGlobal("writefile", self:_path(name), json) end) return okW
    end
    function ConfigManager:Load(fileName)
        local name = self:_normalizeName(fileName)
        if self._canRead then
            local ok, contents = pcall(function() local p = self:_path(name) if hasFunction("isfile") and not callGlobal("isfile", p) then return nil end return callGlobal("readfile", p) end)
            if ok and type(contents) == "string" and contents ~= "" then
                local okD, dec = pcall(HttpService.JSONDecode, HttpService, contents)
                if okD and type(dec) == "table" then local okR, rest = pcall(restore, dec, 0) if okR and type(rest) == "table" then self._memory[name] = contents return rest end end
            end
        end
        local cached = self._memory[name] if cached then local okD, dec = pcall(HttpService.JSONDecode, HttpService, cached) if okD then return restore(dec, 0) end end
        return {}
    end
    return ConfigManager
end)()

-- 2. INTERCEPT SOLVER
local InterceptSolver = (function()
    local API = {}
    function API.solve(targetPos, targetVel, originPos, speed)
        if speed <= 0 then return nil, nil end
        local speedSq = speed * speed local velSq = targetVel:Dot(targetVel) local D = targetPos - originPos
        local a = velSq - speedSq local h = D:Dot(targetVel) local c = D:Dot(D)
        if c < 1e-6 then return targetPos, 0 end
        local t
        if math.abs(a) < 1e-6 then
            if h >= 0 then return nil, nil end t = -c / (2 * h)
        else
            local disc = h * h - a * c if disc < 0 then return nil, nil end
            local sign = if h >= 0 then 1 else -1 local q = -(h + sign * math.sqrt(disc))
            local t1 = q / a local t2 = c / q
            local best = math.huge
            if t1 > 0 and t1 < best then best = t1 end
            if t2 > 0 and t2 < best then best = t2 end
            if best == math.huge then return nil, nil end
            t = best
        end
        return targetPos + targetVel * t, t
    end
    return API
end)()

-- 3. ROLE HUD (ИСПРАВЛЕН БАГ С ЗАЛИВКОЙ)
local RoleHUD = (function()
    local API = {} API.__index = API
    local C = { 
        murderer = Color3.fromRGB(255, 50, 50), killer = Color3.fromRGB(255, 50, 50), zombie = Color3.fromRGB(255, 50, 50),
        sheriff = Color3.fromRGB(50, 120, 255), hero = Color3.fromRGB(50, 120, 255),
        innocent = Color3.fromRGB(50, 255, 100), survivor = Color3.fromRGB(50, 255, 100) 
    }
    function API.new(provider) local s = setmetatable({}, API) s._provider = provider s._hl = {} s._state = {} s._conns = {} s._running = false s._container = nil return s end
    
    -- ФИКС: Принудительное пересоздание Highlight при смене цвета
    function API:_update(p, tbl) 
        local data = tbl[p.UserId] or tbl[tostring(p.UserId)] or tbl[p.Name] 
        local roleStr = type(data) == "table" and tostring(data.Role) or tostring(data)
        local color = C[string.lower(roleStr)] 
        
        local char = p.Character local hum = char and char:FindFirstChildOfClass("Humanoid") 
        local isDead = (type(data) == "table" and data.Dead == true) or not hum or hum.Health <= 0
        
        if not color or isDead then 
            if self._hl[p] then self._hl[p].Enabled = false end
            return 
        end 
        
        local hl = self._hl[p]
        -- Если Highlight нет, или цвет изменился (баг Roblox) — удаляем и создаем заново
        if not hl or self._state[p].Color ~= color then
            if hl then hl:Destroy() end
            hl = Instance.new("Highlight")
            hl.Name = "LibHUD"
            hl.FillTransparency = 0.5
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = self._container
            self._hl[p] = hl
            self._state[p] = { Color = color }
        end
        
        hl.FillColor = color
        hl.OutlineColor = color
        hl.Adornee = char
        hl.Enabled = true
    end
    
    function API:_step() local ok, tbl = pcall(self._provider) if not ok or type(tbl) ~= "table" then return end for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then self:_update(p, tbl) end end end
    function API:Start() if self._running then return end self._running = true self._container = self._container or Instance.new("Folder") self._container.Name = "LibHUD" self._container.Parent = Workspace table.insert(self._conns, Players.PlayerRemoving:Connect(function(p) if self._hl[p] then self._hl[p]:Destroy() self._hl[p] = nil self._state[p] = nil end end)) task.spawn(function() while self._running do self:_step() task.wait(0.3) end end) end
    function API:Stop() self._running = false for _, c in ipairs(self._conns) do c:Disconnect() end table.clear(self._conns) for p in pairs(self._hl) do if self._hl[p] then self._hl[p].Enabled = false end end end
    function API:Destroy() self:Stop() for _, hl in pairs(self._hl) do pcall(function() hl:Destroy() end) end table.clear(self._hl) table.clear(self._state) if self._container then self._container:Destroy() self._container = nil end end
    return API
end)()

-- 4. STABILIZER
local Stabilizer = (function()
    local CONFIG = { LinearThreshold = 1000, LinearSafe = 250, AngularThreshold = 1000, AngularSafe = 50, DampRate = 14, IgnoreVerticalInFreefall = true }
    local ignored = setmetatable({}, {__mode = "k"}) local damping = setmetatable({}, {__mode = "k"}) local API = {}
    local function damp(v, thr, sf, al, st, k, igY) local y = igY and v.Y or 0 local f = igY and Vector3.new(v.X,0,v.Z) or v local m = f.Magnitude if not st[k] then if m <= thr then return nil end st[k] = true end if m <= sf * 1.05 then st[k] = false return nil end local nm = m + (sf - m) * al local d = f.Unit * nm return igY and Vector3.new(d.X, y, d.Z) or d end
    local function step(dt) local char = LocalPlayer.Character if not char then return end local root = char:FindFirstChild("HumanoidRootPart") if not root or ignored[char] then return end local st = damping[root] or {linear=false, angular=false} damping[root] = st local al = 1 - math.exp(-CONFIG.DampRate * dt) local hum = char:FindFirstChildOfClass("Humanoid") local ff = CONFIG.IgnoreVerticalInFreefall and hum and hum:GetState() == Enum.HumanoidStateType.Freefall local l = damp(root.AssemblyLinearVelocity, CONFIG.LinearThreshold, CONFIG.LinearSafe, al, st, "linear", ff) if l then root.AssemblyLinearVelocity = l end local a = damp(root.AssemblyAngularVelocity, CONFIG.AngularThreshold, CONFIG.AngularSafe, al, st, "angular", false) if a then root.AssemblyAngularVelocity = a end end
    function API.Start() if not API._conn then API._conn = RunService.Heartbeat:Connect(step) end end
    function API.Stop() if API._conn then API._conn:Disconnect() API._conn = nil end end
    return API
end)()

-- 5. NOTIFICATION MANAGER
NotificationManager = (function()
    local NM = {}
    local CONFIG = {
        Width = 200, MinHeight = 36, MaxHeight = 100, VerticalPadding = 8, Padding = 6,
        MarginRight = 12, MarginTop = 12, MaxVisible = 6, DefaultDuration = 4,
        DisplayOrder = 1000, SlideDistance = 40,
        Font = Enum.Font.GothamMedium, TextSize = 12, TextInsetLeft = 14, TextInsetRight = 10,
        BackgroundColor = Color3.fromRGB(18, 18, 28), TextColor = Color3.fromRGB(240, 240, 250),
        BackgroundTransparency = 0.2, StrokeTransparency = 0.35,
        TweenIn = TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        TweenOut = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        Reflow = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
    }
    local TYPES = { Info = Color3.fromRGB(140, 90, 255), Success = Color3.fromRGB(70, 210, 120), Error = Color3.fromRGB(240, 75, 90) }
    local TYPE_LOOKUP = { info = "Info", success = "Success", error = "Error" }
    local screenGui = nil
    local stack = {}
    local function getGui()
        if screenGui and screenGui.Parent then return screenGui end
        local pg = PlayerGui
        local gui = Instance.new("ScreenGui")
        gui.Name = "NotificationManager"
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = false
        gui.DisplayOrder = CONFIG.DisplayOrder
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        gui.Parent = pg
        screenGui = gui
        return gui
    end
    local function measureHeight(text)
        local ok, size = pcall(TextService.GetTextSize, TextService, text, CONFIG.TextSize, CONFIG.Font,
            Vector2.new(CONFIG.Width - CONFIG.TextInsetLeft - CONFIG.TextInsetRight, 10000))
        if not ok then return CONFIG.MinHeight end
        return math.clamp(math.ceil(size.Y) + CONFIG.VerticalPadding * 2, CONFIG.MinHeight, CONFIG.MaxHeight)
    end
    local function play(entry, instance, info, goal)
        if entry.Destroyed then return nil end
        local tween = TweenService:Create(instance, info, goal)
        entry.Tweens[tween] = true
        tween.Completed:Once(function() entry.Tweens[tween] = nil end)
        tween:Play()
        return tween
    end
    local function cancelTweens(entry)
        for tween in pairs(table.clone(entry.Tweens)) do pcall(function() tween:Cancel() end) end
        table.clear(entry.Tweens)
        entry.ReflowTween = nil
    end
    local function cancelTimer(entry)
        if entry.Timer then pcall(task.cancel, entry.Timer) entry.Timer = nil end
    end
    local function destroyEntry(entry)
        if entry.Destroyed then return end
        entry.Destroyed = true
        cancelTimer(entry) cancelTweens(entry)
        for _, c in ipairs(entry.Connections) do c:Disconnect() end
        table.clear(entry.Connections)
        local i = table.find(stack, entry)
        if i then table.remove(stack, i) end
        if entry.Slot then entry.Slot:Destroy() end
    end
    local function reflow()
        local y = CONFIG.MarginTop
        for _, entry in ipairs(stack) do
            local target = UDim2.new(1, -CONFIG.MarginRight, 0, y)
            if not entry.Placed then
                entry.Placed = true
                entry.Slot.Position = target
            else
                if entry.ReflowTween then entry.ReflowTween:Cancel() end
                entry.ReflowTween = play(entry, entry.Slot, CONFIG.Reflow, { Position = target })
            end
            y += entry.Height + CONFIG.Padding
        end
    end
    local function fade(entry, show)
        local info = show and CONFIG.TweenIn or CONFIG.TweenOut
        for _, t in ipairs(entry.Targets) do
            play(entry, t[1], info, { [t[2]] = show and t[3] or 1 })
        end
    end
    local function dismiss(entry)
        if entry.Destroyed or entry.Dismissing then return end
        entry.Dismissing = true
        cancelTimer(entry) cancelTweens(entry)
        play(entry, entry.Toast, CONFIG.TweenOut, { Position = UDim2.fromOffset(CONFIG.SlideDistance / 2, 0) })
        fade(entry, false)
        task.delay(CONFIG.TweenOut.Time + 0.05, function()
            if entry.Destroyed then return end
            destroyEntry(entry) reflow()
        end)
    end
    local function createEntry(gui, text, typeName)
        local accent = TYPES[typeName]
        local height = measureHeight(text)
        local slot = Instance.new("Frame")
        slot.Name = "NotificationSlot"
        slot.AnchorPoint = Vector2.new(1, 0)
        slot.Size = UDim2.fromOffset(CONFIG.Width, height)
        slot.BackgroundTransparency = 1
        slot.BorderSizePixel = 0
        slot.Parent = gui
        local toast = Instance.new("Frame")
        toast.Name = "Toast"
        toast.Size = UDim2.fromScale(1, 1)
        toast.Position = UDim2.fromOffset(CONFIG.SlideDistance, 0)
        toast.BackgroundColor3 = CONFIG.BackgroundColor
        toast.BackgroundTransparency = 1
        toast.BorderSizePixel = 0
        toast.Active = true
        toast.Parent = slot
        local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 8); corner.Parent = toast
        local stroke = Instance.new("UIStroke")
        stroke.Color = accent; stroke.Thickness = 1.5; stroke.Transparency = 1
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; stroke.Parent = toast
        local bar = Instance.new("Frame")
        bar.Name = "Accent"; bar.AnchorPoint = Vector2.new(0, 0.5)
        bar.Position = UDim2.new(0, 6, 0.5, 0); bar.Size = UDim2.new(0, 3, 1, -12)
        bar.BackgroundColor3 = accent; bar.BackgroundTransparency = 1
        bar.BorderSizePixel = 0; bar.Parent = toast
        local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(1, 0); bc.Parent = bar
        local label = Instance.new("TextLabel")
        label.Name = "Message"; label.BackgroundTransparency = 1
        label.Position = UDim2.fromOffset(CONFIG.TextInsetLeft, 0)
        label.Size = UDim2.new(1, -(CONFIG.TextInsetLeft + CONFIG.TextInsetRight), 1, 0)
        label.Font = CONFIG.Font; label.TextSize = CONFIG.TextSize
        label.TextColor3 = CONFIG.TextColor; label.TextTransparency = 1
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.TextYAlignment = Enum.TextYAlignment.Center
        label.TextWrapped = true; label.TextTruncate = Enum.TextTruncate.AtEnd
        label.Text = text; label.Parent = toast
        return {
            Slot = slot, Toast = toast, Height = height, Placed = false,
            Dismissing = false, Destroyed = false, Timer = nil, ReflowTween = nil,
            Tweens = {}, Connections = {},
            Targets = {
                { toast, "BackgroundTransparency", CONFIG.BackgroundTransparency },
                { stroke, "Transparency", CONFIG.StrokeTransparency },
                { bar, "BackgroundTransparency", 0 },
                { label, "TextTransparency", 0 },
            },
        }
    end
    function NM.Notify(text, notifType, duration)
        local ok, result = pcall(function()
            local message = tostring(text or "")
            local typeName = TYPE_LOOKUP[string.lower(tostring(notifType or "info"))] or "Info"
            local lifetime = math.max(0.5, tonumber(duration) or CONFIG.DefaultDuration)
            local gui = getGui()
            local entry = createEntry(gui, message, typeName)
            table.insert(stack, 1, entry)
            local active = 0
            for _, other in ipairs(stack) do if not other.Dismissing then active += 1 end end
            if active > CONFIG.MaxVisible then
                for i = #stack, 1, -1 do
                    if not stack[i].Dismissing then dismiss(stack[i]) break end
                end
            end
            reflow()
            play(entry, entry.Toast, CONFIG.TweenIn, { Position = UDim2.fromOffset(0, 0) })
            fade(entry, true)
            table.insert(entry.Connections, entry.Toast.InputBegan:Connect(function(input)
                local it = input.UserInputType
                if it == Enum.UserInputType.MouseButton1 or it == Enum.UserInputType.Touch then dismiss(entry) end
            end))
            entry.Timer = task.delay(lifetime, function()
                entry.Timer = nil
                dismiss(entry)
            end)
            return { Dismiss = function() dismiss(entry) end }
        end)
        if not ok then warn("[NotificationManager] " .. tostring(result)) return nil end
        return result
    end
    function NM.Clear() for i = #stack, 1, -1 do destroyEntry(stack[i]) end end
    function NM.Destroy() NM.Clear() if screenGui then screenGui:Destroy() screenGui = nil end end
    return NM
end)()


local OverheadTracker = (function()
    local OT = {} OT.__index = OT
    local DEFAULT_ROLE_COLORS = { murderer = Color3.fromRGB(255, 70, 70), killer = Color3.fromRGB(255, 70, 70), zombie = Color3.fromRGB(255, 70, 70), sheriff = Color3.fromRGB(70, 140, 255), hero = Color3.fromRGB(70, 140, 255), innocent = Color3.fromRGB(70, 220, 110), survivor = Color3.fromRGB(70, 220, 110) }

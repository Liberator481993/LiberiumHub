function Lib.new(title)
    local s = setmetatable({Tabs = {}, Conns = {}, Destroyed = false}, Win)
    local old = PlayerGui:FindFirstChild("GlassUI")
    if old then pcall(function() old:Destroy() end) end

    s.Gui = create("ScreenGui", {
        Name = "GlassUI", ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 2000,
        Parent = PlayerGui,
    })
    s.Scale = create("UIScale", {Scale = 1, Parent = s.Gui})

    local function updateScale()
        local cam = Workspace.CurrentCamera
        if not cam then return end
        local vp = cam.ViewportSize
        -- Use a taller design canvas on phones so the UI doesn't shrink into a tiny strip.
        local mobile = vp.X < 620
        local baseW, baseH = mobile and 620 or 700, mobile and 720 or 500
        if s.Main then s.Main.Size = UDim2.fromOffset(baseW, baseH) end
        local scale = math.min((vp.X - 16) / baseW, (vp.Y - 24) / baseH, 1)
        s.Scale.Scale = math.clamp(scale, 0.46, 1)
    end

    local function bindCamera()
        if s.CameraConnection then
            pcall(function() s.CameraConnection:Disconnect() end)
            s.CameraConnection = nil
        end
        local cam = Workspace.CurrentCamera
        if cam then
            s.CameraConnection = cam:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
        end
        updateScale()
    end
    bindCamera()
    table.insert(s.Conns, Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera))

    s.Main = create("Frame", {
        Name = "Main", AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(700, 500),
        BackgroundColor3 = UI.Ink, BackgroundTransparency = 0.04,
        BorderSizePixel = 0, ClipsDescendants = true, Parent = s.Gui,
    })
    uiCorner(s.Main, 18)
    uiStroke(s.Main, UI.Violet, 0.38, 1.3)
    updateScale()
    create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(24, 18, 43)),
            ColorSequenceKeypoint.new(0.52, UI.Ink),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(9, 24, 34)),
        }),
        Rotation = 24, Parent = s.Main,
    })

    s.Inner = create("Frame", {
        Name = "Inner", Position = UDim2.fromOffset(1, 1),
        Size = UDim2.new(1, -2, 1, -2), BackgroundTransparency = 1,
        ClipsDescendants = true, Parent = s.Main,
    })

    s.Title = create("Frame", {
        Name = "TopBar", Size = UDim2.new(1, 0, 0, 62),
        BackgroundColor3 = UI.Panel, BackgroundTransparency = 0.04,
        BorderSizePixel = 0, Parent = s.Inner,
    })
    create("UIGradient", {
        Color = ColorSequence.new(Color3.fromRGB(33, 25, 55), UI.Panel),
        Rotation = 0, Parent = s.Title,
    })
    create("Frame", {
        Name = "AccentLine", Position = UDim2.new(0, 18, 1, -2),
        Size = UDim2.new(1, -36, 0, 2), BackgroundColor3 = UI.Cyan,
        BorderSizePixel = 0, Parent = s.Title,
    })

    local brandMark = create("Frame", {
        Position = UDim2.fromOffset(16, 15), Size = UDim2.fromOffset(30, 30),
        BackgroundColor3 = UI.Violet, BorderSizePixel = 0, Parent = s.Title,
    })
    uiCorner(brandMark, 9)
    create("UIGradient", {
        Color = ColorSequence.new(UI.Violet, UI.Cyan), Rotation = 35,
        Parent = brandMark,
    })
    uiText(brandMark, "L", 18, Color3.new(1, 1, 1), Enum.Font.GothamBlack).TextXAlignment = Enum.TextXAlignment.Center

    local brand = uiText(s.Title, "LIBERIUM", 17, UI.Text, Enum.Font.GothamBlack)
    brand.Position = UDim2.fromOffset(56, 10)
    brand.Size = UDim2.new(0, 180, 0, 24)
    local subtitle = uiText(s.Title, string.upper(title or "CONTROL CENTER") .. "  /  MOBILE", 9, UI.Muted, Enum.Font.GothamMedium)
    subtitle.Position = UDim2.fromOffset(57, 34)
    subtitle.Size = UDim2.new(0, 230, 0, 16)

    local status = create("Frame", {
        Name = "StatusPill", AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -16, 0.5, 0), Size = UDim2.fromOffset(118, 28),

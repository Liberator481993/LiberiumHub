local Hotkeys = (function()
    local HK = {} HK._binds = {} HK._connection = nil
    local function onInputBegan(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        local callbacks = HK._binds[input.KeyCode]
        if not callbacks then return end
        for _, callback in ipairs(callbacks) do
            task.spawn(function() local ok, err = pcall(callback) if not ok then warn("[Hotkeys] callback error:", err) end end)
        end
    end
    function HK.Bind(keyCode, callback)
        local list = HK._binds[keyCode]
        if not list then list = {} HK._binds[keyCode] = list end
        table.insert(list, callback)
        if not HK._connection then HK._connection = UserInputService.InputBegan:Connect(onInputBegan) end
        return function() local idx = table.find(list, callback) if idx then table.remove(list, idx) end end
    end
    function HK.Destroy() if HK._connection then HK._connection:Disconnect() HK._connection = nil end table.clear(HK._binds) end
    return HK
end)()

StatsTracker = (function()
    local ST = {} ST.__index = ST
    local UPDATE_INTERVAL = 1
    local COLORS = { Text = Color3.fromRGB(255, 255, 255), Good = Color3.fromRGB(120, 255, 160), Warn = Color3.fromRGB(255, 210, 90), Bad = Color3.fromRGB(255, 100, 100), Muted = Color3.fromRGB(170, 170, 180) }

    local function readPing()
        local ok, value = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
        if ok and type(value) == "number" then return value end
        return nil
    end
    local function readMemory()
        local ok, value = pcall(function() return Stats:GetTotalMemoryUsageMb() end)
        if ok and type(value) == "number" then return value end
        return nil
    end
    local function formatUptime(seconds)
        seconds = math.floor(seconds)
        return string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60)
    end
    local function fpsColor(fps) if fps >= 50 then return COLORS.Good end if fps >= 30 then return COLORS.Warn end return COLORS.Bad end
    local function pingColor(ping) if ping <= 100 then return COLORS.Good end if ping <= 200 then return COLORS.Warn end return COLORS.Bad end

    local function createRow(parent, order, title)
        local row = Instance.new("Frame")
        row.Name = title row.LayoutOrder = order row.Size = UDim2.new(1, 0, 0, 18) row.BackgroundTransparency = 1 row.Parent = parent
        local label = Instance.new("TextLabel")
        label.Name = "Title" label.Size = UDim2.new(0.45, 0, 1, 0) label.BackgroundTransparency = 1 label.Text = title
        label.TextColor3 = COLORS.Muted label.Font = Enum.Font.GothamMedium label.TextSize = 13 label.TextXAlignment = Enum.TextXAlignment.Left label.Parent = row
        local value = Instance.new("TextLabel")
        value.Name = "Value" value.AnchorPoint = Vector2.new(1, 0) value.Position = UDim2.new(1, 0, 0, 0) value.Size = UDim2.new(0.55, 0, 1, 0)
        value.BackgroundTransparency = 1 value.Text = "--" value.TextColor3 = COLORS.Text value.TextTransparency = 0
        value.Font = Enum.Font.GothamMedium value.TextSize = 13 value.TextXAlignment = Enum.TextXAlignment.Right value.Parent = row
        return value
    end

    function ST.new(parentGui, options)
        options = options or {}
        local self = setmetatable({}, ST)
        self._destroyed = false self._startTime = os.clock() self._frames = 0 self._elapsed = 0
        local panel = Instance.new("Frame")
        panel.Name = "StatsTracker" panel.AnchorPoint = Vector2.new(0, 0) panel.Position = options.Position or UDim2.new(0, 10, 0, 10)
        panel.Size = UDim2.new(0, 150, 0, 0) panel.AutomaticSize = Enum.AutomaticSize.Y
        panel.BackgroundColor3 = Color3.fromRGB(20, 20, 28) panel.BackgroundTransparency = 0.35 panel.BorderSizePixel = 0 panel.ZIndex = 30 panel.Parent = parentGui
        self._panel = panel
        local corner = Instance.new("UICorner") corner.CornerRadius = UDim.new(0, 10) corner.Parent = panel
        local stroke = Instance.new("UIStroke") stroke.Color = Color3.fromRGB(255, 255, 255) stroke.Transparency = 0.8 stroke.Thickness = 1 stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border stroke.Parent = panel
        local padding = Instance.new("UIPadding") padding.PaddingTop = UDim.new(0, 8) padding.PaddingBottom = UDim.new(0, 8) padding.PaddingLeft = UDim.new(0, 10) padding.PaddingRight = UDim.new(0, 10) padding.Parent = panel
        local layout = Instance.new("UIListLayout") layout.SortOrder = Enum.SortOrder.LayoutOrder layout.Padding = UDim.new(0, 3) layout.Parent = panel
        self._fpsLabel = createRow(panel, 1, "FPS") self._pingLabel = createRow(panel, 2, "Ping")
        self._uptimeLabel = createRow(panel, 3, "Uptime") self._uptimeLabel.Text = formatUptime(0)
        self._memoryLabel = createRow(panel, 4, "Memory")
        self._connection = RunService.RenderStepped:Connect(function(dt) self:_onFrame(dt) end)
        return self
    end

    function ST:_onFrame(dt)
        if self._destroyed then return end
        self._frames += 1 self._elapsed += dt
        if self._elapsed < UPDATE_INTERVAL then return end
        local fps = math.floor(self._frames / self._elapsed + 0.5) self._frames = 0 self._elapsed = 0
        pcall(function()
            self._fpsLabel.Text = tostring(fps) self._fpsLabel.TextColor3 = fpsColor(fps)
            local ping = readPing()
            if ping then self._pingLabel.Text = string.format("%d ms", math.floor(ping + 0.5)) self._pingLabel.TextColor3 = pingColor(ping)
            else self._pingLabel.Text = "N/A" self._pingLabel.TextColor3 = COLORS.Muted end
            self._uptimeLabel.Text = formatUptime(os.clock() - self._startTime)
            local memory = readMemory()
            if memory then self._memoryLabel.Text = string.format("%d MB", math.floor(memory + 0.5)) self._memoryLabel.TextColor3 = COLORS.Text
            else self._memoryLabel.Text = "N/A" self._memoryLabel.TextColor3 = COLORS.Muted end
        end)
    end

    function ST:SetVisible(visible) if self._destroyed then return end self._panel.Visible = visible == true end
    function ST:Destroy()
        if self._destroyed then return end self._destroyed = true
        if self._connection then self._connection:Disconnect() self._connection = nil end
        pcall(function() self._panel:Destroy() end)
    end
    return ST
end)()

AestheticsManager = (function()
    local AM = {}
    local TRANSITION = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local MAX_EMITTER_RATE = 25
    local PRESETS = {
        Neon = { ColorCorrection = { Enabled = true, Saturation = 1.5, Contrast = 0.15, Brightness = -0.05, TintColor = Color3.fromRGB(185, 175, 235) }, Bloom = { Enabled = true, Intensity = 1.5, Size = 40, Threshold = 0.8 }, DepthOfField = { Enabled = false } },
        Cinematic = { ColorCorrection = { Enabled = true, Saturation = 0.1, Contrast = 0.2, Brightness = 0, TintColor = Color3.fromRGB(255, 240, 220) }, Bloom = { Enabled = true, Intensity = 0.5, Size = 24, Threshold = 1.0 }, DepthOfField = { Enabled = true, FarIntensity = 0.15, NearIntensity = 0, FocusDistance = 40, InFocusRadius = 30 } },
        Default = { ColorCorrection = { Enabled = true, Saturation = 0, Contrast = 0, Brightness = 0, TintColor = Color3.new(1, 1, 1) }, Bloom = { Enabled = false, Intensity = 0, Size = 24, Threshold = 2 }, DepthOfField = { Enabled = false, FarIntensity = 0, NearIntensity = 0 } },
    }
    local EFFECT_DEFS = { ColorCorrection = { class = "ColorCorrectionEffect", name = "AestheticsColorCorrection" }, Bloom = { class = "BloomEffect", name = "AestheticsBloom" }, DepthOfField = { class = "DepthOfFieldEffect", name = "AestheticsDepthOfField" } }
    local currentPreset = "Default"

    local function getEffect(key)
        local def = EFFECT_DEFS[key]
        local existing = Lighting:FindFirstChild(def.name)
        if existing and existing:IsA(def.class) then return existing end
        local effect = Instance.new(def.class) effect.Name = def.name effect.Parent = Lighting return effect
    end
    local function applyToEffect(effect, values)
        local tweenGoals = {}
        for property, value in pairs(values) do
            if property == "Enabled" then if value then effect.Enabled = true end else tweenGoals[property] = value end
        end
        local tween = TweenService:Create(effect, TRANSITION, tweenGoals)
        if values.Enabled == false then tween.Completed:Once(function() pcall(function() effect.Enabled = false end) end) end
        tween:Play()
    end

    function AM.ApplyShaderPreset(presetName)
        local preset = PRESETS[presetName] if not preset then return false end
        for key, values in pairs(preset) do pcall(function() applyToEffect(getEffect(key), values) end) end
        currentPreset = presetName return true
    end
    function AM.CleanupShaders() for _, def in pairs(EFFECT_DEFS) do local effect = Lighting:FindFirstChild(def.name) if effect then pcall(function() effect:Destroy() end) end end currentPreset = "Default" end

    local function seq(...) return NumberSequence.new({ ... }) end
    local AURAS = {
        Fire = { Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 190, 60)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 90, 20)), ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 10, 0)) }), Size = seq(NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(0.6, 0.4), NumberSequenceKeypoint.new(1, 0)), Transparency = seq(NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.7, 0.6), NumberSequenceKeypoint.new(1, 1)), Lifetime = NumberRange.new(0.7, 1.2), Speed = NumberRange.new(3, 5), Rate = 22, SpreadAngle = Vector2.new(20, 20), Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-30, 30), Acceleration = Vector3.new(0, 4, 0), LightEmission = 1, LightColor = Color3.fromRGB(255, 120, 30), LightBrightness = 1.5 },
        Ice = { Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(150, 235, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(60, 190, 255)) }), Size = seq(NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.3, 0.5), NumberSequenceKeypoint.new(1, 0.1)), Transparency = seq(NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.3), NumberSequenceKeypoint.new(1, 1)), Lifetime = NumberRange.new(1.5, 2.5), Speed = NumberRange.new(0.5, 1.5), Rate = 14, SpreadAngle = Vector2.new(180, 180), Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-60, 60), Acceleration = Vector3.new(0, 0.6, 0), LightEmission = 0.6, LightColor = Color3.fromRGB(140, 225, 255), LightBrightness = 1 },
    }
    local EMITTER_NAME = "AestheticsAuraEmitter" local LIGHT_NAME = "AestheticsAuraLight" local auraState = {}
    local function destroyAuraInstances(character)
        if not character then return end
        pcall(function() local root = character:FindFirstChild("HumanoidRootPart") if not root then return end local emitter = root:FindFirstChild(EMITTER_NAME) if emitter then emitter:Destroy() end local light = root:FindFirstChild(LIGHT_NAME) if light then light:Destroy() end end)
    end
    local function buildAura(character, auraType)
        local config = AURAS[auraType] if not config then return end
        local root = character:WaitForChild("HumanoidRootPart", 5) if not root or not root.Parent then return end
        destroyAuraInstances(character)
        pcall(function()
            local emitter = Instance.new("ParticleEmitter")
            emitter.Name = EMITTER_NAME emitter.Color = config.Color emitter.Size = config.Size emitter.Transparency = config.Transparency
            emitter.Lifetime = config.Lifetime emitter.Speed = config.Speed emitter.Rate = math.min(config.Rate, MAX_EMITTER_RATE)
            emitter.SpreadAngle = config.SpreadAngle emitter.Rotation = config.Rotation emitter.RotSpeed = config.RotSpeed
            emitter.Acceleration = config.Acceleration emitter.LightEmission = config.LightEmission
            emitter.EmissionDirection = Enum.NormalId.Top emitter.Shape = Enum.ParticleEmitterShape.Box emitter.LockedToPart = false emitter.Parent = root
            local light = Instance.new("PointLight")
            light.Name = LIGHT_NAME light.Color = config.LightColor light.Brightness = config.LightBrightness
            light.Range = 10 light.Shadows = false light.Parent = root
        end)
    end
    function AM.SetAura(player, auraType)
        if not player or not AURAS[auraType] then return false end
        local state = auraState[player]
        if not state then state = {} auraState[player] = state state.charConn = player.CharacterAdded:Connect(function(character) task.spawn(buildAura, character, state.type) end) end
        state.type = auraType if player.Character then task.spawn(buildAura, player.Character, auraType) end return true
    end
    function AM.RemoveAura(player)
        local state = auraState[player]
        if state then if state.charConn then state.charConn:Disconnect() end auraState[player] = nil end
        destroyAuraInstances(player and player.Character)
    end
    function AM.ClearAllAuras() local players = {} for player in pairs(auraState) do table.insert(players, player) end for _, player in ipairs(players) do AM.RemoveAura(player) end end
    Players.PlayerRemoving:Connect(function(player) local state = auraState[player] if state then if state.charConn then state.charConn:Disconnect() end auraState[player] = nil end end)
    return AM
end)()


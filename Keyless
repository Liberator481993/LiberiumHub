-- 1. РОЛИ (ИЗ GetPlayerData)
local roles = {}
task.spawn(function()
    while task.wait(2) do
        safe(function()
            local getData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
            if getData and getData:IsA("RemoteFunction") then
                local success, data = getData:InvokeServer()
                if success and type(data) == "table" then roles = data end
            end
        end)
    end
end)

local function getRoleColor(targetPlayer)
    local rData = roles[targetPlayer.Name]
    if rData then
        local r = rData.Role or rData[1]
        if r == "Murderer" then return ROLE_RED end
        if r == "Sheriff" then return ROLE_BLUE end
    end
    return ROLE_GREEN
end

-- 2. VISUALS (HIGHLIGHT)
local highlights = {}
local function refreshAllHighlights()
	for _, p in ipairs(Players:GetPlayers()) do
        if p == player then continue end
		if state.highlight then
            if p.Character then
                local hl = highlights[p]
                if not hl or hl.Parent ~= p.Character then
                    if hl then hl:Destroy() end
                    hl = Instance.new("Highlight")
                    hl.OutlineTransparency = 0
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = p.Character
                    highlights[p] = hl
                end
                local col = getRoleColor(p)
                hl.FillColor = col
                hl.OutlineColor = col
                hl.FillTransparency = state.highlightFill
            end
		else
			if highlights[p] then highlights[p]:Destroy(); highlights[p] = nil end
		end
	end
end
RunService.RenderStepped:Connect(refreshAllHighlights)

-- 3. MOVEMENT (NOCLIP & SPEED)
local originalCollide = setmetatable({}, { __mode = "k" })
local function restoreCollisions()
	for part, value in pairs(originalCollide) do
		pcall(function() if part and part.Parent then part.CanCollide = value end end)
	end
	table.clear(originalCollide)
end
RunService.Stepped:Connect(function()
	if not state.noclip then return end
	pcall(function()
		local character = player.Character
		if not character then return end
		for _, descendant in ipairs(character:GetDescendants()) do
			if descendant:IsA("BasePart") then
				if originalCollide[descendant] == nil then originalCollide[descendant] = descendant.CanCollide end
				descendant.CanCollide = false
			end
		end
	end)
end)
RunService.Heartbeat:Connect(function()
	if not state.walkSpeedTouched then return end
	pcall(function()
		local humanoid = getHumanoid()
		if humanoid and humanoid.WalkSpeed ~= state.walkSpeed then humanoid.WalkSpeed = state.walkSpeed end
	end)
end)

-- 4. AUTOMATION (FARM COINS & CANDY)
task.spawn(function()
    while task.wait(0.5) do
        if state.autoFarm and player.Character then
            pcall(function()
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                -- Ищем монеты в GUI
                local main = playerGui:FindFirstChild("MainGUI")
                local bags = main and main:FindFirstChild("Game") and main.Game:FindFirstChild("CoinBags")
                local closest, dist = nil, 100
                
                if bags then
                    for _, bag in ipairs(bags:GetChildren()) do
                        if bag:IsA("BasePart") then
                            local d = (bag.Position - hrp.Position).Magnitude
                            if d < dist then dist = d; closest = bag end
                        end
                    end
                end
                
                -- Ищем конфеты в Workspace
                for _, obj in ipairs(Workspace:GetChildren()) do
                    if obj:IsA("BasePart") or obj:IsA("Model") then
                        local name = string.lower(obj.Name)
                        if name:find("candy") or name:find("sweet") then
                            local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                            local d = (pos - hrp.Position).Magnitude
                            if d < dist then dist = d; closest = obj end
                        end
                    end
                end

                if closest then
                    local pos = closest:IsA("Model") and closest:GetPivot().Position or closest.Position
                    hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
                end
            end)
        end
    end
end)


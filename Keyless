local farmBV, farmBG

-- Функция для создания физики полета
local function createPhysics(char)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if not farmBV then
        farmBV = Instance.new("BodyVelocity")
        farmBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        farmBV.Velocity = Vector3.zero
        farmBV.Parent = hrp
        farmBG = Instance.new("BodyGyro")
        farmBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
        farmBG.P = 1000
        farmBG.Parent = hrp
    end
end

-- Очистка физики
local function destroyPhysics()
    if farmBV then farmBV:Destroy(); farmBV = nil end
    if farmBG then farmBG:Destroy(); farmBG = nil end
end

-- ============ ЛОГИКА ФАРМА ============
RunService.Heartbeat:Connect(function()
    if not (CFG.FarmCoins or CFG.FarmCandies) then
        if farmBV then destroyPhysics() end
        return
    end

    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    if not farmBV then createPhysics(char) end

    local targetPart = nil
    local minDist = math.huge

    -- Ищем монеты
    if CFG.FarmCoins then
        local main = LP.PlayerGui:FindFirstChild("MainGUI")
        local bags = main and ((main:FindFirstChild("Lobby") and main.Lobby:FindFirstChild("CoinBags")) or (main:FindFirstChild("Game") and main.Game:FindFirstChild("CoinBags")))
        if bags then
            for _, bag in ipairs(bags:GetChildren()) do
                if bag:IsA("BasePart") then
                    local d = (bag.Position - hrp.Position).Magnitude
                    if d < minDist then minDist = d; targetPart = bag end
                end
            end
        end
    end

    -- Ищем конфеты в Workspace (ищем по имени)
    if CFG.FarmCandies then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and (string.find(string.lower(obj.Name), "candy") or string.find(string.lower(obj.Name), "sweet")) then
                local d = (obj.Position - hrp.Position).Magnitude
                if d < minDist then minDist = d; targetPart = obj end
            end
        end
    end

    -- Летим к цели
    if targetPart then
        farmBV.Velocity = (targetPart.Position - hrp.Position).Unit * 45
        farmBG.CFrame = CFrame.new(hrp.Position, targetPart.Position)
        
        -- Если близко, активируем ProximityPrompt (если он есть)
        if minDist < 10 then
            for _, prompt in ipairs(targetPart:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") then
                    pcall(function() fireproximityprompt(prompt) end)
                end
            end
        end
    else
        farmBV.Velocity = Vector3.zero
    end
end)

-- ============ ESP ДЛЯ ПРЕДМЕТОВ ============
local itemHighlights = {}
RunService.RenderStepped:Connect(function()
    if not CFG.ItemESP then
        for _, hl in pairs(itemHighlights) do hl:Destroy() end
        table.clear(itemHighlights)
        return
    end
    
    -- Подсветка конфет (желтым)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (string.find(string.lower(obj.Name), "candy") or string.find(string.lower(obj.Name), "sweet")) then
            if not itemHighlights[obj] then
                local hl = Instance.new("Highlight")
                hl.FillColor = Color3.fromRGB(255, 255, 0) -- Желтый
                hl.FillTransparency = 0.5
                hl.OutlineColor = Color3.fromRGB(255, 255, 0)
                hl.Parent = obj
                itemHighlights[obj] = hl
            end
        end
    end

    -- Подсветка мешков с монетами (зеленым)
    local main = LP.PlayerGui:FindFirstChild("MainGUI")
    local bags = main and ((main:FindFirstChild("Lobby") and main.Lobby:FindFirstChild("CoinBags")) or (main:FindFirstChild("Game") and main.Game:FindFirstChild("CoinBags")))
    if bags then
        for _, obj in ipairs(bags:GetChildren()) do
            if obj:IsA("BasePart") then
                if not itemHighlights[obj] then
                    local hl = Instance.new("Highlight")
                    hl.FillColor = Color3.fromRGB(0, 255, 0) -- Зеленый
                    hl.FillTransparency = 0.5
                    hl.OutlineColor = Color3.fromRGB(0, 255, 0)
                    hl.Parent = obj
                    itemHighlights[obj] = hl
                end
            end
        end
    end
end)


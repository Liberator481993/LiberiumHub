-- 1. RATE LIMITER (От Клода)
-- ==========================================
local RateLimiter = (function()
    local clock = os.clock
    local cooldowns = {}
    local callsSinceSweep = 0
    local SWEEP_EVERY = 256
    local throttles = setmetatable({}, { __mode = "k" })

    local function sweep(now)
        for key, expiry in pairs(cooldowns) do if expiry <= now then cooldowns[key] = nil end end
    end

    local API = {}
    function API.Debounce(key, cooldown)
        local now = clock()
        callsSinceSweep += 1
        if callsSinceSweep >= SWEEP_EVERY then callsSinceSweep = 0 sweep(now) end
        local expiry = cooldowns[key]
        if expiry and now < expiry then return false end
        cooldowns[key] = now + cooldown
        return true
    end
    function API.Throttle(fn, interval)
        local state = { lastRun = -math.huge, pending = nil, thread = nil }
        throttles[state] = true
        local function trailing()
            state.thread = nil
            local args = state.pending
            state.pending = nil
            if not args then return end
            state.lastRun = clock()
            fn(table.unpack(args, 1, args.n))
        end
        local function wrapped(...)
            local now = clock()
            local elapsed = now - state.lastRun
            if elapsed >= interval and not state.thread then
                state.lastRun = now
                state.pending = nil
                return fn(...)
            end
            state.pending = table.pack(...)
            if not state.thread then state.thread = task.delay(math.max(0, interval - elapsed), trailing) end
        end
        return wrapped, function() if state.thread then task.cancel(state.thread) state.thread = nil end state.pending = nil end
    end
    function API.Once(fn)
        local called = false
        return function(...)
            if called then return end
            called = true
            return fn(...)
        end
    end
    function API.Cleanup()
        table.clear(cooldowns)
        callsSinceSweep = 0
        for state in pairs(throttles) do
            if state.thread then task.cancel(state.thread) end
            state.thread = nil state.pending = nil state.lastRun = -math.huge
        end
    end
    return table.freeze(API)
end)()


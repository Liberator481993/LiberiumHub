local collectedCount = 0
local Blacklist = setmetatable({}, { __mode = "k" })
local originalCollide = setmetatable({}, { __mode = "k" })
local roles = {}
local canFarmNow = false
local currentSession = nil 
local lastHealth = 100

task.spawn(function()
    while task.wait(0.5) do
        pcall(function()
            local getData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
            if getData and getData:IsA("RemoteFunction") then
                local ok, data = pcall(function() return getData:InvokeServer() end)
                if ok and type(data) == "table" then roles = data end
            end
        end)
    end
end)

local function getPlayerRole(plr)
    local rData = roles[plr.Name]
    if rData and rData.Role then return rData.Role end
    local char = plr.Character
    if char then
        if char:FindFirstChild("Knife") or char:FindFirstChild("KnifeServer") then return "Murderer" end
        if char:FindFirstChild("Gun") or char:FindFirstChild("GunServer") then return "Sheriff" end
    end
    local bp = plr:FindFirstChild("Backpack")
    if bp then
        if bp:FindFirstChild("Knife") or bp:FindFirstChild("KnifeServer") then return "Murderer" end
        if bp:FindFirstChild("Gun") or bp:FindFirstChild("GunServer") then return "Sheriff" end
    end
    return "Innocent"
end

local function getRoleColor(plr)
    local role = getPlayerRole(plr)
    if role == "Murderer" or role == "Zombie" then return Color3.fromRGB(255, 50, 50) end
    if role == "Sheriff" then return Color3.fromRGB(50, 120, 255) end
    return Color3.fromRGB(50, 255, 100)
end

local function canCollect()
    if not canFarmNow then return false end
    local s = currentSession
    if not s or s.destroyed or s.humanoid.Health <= 0 then return false end
    local myData = roles[player.Name]
    if not myData or myData.Dead then return false end 
    local r = myData.Role
    if not r or r == "Spectator" or r == "Lobby" or r == "None" then return false end
    local container = Workspace:FindFirstChild("CoinContainer", true)
    if not container or #container:GetChildren() == 0 then return false end
    return true
end


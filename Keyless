    local function byDepth(a, b) return a.Depth < b.Depth end
    local function setShown(entry, shown) if entry.Shown ~= shown then entry.Shown = shown entry.Gui.Enabled = shown end end
    local function applyLevel(entry, level) if entry.Level ~= level then entry.Level = level entry.Gui.SizeOffset = Vector2.new(0, level * 1) end end

local function bindCharacter(char)
    if currentSession then currentSession.destroyed = true end canFarmNow = false 
    local root = char:WaitForChild("HumanoidRootPart", 10) local hum = char:WaitForChild("Humanoid", 10) 
    if not (root and hum) or LocalPlayer.Character ~= char then return end
    local s = { character = char, root = root, humanoid = hum, destroyed = false } currentSession = s
    hum.Died:Connect(function() s.destroyed = true if currentSession == s then currentSession = nil end end)
    char.AncestryChanged:Connect(function(_, par) if par == nil then s.destroyed = true if currentSession == s then currentSession = nil end end end)
    task.wait(3) canFarmNow = true 
end
LocalPlayer.CharacterAdded:Connect(bindCharacter) if LocalPlayer.Character then task.spawn(bindCharacter, LocalPlayer.Character) end

local coinTracker = ObjectTracker.new("CoinContainer", "^Coin", { Parent = Workspace, Recursive = true })
local function glideTo(target, speed)
    local s = currentSession 
    if not s or s.destroyed or not s.root or not s.root.Parent or not s.humanoid or s.humanoid.Health <= 0 or not target.Parent then return false end
    local char = s.character local root = s.root local hum = s.humanoid
    local origPS = hum.PlatformStand local origAR = hum.AutoRotate
    hum.AutoRotate = false hum.PlatformStand = true
    local arrived = false local start = os.clock() local lastPos = root.Position local stuck = 0 local lastF = os.clock()
    local ok, err = pcall(function()
        while not s.destroyed and hum.Health > 0 and target.Parent and isRunning do
            RunService.Heartbeat:Wait() if s.destroyed or hum.Health <= 0 then break end
            for _, d in ipairs(char:GetDescendants()) do if d:IsA("BasePart") then d.CanCollide = false end end
            local now = os.clock() local dt = math.min(now - lastF, 0.1) lastF = now
            local pos = root.Position local offset = target.Position - pos local dist = offset.Magnitude
            if dist <= 3 then arrived = true break end
            local dRatio = math.clamp(dist / 20, 0, 1) local sm = dRatio * dRatio * (3 - 2 * dRatio)
            local stepD = math.min(math.min(speed * sm * dt, dist), 2.0) 
            local newPos = pos + offset.Unit * stepD local flat = Vector3.new(offset.X, 0, offset.Z) 
            if flat.Magnitude > 0.1 then root.CFrame = CFrame.lookAt(newPos, newPos + flat) else root.CFrame = CFrame.new(newPos) end
            if (root.Position - lastPos).Magnitude < 0.3 then stuck = stuck + dt if stuck > 0.3 then root.CFrame = CFrame.new(target.Position + Vector3.new(0, 2, 0)) stuck = 0 task.wait(0.1) end
            else stuck = 0 lastPos = root.Position end
            if os.clock() - start > 6 then break end 
        end
    end)
    if not ok then warn("[glideTo]", err) end
    for _, d in ipairs(char:GetDescendants()) do if d:IsA("BasePart") then d.CanCollide = true end end
    if hum.Parent and hum.Health > 0 then hum.PlatformStand = origPS hum.AutoRotate = origAR hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
    return arrived
end

local function collectSession() 
    while CFG.AutoFarm and canFarmNow and isRunning do 
        local root = currentSession and currentSession.root
        if not root then break end
        local target = coinTracker:GetClosest(root.Position, 100)
        if not target then task.wait(0.5) continue end
        if glideTo(target, CFG.MaxSpeed) then
            pcall(function()
                if typeof(firetouchinterest) == "function" then firetouchinterest(root, target, 0) firetouchinterest(root, target, 1) task.wait(0.05) firetouchinterest(root, target, 0) firetouchinterest(root, target, 1) end
            end)
            task.wait(0.15)
        else task.wait(0.1) end
    end 
end
task.spawn(function() while true and isRunning do if CFG.AutoFarm then collectSession() end task.wait(1) end end)


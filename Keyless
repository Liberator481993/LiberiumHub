local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local LP = Players.LocalPlayer
local isFarming = false
local blacklist = {}
local currentTarget = nil

-- Очистка старого GUI
pcall(function()
    local core = game:GetService("CoreGui")
    if core:FindFirstChild("FarmTestGui") then core.FarmTestGui:Destroy() end
    if LP.PlayerGui:FindFirstChild("FarmTestGui") then LP.PlayerGui.FarmTestGui:Destroy() end
end)


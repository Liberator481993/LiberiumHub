-- LiberiumHub | UI TEST
-- Проверка отрисовки интерфейса на Arceus X

local Players = game:GetService("Players")
local LP = Players.LocalPlayer

-- Создаем ScreenGui напрямую в PlayerGui
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "LiberiumTest"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = LP:WaitForChild("PlayerGui")

-- Создаем фиолетовую кнопку
local IconBtn = Instance.new("TextButton")
IconBtn.Size = UDim2.new(0, 50, 0, 50)
IconBtn.Position = UDim2.new(0, 20, 0, 100)
IconBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 255)
IconBtn.Text = "L"
IconBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
IconBtn.Font = Enum.Font.GothamBlack
IconBtn.TextSize = 24
IconBtn.BorderSizePixel = 0
IconBtn.Parent = ScreenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(1, 0)
corner.Parent = IconBtn

-- Окно
local Main = Instance.new("Frame")
Main.Size = UDim2.new(0, 300, 0, 200)
Main.Position = UDim2.new(0.5, -150, 0.5, -100)
Main.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
Main.BorderSizePixel = 0
Main.Visible = false
Main.Parent = ScreenGui

local MainCorner = Instance.new("UICorner")
MainCorner.CornerRadius = UDim.new(0, 10)
MainCorner.Parent = Main

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 50)
Title.BackgroundTransparency = 1
Title.Text = "Liberium Hub"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 18
Title.Parent = Main

-- Логика открытия
IconBtn.MouseButton1Click:Connect(function()
    Main.Visible = not Main.Visible
    print("[Liberium] Menu toggled! Visible:", Main.Visible)
end)

print("[Liberium] Script loaded! Look at the top left of your screen.")

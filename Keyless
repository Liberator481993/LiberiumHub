local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local LP = Players.LocalPlayer
local isFarming = false
local isMoving = false
local blacklist = {}

-- GUI
local oldGui = LP.PlayerGui:FindFirstChild("FarmTestGui")
if oldGui then oldGui:Destroy() end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FarmTestGui"
ScreenGui.Parent = LP:WaitForChild("PlayerGui")

local Btn = Instance.new("TextButton")
Btn.Size = UDim2.new(0, 150, 0, 50)
Btn.AnchorPoint = Vector2.new(0.5, 0.5)
Btn.Position = UDim2.new(0.5, 0, 0.4, 0)
Btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
Btn.Font = Enum.Font.GothamBold
Btn.TextSize = 18
Btn.Text = "FARM: OFF"
Btn.Parent = ScreenGui

local StatusText = Instance.new("TextLabel")
StatusText.Size = UDim2.new(0, 350, 0, 40)
StatusText.AnchorPoint = Vector2.new(0.5, 0.5)
StatusText.Position = UDim2.new(0.5, 0, 0.4, 60)
StatusText.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
StatusText.BackgroundTransparency = 0.4
StatusText.TextColor3 = Color3.fromRGB(0, 255, 0)
StatusText.Font = Enum.Font.Code
StatusText.TextSize = 16
StatusText.Text = "Ожидание..."
StatusText.Parent = ScreenGui

local function getContainer()
    return Workspace:FindFirstChild("CoinContainer", true)
end

local function findNearest()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local container = getContainer()
    if not container then return nil end
    
    local closest, minDist = nil, math.huge
    for _, coin in ipairs(container:GetChildren()) do
        if coin.Name == "Coin_Server" and coin:IsA("BasePart") and not blacklist[coin] then
            local dist = (coin.Position - hrp.Position).Magnitude
            if dist < minDist then
                minDist = dist
                closest = coin
            end
        end
    end
    return closest
end

local function flyToAndCollect(coin)
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    isMoving = true
    blacklist[coin] = true
    
    -- 1. Полностью отключаем физику персонажа
    hrp.Anchored = true
    hum.PlatformStand = true
    
    -- 2. Отключаем коллизии всем частям тела (чтобы не застрять в стене)
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end

    -- 3. Летим строго в центр конфеты (на 1.5 стада выше пола)
    local targetPos = coin.Position + Vector3.new(0, 1.5, 0)
    local distance = (hrp.Position - targetPos).Magnitude
    
    -- Время полета (чем дальше, тем дольше летим, но не более 0.3 сек)
    local travelTime = math.clamp(distance / 200, 0.05, 0.3)
    
    local tween = TweenService:Create(hrp, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), { CFrame = CFrame.new(targetPos) })
    tween:Play()
    tween.Completed:Wait()

    -- 4. Собираем монету (касание + Prompt)
    pcall(function()
        firetouchinterest(hrp, coin, 0)
        firetouchinterest(hrp, coin, 1)
    end)
    for _, prompt in ipairs(coin:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            pcall(function() fireproximityprompt(prompt) end)
        end
    end

    -- 5. ВАЖНАЯ ПАУЗА: Ждем 0.2 секунды, чтобы сервер удалил монету из игры!
    task.wait(0.2)

    -- 6. Возвращаем физику
    hrp.Anchored = false
    hum.PlatformStand = false
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
        end
    end
    
    isMoving = false
end

-- Главный цикл
task.spawn(function()
    while task.wait(0.1) do
        if isFarming and not isMoving then -- Ищем новую цель, только если не в процессе полета
            local char = LP.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            if not char or not hum or hum.Health <= 0 then
                StatusText.Text = "Мертв..."
                continue
            end

            local coin = findNearest()
            if coin then
                StatusText.Text = "Летим к монете!"
                flyToAndCollect(coin)
            else
                StatusText.Text = "Монет нет (ждем)"
            end
        end
    end
end)

-- Очистка
task.spawn(function()
    while task.wait(5) do
        for coin in pairs(blacklist) do
            if not coin.Parent then blacklist[coin] = nil end
        end
    end
end)

Btn.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        Btn.Text = "FARM: ON"
        Btn.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
    else
        Btn.Text = "FARM: OFF"
        Btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        StatusText.Text = "Ожидание..."
        -- Экстренный сброс физики
        local char = LP.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hrp then hrp.Anchored = false end
            if hum then hum.PlatformStand = false end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
        end
    end
end)

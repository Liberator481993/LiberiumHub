-- ==========================================
local function startAntiFling(threshold)
    local limitSq = (threshold or 1000) ^ 2
    RunService.Heartbeat:Connect(function()
        if not CFG.AntiFling or not isRunning then return end
        local character = Player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local lin = root.AssemblyLinearVelocity
        local ang = root.AssemblyAngularVelocity
        if lin.Dot(lin, lin) > limitSq or ang.Dot(ang, ang) > limitSq then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end
startAntiFling(1000)


function Win:_Select(t)
    if self.Active==t then return end self.Active=t
    for _, v in ipairs(self.Tabs) do local a = v==t tween(v.Btn,FAST,{BackgroundTransparency=a and 0.8 or 1}) tween(v.Lbl,FAST,{TextColor3=a and THEME.Text or THEME.SubText}) if not a then v.Cont.Visible=false v.Cont.GroupTransparency=1 end end
    t.Cont.Position=UDim2.fromOffset(0,8) t.Cont.Visible=true tween(t.Cont,SLOW,{GroupTransparency=0,Position=UDim2.fromOffset(0,0)})
end
function Win:AddTab(name, icon)
    local t = setmetatable({Win=self,Name=name,Subs={}}, Tab)
    t.Btn = create("TextButton", {Size=UDim2.new(1,0,0,36),BackgroundTransparency=1,BackgroundColor3=THEME.Accent,Parent=self.Side}, {corner(8)})
    label({Text=icon or "•",TextSize=15,TextXAlignment=Enum.TextXAlignment.Center,Position=UDim2.fromOffset(8,0),Size=UDim2.new(0,22,1,0),Parent=t.Btn})
    t.Lbl = label({Text=name,TextColor3=THEME.SubText,Position=UDim2.fromOffset(38,0),Size=UDim2.new(1,-44,1,0),Parent=t.Btn})
    t.Btn.MouseEnter:Connect(function() if self.Active~=t then tween(t.Btn,FAST,{BackgroundTransparency=0.92}) end end) t.Btn.MouseLeave:Connect(function() if self.Active~=t then tween(t.Btn,FAST,{BackgroundTransparency=1}) end end)
    t.Btn.Activated:Connect(function() self:_Select(t) end)
    t.Cont = create("CanvasGroup", {Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Visible=false,GroupTransparency=1,Parent=self.Content})
    t.SubBar = create("Frame", {Size=UDim2.new(1,0,0,32),BackgroundTransparency=1,Parent=t.Cont}, {pad(4), create("UIListLayout", {FillDirection=Enum.FillDirection.Horizontal,Padding=UDim.new(0,6)})})
    t.PageHolder = create("Frame", {Position=UDim2.fromOffset(0,36),Size=UDim2.new(1,0,1,-36),BackgroundTransparency=1,Parent=t.Cont})
    table.insert(self.Tabs, t) if #self.Tabs==1 then self:_Select(t) end return t
end
function Tab:_SelectSub(s) if self.ActiveSub==s then return end self.ActiveSub=s for _, v in ipairs(self.Subs) do local a = v==s tween(v.Btn,FAST,{BackgroundTransparency=a and 0.7 or 0.9,TextColor3=a and THEME.Text or THEME.SubText}) if not a then v.Page.Visible=false v.Page.GroupTransparency=1 end end s.Page.Visible=true tween(s.Page,SLOW,{GroupTransparency=0}) end

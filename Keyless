-- ============ ROLES ============
local roles = {}
local function setRoles()
    local getData = RS:FindFirstChild("GetPlayerData", true)
    if getData and getData:IsA("RemoteFunction") then
        local success, data = pcall(function() return getData:InvokeServer() end)
        if success and type(data) == "table" then
            roles = data
        end
    end
end
task.spawn(function()
    while task.wait(5) do setRoles() end
end)

local function getRole(plr)
    local roleData = roles[plr.Name]
    if roleData then return roleData.Role or roleData[1] end
    return "Innocent"
end

local function getChar(plr)
    local c = plr.Character
    if not c then return nil end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then return c, hrp, hum end
    return nil
end

-- ============ ESP ============
local espCache = {}
local function applyESP(plr)
    if plr == LP then return end
    local char = getChar(plr)
    if not char then return end
    local role = getRole(plr)
    
    local hl = espCache[plr]
    if not hl or hl.Parent ~= char then
        if hl then hl:Destroy() end
        hl = Instance.new("Highlight")
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.Parent = char
        espCache[plr] = hl
    end
    
    if role == "Murderer" then
        hl.FillColor = Color3.fromRGB(220, 60, 60)
    elseif role == "Sheriff" then
        hl.FillColor = Color3.fromRGB(60, 140, 255)
    else
        hl.FillColor = Color3.fromRGB(80, 200, 120)
    end
    hl.Enabled = CFG.ESP
end

local function clearESP()
    for plr, hl in pairs(espCache) do
        pcall(function() hl:Destroy() end)
        espCache[plr] = nil
    end
end

RunService.RenderStepped:Connect(function()
    if not CFG.ESP then
        for _, hl in pairs(espCache) do hl.Enabled = false end
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then applyESP(plr) end
    end
end)

-- ============ SILENT AIM ============
local mt = getrawmetatable(game)
local oldIndex = mt.__index
setreadonly(mt, false)
mt.__index = newcclosure(function(self, key)
    if CFG.SilentAim and (key == "Hit" or key == "Target") then
        local tool = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
        if tool and tool.Name:find("Gun") then
            local closest, dist = nil, math.huge
            local origin = Cam.CFrame.Position
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LP then
                    local _, hrp, hum = getChar(plr)
                    if hrp and hum.Health > 0 then
                        local d = (hrp.Position - origin).Magnitude
                        if d < dist then dist = d; closest = hrp end
                    end
                end
            end
            if closest then
                if key == "Hit" then return CFrame.new(closest.Position) end
                if key == "Target" then return closest end
            end
        end
    end
    return oldIndex(self, key)
end)
setreadonly(mt, true)

-- ============ AIMBOT ============
local aimTarget = nil
UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if CFG.Aimbot and (input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.Touch) then
        local best, bd = nil, math.huge
        local origin = Cam.CFrame.Position
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP then
                local role = getRole(plr)
                if role == "Murderer" or role == "Sheriff" then
                    local _, hrp, hum = getChar(plr)
                    if hrp and hum.Health > 0 then
                        local d = (hrp.Position - origin).Magnitude
                        if d < bd then bd = d; best = hrp end
                    end
                end
            end
        end
        aimTarget = best
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.Touch then
        aimTarget = nil
    end
end)

RunService.RenderStepped:Connect(function()
    if aimTarget and aimTarget.Parent then
        Cam.CFrame = CFrame.new(Cam.CFrame.Position, aimTarget.Position)
    end
end)

-- ============ AUTO FARM ============
local function getCoinBags()
    local gui = LP.PlayerGui
    local main = gui:FindFirstChild("MainGUI")
    if not main then return {} end
    local lobby = main:FindFirstChild("Lobby")
    local gameFolder = main:FindFirstChild("Game")
    local bags = (lobby and lobby:FindFirstChild("CoinBags")) or (gameFolder and gameFolder:FindFirstChild("CoinBags"))
    if bags then return bags:GetChildren() end
    return {}
end

RunService.Heartbeat:Connect(function()
    if not CFG.AutoFarm then return end
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    for _, bag in ipairs(getCoinBags()) do
        if bag:IsA("BasePart") then
            hrp.CFrame = CFrame.new(bag.Position + Vector3.new(0, 3, 0))
            task.wait(0.1)
        end
    end
end)

-- ============ MOVEMENT ============
local noclipConn
local function setNoclip(on)
    if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
    if not on then return end
    noclipConn = RunService.Stepped:Connect(function()
        local char = LP.Character
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end)
end

RunService.Heartbeat:Connect(function()
    if CFG.Speed then
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = CFG.SpeedVal end
    end
end)

local flyConn, flyBV, flyBG
local function setFly(on)
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    if flyBV then flyBV:Destroy(); flyBV = nil end
    if flyBG then flyBG:Destroy(); flyBG = nil end
    if not on then return end
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    flyBV.Velocity = Vector3.zero
    flyBV.Parent = hrp

    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    flyBG.P = 1000
    flyBG.Parent = hrp

    flyConn = RunService.RenderStepped:Connect(function()
        local move = Vector3.zero
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = true end
        if UIS:IsKeyDown(Enum.KeyCode.W) then move += Cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then move -= Cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then move -= Cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then move += Cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.new(0, 1, 0) end
        flyBV.Velocity = move * 60
        flyBG.CFrame = Cam.CFrame
    end)
end


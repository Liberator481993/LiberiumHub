-- Функция поиска ближайшей конфеты
local function findCoin()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local closest, minDist = nil, math.huge
    -- Ищем Coin_Server по всей карте (быстро, так как проверяем только имена)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "Coin_Server" and obj:IsA("BasePart") then
            local dist = (obj.Position - hrp.Position).Magnitude
            if dist < minDist then
                minDist = dist
                closest = obj
            end
        end
    end
    return closest
end

-- Логика полета
local function moveToCoin(coin)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    isMoving = true
    
    -- 1. Отключаем физику, чтобы не падать
    hrp.Anchored = true
    hum.PlatformStand = true
    hrp.CanCollide = false
    
    -- 2. Летим к конфете (встаем на 2 стада выше неё)
    local targetPos = coin.Position + Vector3.new(0, 2.5, 0)
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Linear) -- 0.3 сек на полет
    local tween = TweenService:Create(hrp, tweenInfo, { CFrame = CFrame.new(targetPos) })
    tween:Play()
    tween.Completed:Wait()
    
    -- 3. Собираем
    if coin and coin.Parent then
        -- Активируем нажатие (если есть)
        for _, prompt in ipairs(coin:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") then
                pcall(function() fireproximityprompt(prompt) end)
            end
        end
        -- Имитируем касание
        pcall(function()
            firetouchinterest(hrp, coin, 0)
            firetouchinterest(hrp, coin, 1)
        end)
    end
    
    -- 4. Возвращаем управление
    task.wait(0.1)
    hrp.Anchored = false
    hrp.CanCollide = true
    hum.PlatformStand = false
    
    isMoving = false
end

-- Главный цикл
task.spawn(function()
    while task.wait(0.1) do
        if isFarming and not isMoving then
            local coin = findCoin()
            if coin then
                moveToCoin(coin)
            end
        end
    end
end)

-- Кнопка вкл/выкл
Btn.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        Btn.Text = "FARM: ON"
        Btn.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
    else
        Btn.Text = "FARM: OFF"
        Btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        -- Возвращаем управление, если выключили в полете
        local char = LP.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hrp then hrp.Anchored = false; hrp.CanCollide = true end
            if hum then hum.PlatformStand = false end
        end
    end
end)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RS = game:GetService("ReplicatedStorage")
local LP = Players.LocalPlayer
local Cam = workspace.CurrentCamera

local CFG = {
    -- Combat
    SilentAim = false, Aimbot = false, FOV = 120, AimPart = "Head",
    -- Visuals
    ESP = false,
    -- Farm
    AutoFarm = false,
    -- Movement
    Noclip = false, Speed = false, SpeedVal = 35,
}

-- ============ РОЛИ (АВТООБНОВЛЕНИЕ) ============
local roles = {}
local function updateRoles()
    local getData = RS:FindFirstChild("GetPlayerData", true)
    if getData and getData:IsA("RemoteFunction") then
        local success, data = pcall(function() return getData:InvokeServer() end)
        if success and type(data) == "table" then roles = data end
    end
end
task.spawn(function() while task.wait(2) do updateRoles() end end)

local function getRole(plr)
    local roleData = roles[plr.Name]
    if roleData then return roleData.Role or roleData[1] end
    return "Innocent"
end

-- ============ ESP ============
local espCache = {}
RunService.RenderStepped:Connect(function()
    if not CFG.ESP then
        for _, hl in pairs(espCache) do pcall(function() hl:Destroy() end) end
        table.clear(espCache)
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local char = plr.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local hl = espCache[plr]
                if not hl or hl.Parent ~= char then
                    if hl then hl:Destroy() end
                    hl = Instance.new("Highlight")
                    hl.FillTransparency = 0.6
                    hl.OutlineTransparency = 0
                    hl.Parent = char
                    espCache[plr] = hl
                end
                local role = getRole(plr)
                if role == "Murderer" then
                    hl.FillColor = Color3.fromRGB(255, 50, 50)
                    hl.OutlineColor = Color3.fromRGB(255, 50, 50)
                elseif role == "Sheriff" then
                    hl.FillColor = Color3.fromRGB(50, 150, 255)
                    hl.OutlineColor = Color3.fromRGB(50, 150, 255)
                else
                    hl.FillColor = Color3.fromRGB(50, 255, 50)
                    hl.OutlineColor = Color3.fromRGB(50, 255, 50)
                end
            end
        end
    end
end)

-- ============ SILENT AIM & AIMBOT (СТАБИЛЬНЫЙ) ============
local FOVCircle = Instance.new("ScreenGui")
FOVCircle.Name = "LiberiumFOV"; FOVCircle.ResetOnSpawn = false
pcall(function() FOVCircle.Parent = game:GetService("CoreGui") end)
if not FOVCircle.Parent then FOVCircle.Parent = LP:WaitForChild("PlayerGui") end

local circle = Instance.new("Frame")
circle.Size = UDim2.new(0, CFG.FOV * 2, 0, CFG.FOV * 2)
circle.AnchorPoint = Vector2.new(0.5, 0.5); circle.Position = UDim2.new(0.5, 0, 0.5, 0)
circle.BackgroundTransparency = 1; circle.Visible = false; circle.Parent = FOVCircle
local stroke = Instance.new("UIStroke"); stroke.Color = Color3.fromRGB(150, 50, 255); stroke.Thickness = 1.5; stroke.Parent = circle
local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(1, 0); corner.Parent = circle

local function getClosestInFOV()
    local closest = nil
    local shortestDist = CFG.FOV
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local targetPart = plr.Character:FindFirstChild(CFG.AimPart)
            if hum and hum.Health > 0 and targetPart then
                local screenPos, onScreen = Cam:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local center = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if dist < shortestDist then shortestDist = dist; closest = targetPart end
                end
            end
        end
    end
    return closest
end

-- Хук для Silent Aim (Namecall - стабильнее)
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if CFG.SilentAim and (method == "HitKnife" or method == "ShootGun" or method == "FireGun") then
        local target = getClosestInFOV()
        if target then
            return oldNamecall(self, target, ...)
        end
    end
    return oldNamecall(self, ...)
end)
setreadonly(mt, true)

local aimTarget = nil
UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if CFG.Aimbot and (input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.Touch) then
        aimTarget = getClosestInFOV()
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.Touch then aimTarget = nil end
end)
RunService.RenderStepped:Connect(function()
    if aimTarget and aimTarget.Parent then
        Cam.CFrame = Cam.CFrame:Lerp(CFrame.new(Cam.CFrame.Position, aimTarget.Position), 0.25)
    end
end)

-- ============ AUTO FARM (ИСПРАВЛЕННЫЙ) ============
task.spawn(function()
    while task.wait(0.5) do
        if CFG.AutoFarm and LP.Character then
            local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local main = LP.PlayerGui:FindFirstChild("MainGUI")
                local bags = main and main:FindFirstChild("Game") and main.Game:FindFirstChild("CoinBags")
                if bags then
                    for _, bag in ipairs(bags:GetChildren()) do
                        if bag:IsA("BasePart") then
                            hrp.CFrame = CFrame.new(bag.Position + Vector3.new(0, 3, 0))
                            task.wait(0.1)
                            break
                        end
                    end
                end
            end
        end
    end
end)

-- ============ MOVEMENT ============
local noclipConn
local function setNoclip(on)
    if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
    if not on then return end
    noclipConn = RunService.Stepped:Connect(function()
        local char = LP.Character
        if char then for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end end
    end)
end

RunService.Heartbeat:Connect(function()
    if CFG.Speed then
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = CFG.SpeedVal end
    end
end)

-- ============ UI (УЛУЧШЕННЫЙ) ============
local UI = {}
local C = {
    bg = Color3.fromRGB(12, 12, 15), panel = Color3.fromRGB(20, 20, 25),
    accent = Color3.fromRGB(150, 50, 255), text = Color3.fromRGB(255, 255, 255), muted = Color3.fromRGB(130, 130, 140),
}

local function create(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props) do obj[k] = v end
    obj.Parent = parent
    return obj
end

function UI:Build()
    local ScreenGui = create("ScreenGui", {Name = "LiberiumHub_Premium", ResetOnSpawn = false, DisplayOrder = 999, Parent = LP:WaitForChild("PlayerGui")})
    
    local IconBtn = create("TextButton", {
        Size = UDim2.new(0, 50, 0, 50), Position = UDim2.new(0, 100, 0, 100),
        BackgroundColor3 = C.accent, Text = "L", TextColor3 = C.text,
        Font = Enum.Font.GothamBlack, TextSize = 24, BorderSizePixel = 0, ZIndex = 10, Parent = ScreenGui
    })
    create("UICorner", {CornerRadius = UDim.new(1, 0)}, IconBtn)

    local Main = create("Frame", {
        Size = UDim2.new(0, 620, 0, 420), Position = UDim2.new(0.5, -310, 0.5, -210),
        BackgroundColor3 = C.bg, BorderSizePixel = 0, Visible = false, ZIndex = 5, Parent = ScreenGui
    })
    create("UICorner", {CornerRadius = UDim.new(0, 14)}, Main)
    create("UIStroke", {Color = C.panel, Thickness = 1.5}, Main)

    local scale = create("UIScale", {Parent = Main})
    local function updateScale()
        local v = Cam.ViewportSize
        scale.Scale = math.min(1, v.X / 650, v.Y / 450)
    end
    updateScale()
    Cam:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)

    -- Сайдбар
    local Sidebar = create("Frame", {Size = UDim2.new(0, 170, 1, 0), BackgroundColor3 = C.panel, BorderSizePixel = 0, Parent = Main})
    create("UICorner", {CornerRadius = UDim.new(0, 14)}, Sidebar)
    create("TextLabel", {Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1, Text = "LIBERIUM", TextColor3 = C.accent, Font = Enum.Font.GothamBlack, TextSize = 20, Parent = Sidebar})

    local TabHolder = create("Frame", {Size = UDim2.new(1, -20, 1, -80), Position = UDim2.new(0, 10, 0, 60), BackgroundTransparency = 1, Parent = Sidebar})
    create("UIListLayout", {Padding = UDim.new(0, 6)}, TabHolder)

    local Content = create("Frame", {Size = UDim2.new(1, -190, 1, -40), Position = UDim2.new(0, 180, 0, 20), BackgroundTransparency = 1, Parent = Main})
    local Pages = {}
    local currentPage = nil

    local function CreateTab(name, title)
        local btn = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = C.panel, BackgroundTransparency = 1,
            Text = "  " .. title, TextColor3 = C.muted, Font = Enum.Font.GothamBold, TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false, BorderSizePixel = 0, Parent = TabHolder
        })
        create("UICorner", {CornerRadius = UDim.new(0, 8)}, btn)

        local page = create("ScrollingFrame", {
            Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
            ScrollBarThickness = 0, CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false, Parent = Content
        })
        create("UIListLayout", {Padding = UDim.new(0, 8)}, page)
        Pages[name] = {Btn = btn, Page = page}

        btn.MouseButton1Click:Connect(function()
            for _, p in pairs(Pages) do
                p.Page.Visible = false
                TweenService:Create(p.Btn, TweenInfo.new(0.2), {TextColor3 = C.muted, BackgroundTransparency = 1}):Play()
            end
            page.Visible = true
            btn.TextColor3 = C.text
            btn.BackgroundTransparency = 0.8
            currentPage = name
        end)

        if not currentPage then
            currentPage = name
            page.Visible = true
            btn.TextColor3 = C.text
            btn.BackgroundTransparency = 0.8
        end
    end

    local function CreateToggle(parent, text, default, callback)
        local btn = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 45), BackgroundColor3 = C.panel,
            Text = "  " .. text, TextColor3 = C.text, Font = Enum.Font.Gotham,
            TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false, BorderSizePixel = 0, Parent = parent
        })
        create("UICorner", {CornerRadius = UDim.new(0, 8)}, btn)
        local isOn = default
        local ind = create("Frame", {Size = UDim2.new(0, 40, 0, 20), Position = UDim2.new(1, -50, 0.5, -10), BackgroundColor3 = isOn and C.accent or C.bg, Parent = btn})
        create("UICorner", {CornerRadius = UDim.new(1, 0)}, ind)
        local circle = create("Frame", {Size = UDim2.new(0, 16, 0, 16), Position = isOn and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8), BackgroundColor3 = Color3.new(1,1,1), Parent = ind})
        create("UICorner", {CornerRadius = UDim.new(1, 0)}, circle)

        btn.MouseButton1Click:Connect(function()
            isOn = not isOn
            TweenService:Create(ind, TweenInfo.new(0.2), {BackgroundColor3 = isOn and C.accent or C.bg}):Play()
            TweenService:Create(circle, TweenInfo.new(0.2), {Position = isOn and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)}):Play()
            callback(isOn)
        end)
    end

    CreateTab("Combat", "⚔ Combat")
    CreateTab("Visuals", "👁 Visuals")
    CreateTab("Farm", "🌾 Farm")
    CreateTab("Movement", "🏃 Movement")

    CreateToggle(Pages["Combat"].Page, "Silent Aim", CFG.SilentAim, function(v) CFG.SilentAim = v end)
    CreateToggle(Pages["Combat"].Page, "Aimbot (FOV Circle)", CFG.Aimbot, function(v) CFG.Aimbot = v; circle.Visible = v end)

    CreateToggle(Pages["Visuals"].Page, "Player ESP (Roles)", CFG.ESP, function(v) CFG.ESP = v end)

    CreateToggle(Pages["Farm"].Page, "Auto Farm Coins", CFG.AutoFarm, function(v) CFG.AutoFarm = v end)

    CreateToggle(Pages["Movement"].Page, "Noclip", CFG.Noclip, function(v) CFG.Noclip = v; setNoclip(v) end)
    CreateToggle(Pages["Movement"].Page, "Speed Hack", CFG.Speed, function(v) CFG.Speed = v end)

    -- Перетаскивание окна
    local draggingMain = false
    local dragStartMain = nil
    local startPosMain = nil
    local function isInsideHeader(pos)
        local absPos = Main.AbsolutePosition
        local absSize = Main.AbsoluteSize
        return pos.X >= absPos.X and pos.X <= absPos.X + absSize.X and pos.Y >= absPos.Y and pos.Y <= absPos.Y + 50
    end
    UIS.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if Main.Visible and isInsideHeader(input.Position) then
                draggingMain = true; dragStartMain = input.Position; startPosMain = Main.Position
            end
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if draggingMain and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStartMain
            Main.Position = UDim2.new(startPosMain.X.Scale, startPosMain.X.Offset + delta.X, startPosMain.Y.Scale, startPosMain.Y.Offset + delta.Y)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingMain = false end
    end)

    IconBtn.MouseButton1Click:Connect(function()
        Main.Visible = not Main.Visible
    end)
end

UI:Build()
print("[LiberiumHub] Premium v3.0 Loaded!")

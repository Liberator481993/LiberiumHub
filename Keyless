-- Функция создания вкладки
local function CreateTab(name, layoutOrder)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    btn.BackgroundTransparency = 0.5
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(150, 150, 150)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 14
    btn.LayoutOrder = layoutOrder
    btn.AutoButtonColor = false
    btn.Parent = TabHolder
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 6); c.Parent = btn
    
    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, -130, 1, -20)
    page.Position = UDim2.new(0, 125, 0, 10)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 2
    page.ScrollBarImageColor3 = Color3.fromRGB(0, 255, 102)
    page.Visible = false
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Parent = MenuFrame
    Instance.new("UIListLayout", page).Padding = UDim.new(0, 8)
    
    Pages[name] = { Button = btn, Page = page }
    
    btn.MouseButton1Click:Connect(function()
        for _, p in pairs(Pages) do
            p.Page.Visible = false
            TweenService:Create(p.Button, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(150, 150, 150), BackgroundTransparency = 0.5}):Play()
        end
        page.Visible = true
        btn.TextColor3 = Color3.fromRGB(0, 255, 102)
        btn.BackgroundTransparency = 0
        ActiveTab = name
    end)
    
    if not ActiveTab then
        ActiveTab = name
        page.Visible = true
        btn.TextColor3 = Color3.fromRGB(0, 255, 102)
        btn.BackgroundTransparency = 0
    end
end


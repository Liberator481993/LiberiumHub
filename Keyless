-- Combat
local secCombat = TabCombat:CreateSection({ Name = "Murderer / Sheriff" })
secCombat:Toggle({
    Name = "Silent Aim",
    Default = false,
    Callback = function(v) CFG.SilentAim = v end
})
secCombat:Toggle({
    Name = "Aimbot",
    Default = false,
    Callback = function(v) CFG.Aimbot = v end
})
secCombat:Toggle({
    Name = "Auto Shoot",
    Default = false,
    Callback = function(v) 
        CFG.AutoShoot = v 
        if v then
            task.spawn(function()
                while CFG.AutoShoot do
                    local tool = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
                    if tool and tool.Name == "Gun" then
                        local mouse = LP:GetMouse()
                        if mouse.Target and mouse.Target.Parent then
                            local targetHum = mouse.Target.Parent:FindFirstChildOfClass("Humanoid")
                            if targetHum and targetHum.Health > 0 and targetHum.Parent ~= LP.Character then
                                tool:Activate()
                            end
                        end
                    end
                    task.wait(0.1)
                end
            end)
        end
    end
})
secCombat:Button({
    Name = "🔫 Shot Murderer (Kill All)",
    Callback = function()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP then
                local char = plr.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then pcall(function() hum.Health = 0 end) end
            end
        end
    end
})


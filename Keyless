secCfg:AddButton("Save Settings", function() 
    local ok = Config:Save(CFG, "settings")
    if ok then NotificationManager.Notify("Config saved!", "Success", 3) else NotificationManager.Notify("Saved to memory only", "Info", 3) end
end)
secCfg:AddButton("Load Settings", function()
    local loaded = Config:Load("settings")
    if loaded then
        for k, v in pairs(loaded) do if CFG[k] ~= nil then CFG[k] = v end end
        if loaded.AutoFarm ~= nil then farmToggle:Set(loaded.AutoFarm, true) end
        if loaded.MaxSpeed ~= nil then speedSlider:Set(loaded.MaxSpeed, true) end
        if loaded.ESP ~= nil then espToggle:Set(loaded.ESP, true) end
        if loaded.AutoFling ~= nil then autoFlingToggle:Set(loaded.AutoFling, true) end
        if loaded.AntiFling ~= nil then antiFlingToggle:Set(loaded.AntiFling, true) end
        if loaded.Prediction ~= nil then predictionToggle:Set(loaded.Prediction, true) end
        if loaded.ProjSpeed ~= nil then projSpeedSlider:Set(loaded.ProjSpeed, true) end
        if loaded.OptimizeFPS ~= nil then optToggle:Set(loaded.OptimizeFPS, true) VisualOptimizer.OptimizeVisuals(loaded.OptimizeFPS) end
        if loaded.ShowStats ~= nil then statsToggle:Set(loaded.ShowStats, true) if statsObj then statsObj:SetVisible(loaded.ShowStats) end end
        
        if CFG.ESP then roleHUD:Start() overheadTracker:Start() else roleHUD:Stop() overheadTracker:Stop() end
        if CFG.AntiFling then Stabilizer.Start() else Stabilizer.Stop() end
        NotificationManager.Notify("Config loaded!", "Success", 3)
    end
end)


local StatusText = Instance.new("TextLabel")
StatusText.Size = UDim2.new(0, 350, 0, 30)
StatusText.AnchorPoint = Vector2.new(0.5, 0.5)
StatusText.Position = UDim2.new(0.5, 0, 0.4, 40)
StatusText.BackgroundTransparency = 0.5
StatusText.BackgroundColor3 = Color3.fromRGB(0,0,0)
StatusText.TextColor3 = Color3.fromRGB(0, 255, 0)
StatusText.Font = Enum.Font.Code
StatusText.TextSize = 14
StatusText.Text = "Ожидание..."
StatusText.Parent = ScreenGui

local function getContainer()
    return Workspace:FindFirstChild("CoinContainer", true)
end

local function findNearest()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local container = getContainer()
    if not container then return nil end
    
    local closest, minDist = nil, math.huge
    for _, coin in ipairs(container:GetChildren()) do
        -- Проверяем, что монета существует, это BasePart, не в черном списке и она видима (не собрана)
        if coin.Name == "Coin_Server" and coin:IsA("BasePart") and not blacklist[coin] and coin.Transparency < 1 then
            local dist = (coin.Position - hrp.Position).Magnitude
            if dist < minDist then
                minDist = dist
                closest = coin
            end
        end
    end
    return closest
end

-- Основной цикл сбора
task.spawn(function()
    while task.wait(0.03) do -- Очень быстро (30 раз в секунду)
        if isFarming then
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            if not hrp or not hum or hum.Health <= 0 then
                StatusText.Text = "Мертв..."
                continue
            end

            -- Если мы в полете (сбрасываем цель)
            if currentTarget and not currentTarget.Parent then
                currentTarget = nil
            end

            if not currentTarget then
                currentTarget = findNearest()
            end

            if currentTarget then
                StatusText.Text = "Телепорт к монете!"
                
                -- 1. Мгновенно телепортируемся
                local targetPos = currentTarget.Position + Vector3.new(0, 2.5, 0)
                hrp.CFrame = CFrame.new(targetPos)
                
                -- 2. Активируем сбор
                pcall(function()
                    firetouchinterest(hrp, currentTarget, 0)
                    firetouchinterest(hrp, currentTarget, 1)
                end)
                for _, prompt in ipairs(currentTarget:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        pcall(function() fireproximityprompt(prompt) end)
                    end
                end
                
                -- 3. Сразу заносим в черный список и сбрасываем цель
                blacklist[currentTarget] = true
                currentTarget = nil
            else
                StatusText.Text = "Все собрано (ждем)"
            end
        end
    end
end)

-- Управление кнопкой
Btn.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        Btn.Text = "FARM: ON"
        Btn.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
    else
        Btn.Text = "FARM: OFF"
        Btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        StatusText.Text = "Ожидание..."
    end
end)

-- Очистка черного списка, чтобы не забивать память
task.spawn(function()
    while task.wait(5) do
        for coin in pairs(blacklist) do
            if not coin.Parent then blacklist[coin] = nil end
        end
    end
end)

local function FlingMurderer()
    local s = currentSession
    if not s or s.destroyed or s.humanoid.Health <= 0 then return end
    
    local myRoot = s.root
    local mRoot = getClosestMurderer(myRoot.Position)
    if not mRoot then return end

    -- 1. Запоминаем нашу позицию и ставим на анкор
    local oldCFrame = myRoot.CFrame
    local oldAnchored = myRoot.Anchored
    myRoot.Anchored = true -- ФИКС: Теперь физика нас не выкинет за карту

    pcall(function()
        if setnetworkowner then pcall(setnetworkowner, mRoot, player) end
        
        -- 2. Телепортируемся к маньяку и флингаем его
        myRoot.CFrame = mRoot.CFrame
        
        local spin = Instance.new("BodyAngularVelocity")
        spin.AngularVelocity = Vector3.new(1e5, 1e5, 1e5)
        spin.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        spin.Parent = mRoot
        
        local push = Instance.new("BodyVelocity")
        push.Velocity = Vector3.new(1e5, 1e5, 1e5)
        push.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        push.Parent = mRoot
        
        task.wait(0.1)
        
        spin:Destroy()
        push:Destroy()
    end)
    
    -- 3. Возвращаемся на исходную и снимаем анкор
    myRoot.CFrame = oldCFrame
    myRoot.Anchored = oldAnchored
    
    -- Останавливаем наши силы
    if s.bv then s.bv.Velocity = Vector3.zero s.bv.MaxForce = Vector3.zero end
    if s.bg then s.bg.MaxTorque = Vector3.zero s.bg.CFrame = oldCFrame end
end


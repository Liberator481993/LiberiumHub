local originalCollide = setmetatable({}, { __mode = "k" })
RunService.Stepped:Connect(function()
    if (CFG.Noclip or CFG.AutoFarm) and player.Character then
        for _, d in ipairs(player.Character:GetDescendants()) do
            if d:IsA("BasePart") then
                if originalCollide[d] == nil then originalCollide[d] = d.CanCollide end
                d.CanCollide = false
            end
        end
    elseif not CFG.Noclip and not CFG.AutoFarm then
        for p, c in pairs(originalCollide) do pcall(function() if p and p.Parent then p.CanCollide = c end end) end
        table.clear(originalCollide)
    end
end)


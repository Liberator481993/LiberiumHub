local function getContainer()
    return Workspace:FindFirstChild("CoinContainer", true)
end

local function findNearest()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local container = getContainer()
    if not container then return nil end
    
    local closest, minDist = nil, math.huge
    for _, coin in ipairs(container:GetChildren()) do
        if coin.Name == "Coin_Server" and coin:IsA("BasePart") and not blacklist[coin] then
            local dist = (coin.Position - hrp.Position).Magnitude
            if dist < minDist then
                minDist = dist
                closest = coin
            end
        end
    end
    return closest
end

local function collect(coin)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    blacklist[coin] = true
    pcall(function()
        firetouchinterest(hrp, coin, 0)
        firetouchinterest(hrp, coin, 1)
    end)
    for _, prompt in ipairs(coin:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            pcall(function() fireproximityprompt(prompt) end)
        end
    end
end

-- Главный цикл физики (Плавный полет)
RunService.Heartbeat:Connect(function()
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    
    if isFarming then
        -- Отключаем стандартную физику персонажа, чтобы он не сопротивлялся
        if not hum.PlatformStand then hum.PlatformStand = true end
        
        -- Создаем физические силы (один раз)
        if not bv or bv.Parent ~= hrp then
            bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.P = 1250
            bv.Parent = hrp
            bg = Instance.new("BodyGyro")
            bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bg.P = 1000
            bg.Parent = hrp
        end
        
        -- Если цель потеряна (ее собрали), сбрасываем
        if currentTarget and not currentTarget.Parent then
            currentTarget = nil
        end
        
        -- Ищем новую, если нет цели
        if not currentTarget then
            currentTarget = findNearest()
            if currentTarget then
                StatusText.Text = "Цель найдена!"
            else
                StatusText.Text = "Нет монет..."
            end
        end
        
        -- Летим к цели
        if currentTarget then
            local targetPos = currentTarget.Position
            local distance = (hrp.Position - targetPos).Magnitude
            
            -- Если подлетели близко (на 3.5 стада), собираем
            if distance < 3.5 then
                collect(currentTarget)
                currentTarget = nil
                bv.Velocity = Vector3.zero
                task.wait(0.1) -- Пауза, чтобы сервер удалил монету
            else
                -- Летим
                local dir = (targetPos - hrp.Position).Unit
                bv.Velocity = dir * 90 -- Скорость полета (90 стадов в секунду)
                bg.CFrame = CFrame.new(hrp.Position, targetPos)
            end
        else
            bv.Velocity = Vector3.zero -- Висим на месте, если нет цели
        end
    else
        -- Если выключено, убиваем физику и возвращаем управление
        if bv then bv:Destroy(); bv = nil end
        if bg then bg:Destroy(); bg = nil end
        if hum.PlatformStand then hum.PlatformStand = false end
    end
end)

-- Очистка черного списка
task.spawn(function()
    while task.wait(5) do
        for coin in pairs(blacklist) do
            if not coin.Parent then blacklist[coin] = nil end
        end
    end
end)


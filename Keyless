local coinTracker = (function()
    local API = {} local coins = {}
    local function isCoin(inst) return inst.Name:match("^Coin") and (inst:IsA("BasePart") or inst:IsA("Model")) end
    local conn1 = Workspace.DescendantAdded:Connect(function(inst) if isCoin(inst) then table.insert(coins, inst) end end)
    local conn2 = Workspace.DescendantRemoving:Connect(function(inst) local idx = table.find(coins, inst) if idx then table.remove(coins, idx) end end)
    for _, inst in ipairs(Workspace:GetDescendants()) do if isCoin(inst) then table.insert(coins, inst) end end
    function API:GetClosest(origin, maxDist) local best, bestSq = nil, maxDist and maxDist^2 or math.huge for i = #coins, 1, -1 do local obj = coins[i] if obj and obj.Parent then local p = obj:IsA("BasePart") and obj.Position or obj:GetPivot().Position local sq = (p - origin).Magnitude^2 if sq < bestSq then bestSq = sq best = obj end else table.remove(coins, i) end end return best, bestSq and math.sqrt(bestSq) end
    function API:Destroy() conn1:Disconnect() conn2:Disconnect() end
    return API
end)()

local function glideTo(target, speed)
    local s = currentSession 
    if not s or s.destroyed or not s.root or not s.root.Parent or not s.humanoid or s.humanoid.Health <= 0 or not target.Parent then return false end
    local char = s.character local root = s.root local hum = s.humanoid
    local targetPos = target:IsA("BasePart") and target.Position or target:GetPivot().Position
    local origAnchored = root.Anchored local origCanCollide = root.CanCollide
    root.Anchored = true root.CanCollide = false
    local parts = {} for _, d in ipairs(char:GetDescendants()) do if d:IsA("BasePart") then d.CanCollide = false parts[#parts+1] = d end end
    local arrived = false local startTime = tick()
    while isRunning do
        RunService.Heartbeat:Wait()
        if s.destroyed or hum.Health <= 0 then break end
        local currentPos = root.Position local offset = targetPos - currentPos local dist = offset.Magnitude
        if dist <= 3 then arrived = true break end
        if tick() - startTime > 6 then break end
        local step = math.min(speed * 0.05, dist)
        root.CFrame = CFrame.new(currentPos + offset.Unit * step)
    end
    root.Anchored = origAnchored root.CanCollide = origCanCollide
    for _, p in ipairs(parts) do if p and p.Parent then p.CanCollide = true end end
    if arrived then pcall(function() if target and target.Parent and typeof(firetouchinterest) == "function" then local targetPart = target:IsA("BasePart") and target or (target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")) if targetPart then firetouchinterest(root, targetPart, 0) firetouchinterest(targetPart, root, 0) task.wait(0.05) firetouchinterest(root, targetPart, 1) firetouchinterest(targetPart, root, 1) end end end) end
    return arrived
end


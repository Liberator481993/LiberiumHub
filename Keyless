local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local LP = Players.LocalPlayer
local isFarming = false
local blacklist = {}
local currentTarget = nil

-- Скорость (в стадах в секунду). Ставим очень маленькую для теста.
local speed = 5

-- ... (часть с GUI и поиском цели остается как в прошлом коде) ...

-- Основной цикл (Плавное движение через CFrame)
RunService.Heartbeat:Connect(function(dt)
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if isFarming then
        -- Noclip (сквозь стены)
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        if not hum.PlatformStand then hum.PlatformStand = true end

        if currentTarget and not currentTarget.Parent then
            currentTarget = nil
        end

        if not currentTarget then
            currentTarget = findNearest()
        end

        if currentTarget then
            local targetPos = currentTarget.Position
            local distance = (hrp.Position - targetPos).Magnitude

            if distance < 3.5 then
                -- Долетели, собираем
                blacklist[currentTarget] = true
                pcall(function()
                    firetouchinterest(hrp, currentTarget, 0)
                    firetouchinterest(hrp, currentTarget, 1)
                end)
                for _, prompt in ipairs(currentTarget:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        pcall(function() fireproximityprompt(prompt) end)
                    end
                end
                currentTarget = nil
                task.wait(0.1)
            else
                -- Плавно двигаемся к цели (шаг за шагом)
                local dir = (targetPos - hrp.Position).Unit
                local moveStep = speed * dt -- Скорость * время кадра
                if moveStep > distance then moveStep = distance end
                hrp.CFrame = CFrame.new(hrp.Position + dir * moveStep)
            end
        else
            StatusText.Text = "Нет монет (ждем)"
        end
    else
        -- Выключено
        if hum.PlatformStand then hum.PlatformStand = false end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end
end)

    SideLayout.VerticalAlignment = Enum.VerticalAlignment.Top
    
    local SidePadding = Instance.new("UIPadding", Sidebar)
    SidePadding.PaddingTop = UDim.new(0, 10)

    -- Content
    local Content = Instance.new("ScrollingFrame", Main)
    Content.Size = UDim2.new(1, -190, 1, -60)
    Content.Position = UDim2.new(0, 180, 0, 50)
    Content.BackgroundTransparency = 1
    Content.BorderSizePixel = 0
    Content.ScrollBarThickness = 0
    
    local ContentLayout = Instance.new("UIListLayout", Content)
    ContentLayout.Padding = UDim.new(0, 10)

    local Tabs = {}
    
    local UI = {}

    function UI:CreateTab(tabInfo)
        local btn = Instance.new("TextButton", Sidebar)
        btn.Size = UDim2.new(1, -10, 0, 36)
        btn.BackgroundColor3 = Colors.Sidebar
        btn.Text = "  " .. tabInfo.Name
        btn.TextColor3 = Colors.Dim
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 14
        btn.BorderSizePixel = 0
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

        local page = Instance.new("Frame", Content)
        page.Size = UDim2.new(1, -10, 0, 0)
        page.AutomaticSize = Enum.AutomaticSize.Y
        page.BackgroundTransparency = 1
        page.Visible = false
        
        local pageLayout = Instance.new("UIListLayout", page)
        pageLayout.Padding = UDim.new(0, 10)

        local tab = { btn = btn, page = page }

        btn.MouseButton1Click:Connect(function()
            for _, t in ipairs(Tabs) do
                t.page.Visible = false
                t.btn.BackgroundColor3 = Colors.Sidebar
                t.btn.TextColor3 = Colors.Dim
            end
            page.Visible = true
            btn.BackgroundColor3 = Colors.Element
            btn.TextColor3 = Colors.Text
        end)

        table.insert(Tabs, tab)
        if #Tabs == 1 then
            page.Visible = true
            btn.BackgroundColor3 = Colors.Element
            btn.TextColor3 = Colors.Text
        end

        function tab:CreateSection(secInfo)
            local secFrame = Instance.new("Frame", page)
            secFrame.Size = UDim2.new(1, 0, 0, 0)
            secFrame.AutomaticSize = Enum.AutomaticSize.Y
            secFrame.BackgroundColor3 = Colors.Section
            secFrame.BorderSizePixel = 0
            Instance.new("UICorner", secFrame).CornerRadius = UDim.new(0, 8)
            
            local pad = Instance.new("UIPadding", secFrame)
            pad.PaddingTop = UDim.new(0, 10)
            pad.PaddingBottom = UDim.new(0, 10)
            
            local layout = Instance.new("UIListLayout", secFrame)
            layout.Padding = UDim.new(0, 5)
            layout.SortOrder = Enum.SortOrder.LayoutOrder
            
            local title = Instance.new("TextLabel", secFrame)
            title.Size = UDim2.new(1, -20, 0, 20)
            title.Position = UDim2.new(0, 10, 0, 0)
            title.BackgroundTransparency = 1
            title.Text = secInfo.Name
            title.TextColor3 = Colors.Dim
            title.TextSize = 12
            title.Font = Enum.Font.GothamBold
            title.TextXAlignment = Enum.TextXAlignment.Left

            local sec = {}

            function sec:CreateToggle(opt)
                local row = Instance.new("Frame", secFrame)
                row.Size = UDim2.new(1, -20, 0, 34)
                row.BackgroundColor3 = Colors.Element
                row.BorderSizePixel = 0
                Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

                local txt = Instance.new("TextLabel", row)
                txt.Size = UDim2.new(1, -60, 1, 0)
                txt.Position = UDim2.new(0, 10, 0, 0)
                txt.BackgroundTransparency = 1
                txt.Text = opt.Name
                txt.TextColor3 = Colors.Text
                txt.TextSize = 13
                txt.Font = Enum.Font.Gotham
                txt.TextXAlignment = Enum.TextXAlignment.Left

                local state = opt.Default or false
                local track = Instance.new("Frame", row)
                track.Size = UDim2.new(0, 36, 0, 18)
                track.Position = UDim2.new(1, -46, 0.5, -9)
                track.BackgroundColor3 = state and Colors.Accent or Colors.Off
                track.BorderSizePixel = 0
                Instance.new("UICorner", track).CornerRadius = UDim.new(0, 9)

                local thumb = Instance.new("Frame", track)
                thumb.Size = UDim2.new(0, 14, 0, 14)
                thumb.Position = UDim2.new(0, state and 20 or 2, 0, 2)
                thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                thumb.BorderSizePixel = 0
                Instance.new("UICorner", thumb).CornerRadius = UDim.new(0, 7)

                local click = Instance.new("TextButton", row)
                click.Size = UDim2.new(1, 0, 1, 0)
                click.BackgroundTransparency = 1
                click.Text = ""
                
                click.MouseButton1Click:Connect(function()
                    state = not state
                    track.BackgroundColor3 = state and Colors.Accent or Colors.Off
                    TweenService:Create(thumb, TweenInfo.new(0.15), {Position = UDim2.new(0, state and 20 or 2, 0, 2)}):Play()
                    pcall(opt.Callback, state)
                end)
            end

            function sec:CreateSlider(opt)
                local row = Instance.new("Frame", secFrame)
                row.Size = UDim2.new(1, -20, 0, 46)
                row.BackgroundColor3 = Colors.Element
                row.BorderSizePixel = 0
                Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

                local mn, mx = opt.Min or 0, opt.Max or 100
                local cur = opt.Default or mn

                local txt = Instance.new("TextLabel", row)
                txt.Size = UDim2.new(1, -20, 0, 20)
                txt.Position = UDim2.new(0, 10, 0, 4)
                txt.BackgroundTransparency = 1
                txt.Text = opt.Name .. "  [" .. cur .. "]"
                txt.TextColor3 = Colors.Text
                txt.TextSize = 13
                txt.Font = Enum.Font.Gotham
                txt.TextXAlignment = Enum.TextXAlignment.Left

                local track = Instance.new("Frame", row)
                track.Size = UDim2.new(1, -20, 0, 4)
                track.Position = UDim2.new(0, 10, 1, -12)
                track.BackgroundColor3 = Colors.Off
                track.BorderSizePixel = 0
                Instance.new("UICorner", track).CornerRadius = UDim.new(0, 2)

                local fill = Instance.new("Frame", track)
                fill.Size = UDim2.new((cur - mn) / (mx - mn), 0, 1, 0)
                fill.BackgroundColor3 = Colors.Accent
                fill.BorderSizePixel = 0
                Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 2)

                local click = Instance.new("TextButton", row)
                click.Size = UDim2.new(1, 0, 1, 0)
                click.BackgroundTransparency = 1
                click.Text = ""

                local dragging = false
                local function update(x)
                    local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
                    cur = math.floor(mn + rel * (mx - mn) + 0.5)
                    fill.Size = UDim2.new(rel, 0, 1, 0)
                    txt.Text = opt.Name .. "  [" .. cur .. "]"
                    pcall(opt.Callback, cur)
                end

                click.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        update(input.Position.X)
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        update(input.Position.X)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)
            end

            return sec
        end
        return tab
    end
    return UI
end


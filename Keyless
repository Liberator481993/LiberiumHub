local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local LP = Players.LocalPlayer
local isFarming = false

-- Удаляем старое окно, если оно было
local oldGui = LP.PlayerGui:FindFirstChild("FarmTestGui")
if oldGui then oldGui:Destroy() end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FarmTestGui"
ScreenGui.Parent = LP:WaitForChild("PlayerGui")

-- Кнопка строго по центру
local Btn = Instance.new("TextButton")
Btn.Size = UDim2.new(0, 150, 0, 50)
Btn.AnchorPoint = Vector2.new(0.5, 0.5)
Btn.Position = UDim2.new(0.5, 0, 0.4, 0) -- 0.5 = центр экрана
Btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
Btn.Font = Enum.Font.GothamBold
Btn.TextSize = 18
Btn.Text = "FARM: OFF"
Btn.Parent = ScreenGui

-- Текст статуса (под кнопкой)
local StatusText = Instance.new("TextLabel")
StatusText.Size = UDim2.new(0, 300, 0, 40)
StatusText.AnchorPoint = Vector2.new(0.5, 0.5)
StatusText.Position = UDim2.new(0.5, 0, 0.4, 60)
StatusText.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
StatusText.BackgroundTransparency = 0.4
StatusText.TextColor3 = Color3.fromRGB(0, 255, 0)
StatusText.Font = Enum.Font.Code
StatusText.TextSize = 16
StatusText.Text = "Ожидание..."
StatusText.Parent = ScreenGui

local coinContainer = nil

local function getContainer()
    if coinContainer and coinContainer.Parent then return coinContainer end
    local cc = Workspace:FindFirstChild("CoinContainer", true)
    if cc then
        coinContainer = cc
        return cc
    end
    return nil
end

local function teleportAndGrab(coin)
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    -- Проверка, что мы живы и можем двигаться
    if not hrp or not hum or hum.Health <= 0 then return end

    -- Мгновенный телепорт через PivotTo (не ломает физику)
    char:PivotTo(CFrame.new(coin.Position + Vector3.new(0, 1.5, 0)))
    
    -- Сбор
    pcall(function()
        firetouchinterest(hrp, coin, 0)
        firetouchinterest(hrp, coin, 1)
    end)
    
    for _, prompt in ipairs(coin:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            pcall(function() fireproximityprompt(prompt) end)
        end
    end
end

-- Главный цикл (теперь без задержек)
task.spawn(function()
    while task.wait(0.05) do
        if isFarming then
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            -- Если мертвы - не фармим
            if not hrp or not hum or hum.Health <= 0 then
                StatusText.Text = "Вы мертвы, ожидание респавна..."
                continue
            end

            local container = getContainer()
            if container then
                local closest, minDist = nil, math.huge
                for _, coin in ipairs(container:GetChildren()) do
                    if coin.Name == "Coin_Server" and coin:IsA("BasePart") then
                        local dist = (coin.Position - hrp.Position).Magnitude
                        if dist < minDist then
                            minDist = dist
                            closest = coin
                        end
                    end
                end

                if closest then
                    StatusText.Text = "ТП к монете (Дист: " .. math.floor(minDist) .. ")"
                    teleportAndGrab(closest)
                else
                    StatusText.Text = "Монет нет на карте"
                end
            else
                StatusText.Text = "Папка CoinContainer не найдена!"
            end
        end
    end
end)

Btn.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        Btn.Text = "FARM: ON"
        Btn.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
    else
        Btn.Text = "FARM: OFF"
        Btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        StatusText.Text = "Ожидание..."
    end
end)

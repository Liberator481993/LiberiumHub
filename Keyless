        local textLeft = o.RowHeight - 14 + 16
        local displayLabel = create("TextLabel", {Name = "DisplayName", BackgroundTransparency = 1, Position = UDim2.new(0, textLeft, 0, 7), Size = UDim2.new(1, -(textLeft + 96), 0, 20), Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = THEME_LIST.Text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = "", Parent = frame})
        local userLabel = create("TextLabel", {Name = "Username", BackgroundTransparency = 1, Position = UDim2.new(0, textLeft, 0, 27), Size = UDim2.new(1, -(textLeft + 96), 0, 16), Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = THEME_LIST.SubText, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = "", Parent = frame})
        local button = create("TextButton", {Name = "ActionButton", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(78, 30), BackgroundColor3 = THEME_LIST.Accent, BackgroundTransparency = 0.2, AutoButtonColor = true, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = THEME_LIST.Text, Text = o.ButtonText, Parent = frame}, {corner(6)})
        local row = { Frame = frame, Avatar = avatar, DisplayLabel = displayLabel, UserLabel = userLabel, Button = button, Player = nil, BoundUserId = nil }
        row.Connection = button.Activated:Connect(function() local p = row.Player if p and p.Parent == Players then self._selected = p self._selectedEvent:Fire(p) end end)
        table.insert(self._pool, row) return row
    end

    local function bindRow(row, player, avatarSize)
        if row.BoundUserId ~= player.UserId then row.BoundUserId = player.UserId row.Avatar.Image = avatarUrl(player.UserId, avatarSize) end
        local display, username = player.DisplayName, "@" .. player.Name
        if row.DisplayLabel.Text ~= display then row.DisplayLabel.Text = display end
        if row.UserLabel.Text ~= username then row.UserLabel.Text = username end
        row.Player = player
    end

    function API:_collect()
        local query = string.lower(self._searchBox.Text) local list = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if self._removing[player] then continue end
            if self._options.ExcludeLocalPlayer and player == Players.LocalPlayer then continue end
            if query == "" or string.find(string.lower(player.DisplayName), query, 1, true) or string.find(string.lower(player.Name), query, 1, true) then table.insert(list, player) end
        end
        table.sort(list, function(a, b) local da, db = string.lower(a.DisplayName), string.lower(b.DisplayName) if da == db then return a.UserId < b.UserId end return da < db end)
        return list
    end

    function API:_refresh()
        if self._destroyed then return end
        local list = self:_collect() local pool = self._pool local o = self._options
        for i, player in ipairs(list) do
            local row = pool[i] or self:_createRow()
            bindRow(row, player, o.AvatarSize) row.Frame.LayoutOrder = i
            if not row.Frame.Visible then row.Frame.Visible = true end
        end
        for i = #list + 1, #pool do local row = pool[i] if row.Frame.Visible then row.Frame.Visible = false end row.Player = nil end
        self._count = #list
    end

    function API:_queueRefresh()
        if self._refreshQueued or self._destroyed then return end
        self._refreshQueued = true
        task.defer(function() self._refreshQueued = false self:_refresh() end)
    end

    function API:_track(player)
        if self._playerConns[player] then return end
        self._playerConns[player] = player:GetPropertyChangedSignal("DisplayName"):Connect(function() self:_queueRefresh() end)
    end

    function API:_untrack(player)
        local conn = self._playerConns[player] if conn then conn:Disconnect() self._playerConns[player] = nil end
    end

    function API.new(parent, options)
        local self = setmetatable({}, API)
        local o = table.clone(DEFAULTS) for k, v in pairs(options or {}) do if o[k] ~= nil then o[k] = v end end
        self._options = o self._pool = {} self._connections = {} self._playerConns = {} self._removing = setmetatable({}, {__mode = "k"}) self._selected = nil self._count = 0 self._destroyed = false self._refreshQueued = false
        self._selectedEvent = Instance.new("BindableEvent") self.Selected = self._selectedEvent.Event
        self.Root = create("Frame", {Name = "PlayerList", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = parent})
        self._searchBox = create("TextBox", {Name = "Search", Size = UDim2.new(1, 0, 0, o.SearchHeight), BackgroundColor3 = THEME_LIST.Row, BackgroundTransparency = 0.2, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = THEME_LIST.Text, PlaceholderText = "Search players...", PlaceholderColor3 = THEME_LIST.SubText, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, Text = "", Parent = self.Root}, {corner(8), create("UIPadding", {PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12)})})
        self._scroll = create("ScrollingFrame", {Name = "List", Position = UDim2.fromOffset(0, o.SearchHeight + o.Padding), Size = UDim2.new(1, 0, 1, -(o.SearchHeight + o.Padding)), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = THEME_LIST.Accent, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.Y, Parent = self.Root}, {create("UIListLayout", {Padding = UDim.new(0, o.Padding), SortOrder = Enum.SortOrder.LayoutOrder}), create("UIPadding", {PaddingRight = UDim.new(0, 6)})})
        table.insert(self._connections, self._searchBox:GetPropertyChangedSignal("Text"):Connect(function() self:_queueRefresh() end))
        table.insert(self._connections, Players.PlayerAdded:Connect(function(player) self:_track(player) self:_queueRefresh() end))
        table.insert(self._connections, Players.PlayerRemoving:Connect(function(player) self._removing[player] = true self:_untrack(player) if self._selected == player then self._selected = nil end self:_queueRefresh() end))
        for _, player in ipairs(Players:GetPlayers()) do self:_track(player) end
        self:_refresh() return self
    end
    function API:Destroy() if self._destroyed then return end self._destroyed = true for _, conn in ipairs(self._connections) do conn:Disconnect() end for player in pairs(self._playerConns) do self:_untrack(player) end for _, row in ipairs(self._pool) do row.Connection:Disconnect() end self._selectedEvent:Destroy() self.Root:Destroy() table.clear(self._pool) table.clear(self._connections) end
    return API
end)()


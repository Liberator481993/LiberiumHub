local currentChar = nil
local originalCollide = setmetatable({}, { __mode = "k" })

local function bindCharacter(character)
    currentChar = nil
    local root = character:WaitForChild("HumanoidRootPart", 10)
    local humanoid = character:WaitForChild("Humanoid", 10)
    if not (root and humanoid) or player.Character ~= character then return end

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.zero
    bv.Velocity = Vector3.zero
    bv.P = 3000
    bv.Parent = root

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.zero
    bg.P = 6000
    bg.D = 500
    bg.CFrame = root.CFrame
    bg.Parent = root

    currentChar = { character = character, root = root, humanoid = humanoid, bv = bv, bg = bg }
end

player.CharacterAdded:Connect(bindCharacter)
if player.Character then task.spawn(bindCharacter, player.Character) end

-- Noclip
RunService.Stepped:Connect(function()
    if (CFG.Noclip or CFG.AutoFarm) and player.Character then
        for _, d in ipairs(player.Character:GetDescendants()) do
            if d:IsA("BasePart") then
                if originalCollide[d] == nil then originalCollide[d] = d.CanCollide end
                d.CanCollide = false
            end
        end
    elseif not CFG.Noclip and not CFG.AutoFarm then
        for p, c in pairs(originalCollide) do pcall(function() if p and p.Parent then p.CanCollide = c end end) end
        table.clear(originalCollide)
    end
end)

-- ==========================================
-- ПОЛЕТ (От Клода)
-- ==========================================
local function flyTo(target)
    local c = currentChar
    if not c or c.humanoid.Health <= 0 then return false end

    local origPlatformStand = c.humanoid.PlatformStand
    local origAutoRotate = c.humanoid.AutoRotate
    local arrived = false

    local ok, err = pcall(function()
        c.humanoid.AutoRotate = false
        c.humanoid.PlatformStand = true
        local f = c.root.AssemblyMass * CFG.ForcePerMass
        c.bv.MaxForce = Vector3.new(f, f, f)
        c.bg.MaxTorque = Vector3.new(4e5, 4e5, 4e5)

        while c.humanoid.Health > 0 and c.root.Parent and target.Parent do
            RunService.Heartbeat:Wait()

            local rootPos = c.root.Position
            local offset = target.Position - rootPos
            local dist = offset.Magnitude
            if dist <= 3 then -- ArriveDistance
                arrived = true
                break
            end

            local speed = math.min(CFG.MaxSpeed, dist * CFG.Gain)
            c.bv.Velocity = offset.Unit * speed

            local flat = Vector3.new(offset.X, 0, offset.Z)
            if flat.Magnitude > 0.5 then
                c.bg.CFrame = CFrame.lookAt(rootPos, rootPos + flat)
            end
        end
    end)
    if not ok then warn("flyTo error:", err) end

    -- Восстановление состояния
    c.bv.MaxForce = Vector3.zero
    c.bv.Velocity = Vector3.zero
    c.bg.MaxTorque = Vector3.zero
    if c.root.Parent then
        c.root.AssemblyLinearVelocity = Vector3.zero
        c.root.AssemblyAngularVelocity = Vector3.zero
        local _, yaw = c.root.CFrame:ToOrientation()
        c.root.CFrame = CFrame.new(c.root.Position) * CFrame.Angles(0, yaw, 0)
    end
    if c.humanoid.Parent and c.humanoid.Health > 0 then
        c.humanoid.AutoRotate = origAutoRotate
        c.humanoid.PlatformStand = origPlatformStand
        c.humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end

    return arrived
end

-- ==========================================
-- ЛОГИКА СБОРА И ОЖИДАНИЯ
-- ==========================================
local function waitForAny(...)
    local thread = coroutine.running()
    local connections = {}
    local fired = false

    local function onFire()
        if fired then return end
        fired = true
        for _, c in connections do c:Disconnect() end
        if coroutine.status(thread) == "suspended" then task.spawn(thread) end
    end

    for _, signal in { ... } do table.insert(connections, signal:Connect(onFire)) end
    coroutine.yield()
end

local function waitForDeath(humanoid)
    while humanoid.Health > 0 and humanoid:IsDescendantOf(Workspace) do
        waitForAny(humanoid.Died, humanoid.AncestryChanged)
    end
end

local knownParts = setmetatable({}, { __mode = "k" })

local function markKnownParts()
    local folder = Workspace:FindFirstChild("CoinContainer", true)
    if not folder then return end
    for _, child in folder:GetChildren() do
        if child.Name == "Coin_Server" then knownParts[child] = true end
    end
end

local function hasUsableParts(freshOnly)
    local folder = Workspace:FindFirstChild("CoinContainer", true)
    if not folder then return false end
    for _, child in folder:GetChildren() do
        if child.Name == "Coin_Server" and not (freshOnly and knownParts[child]) then
            return true
        end
    end
    return false
end

local function WaitForActivePhase(freshOnly)
    local char = player.Character
    local hum = char and (char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5))
    if hum then
        if freshOnly then markKnownParts() end
        waitForDeath(hum)
    end
    local deadChar = char

    while true do
        while player.Character == nil or player.Character == deadChar do
            player.CharacterAdded:Wait()
        end
        local newChar = player.Character
        local newHum = newChar:WaitForChild("Humanoid", 10)
        task.wait(2)

        if newHum then
            while task.wait(1) do
                if newHum.Health <= 0 or not newChar:IsDescendantOf(Workspace) then break end
                if hasUsableParts(freshOnly) then return true end
            end
        end
        deadChar = newChar
    end
end

-- ==========================================
-- СЕССИЯ СБОРА
-- ==========================================
local collectedCount = 0
local Blacklist = {}

local function nearestPart()
    local folder = Workspace:FindFirstChild("CoinContainer", true)
    if not (folder and currentChar) then return nil end
    local best, bestDist = nil, math.huge
    local pos = currentChar.root.Position
    for _, child in folder:GetChildren() do
        if child.Name == "Coin_Server" and child:IsA("BasePart") and not Blacklist[child] then
            local d = (child.Position - pos).Magnitude
            if d < bestDist then best, bestDist = child, d end
        end
    end
    return best
end

local function collectTarget(target)
    local c = currentChar
    if not c then return end
    Blacklist[target] = true
    collectedCount += 1
    if typeof(firetouchinterest) == "function" then
        firetouchinterest(c.root, target, 0)
        firetouchinterest(c.root, target, 1)
    end
    local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and prompt.Enabled and typeof(fireproximityprompt) == "function" then
        fireproximityprompt(prompt)
    end
end

local function collectSession()
    while CFG.AutoFarm and currentChar and currentChar.humanoid.Health > 0 do
        if CFG.AutoReset and collectedCount >= CFG.MaxCoins then
            currentChar.humanoid.Health = 0
            break
        end
        local target = nearestPart()
        if not target then break end
        
        if flyTo(target) then
            collectTarget(target)
            task.wait(0.1)
        end
    end
end


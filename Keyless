local function makeCard(parentObj, titleText, description, y, h)
    local card = make("Frame", {Position = UDim2.new(0, 0, 0, y), Size = UDim2.new(1, 0, 0, h or 65), BackgroundColor3 = C.card, BorderSizePixel = 0}, parentObj)
    round(card, 10); outline(card, C.stroke, 0.42)
    local title = label(card, titleText, 13, C.white, Enum.Font.GothamBold)
    title.Position = UDim2.new(0, 12, 0, 8); title.Size = UDim2.new(1, -24, 0, 20)
    local desc = label(card, description, 10, C.muted)
    desc.Position = UDim2.new(0, 12, 0, 28); desc.Size = UDim2.new(1, -24, 0, 20); desc.TextWrapped = true
    return card
end

local function createToggle(card, initial, callback)
    local state = initial or false
    local toggle = make("TextButton", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 36, 0, 20), BackgroundColor3 = state and C.greenDark or C.card2, Text = "", AutoButtonColor = false, BorderSizePixel = 0}, card)
    round(toggle, 10)
    local knob = make("Frame", {Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 4, 0.5, -7), Size = UDim2.new(0, 12, 0, 12), BackgroundColor3 = state and C.green or C.muted, BorderSizePixel = 0}, toggle)
    round(knob, 6)

    toggle.MouseButton1Click:Connect(function()
        state = not state
        tween(toggle, 0.18, {BackgroundColor3 = state and C.greenDark or C.card2})
        tween(knob, 0.18, {Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 4, 0.5, -7), BackgroundColor3 = state and C.green or C.muted})
        if callback then callback(state) end
    end)
end


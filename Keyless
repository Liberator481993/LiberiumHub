    "https://raw.githubusercontent.com/PulseZax/Slate/refs/heads/main/.lua",
    "https://cdn.jsdelivr.net/gh/PulseZax/Slate@main/.lua",
    "https://ghproxy.net/https://raw.githubusercontent.com/PulseZax/Slate/refs/heads/main/.lua",
}

local function loadSlate()
    local LS = loadstring or load
    if not LS then return nil end
    for _, url in ipairs(SLATE_SOURCES) do
        local ok, src = pcall(game.HttpGet, game, url)
        if ok and type(src) == "string" and #src > 500 then
            local fn, perr = LS(src)
            if fn then
                local ok2, Slate = pcall(fn)
                if ok2 and type(Slate) == "table" and Slate.CreateWindow then
                    return Slate
                end
            end
        end
    end
    return nil
end


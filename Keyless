local function CreateToggle(parent, text, default, callback)
    local isOn = default
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundTransparency = 1
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.Parent = parent
    
    local indBg = Instance.new("Frame")
    indBg.Size = UDim2.new(0, 36, 0, 18)
    indBg.Position = UDim2.new(1, -36, 0.5, -9)
    indBg.BackgroundColor3 = isOn and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(40, 40, 45)
    indBg.Parent = btn
    local indC = Instance.new("UICorner"); indC.CornerRadius = UDim.new(1, 0); indC.Parent = indBg
    
    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0, 12, 0, 12)
    circle.Position = isOn and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
    circle.BackgroundColor3 = isOn and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(150, 150, 150)
    circle.Parent = indBg
    local cc = Instance.new("UICorner"); cc.CornerRadius = UDim.new(1, 0); cc.Parent = circle
    
    btn.MouseButton1Click:Connect(function()
        isOn = not isOn
        TweenService:Create(indBg, TweenInfo.new(0.15), {BackgroundColor3 = isOn and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(40, 40, 45)}):Play()
        TweenService:Create(circle, TweenInfo.new(0.15), {
            Position = isOn and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6),
            BackgroundColor3 = isOn and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(150, 150, 150)
        }):Play()
        callback(isOn)
    end)
end


        local c1 = makeCard(pages, "Silent Aim", "Бьет в голову через стены", y, 60); createToggle(c1, CFG.SilentAim, function(v) CFG.SilentAim = v end); y = y + 68
        local c2 = makeCard(pages, "Auto Shoot", "Стреляет при наведении", y, 60); createToggle(c2, CFG.AutoShoot, function(v) CFG.AutoShoot = v end); y = y + 68
        
    elseif name == "Visuals" then
        local c1 = makeCard(pages, "Player ESP", "Подсветка ролей (Убийца/Шериф)", y, 60); createToggle(c1, CFG.ESP, function(v) CFG.ESP = v end); y = y + 68
        
    elseif name == "Movement" then
        local c1 = makeCard(pages, "Noclip", "Проход сквозь стены", y, 60); createToggle(c1, CFG.Noclip, function(v) CFG.Noclip = v; setNoclip(v) end); y = y + 68
        local c2 = makeCard(pages, "Speed Hack", "Ускорение персонажа", y, 60); createToggle(c2, CFG.Speed, function(v) CFG.Speed = v end); y = y + 68
        
    elseif name == "Farm" then
        local c1 = makeCard(pages, "Auto Farm", "Сбор монет", y, 60); createToggle(c1, CFG.AutoFarm, function(v) CFG.AutoFarm = v; toggleFarm(v) end); y = y + 68
    end
end


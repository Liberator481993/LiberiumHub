    uiCorner(status, 14)
    uiStroke(status, UI.Green, 0.65, 1)
    create("Frame", {
        Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(7, 7),
        BackgroundColor3 = UI.Green, BorderSizePixel = 0, Parent = status,
    })
    uiCorner(status:FindFirstChildOfClass("Frame"), 4)
    local statusText = uiText(status, "MM2  •  v91.18", 9, UI.Green, Enum.Font.GothamBold)
    statusText.Position = UDim2.fromOffset(23, 0)
    statusText.Size = UDim2.new(1, -28, 1, 0)

    s.Side = create("ScrollingFrame", {
        Name = "Sidebar", Position = UDim2.fromOffset(0, 62),

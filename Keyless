-- ФИЗИКА (State Machine)
local function releaseForces(s)
    s.bv.MaxForce = Vector3.zero
    s.bv.Velocity = Vector3.zero
    s.bg.MaxTorque = Vector3.zero
end

local function resetHumanoid(s)
    local hum = s.humanoid
    if not hum.Parent then return end
    hum.PlatformStand = s.origPlatformStand
    hum.AutoRotate = s.origAutoRotate
    if hum.Health > 0 and s.root.Parent then
        local _, yaw = s.root.CFrame:ToOrientation()
        s.root.CFrame = CFrame.new(s.root.Position) * CFrame.Angles(0, yaw, 0)
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

local function teardown(s)
    if not s or s.destroyed then return end
    s.destroyed = true
    for _, conn in s.conns do conn:Disconnect() end
    table.clear(s.conns)
    releaseForces(s)
    if s.root.Parent then
        s.root.AssemblyLinearVelocity = Vector3.zero
        s.root.AssemblyAngularVelocity = Vector3.zero
    end
    resetHumanoid(s)
    s.bv:Destroy()
    s.bg:Destroy()
    if currentSession == s then currentSession = nil end
end

local function bindCharacter(character)
    if currentSession then teardown(currentSession) end
    canFarmNow = false
    collectedCount = 0 
    table.clear(Blacklist)

    local root = character:WaitForChild("HumanoidRootPart", 10)
    local humanoid = character:WaitForChild("Humanoid", 10)
    if not (root and humanoid) or player.Character ~= character then return end

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.zero
    bv.Velocity = Vector3.zero
    bv.P = 3000
    bv.Parent = root

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.zero
    bg.P = 6000
    bg.D = 500
    bg.CFrame = root.CFrame
    bg.Parent = root

    local s = {
        character = character, root = root, humanoid = humanoid, bv = bv, bg = bg,
        conns = {}, destroyed = false, origPlatformStand = humanoid.PlatformStand, origAutoRotate = humanoid.AutoRotate,
    }
    currentSession = s

    table.insert(s.conns, humanoid.Died:Connect(function() teardown(s) end))
    table.insert(s.conns, character.AncestryChanged:Connect(function(_, parent)
        if parent == nil then teardown(s) end
    end))

    if humanoid.Health <= 0 then teardown(s) end

    task.wait(3)
    canFarmNow = true
end

player.CharacterAdded:Connect(bindCharacter)
player.CharacterRemoving:Connect(function(character)
    if currentSession and currentSession.character == character then teardown(currentSession) end
end)
if player.Character then task.spawn(bindCharacter, player.Character) end

RunService.Stepped:Connect(function()
    if (CFG.Noclip or CFG.AutoFarm) and player.Character and currentSession and not currentSession.destroyed then
        for _, d in ipairs(player.Character:GetDescendants()) do
            if d:IsA("BasePart") then
                if originalCollide[d] == nil then originalCollide[d] = d.CanCollide end
                d.CanCollide = false
            end
        end
    elseif not CFG.Noclip and not CFG.AutoFarm then
        for p, c in pairs(originalCollide) do pcall(function() if p and p.Parent then p.CanCollide = c end end) end
        table.clear(originalCollide)
    end
end)

local function flyTo(target)
    local s = currentSession
    if not s or s.destroyed or s.humanoid.Health <= 0 or not target.Parent then return false end

    local arrived = false
    local startTime = os.clock()
    local ok, err = pcall(function()
        s.humanoid.AutoRotate = false
        s.humanoid.PlatformStand = true
        local f = s.root.AssemblyMass * CFG.ForcePerMass
        s.bv.MaxForce = Vector3.new(f, f, f)
        s.bg.MaxTorque = Vector3.new(4e5, 4e5, 4e5)

        while not s.destroyed and s.humanoid.Health > 0 and target.Parent do
            RunService.Heartbeat:Wait()
            if s.destroyed then break end
            if not target:IsDescendantOf(Workspace) or os.clock() - startTime > 4.0 then Blacklist[target] = true break end
            if not canCollect() then break end

            local pos = s.root.Position
            local offset = target.Position - pos
            local dist = offset.Magnitude
            if dist <= 3 then arrived = true break end

            s.bv.Velocity = offset.Unit * math.min(CFG.MaxSpeed, dist * CFG.Gain)
            local flat = Vector3.new(offset.X, 0, offset.Z)
            if flat.Magnitude > 0.5 then s.bg.CFrame = CFrame.lookAt(pos, pos + flat) end
        end
    end)
    if not ok then warn("flyTo error:", err) end

    if not s.destroyed then
        releaseForces(s)
        s.root.AssemblyLinearVelocity = Vector3.zero
        s.root.AssemblyAngularVelocity = Vector3.zero
        resetHumanoid(s)
    end
    return arrived
end

-- Поиск конфет
local COIN_PRIMARY = "Coin_Server"
local COIN_FALLBACK = { Coin = true, Candy = true, Sweet = true }
local coinCache, coinCacheTime, coinContainer = {}, 0, nil

local function findCoinContainer()
    return Workspace:FindFirstChild("CoinContainer", true) or Workspace:FindFirstChild("Coins", true) or Workspace:FindFirstChild("CoinFolder", true)
end

local function isCoinName(name)
    if name == COIN_PRIMARY then return true end
    if COIN_FALLBACK[name] then return true end
    if name == "CoinVisual" then return false end
    local n = string.lower(name)
    return string.find(n, "coin", 1, true) ~= nil or string.find(n, "candy", 1, true) ~= nil or string.find(n, "sweet", 1, true) ~= nil
end

local function isCoinAlive(c, container)
    if not c or not c.Parent then return false end
    if not c:IsDescendantOf(Workspace) then return false end
    if container and not c:IsDescendantOf(container) then return false end
    local vis = c:FindFirstChild("CoinVisual")
    if vis and vis:IsA("BasePart") and vis.Transparency >= 0.99 then return false end
    return true
end

local function refreshCoinCache()
    local t = os.clock()
    if t - coinCacheTime < 1 then return end
    coinCacheTime = t coinCache = {} coinContainer = findCoinContainer()
    if coinContainer then
        for _, c in ipairs(coinContainer:GetChildren()) do
            if c:IsA("BasePart") and isCoinName(c.Name) then
                if not Blacklist[c] and isCoinAlive(c, coinContainer) then
                    coinCache[#coinCache+1] = c
                elseif not isCoinAlive(c, coinContainer) then Blacklist[c] = true end
            end
        end
    end
    if #coinCache == 0 then
        for _, d in ipairs(Workspace:GetDescendants()) do
            if d:IsA("BasePart") and isCoinName(d.Name) and not Blacklist[d] and isCoinAlive(d, nil) then coinCache[#coinCache+1] = d end
        end
    end
end

local function isCoinGuarded(pos)
    local r = CFG.AvoidRadius
    if r <= 0 then return false end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local pRoot = plr.Character:FindFirstChild("HumanoidRootPart")
            if pRoot and (pRoot.Position - pos).Magnitude < r then return true end
        end
    end
    return false
end

local function nearestPart()
    local s = currentSession
    if not s or s.destroyed then return nil end
    refreshCoinCache()
    local best, bestDist = nil, math.huge
    local pos = s.root.Position
    for _, c in ipairs(coinCache) do
        if c and c.Parent and not Blacklist[c] then
            local d = (c.Position - pos).Magnitude
            if d < bestDist and not isCoinGuarded(c.Position) then best, bestDist = c, d end
        else Blacklist[c] = true end
    end
    return best
end

local function collectTarget(target)
    local s = currentSession
    if not s or s.destroyed or not target.Parent then return end
    Blacklist[target] = true collectedCount += 1
    pcall(function()
        if typeof(firetouchinterest) == "function" then firetouchinterest(s.root, target, 0) firetouchinterest(s.root, target, 1) end
        local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt and prompt.Enabled and typeof(fireproximityprompt) == "function" then fireproximityprompt(prompt) end
    end)
end

local function collectSession()
    while CFG.AutoFarm and canCollect() do
        if CFG.AutoReset and collectedCount >= CFG.MaxCoins then
            if currentSession and currentSession.humanoid then currentSession.humanoid.Health = 0 end
            break
        end
        local target = nearestPart()
        if not target then break end
        if flyTo(target) then collectTarget(target) task.wait(0.1) else break end
    end
end

task.spawn(function()
    while true do
        if CFG.AutoFarm and canCollect() then collectSession() end
        task.wait(1)
    end
end)


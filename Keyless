-- ============ БЕЗОПАСНЫЙ ПОИСК (БЕЗ ЛАГОВ) ============
-- Ищем монеты только в правильных папках GUI, а не по всей карте.
local function getCoins()
    local coins = {}
    pcall(function()
        local main = LP.PlayerGui:FindFirstChild("MainGUI")
        if main then
            local lobby = main:FindFirstChild("Lobby")
            local gameFolder = main:FindFirstChild("Game")
            local bags = (lobby and lobby:FindFirstChild("CoinBags")) or (gameFolder and gameFolder:FindFirstChild("CoinBags"))
            if bags then
                for _, bag in ipairs(bags:GetChildren()) do
                    if bag:IsA("BasePart") then table.insert(coins, bag) end
                end
            end
        end
    end)
    return coins
end

-- Ищем конфеты в конкретной папке (обычно это Game или Map)
local function getCandies()
    local candies = {}
    pcall(function()
        -- Сначала пробуем найти папку CandyBags (как в большинстве скриптов)
        local candyFolder = workspace:FindFirstChild("CandyBags") 
        if not candyFolder then
            -- Если нет, ищем в Game
            local gameFolder = workspace:FindFirstChild("Game")
            if gameFolder then candyFolder = gameFolder:FindFirstChild("CandyBags") end
        end
        
        -- Если папка найдена, берем детей оттуда
        if candyFolder then
            for _, obj in ipairs(candyFolder:GetChildren()) do
                if obj:IsA("BasePart") or obj:IsA("Model") then table.insert(candies, obj) end
            end
        else
            -- Если папки нет, делаем ОДИН быстрый поиск только по Models с именем Candy
            for _, obj in ipairs(workspace:GetChildren()) do
                if obj:IsA("Model") and string.find(string.lower(obj.Name), "candy") then
                    table.insert(candies, obj)
                end
            end
        end
    end)
    return candies
end

-- Получение позиции (безопасно для Model и Part)
local function getPos(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then
        local ok, pivot = pcall(function() return obj:GetPivot().Position end)
        return ok and pivot or nil
    end
    return nil
end

-- ============ ESP ============
local espCache = {}
RunService.RenderStepped:Connect(function()
    if not CFG.ItemESP then
        for _, hl in pairs(espCache) do pcall(function() hl:Destroy() end) end
        table.clear(espCache)
        return
    end
    
    for _, obj in ipairs(getCandies()) do
        if not espCache[obj] then
            local hl = Instance.new("Highlight")
            hl.FillColor = Color3.fromRGB(255, 255, 0)
            hl.FillTransparency = 0.5
            hl.OutlineColor = Color3.fromRGB(255, 255, 0)
            hl.Parent = obj
            espCache[obj] = hl
        end
    end
    for _, obj in ipairs(getCoins()) do
        if not espCache[obj] then
            local hl = Instance.new("Highlight")
            hl.FillColor = Color3.fromRGB(0, 255, 0)
            hl.FillTransparency = 0.5
            hl.OutlineColor = Color3.fromRGB(0, 255, 0)
            hl.Parent = obj
            espCache[obj] = hl
        end
    end
end)

-- ============ AUTO FARM (ПЛАВНЫЙ ПОЛЕТ) ============
local isFlying = false
task.spawn(function()
    while task.wait(0.5) do -- Проверка раз в 0.5 сек (меньше лагов)
        if CFG.FarmCandies or CFG.FarmCoins then
            local char = LP.Character
            if not char then continue end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then continue end

            local targetPos = nil
            local minDist = math.huge

            if CFG.FarmCandies then
                for _, candy in ipairs(getCandies()) do
                    local pos = getPos(candy)
                    if pos then
                        local d = (pos - hrp.Position).Magnitude
                        if d < minDist then minDist = d; targetPos = pos end
                    end
                end
            end

            if CFG.FarmCoins and not targetPos then
                for _, coin in ipairs(getCoins()) do
                    local d = (coin.Position - hrp.Position).Magnitude
                    if d < minDist then minDist = d; targetPos = coin.Position end
                end
            end

            if targetPos and not isFlying then
                isFlying = true
                -- Плавный полет через Tween (занимает 0.3 сек)
                local tween = TweenService:Create(hrp, TweenInfo.new(0.3, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))})
                tween:Play()
                tween.Completed:Wait()
                task.wait(0.2) -- Пауза на сбор
                isFlying = false
            end
        end
    end
end)


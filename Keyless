local SessionManager = (function()
    local SM = {} local AFK_INTERVAL = 60 local SERVER_LIST_URL = "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100" local afkToken = 0 local afkRunning = false local isTeleporting = false
    SM.Notify = function(msg) if NotificationManager then NotificationManager.Notify(msg, "Error", 4) end end
    local function getLocalPlayer() return Players.LocalPlayer end
    local function getHumanoid() local player = getLocalPlayer() local character = player and player.Character if not character or not character.Parent then return nil end local humanoid = character:FindFirstChildOfClass("Humanoid") if humanoid and humanoid.Health > 0 then return humanoid end return nil end
    local function doAfkAction() local ok = pcall(function() local VirtualUser = game:GetService("VirtualUser") VirtualUser:CaptureController() VirtualUser:ClickButton2(Vector2.new(0, 0)) end) if ok then return end pcall(function() local humanoid = getHumanoid() if humanoid then humanoid.Jump = true end end) end
    function SM.StartAntiAFK() if afkRunning then return end afkRunning = true afkToken += 1 local myToken = afkToken task.spawn(function() while afkRunning and afkToken == myToken do for _ = 1, AFK_INTERVAL do if not afkRunning or afkToken ~= myToken then return end task.wait(1) end if afkRunning and afkToken == myToken then doAfkAction() end end end) end
    function SM.StopAntiAFK() afkRunning = false afkToken += 1 end
    function SM.IsAntiAFKRunning() return afkRunning end
    TeleportService.TeleportInitFailed:Connect(function(player, result, errorMessage) if player == getLocalPlayer() then isTeleporting = false SM.Notify(("Teleport failed: %s"):format(tostring(errorMessage))) end end)
    function SM.RejoinServer()
        if isTeleporting then return end local player = getLocalPlayer() if not player then return end isTeleporting = true
        local ok, err = pcall(function() if #Players:GetPlayers() <= 1 then TeleportService:Teleport(game.PlaceId, player) else TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player) end end)
        if not ok then isTeleporting = false SM.Notify("Rejoin failed: " .. tostring(err)) end
    end
    function SM.ServerHop()
        if isTeleporting then return end isTeleporting = true
        local ok, err = pcall(function()
            local url = SERVER_LIST_URL:format(game.PlaceId) local response = HttpService:RequestAsync({ Url = url, Method = "GET" }) if not response.Success then error("HTTP " .. response.StatusCode) end
            local data = HttpService:JSONDecode(response.Body) local candidates = {}
            for _, server in ipairs(data.data or {}) do if server.id ~= game.JobId and server.playing < server.maxPlayers then table.insert(candidates, server.id) end end
            if #candidates == 0 then error("no other open public servers found") end
            local jobId = candidates[math.random(1, #candidates)] TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, getLocalPlayer())
        end)
        if not ok then isTeleporting = false SM.Notify("Server hop failed (HttpService blocked?)") end
    end
    return SM
end)()


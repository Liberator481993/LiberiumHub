-- ========== Адаптивный масштаб ==========
local function updateScale()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	local scale = math.min(viewport.X / 480, viewport.Y / 420)
	scale = math.clamp(scale, 0.5, 1.25)
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		scale = math.clamp(scale, 0.5, 1)
	end
	windowScale.Scale = scale
	toggleScale.Scale = scale
end

updateScale()
local function bindCamera()
	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
end
bindCamera()
Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	bindCamera()
	updateScale()
end)

-- ========== Visuals: подсветка по роли ==========
local highlights = {}
local playerConnections = {}

local function getRoleColor(targetPlayer)
	local ok, role = pcall(function()
		return targetPlayer:GetAttribute("Role")
	end)
	if ok and role ~= nil then
		if role == "Murderer" then
			return COLOR_RED
		elseif role == "Sheriff" then
			return COLOR_BLUE
		end
	end
	return COLOR_GREEN
end

local function removeHighlight(targetPlayer)
	local existing = highlights[targetPlayer]
	highlights[targetPlayer] = nil
	if existing then
		pcall(function()
			existing:Destroy()
		end)
	end
end

local function applyHighlight(targetPlayer)
	pcall(function()
		local character = targetPlayer.Character
		if not character then
			return
		end
		local highlight = highlights[targetPlayer]
		if not highlight or highlight.Parent == nil or highlight.Adornee ~= character then
			if highlight then
				highlight:Destroy()
			end
			highlight = Instance.new("Highlight")
			highlight.Name = "RoleHighlight"
			highlight.Adornee = character
			highlight.FillTransparency = 0.5
			highlight.OutlineTransparency = 0
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.Parent = character
			highlights[targetPlayer] = highlight
		end
		local color = getRoleColor(targetPlayer)
		highlight.FillColor = color
		highlight.OutlineColor = color
	end)
end

local function setupPlayer(targetPlayer)
	if targetPlayer == player or playerConnections[targetPlayer] then
		return
	end
	local connections = {}
	playerConnections[targetPlayer] = connections

	table.insert(connections, targetPlayer.CharacterAdded:Connect(function()
		if state.visuals then
			task.defer(applyHighlight, targetPlayer)
		end
	end))
	table.insert(connections, targetPlayer:GetAttributeChangedSignal("Role"):Connect(function()
		if state.visuals then
			applyHighlight(targetPlayer)
		end
	end))
end

local function cleanupPlayer(targetPlayer)
	removeHighlight(targetPlayer)
	local connections = playerConnections[targetPlayer]
	if connections then
		for _, connection in ipairs(connections) do
			connection:Disconnect()
		end
		playerConnections[targetPlayer] = nil
	end
end

for _, p in ipairs(Players:GetPlayers()) do
	setupPlayer(p)
end
Players.PlayerAdded:Connect(function(p)
	setupPlayer(p)
end)
Players.PlayerRemoving:Connect(cleanupPlayer)

-- ========== Physics: Noclip ==========
local originalCollide = setmetatable({}, { __mode = "k" })

local function restoreCollisions()
	for part, value in pairs(originalCollide) do
		pcall(function()
			if part and part.Parent then
				part.CanCollide = value
			end
		end)
	end
	table.clear(originalCollide)
end

RunService.Stepped:Connect(function()
	if not state.noclip then
		return
	end
	pcall(function()
		local character = player.Character
		if not character then
			return
		end
		for _, descendant in ipairs(character:GetDescendants()) do
			if descendant:IsA("BasePart") then
				if originalCollide[descendant] == nil then
					originalCollide[descendant] = descendant.CanCollide
				end
				descendant.CanCollide = false
			end
		end
	end)
end)

-- ========== Physics: WalkSpeed ==========
RunService.Heartbeat:Connect(function()
	if not state.speedTouched then
		return
	end
	pcall(function()
		local humanoid = getHumanoid()
		if humanoid and humanoid.WalkSpeed ~= state.walkSpeed then
			humanoid.WalkSpeed = state.walkSpeed
		end
	end)
end)

-- ========== Automation: перемещение к TestCoin ==========
local currentCoin = nil
local lastCoinSearch = 0

local function findNearestCoin(rootPosition)
	local nearest, nearestDistance = nil, math.huge
	local ok = pcall(function()
		for _, descendant in ipairs(Workspace:GetDescendants()) do
			if descendant.Name == "TestCoin" and descendant:IsA("BasePart") then
				local distance = (descendant.Position - rootPosition).Magnitude
				if distance < nearestDistance then
					nearest = descendant
					nearestDistance = distance
				end
			end
		end
	end)
	if not ok then
		return nil
	end
	return nearest
end

RunService.Heartbeat:Connect(function(dt)
	if not state.auto then
		currentCoin = nil
		return
	end
	pcall(function()
		local root = getRoot()
		if not root then
			return
		end

		local now = os.clock()
		local invalid = currentCoin == nil or currentCoin.Parent == nil
		if invalid or now - lastCoinSearch >= COIN_REFRESH_INTERVAL then
			lastCoinSearch = now
			currentCoin = findNearestCoin(root.Position)
		end
		if not currentCoin then
			return
		end

		local delta = currentCoin.Position - root.Position
		local distance = delta.Magnitude
		if distance > 0.5 then
			local step = math.min(distance, AUTO_MOVE_SPEED * dt)
			root.CFrame = root.CFrame + delta.Unit * step
		end
	end)
end)


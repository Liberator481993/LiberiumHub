-- Поиск монет
local function getContainer()
    local gameW = Workspace:FindFirstChild("Game")
    if gameW and gameW:FindFirstChild("CoinContainer") then
        return gameW.CoinContainer
    end
    return Workspace:FindFirstChild("CoinContainer", true)
end

local function findNearest()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local container = getContainer()
    if not container then return nil end
    
    local closest, minDist = nil, math.huge
    for _, obj in ipairs(container:GetChildren()) do
        if obj.Name == "Coin_Server" and obj:IsA("BasePart") and not blacklist[obj] then
            local dist = (obj.Position - hrp.Position).Magnitude
            if dist < minDist then
                minDist = dist
                closest = obj
            end
        end
    end
    return closest
end

-- Основной цикл (Плавное движение через CFrame)
RunService.Heartbeat:Connect(function(dt)
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if isFarming then
        -- 1. Noclip (сквозь стены)
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        if not hum.PlatformStand then hum.PlatformStand = true end

        -- 2. Поиск цели
        if currentTarget and not currentTarget.Parent then
            currentTarget = nil
        end
        if not currentTarget then
            currentTarget = findNearest()
        end

        -- 3. Движение
        if currentTarget then
            local targetPos = currentTarget.Position
            local distance = (hrp.Position - targetPos).Magnitude

            StatusText.Text = "Летим к монете (" .. math.floor(distance) .. " st)"

            if distance < 3.5 then
                -- Сбор
                blacklist[currentTarget] = true
                pcall(function()
                    firetouchinterest(hrp, currentTarget, 0)
                    firetouchinterest(hrp, currentTarget, 1)
                end)
                for _, prompt in ipairs(currentTarget:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        pcall(function() fireproximityprompt(prompt) end)
                    end
                end
                currentTarget = nil
                task.wait(0.1)
            else
                -- Плавно двигаемся к цели (шаг за шагом)
                local dir = (targetPos - hrp.Position).Unit
                local moveStep = speed * dt -- Скорость * время кадра
                if moveStep > distance then moveStep = distance end
                hrp.CFrame = CFrame.new(hrp.Position + dir * moveStep)
            end
        else
            StatusText.Text = "Нет монет (ждем)"
        end
    else
        -- Выключено
        if hum.PlatformStand then hum.PlatformStand = false end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end
end)

-- Управление ползунком
SliderBg.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local function update(x)
            local percent = math.clamp((x - SliderBg.AbsolutePosition.X) / SliderBg.AbsoluteSize.X, 0, 1)
            speed = math.floor(percent * 50) + 5
            SliderFill.Size = UDim2.new(percent, 0, 1, 0)
            StatusText.Text = "Скорость: " .. speed
        end
        update(input.Position.X)
        
        local moveConn = game:GetService("UserInputService").InputChanged:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
                update(i.Position.X)
            end
        end)
        game:GetService("UserInputService").InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                if moveConn then moveConn:Disconnect() end
            end
        end)
    end
end)

-- Включение/выключение
Btn.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        Btn.Text = "FARM: ON"
        Btn.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
    else
        Btn.Text = "FARM: OFF"
        Btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        StatusText.Text = "Скорость: " .. speed
    end
end)


-- 2. OBJECT TRACKER (От Клода - для фарма)
-- ==========================================
local ObjectTracker = (function()
    local Workspace = game:GetService("Workspace")
    local Tracker = {}
    Tracker.__index = Tracker

    function Tracker:_passesFilter(inst)
        local filter = self._filter
        if filter == nil then return true end
        if type(filter) == "function" then local ok, res = pcall(filter, inst) return ok and res == true end
        return string.find(inst.Name, filter) ~= nil
    end

    function Tracker:_add(inst)
        if self._index[inst] then return end
        local isModel
        if inst:IsA("BasePart") then isModel = false
        elseif inst:IsA("Model") then isModel = true
        else return end
        if not self:_passesFilter(inst) then return end
        local n = #self._objs + 1
        self._objs[n] = inst self._isModel[n] = isModel self._index[inst] = n
    end

    function Tracker:_remove(inst)
        local i = self._index[inst]
        if not i then return end
        local last = #self._objs
        if i ~= last then
            local moved = self._objs[last]
            self._objs[i] = moved self._isModel[i] = self._isModel[last] self._index[moved] = i
        end
        self._objs[last] = nil self._isModel[last] = nil self._index[inst] = nil
    end

    function Tracker:_clearCache()
        table.clear(self._objs) table.clear(self._isModel) table.clear(self._index)
    end

    function Tracker:_detach()
        for _, conn in ipairs(self._folderConns) do conn:Disconnect() end
        table.clear(self._folderConns) self._folder = nil self:_clearCache()
    end

    function Tracker:_attach(folder)
        self:_detach() self._folder = folder
        local conns = self._folderConns local recursive = self._recursive
        if recursive then
            table.insert(conns, folder.DescendantAdded:Connect(function(inst) self:_add(inst) end))
            table.insert(conns, folder.DescendantRemoving:Connect(function(inst) self:_remove(inst) end))
        else
            table.insert(conns, folder.ChildAdded:Connect(function(inst) self:_add(inst) end))
            table.insert(conns, folder.ChildRemoved:Connect(function(inst) self:_remove(inst) end))
        end
        table.insert(conns, folder.AncestryChanged:Connect(function()
            if folder.Parent ~= self._parent then self:_detach() end
        end))
        for _, inst in ipairs(recursive and folder:GetDescendants() or folder:GetChildren()) do self:_add(inst) end
    end

    function Tracker.new(folderName, nameFilter, options)
        local self = setmetatable({}, Tracker)
        self._folderName = folderName self._filter = nameFilter
        self._parent = (options and options.Parent) or Workspace
        self._recursive = options ~= nil and options.Recursive == true
        self._objs = {} self._isModel = {} self._index = {}
        self._folder = nil self._folderConns = {} self._destroyed = false
        self._parentConn = self._parent.ChildAdded:Connect(function(child)
            if child.Name == self._folderName and self._folder == nil then self:_attach(child) end
        end)
        local existing = self._parent:FindFirstChild(folderName)
        if existing then self:_attach(existing) end
        return self
    end

    function Tracker:GetClosest(origin, maxDistance)
        if self._destroyed then return nil, nil end
        local objs, isModel = self._objs, self._isModel
        local limitSq = maxDistance and (maxDistance * maxDistance) or math.huge
        local bestObj, bestSq = nil, limitSq
        for i = 1, #objs do
            local obj = objs[i]
            if obj.Parent then
                local pos = isModel[i] and obj:GetPivot().Position or (obj :: BasePart).Position
                local d = pos - origin
                local sq = d.X * d.X + d.Y * d.Y + d.Z * d.Z
                if sq < bestSq or (bestObj == nil and sq <= limitSq) then bestSq = sq bestObj = obj end
            end
        end
        if bestObj then return bestObj, math.sqrt(bestSq) end
        return nil, nil
    end
    function Tracker:Destroy() if self._destroyed then return end self._destroyed = true self._parentConn:Disconnect() self:_detach() end
    return Tracker
end)()


local Hotkeys = (function()
    local HK = {} HK._binds = {} HK._connection = nil
    local function onInputBegan(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        local callbacks = HK._binds[input.KeyCode]
        if not callbacks then return end
        for _, callback in ipairs(callbacks) do task.spawn(function() local ok, err = pcall(callback) if not ok then warn("[Hotkeys] callback error:", err) end end) end
    end
    function HK.Bind(keyCode, callback)
        local list = HK._binds[keyCode] if not list then list = {} HK._binds[keyCode] = list end table.insert(list, callback)
        if not HK._connection then HK._connection = UserInputService.InputBegan:Connect(onInputBegan) end
        return function() local idx = table.find(list, callback) if idx then table.remove(list, idx) end end
    end
    function HK.Destroy() if HK._connection then HK._connection:Disconnect() HK._connection = nil end table.clear(HK._binds) end
    return HK
end)()

MovementUtility = (function()
    local MU = {} MU.__index = MU
    local DEFAULT_WALKSPEED = 16
    local DEFAULT_JUMPPOWER = 50
    local SAFE_RECORD_INTERVAL = 0.5
    local SUPPRESSED_STATES = { Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Ragdoll }

    local function getCharacterParts(player)
        local character = player.Character if not character or not character.Parent then return nil end
        local humanoid = character:FindFirstChildOfClass("Humanoid") local root = character:FindFirstChild("HumanoidRootPart")
        return character, humanoid, root
    end

    function MU.new()
        local self = setmetatable({}, MU)
        self._player = Players.LocalPlayer self._destroyed = false
        self._walkSpeed = nil self._jumpPower = nil self._collisionEnabled = true
        self._originalCollide = setmetatable({}, { __mode = "k" }) self._lastSafeCFrame = nil self._safeTimer = 0
        self._steppedConn = nil self._heartbeatConn = nil
        self._charConn = self._player.CharacterAdded:Connect(function(character) task.spawn(function() self:_onCharacterAdded(character) end) end)
        self._heartbeatConn = RunService.Heartbeat:Connect(function(dt)
            self._safeTimer += dt
            if self._safeTimer < SAFE_RECORD_INTERVAL then return end
            self._safeTimer = 0
            if self._collisionEnabled then
                pcall(function() local _, humanoid, root = getCharacterParts(self._player) if root and humanoid and humanoid.Health > 0 then self._lastSafeCFrame = root.CFrame end end)
            end
        end)
        if self._player.Character then task.spawn(function() self:_onCharacterAdded(self._player.Character) end) end
        return self
    end

    function MU:_applyStats(humanoid)
        pcall(function()
            if self._walkSpeed ~= nil then humanoid.WalkSpeed = self._walkSpeed end
            if self._jumpPower ~= nil then humanoid.UseJumpPower = true humanoid.JumpPower = self._jumpPower end
        end)
    end

    function MU:_onCharacterAdded(character)
        local humanoid = character:WaitForChild("Humanoid", 5) if not humanoid or self._destroyed then return end
        self:_applyStats(humanoid) table.clear(self._originalCollide)
        if not self._collisionEnabled then character:WaitForChild("HumanoidRootPart", 5) self:_startNoclip(character) end
    end

    function MU:SetWalkSpeed(speed)
        if self._destroyed or type(speed) ~= "number" then return end
        self._walkSpeed = math.max(speed, 0) local _, humanoid = getCharacterParts(self._player) if humanoid then self:_applyStats(humanoid) end
    end

    function MU:SetJumpPower(power)
        if self._destroyed or type(power) ~= "number" then return end
        self._jumpPower = math.max(power, 0) local _, humanoid = getCharacterParts(self._player) if humanoid then self:_applyStats(humanoid) end
    end

    function MU:_noclipPart(part)
        if self._originalCollide[part] == nil then self._originalCollide[part] = part.CanCollide end
        part.CanCollide = false
    end

    function MU:_setStatesSuppressed(humanoid, suppressed)
        for _, state in ipairs(SUPPRESSED_STATES) do pcall(function() humanoid:SetStateEnabled(state, not suppressed) end) end
    end

    function MU:_startNoclip(character)
        for _, inst in ipairs(character:GetDescendants()) do if inst:IsA("BasePart") then pcall(function() self:_noclipPart(inst) end) end end
        local humanoid = character:FindFirstChildOfClass("Humanoid") if humanoid then self:_setStatesSuppressed(humanoid, true) end
        if not self._steppedConn then
            self._steppedConn = RunService.Stepped:Connect(function()
                pcall(function()
                    local char = self._player.Character if not char then return end
                    for _, child in ipairs(char:GetChildren()) do
                        if child:IsA("BasePart") then self:_noclipPart(child)
                        elseif child:IsA("Tool") then for _, toolPart in ipairs(child:GetDescendants()) do if toolPart:IsA("BasePart") then self:_noclipPart(toolPart) end end end
                    end
                end)
            end)
        end
    end

    function MU:_isOverlappingWorld(character)
        local ok, result = pcall(function()
            local cf, size = character:GetBoundingBox()
            local params = OverlapParams.new() params.FilterType = Enum.RaycastFilterType.Exclude params.FilterDescendantsInstances = { character }
            local parts = Workspace:GetPartBoundsInBox(cf, size - Vector3.new(0.6, 0.6, 0.6), params)
            for _, part in ipairs(parts) do if part.CanCollide then return true end end
            return false
        end)
        return ok and result == true
    end

    function MU:_stopNoclip(character)
        if self._steppedConn then self._steppedConn:Disconnect() self._steppedConn = nil end
        local humanoid, root = nil, nil
        if character then humanoid = character:FindFirstChildOfClass("Humanoid") root = character:FindFirstChild("HumanoidRootPart") end
        if character and root and self._lastSafeCFrame and self:_isOverlappingWorld(character) then
            pcall(function() root.AssemblyLinearVelocity = Vector3.zero character:PivotTo(self._lastSafeCFrame) end)
        end
        for part, original in pairs(self._originalCollide) do pcall(function() if part.Parent then part.CanCollide = original end end) end
        table.clear(self._originalCollide)
        if humanoid then self:_setStatesSuppressed(humanoid, false) pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
    end

    function MU:SetCollision(enabled)
        if self._destroyed then return end
        enabled = enabled == true
        if enabled == self._collisionEnabled then return end
        local character, _, root = getCharacterParts(self._player)
        if not enabled then
            if root then self._lastSafeCFrame = root.CFrame end
            self._collisionEnabled = false if character then self:_startNoclip(character) end
        else
            self._collisionEnabled = true self:_stopNoclip(character)
        end
    end

    function MU:Reset()
        if self._destroyed then return end
        self:SetCollision(true) self._walkSpeed = nil self._jumpPower = nil
        local _, humanoid = getCharacterParts(self._player)
        if humanoid then pcall(function() humanoid.WalkSpeed = DEFAULT_WALKSPEED humanoid.UseJumpPower = true humanoid.JumpPower = DEFAULT_JUMPPOWER end) end
    end

    function MU:Destroy()
        if self._destroyed then return end
        self:Reset() self._destroyed = true
        if self._charConn then self._charConn:Disconnect() end
        if self._heartbeatConn then self._heartbeatConn:Disconnect() end
        if self._steppedConn then self._steppedConn:Disconnect() end
    end
    return MU
end)()

LootTracker = (function()
    local LT = {} LT.__index = LT
    local UPDATE_INTERVAL = 0.2
    local STUDS_PER_METER = 3.571
    local SCAN_BATCH_SIZE = 500
    local MAX_TRACKED = 150
    local TRACKED = { Coin = Color3.fromRGB(255, 220, 60), Gem = Color3.fromRGB(70, 230, 255), Cash = Color3.fromRGB(80, 230, 120) }

    local function isTrackable(inst) return TRACKED[inst.Name] ~= nil and (inst:IsA("BasePart") or inst:IsA("Model")) end
    local function getPosition(item)
        if item:IsA("BasePart") then return item.Position
        elseif item:IsA("Model") then local ok, pivot = pcall(function() return item:GetPivot().Position end) if ok then return pivot end end
        return nil
    end

    function LT.new(parentGui)
        local self = setmetatable({}, LT)
        self._parentGui = parentGui self._running = false self._destroyed = false self._cache = {} self._count = 0 self._connections = {} self._scanToken = 0 self._accumulator = 0
        self._folder = Instance.new("Folder") self._folder.Name = "LootTrackerVisuals" self._folder.Parent = parentGui
        return self
    end

    function LT:_track(item)
        if self._cache[item] or self._destroyed or not item.Parent then return end
        if self._count >= MAX_TRACKED then return end
        if not isTrackable(item) then return end
        local color = TRACKED[item.Name]
        local ok, entry = pcall(function()
            local highlight = Instance.new("Highlight") highlight.Name = "LootHighlight" highlight.Adornee = item highlight.FillColor = color highlight.FillTransparency = 0.6 highlight.OutlineColor = color highlight.OutlineTransparency = 0 highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop highlight.Parent = self._folder
            local billboard = Instance.new("BillboardGui") billboard.Name = "LootBillboard" billboard.Adornee = item billboard.AlwaysOnTop = true billboard.Size = UDim2.new(0, 100, 0, 34) billboard.StudsOffsetWorldSpace = Vector3.new(0, 2.5, 0) billboard.MaxDistance = 300 billboard.ResetOnSpawn = false billboard.Parent = self._folder
            local label = Instance.new("TextLabel") label.Size = UDim2.new(1, 0, 1, 0) label.BackgroundTransparency = 1 label.Text = item.Name label.TextColor3 = color label.TextTransparency = 0 label.TextStrokeTransparency = 0.4 label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0) label.Font = Enum.Font.GothamBold label.TextSize = 14 label.TextWrapped = true label.Parent = billboard
            return { highlight = highlight, billboard = billboard, label = label, name = item.Name, lastText = "" }
        end)
        if ok and entry then self._cache[item] = entry self._count += 1
        else pcall(function() for _, child in ipairs(self._folder:GetChildren()) do if child:IsA("Highlight") and child.Adornee == nil then child:Destroy() end if child:IsA("BillboardGui") and child.Adornee == nil then child:Destroy() end end end) end
    end

    function LT:_untrack(item)
        local entry = self._cache[item] if not entry then return end
        self._cache[item] = nil self._count -= 1
        pcall(function() entry.highlight:Destroy() end) pcall(function() entry.billboard:Destroy() end)
    end

    function LT:_onRemoving(inst)
        if self._cache[inst] then self:_untrack(inst) return end
        if self._count > 0 and (inst:IsA("Model") or inst:IsA("Folder")) then for item in pairs(self._cache) do if item:IsDescendantOf(inst) then self:_untrack(item) end end end
    end

    function LT:_refresh()
        local localPlayer = Players.LocalPlayer local character = localPlayer and localPlayer.Character local root = character and character:FindFirstChild("HumanoidRootPart") local origin = root and root.Position
        if not origin then return end
        for item, entry in pairs(self._cache) do
            if not item.Parent then self:_untrack(item)
            else
                local pos = getPosition(item)
                if pos then
                    local text = string.format("%s\n%.0f m", entry.name, (pos - origin).Magnitude / STUDS_PER_METER)
                    if text ~= entry.lastText then entry.lastText = text entry.label.Text = text end
                end
            end
        end
    end

    function LT:Start()
        if self._running or self._destroyed then return end self._running = true
        self._scanToken += 1 local token = self._scanToken
        table.insert(self._connections, Workspace.DescendantAdded:Connect(function(inst) if TRACKED[inst.Name] then task.defer(function() if self._running then self:_track(inst) end end) end end))
        table.insert(self._connections, Workspace.DescendantRemoving:Connect(function(inst) self:_onRemoving(inst) end))
        self._accumulator = 0
        table.insert(self._connections, RunService.Heartbeat:Connect(function(dt) self._accumulator += dt if self._accumulator < UPDATE_INTERVAL then return end self._accumulator = 0 pcall(function() self:_refresh() end) end))
        task.spawn(function()
            local processed = 0
            for _, inst in ipairs(Workspace:GetDescendants()) do
                if not self._running or self._scanToken ~= token then return end
                if TRACKED[inst.Name] then self:_track(inst) end
                processed += 1 if processed % SCAN_BATCH_SIZE == 0 then task.wait() end
            end
        end)
    end

    function LT:Stop()
        if not self._running then return end self._running = false self._scanToken += 1
        for _, conn in ipairs(self._connections) do pcall(function() conn:Disconnect() end) end table.clear(self._connections)
        local items = {} for item in pairs(self._cache) do table.insert(items, item) end for _, item in ipairs(items) do self:_untrack(item) end
    end

    function LT:Destroy() if self._destroyed then return end self:Stop() self._destroyed = true pcall(function() self._folder:Destroy() end) end
    return LT
end)()

TargetHUD = (function()
    local TH = {} TH.__index = TH
    local DISTANCE_INTERVAL = 0.5
    local FADE_INFO = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local BAR_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local STUDS_PER_METER = 3.571
    local COLORS = { Text = Color3.fromRGB(255, 255, 255), Muted = Color3.fromRGB(190, 190, 200), BarBack = Color3.fromRGB(10, 10, 14), High = Color3.fromRGB(90, 230, 130), Mid = Color3.fromRGB(255, 205, 80), Low = Color3.fromRGB(255, 90, 90) }
    local function healthColor(fraction) if fraction > 0.6 then return COLORS.High end if fraction > 0.3 then return COLORS.Mid end return COLORS.Low end
    local function getCharacterParts(player) local character = player.Character if not character or not character.Parent then return nil end local humanoid = character:FindFirstChildOfClass("Humanoid") local root = character:FindFirstChild("HumanoidRootPart") return character, humanoid, root end
    
    function TH.new(parentGui)
        local self = setmetatable({}, TH)
        self._destroyed = false self._target = nil self._targetToken = 0 self._connections = {} self._fadeTween = nil self._barTween = nil self._healthFraction = 1
        local panel = create("Frame", {Name="TargetHUD",AnchorPoint=Vector2.new(0.5,0),Position=UDim2.new(0.5,0,0,12),Size=UDim2.new(0,260,0,64),BackgroundColor3=Color3.fromRGB(20,20,28),BackgroundTransparency=1,BorderSizePixel=0,Visible=false,ZIndex=30,Parent=parentGui})
        self._panel = panel
        create("UICorner", {CornerRadius=UDim.new(0,12),Parent=panel})
        self._stroke = create("UIStroke",{Color=Color3.fromRGB(255,255,255),Transparency=1,Thickness=1,ApplyStrokeMode=Enum.ApplyStrokeMode.Border,Parent=panel})
        create("UIPadding", {PaddingTop=UDim.new(0,8),PaddingBottom=UDim.new(0,8),PaddingLeft=UDim.new(0,12),PaddingRight=UDim.new(0,12),Parent=panel})
        self._nameLabel = create("TextLabel", {Name="PlayerName",Size=UDim2.new(0.65,0,0,20),BackgroundTransparency=1,Text="",TextColor3=COLORS.Text,TextTransparency=1,Font=Enum.Font.GothamBold,TextSize=16,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,ZIndex=31,Parent=panel})
        self._distanceLabel = create("TextLabel", {Name="Distance",AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,0,0,0),Size=UDim2.new(0.35,0,0,20),BackgroundTransparency=1,Text="",TextColor3=COLORS.Muted,TextTransparency=1,Font=Enum.Font.GothamMedium,TextSize=14,TextXAlignment=Enum.TextXAlignment.Right,ZIndex=31,Parent=panel})
        local barBack = create("Frame", {Name="BarBack",AnchorPoint=Vector2.new(0,1),Position=UDim2.new(0,0,1,0),Size=UDim2.new(1,0,0,12),BackgroundColor3=COLORS.BarBack,BackgroundTransparency=1,BorderSizePixel=0,ClipsDescendants=true,ZIndex=31,Parent=panel})
        create("UICorner", {CornerRadius=UDim.new(0,6),Parent=barBack}) self._barBack = barBack
        self._barFill = create("Frame", {Name="BarFill",Size=UDim2.new(1,0,1,0),BackgroundColor3=COLORS.High,BackgroundTransparency=1,BorderSizePixel=0,ZIndex=32,Parent=barBack})
        create("UICorner", {CornerRadius=UDim.new(0,6),Parent=self._barFill})
        return self
    end

    function TH:_fade(visible)
        if self._fadeTween then self._fadeTween:Cancel() end
        if visible then self._panel.Visible = true end
        local tweens = {
            TweenService:Create(self._panel, FADE_INFO, { BackgroundTransparency = visible and 0.35 or 1 }),
            TweenService:Create(self._stroke, FADE_INFO, { Transparency = visible and 0.8 or 1 }),
            TweenService:Create(self._nameLabel, FADE_INFO, { TextTransparency = visible and 0 or 1 }),
            TweenService:Create(self._distanceLabel, FADE_INFO, { TextTransparency = visible and 0 or 1 }),
            TweenService:Create(self._barBack, FADE_INFO, { BackgroundTransparency = visible and 0.2 or 1 }),
            TweenService:Create(self._barFill, FADE_INFO, { BackgroundTransparency = visible and 0 or 1 }),
        }
        for _, tween in ipairs(tweens) do tween:Play() end
        self._fadeTween = tweens[1]
        if not visible then local token = self._targetToken tweens[1].Completed:Once(function(state) if state == Enum.PlaybackState.Completed and self._targetToken == token and not self._destroyed then self._panel.Visible = false end end) end
    end
    function TH:_setHealth(humanoid, instant)
        local maxHealth = math.max(humanoid.MaxHealth, 1) local fraction = math.clamp(humanoid.Health / maxHealth, 0, 1) self._healthFraction = fraction
        if self._barTween then self._barTween:Cancel() end
        local goal = { Size = UDim2.new(fraction, 0, 1, 0), BackgroundColor3 = healthColor(fraction) }
        if instant then self._barFill.Size = goal.Size self._barFill.BackgroundColor3 = goal.BackgroundColor3
        else self._barTween = TweenService:Create(self._barFill, BAR_INFO, goal) self._barTween:Play() end
    end
    function TH:_updateDistance()
        local target = self._target local localPlayer = Players.LocalPlayer if not target or not localPlayer then return end
        local _, _, targetRoot = getCharacterParts(target) local _, _, myRoot = getCharacterParts(localPlayer)
        if targetRoot and myRoot then self._distanceLabel.Text = string.format("%.0f m", (targetRoot.Position - myRoot.Position).Magnitude / STUDS_PER_METER) else self._distanceLabel.Text = "-- m" end
    end
    function TH:_disconnectTarget() for _, conn in ipairs(self._connections) do pcall(function() conn:Disconnect() end) end table.clear(self._connections) end
    function TH:_bindHumanoid(humanoid, token)
        self:_setHealth(humanoid, true)
        table.insert(self._connections, humanoid.HealthChanged:Connect(function() if self._targetToken == token then self:_setHealth(humanoid) end end))
        table.insert(self._connections, humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(function() if self._targetToken == token then self:_setHealth(humanoid) end end))
    end
    function TH:SetTarget(player)
        if self._destroyed then return end
        self._targetToken += 1 local token = self._targetToken self:_disconnectTarget() self._target = player
        if not player then self:_fade(false) return end
        self._nameLabel.Text = player.DisplayName ~= player.Name and player.DisplayName or player.Name self._distanceLabel.Text = "-- m"
        local function bindCharacter(character) if self._targetToken ~= token or not character then return end local humanoid = character:WaitForChild("Humanoid", 5) if humanoid and self._targetToken == token then self:_bindHumanoid(humanoid, token) end end

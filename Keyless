local function getPlayerRole(plr) 
    local rData = roles[plr.Name] 
    if rData and rData.Role then return rData.Role end 
    local char = plr.Character 
    if char then 
        if char:FindFirstChild("Knife") or char:FindFirstChild("KnifeServer") then return "Murderer" end 
        if char:FindFirstChild("Gun") or char:FindFirstChild("GunServer") then return "Sheriff" end 
    end 
    local bp = plr:FindFirstChild("Backpack") 
    if bp then 
        if bp:FindFirstChild("Knife") or bp:FindFirstChild("KnifeServer") then return "Murderer" end 
        if bp:FindFirstChild("Gun") or bp:FindFirstChild("GunServer") then return "Sheriff" end 
    end 
    return "Innocent" 
end

local function getRoleColor(plr) 
    local role = getPlayerRole(plr) 
    if role == "Murderer" or role == "Zombie" then return Color3.fromRGB(255, 50, 50) end 
    if role == "Sheriff" then return Color3.fromRGB(50, 120, 255) end 
    return Color3.fromRGB(50, 255, 100) 
end


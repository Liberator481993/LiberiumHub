-- 2. ТЕПЕРЬ ЛОГИКА (В ОТДЕЛЬНОМ ПОТОКЕ, ЧТОБЫ НЕ ЛАГАЛО)
-- ==========================================
task.spawn(function()
    task.wait(1) -- Ждем, чтобы UI 100% отрисовался
    
    -- 1. Роли
    local roles = {}
    task.spawn(function()
        while task.wait(2) do
            safe(function()
                local getData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
                if getData and getData:IsA("RemoteFunction") then
                    local succ, data = getData:InvokeServer()
                    if succ and type(data) == "table" then roles = data end
                end
            end)
        end
    end)

    local function getColor(plr)
        local rData = roles[plr.Name]
        if rData then
            local r = rData.Role or rData[1]
            if r == "Murderer" then return ROLE_RED end
            if r == "Sheriff" then return ROLE_BLUE end
        end
        return ROLE_GREEN
    end

    -- 2. ESP
    local highlights = {}
    RunService.RenderStepped:Connect(function()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                if state.highlight and p.Character then
                    local hl = highlights[p]
                    if not hl or hl.Parent ~= p.Character then
                        if hl then hl:Destroy() end
                        hl = Instance.new("Highlight")
                        hl.OutlineTransparency = 0
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Parent = p.Character
                        highlights[p] = hl
                    end
                    local c = getColor(p)
                    hl.FillColor = c
                    hl.OutlineColor = c
                    hl.FillTransparency = state.highlightFill
                else
                    if highlights[p] then highlights[p]:Destroy(); highlights[p] = nil end
                end
            end
        end
    end)

    -- 3. Движение
    local origCol = setmetatable({}, {__mode = "k"})
    RunService.Stepped:Connect(function()
        if state.noclip and player.Character then
            for _, d in ipairs(player.Character:GetDescendants()) do
                if d:IsA("BasePart") then
                    if origCol[d] == nil then origCol[d] = d.CanCollide end
                    d.CanCollide = false
                end
            end
        end
    end)
    RunService.Heartbeat:Connect(function()
        if state.walkSpeedTouched then
            local h = getHumanoid()
            if h then h.WalkSpeed = state.walkSpeed end
        end
    end)

    -- 4. Фарм
    task.spawn(function()
        while task.wait(0.5) do
            if state.autoFarm and player.Character then
                safe(function()
                    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                    if not hrp then return end
                    local closest, minDist = nil, 100
                    
                    -- Ищем монеты
                    local main = playerGui:FindFirstChild("MainGUI")
                    local bags = main and main:FindFirstChild("Game") and main.Game:FindFirstChild("CoinBags")
                    if bags then
                        for _, bag in ipairs(bags:GetChildren()) do
                            if bag:IsA("BasePart") then
                                local d = (bag.Position - hrp.Position).Magnitude
                                if d < minDist then minDist = d; closest = bag end
                            end
                        end
                    end
                    -- Ищем конфеты
                    for _, obj in ipairs(Workspace:GetChildren()) do
                        if obj:IsA("BasePart") or obj:IsA("Model") then
                            local n = string.lower(obj.Name)
                            if n:find("candy") or n:find("sweet") then
                                local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                                local d = (pos - hrp.Position).Magnitude
                                if d < minDist then minDist = d; closest = obj end
                            end
                        end
                    end
                    if closest then
                        local pos = closest:IsA("Model") and closest:GetPivot().Position or closest.Position
                        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
                    end
                end)
            end
        end
    end)

    -- 5. Аимбот
    local aimTarget = nil
    local fovGui = Instance.new("Frame", screenGui)
    fovGui.Size = UDim2.fromOffset(240, 240); fovGui.AnchorPoint = Vector2.new(0.5, 0.5); fovGui.Position = UDim2.new(0.5, 0, 0.5, 0); fovGui.BackgroundTransparency = 1; fovGui.Visible = false
    local fovStr = Instance.new("UIStroke", fovGui); fovStr.Color = Theme.Accent; fovStr.Thickness = 1.5
    local fovCrn = Instance.new("UICorner", fovGui); fovCrn.CornerRadius = UDim.new(1, 0)

    UserInputService.InputBegan:Connect(function(i, gp)
        if gp then return end
        if state.aimbot and (i.UserInputType == Enum.UserInputType.MouseButton2 or i.UserInputType == Enum.UserInputType.Touch) then
            local cam = Workspace.CurrentCamera; local c, md = nil, state.aimFOV or 120
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and p.Character then
                    local h = p.Character:FindFirstChild("Head"); local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    if h and hum and hum.Health > 0 then
                        local sp, on = cam:WorldToViewportPoint(h.Position)
                        if on then
                            local d = (Vector2.new(sp.X, sp.Y) - Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)).Magnitude
                            if d < md then md = d; c = h end
                        end
                    end
                end
            end
            aimTarget = c
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton2 or i.UserInputType == Enum.UserInputType.Touch then aimTarget = nil end
    end)
    RunService.RenderStepped:Connect(function()
        if aimTarget and aimTarget.Parent then
            local cam = Workspace.CurrentCamera
            cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, aimTarget.Position), 0.3)
        end
        fovGui.Visible = state.aimbot
        if state.aimbot then fovGui.Size = UDim2.fromOffset((state.aimFOV or 120)*2, (state.aimFOV or 120)*2) end
    end)
end)

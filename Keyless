-- ==========================================
-- 8. AIMBOT (Плавное наведение камеры, без хуков памяти)
-- ==========================================
local aimTarget = nil

local function getClosestTarget()
    local closest = nil
    local shortestDist = CFG.AimFOV
    local cam = Workspace.CurrentCamera
    if not cam then return nil end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local part = plr.Character:FindFirstChild(CFG.AimPart)
            if hum and hum.Health > 0 and part then
                local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
                if onScreen then
                    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closest = part
                    end
                end
            end
        end
    end
    return closest
end

UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if CFG.Aimbot and (input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.Touch) then
        aimTarget = getClosestTarget()
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.Touch then
        aimTarget = nil
    end
end)

RunService.RenderStepped:Connect(function()
    if aimTarget and aimTarget.Parent then
        local cam = Workspace.CurrentCamera
        cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, aimTarget.Position), 0.25)
    end
end)


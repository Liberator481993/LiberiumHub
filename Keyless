UIToggle = (function()
    local UT = {}
    UT.__index = UT
    local DEFAULTS = {
        Keybind = Enum.KeyCode.RightShift, ButtonSize = 48, DragThreshold = 6,
        DisplayOrder = 999999, ZIndex = 1000, AlwaysShowButton = false,
        AccentColor = Color3.fromRGB(140, 90, 255), Parent = nil, OnToggle = nil,
    }
    local PRESS_TWEEN = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    function UT:_connect(signal, callback)
        local c = signal:Connect(function(...)
            local ok, err = pcall(callback, ...)
            if not ok then warn("[UIToggle] " .. tostring(err)) end
        end)
        table.insert(self._connections, c)
        return c
    end
    function UT:_tweenScale(target)
        if not self._scale then return end
        if self._scaleTween then self._scaleTween:Cancel() end
        local t = TweenService:Create(self._scale, PRESS_TWEEN, { Scale = target })
        self._scaleTween = t; t:Play()
    end
    function UT:_setButtonPosition(position)
        local gui, button = self._gui, self._button

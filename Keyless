        local gui = Instance.new("BillboardGui") gui.Name = "OverheadTracker" gui.Adornee = head gui.AlwaysOnTop = opts.AlwaysOnTop gui.Size = UDim2.fromOffset(opts.LabelSize.X, opts.LabelSize.Y) gui.StudsOffset = opts.HeadOffset gui.LightInfluence = 0 gui.ResetOnSpawn = false gui.ClipsDescendants = false gui.Active = false gui.Enabled = false gui.Parent = head
        local label = Instance.new("TextLabel") label.Name = "Label" label.Size = UDim2.fromScale(1,1) label.BackgroundColor3 = Color3.fromRGB(15,15,22) label.BackgroundTransparency = 0.45 label.BorderSizePixel = 0 label.Font = opts.Font label.TextSize = opts.TextSize label.TextColor3 = Color3.fromRGB(200,200,210) label.TextXAlignment = Enum.TextXAlignment.Center label.TextYAlignment = Enum.TextYAlignment.Center label.Text = "" label.Parent = gui

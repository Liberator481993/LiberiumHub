function Sec:AddSlider(name, mn, mx, def, cb, inc)
    inc = inc or 1 local val = math.clamp(def or mn, mn, mx)
    local r = create("Frame", {Size=UDim2.new(1,0,0,44),BackgroundColor3=THEME.Element,BackgroundTransparency=0.6,Parent=self.Frame}, {corner(6)})
    label({Text=name,Position=UDim2.fromOffset(10,4),Size=UDim2.new(1,-80,0,18),Parent=r})
    local vl = label({Text=tostring(val),TextColor3=THEME.SubText,TextXAlignment=Enum.TextXAlignment.Right,Position=UDim2.new(1,-70,0,4),Size=UDim2.fromOffset(60,18),Parent=r})
    local t = create("TextButton", {Position=UDim2.new(0,10,1,-14),Size=UDim2.new(1,-20,0,6),BackgroundColor3=Color3.fromRGB(55,55,70),Parent=r}, {corner(3)})
    local f = create("Frame", {Size=UDim2.fromScale((val-mn)/(mx-mn),1),BackgroundColor3=THEME.Accent,Parent=t}, {corner(3)})
    hover(r,r,0.6,0.4)
    local obj = {}
    function obj:Set(v, s) v = math.clamp(math.floor(v/inc+0.5)*inc, mn, mx) val=v vl.Text=tostring(math.round(v*1000)/1000) tween(f,TweenInfo.new(0.08),{Size=UDim2.fromScale((v-mn)/(mx-mn),1)}) if not s and cb then task.spawn(cb,v) end end
    local dr = false
    local function fromX(x) local a = math.clamp((x-t.AbsolutePosition.X)/t.AbsoluteSize.X,0,1) obj:Set(mn+(mx-mn)*a) end
    t.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dr=true fromX(i.Position.X) end end)
    table.insert(self.Win.Conns, UserInputService.InputChanged:Connect(function(i) if dr and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then fromX(i.Position.X) end end))
    table.insert(self.Win.Conns, UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dr=false end end))
    return obj
end

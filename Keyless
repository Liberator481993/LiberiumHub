-- ESP
local espCache = {}
local function applyESP(plr)
    if plr == LP then return end
    local char = getChar(plr)
    if not char then return end
    local role = getRole(plr)
    
    local hl = espCache[plr]
    if not hl or hl.Parent ~= char then
        if hl then hl:Destroy() end
        hl = Instance.new("Highlight")
        hl.FillTransparency = 0.6
        hl.OutlineTransparency = 0
        hl.Parent = char
        espCache[plr] = hl
    end
    
    if role == "Murderer" then
        hl.FillColor = Color3.fromRGB(220, 60, 60)
    elseif role == "Sheriff" then
        hl.FillColor = Color3.fromRGB(60, 140, 255)
    else
        hl.FillColor = Color3.fromRGB(80, 200, 120)
    end
    hl.Enabled = CFG.ESP
end

RunService.RenderStepped:Connect(function()
    if not CFG.ESP then
        for _, hl in pairs(espCache) do hl.Enabled = false end
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then applyESP(plr) end
    end
end)

-- Silent Aim (хук в голову)
local mt = getrawmetatable(game)
local oldIndex = mt.__index
setreadonly(mt, false)
mt.__index = newcclosure(function(self, key)
    if CFG.SilentAim and (key == "Hit" or key == "Target") then
        local tool = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
        if tool and tool.Name:find("Gun") then
            local closest, dist = nil, math.huge
            local origin = Cam.CFrame.Position
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LP then
                    local char = plr.Character
                    local head = char and char:FindFirstChild("Head")
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if head and hum and hum.Health > 0 then
                        local d = (head.Position - origin).Magnitude
                        if d < dist then dist = d; closest = head end
                    end
                end
            end
            if closest then
                if key == "Hit" then return CFrame.new(closest.Position) end
                if key == "Target" then return closest end
            end
        end
    end
    return oldIndex(self, key)
end)
setreadonly(mt, true)

-- Aimbot
local aimTarget = nil
UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if CFG.Aimbot and (input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.Touch) then
        local best, bd = nil, math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and (getRole(plr) == "Murderer" or getRole(plr) == "Sheriff") then
                local char, hrp, hum = getChar(plr)
                if hrp then
                    local d = (hrp.Position - Cam.CFrame.Position).Magnitude
                    if d < bd then bd = d; best = char.Head or hrp end
                end
            end
        end
        aimTarget = best
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.Touch then aimTarget = nil end
end)
RunService.RenderStepped:Connect(function()
    if aimTarget and aimTarget.Parent then
        Cam.CFrame = Cam.CFrame:Lerp(CFrame.new(Cam.CFrame.Position, aimTarget.Position), 0.2)
    end
end)

-- Auto Farm
local farmBV, farmBG
local function toggleFarm(on)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if on then
        if not farmBV then
            farmBV = Instance.new("BodyVelocity"); farmBV.MaxForce = Vector3.new(1e5, 1e5, 1e5); farmBV.Parent = hrp
            farmBG = Instance.new("BodyGyro"); farmBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5); farmBG.P = 1000; farmBG.Parent = hrp
        end
    else
        if farmBV then farmBV:Destroy(); farmBV = nil end
        if farmBG then farmBG:Destroy(); farmBG = nil end
    end
end

RunService.Heartbeat:Connect(function()
    if not CFG.AutoFarm then return end
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if not farmBV then toggleFarm(true) end
    local main = LP.PlayerGui:FindFirstChild("MainGUI")
    local bags = main and ((main:FindFirstChild("Lobby") and main.Lobby:FindFirstChild("CoinBags")) or (main:FindFirstChild("Game") and main.Game:FindFirstChild("CoinBags")))
    if bags then
        local closest, dist = nil, 100
        for _, bag in ipairs(bags:GetChildren()) do
            if bag:IsA("BasePart") then
                local d = (bag.Position - hrp.Position).Magnitude
                if d < dist then dist = d; closest = bag end
            end
        end
        if closest then
            farmBV.Velocity = (closest.Position - hrp.Position).Unit * 50
            farmBG.CFrame = CFrame.new(hrp.Position, closest.Position)
        end
    end
end)

-- Movement
local noclipConn
local function setNoclip(on)
    if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
    if not on then return end
    noclipConn = RunService.Stepped:Connect(function()
        local char = LP.Character
        if char then for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end end
    end)
end

RunService.Heartbeat:Connect(function()
    if CFG.Speed then
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = CFG.SpeedVal end
    end
end)

local flyConn, flyBV, flyBG
local function setFly(on)
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    if flyBV then flyBV:Destroy(); flyBV = nil end
    if flyBG then flyBG:Destroy(); flyBG = nil end
    if not on then return end
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    flyBV = Instance.new("BodyVelocity"); flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5); flyBV.Velocity = Vector3.zero; flyBV.Parent = hrp
    flyBG = Instance.new("BodyGyro"); flyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5); flyBG.P = 1000; flyBG.Parent = hrp
    flyConn = RunService.RenderStepped:Connect(function()
        local move = Vector3.zero
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = true end
        if UIS:IsKeyDown(Enum.KeyCode.W) then move += Cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then move -= Cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then move -= Cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then move += Cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.new(0, 1, 0) end
        flyBV.Velocity = move * 60
        flyBG.CFrame = Cam.CFrame
    end)
end


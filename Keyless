        ScrollBarThickness = 2, ScrollBarImageColor3 = UI.Violet,
        AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
        Parent = s.Inner,
    }, {
        create("UIPadding", {
            PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 12),
            PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
        }),
        create("UIListLayout", {Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder}),
    })

    local navLabel = uiText(s.Side, "WORKSPACE", 9, UI.Muted, Enum.Font.GothamBold)
    navLabel.LayoutOrder = 0
    navLabel.Size = UDim2.new(1, 0, 0, 18)
    navLabel.TextTransparency = 0.15

    s.Content = create("Frame", {
        Name = "Content", Position = UDim2.fromOffset(164, 62),
        Size = UDim2.new(1, -164, 1, -62), BackgroundTransparency = 1,
        Parent = s.Inner,
    })

    -- Drag from the header; keep connections owned by the window for clean teardown.
    local dragging, dragStart, startPosition = false, nil, nil
    table.insert(s.Conns, s.Title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPosition = true, input.Position, s.Main.Position
        end
    end))
    table.insert(s.Conns, UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local scale = math.max(s.Scale.Scale, 0.01)
        local delta = (input.Position - dragStart) / scale
        s.Main.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X,
            startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
    end))
    table.insert(s.Conns, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
    return s
end

function Win:_Select(tab)
    if self.Destroyed or self.Active == tab then return end
    self.Active = tab
    for _, item in ipairs(self.Tabs) do
        local active = item == tab
        item.ActiveMark.Visible = active
        tween(item.Btn, FAST, {
            BackgroundTransparency = active and 0.76 or 1,
            BackgroundColor3 = active and UI.Violet or UI.Surface,
        })
        tween(item.Lbl, FAST, {TextColor3 = active and UI.Text or UI.Muted})
        tween(item.Icon, FAST, {TextColor3 = active and UI.Cyan or UI.Muted})
        if not active then
            item.Cont.Visible = false
        end
    end
    tab.Cont.Visible = true
    tab.Cont.Position = UDim2.fromOffset(0, 6)
    tween(tab.Cont, SLOW, {Position = UDim2.fromOffset(0, 0)})
end

function Win:AddTab(name, icon)

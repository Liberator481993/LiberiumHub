local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Создаем экран для вывода текста
local gui = Instance.new("ScreenGui")
gui.Name = "InfoDetective"
gui.ResetOnSpawn = false
gui.DisplayOrder = 9999
gui.Parent = playerGui

local frame = Instance.new("ScrollingFrame")
frame.Size = UDim2.new(0.9, 0, 0.8, 0)
frame.Position = UDim2.new(0.05, 0, 0.1, 0)
frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
frame.BorderSizePixel = 2
frame.BorderColor3 = Color3.fromRGB(150, 50, 255)
frame.ScrollBarThickness = 5
frame.Parent = gui

local textLabel = Instance.new("TextLabel")
textLabel.Size = UDim2.new(1, 0, 1, 0)
textLabel.BackgroundTransparency = 1
textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
textLabel.TextXAlignment = Enum.TextXAlignment.Left
textLabel.TextYAlignment = Enum.TextYAlignment.Top
textLabel.Font = Enum.Font.Code
textLabel.TextSize = 14
textLabel.TextWrapped = true
textLabel.Text = "Загрузка данных...\n\n"
textLabel.Parent = frame

local function log(msg)
    textLabel.Text = textLabel.Text .. msg .. "\n"
end

-- 1. Проверка инжектора (хуки)
log("=== ПРОВЕРКА ИНЖЕКТОРА ===")
log("getrawmetatable: " .. tostring(getrawmetatable ~= nil))
log("hookfunction: " .. tostring(hookfunction ~= nil))
log("setreadonly: " .. tostring(setreadonly ~= nil))
log("is_synapse_function: " .. tostring(issynapsefunction ~= nil or is_synapse_function ~= nil))
log("----------------------------\n")

-- 2. Проверка РОЛЕЙ
log("=== ДАННЫЕ РОЛЕЙ ===")
local getData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
if getData and getData:IsA("RemoteFunction") then
    local success, data = pcall(function() return getData:InvokeServer() end)
    if success and type(data) == "table" then
        log("GetPlayerData РАБОТАЕТ.")
        local count = 0
        for name, roleData in pairs(data) do
            if count < 5 then -- Показываем только первых 5 игроков, чтобы не засорять экран
                log("Игрок: " .. tostring(name))
                if type(roleData) == "table" then
                    for k, v in pairs(roleData) do
                        log("  Ключ: " .. tostring(k) .. " = " .. tostring(v))
                    end
                else
                    log("  Значение: " .. tostring(roleData))
                end
            end
            count = count + 1
        end
    else
        log("GetPlayerData вернул ошибку или пустоту.")
    end
else
    log("GetPlayerData НЕ НАЙДЕН в ReplicatedStorage!")
end
log("----------------------------\n")

-- 3. Проверка МОНЕТ (MainGUI)
log("=== ПОИСК МОНЕТ (MainGUI) ===")
local main = playerGui:FindFirstChild("MainGUI")
if main then
    local gameFolder = main:FindFirstChild("Game")
    if gameFolder then
        for _, obj in ipairs(gameFolder:GetDescendants()) do
            local name = string.lower(obj.Name)
            if name:find("coin") or name:find("bag") or name:find("cash") or name:find("money") then
                log("Найдено: " .. obj:GetFullName())
            end
        end
    else
        log("Папка MainGUI.Game не найдена.")
    end
else
    log("MainGUI не найден.")
end
log("----------------------------\n")

-- 4. Проверка КОНФЕТ (Workspace)
log("=== ПОИСК КОНФЕТ (Workspace) ===")
local foundCandies = 0
for _, obj in ipairs(Workspace:GetDescendants()) do
    local name = string.lower(obj.Name)
    if name:find("candy") or name:find("sweet") then
        if foundCandies < 10 then -- Показываем первые 10, чтобы понять структуру
            log("Найдено: " .. obj:GetFullName() .. " [" .. obj.ClassName .. "]")
        end
        foundCandies = foundCandies + 1
    end
end
if foundCandies == 0 then
    log("Конфеты не найдены (возможно, сейчас не раунд или они называются иначе).")
else
    log("Всего найдено конфет: " .. foundCandies)
end
log("----------------------------\n")

log("КОНЕЦ СБОРА ДАННЫХ.")

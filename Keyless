local function CreateToggle(text, default, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 45)
    btn.BackgroundColor3 = Color3.fromRGB(22, 22, 25)
    btn.Text = "  " .. text
    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 14
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.Parent = Scroll
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 8); c.Parent = btn
    
    local isOn = default
    local indBg = Instance.new("Frame")
    indBg.Size = UDim2.new(0, 45, 0, 22)
    indBg.Position = UDim2.new(1, -55, 0.5, -11)
    indBg.BackgroundColor3 = isOn and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(40, 40, 45)
    indBg.Parent = btn
    local indC = Instance.new("UICorner"); indC.CornerRadius = UDim.new(1, 0); indC.Parent = indBg
    
    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0, 16, 0, 16)
    circle.Position = isOn and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
    circle.BackgroundColor3 = isOn and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(150, 150, 150)
    circle.Parent = indBg
    local cc = Instance.new("UICorner"); cc.CornerRadius = UDim.new(1, 0); cc.Parent = circle
    
    btn.MouseButton1Click:Connect(function()
        isOn = not isOn
        TweenService:Create(indBg, TweenInfo.new(0.15), {BackgroundColor3 = isOn and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(40, 40, 45)}):Play()
        TweenService:Create(circle, TweenInfo.new(0.15), {
            Position = isOn and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
            BackgroundColor3 = isOn and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(150, 150, 150)
        }):Play()
        callback(isOn)
    end)
end


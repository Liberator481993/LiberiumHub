local function getClosestMurderer(pos)
    local closestRoot, closestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local role = getPlayerRole(plr)
            if role == "Murderer" or role == "Zombie" then
                local pRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                if pRoot then local d = (pRoot.Position - pos).Magnitude if d < closestDist then closestRoot, closestDist = pRoot, d end end
            end
        end
    end
    return closestRoot, closestDist
end


-- ==========================================
-- 4. РОЛИ (Автообновление с fallback)
-- ==========================================
local roles = {}
local roleCache = {}

local function fetchRoles()
    pcall(function()
        local getData = RS:FindFirstChild("GetPlayerData", true)
        if getData and getData:IsA("RemoteFunction") then
            local success, data = getData:InvokeServer()
            if success and type(data) == "table" then roles = data end
        end
    end)
end

local function getRole(plr)
    -- 1. Пробуем из кэша (если обновляли недавно)
    local cached = roleCache[plr]
    if cached and tick() - cached._t < 2 then
        return cached.role
    end

    -- 2. Пробуем из GetPlayerData
    local roleData = roles[plr.Name]
    if roleData then
        local r = roleData.Role or roleData[1]
        if r then
            roleCache[plr] = { role = r, _t = tick() }
            return r
        end
    end

    -- 3. Fallback: ищем по инструментам (нож/пистолет)
    local char = plr.Character
    local role = "Innocent"
    if char then
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                local n = string.lower(tool.Name)
                if n:find("knife") or n:find("dagger") then role = "Murderer" end
                if n:find("gun") or n:find("revolver") then role = "Sheriff" end
            end
        end
    end
    roleCache[plr] = { role = role, _t = tick() }
    return role
end

-- Обновляем роли каждые 2 секунды в фоне
task.spawn(function()
    while task.wait(2) do
        fetchRoles()
    end
end)

-- ==========================================
-- 5. ESP (HIGHLIGHT - 100% СТАБИЛЬНО)
-- ==========================================
local espCache = {}

RunService.RenderStepped:Connect(function()
    if not CFG.ESP then
        for _, hl in pairs(espCache) do pcall(function() hl:Destroy() end) end
        table.clear(espCache)
        return
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local char = plr.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local hl = espCache[plr]
                if not hl or hl.Parent ~= char then
                    if hl then hl:Destroy() end
                    hl = Instance.new("Highlight")
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0
                    hl.Parent = char
                    espCache[plr] = hl
                end

                local role = getRole(plr)
                local col = Color3.fromRGB(0, 255, 0) -- Мирный
                if role == "Murderer" then col = Color3.fromRGB(255, 0, 0) -- Убийца
                elseif role == "Sheriff" then col = Color3.fromRGB(0, 100, 255) -- Шериф
                end
                hl.FillColor = col
                hl.OutlineColor = col
            end
        end
    end
end)

-- ==========================================
-- 6. AUTO FARM (Поиск CoinBags в MainGUI.Game)
-- ==========================================
task.spawn(function()
    while task.wait(0.5) do
        if CFG.AutoFarm and LP.Character then
            local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local main = LP.PlayerGui:FindFirstChild("MainGUI")
                local bags = main and main:FindFirstChild("Game") and main.Game:FindFirstChild("CoinBags")
                if bags then
                    local closest = nil
                    local dist = 100
                    for _, bag in ipairs(bags:GetChildren()) do
                        if bag:IsA("BasePart") then
                            local d = (bag.Position - hrp.Position).Magnitude
                            if d < dist then dist = d; closest = bag end
                        end
                    end
                    if closest then
                        hrp.CFrame = CFrame.new(closest.Position + Vector3.new(0, 3, 0))
                        task.wait(0.2)
                    end
                end
            end
        end
    end
end)


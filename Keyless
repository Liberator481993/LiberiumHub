local StatusText = Instance.new("TextLabel")
StatusText.Size = UDim2.new(0, 350, 0, 40)
StatusText.AnchorPoint = Vector2.new(0.5, 0.5)
StatusText.Position = UDim2.new(0.5, 0, 0.4, 60)
StatusText.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
StatusText.BackgroundTransparency = 0.4
StatusText.TextColor3 = Color3.fromRGB(0, 255, 0)
StatusText.Font = Enum.Font.Code
StatusText.TextSize = 16
StatusText.Text = "Ожидание..."
StatusText.Parent = ScreenGui

local function getContainer()
    return Workspace:FindFirstChild("CoinContainer", true)
end

local function moveToAndCollect(coin)
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    -- Добавляем в черный список, чтобы не лететь к ней снова
    blacklist[coin] = true

    -- 1. Отключаем физику, чтобы не трясло
    hrp.Anchored = true
    
    -- 2. Вычисляем безопасную скорость полета
    local targetPos = coin.Position + Vector3.new(0, 3, 0) -- Летим на 3 стада выше
    local distance = (hrp.Position - targetPos).Magnitude
    
    -- Скорость 120 стадов в секунду (безопасно для античита)
    local travelTime = math.clamp(distance / 120, 0.1, 0.8) 
    
    -- 3. Плавно летим (Tween)
    local tween = TweenService:Create(hrp, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), { CFrame = CFrame.new(targetPos) })
    tween:Play()
    tween.Completed:Wait()

    -- 4. Собираем монету
    pcall(function()
        firetouchinterest(hrp, coin, 0)
        firetouchinterest(hrp, coin, 1)
    end)
    
    for _, prompt in ipairs(coin:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            pcall(function() fireproximityprompt(prompt) end)
        end
    end

    -- 5. Ждем, пока сервер удалит монету (максимум 0.5 сек)
    local timeout = 0
    while coin.Parent and timeout < 0.5 do
        task.wait(0.05)
        timeout += 0.05
    end

    -- 6. Возвращаем физику и ждем, чтобы персонаж приземлился
    hrp.Anchored = false
    task.wait(0.1) -- Небольшая пауза перед следующей монетой, чтобы убрать рывки
end

-- Главный цикл
task.spawn(function()
    while task.wait(0.1) do
        if isFarming then
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            if not char or not hum or hum.Health <= 0 then
                StatusText.Text = "Вы мертвы или персонаж не загружен..."
                continue
            end

            local container = getContainer()
            if container then
                local closest, minDist = nil, math.huge
                
                -- Ищем ближайшую монету, которой нет в черном списке
                for _, coin in ipairs(container:GetChildren()) do
                    if coin.Name == "Coin_Server" and coin:IsA("BasePart") and not blacklist[coin] then
                        local dist = (coin.Position - hrp.Position).Magnitude
                        if dist < minDist then
                            minDist = dist
                            closest = coin
                        end
                    end
                end

                if closest then
                    StatusText.Text = "Летим к монете (" .. math.floor(minDist) .. " st)"
                    moveToAndCollect(closest)
                else
                    StatusText.Text = "Монет нет (ждем спавн)"
                end
            else
                StatusText.Text = "Папка CoinContainer не найдена"
            end
        end
    end
end)

-- Очистка черного списка от удаленных монет
task.spawn(function()
    while task.wait(5) do
        for coin in pairs(blacklist) do
            if not coin.Parent then
                blacklist[coin] = nil
            end
        end
    end
end)

Btn.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        Btn.Text = "FARM: ON"
        Btn.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
    else
        Btn.Text = "FARM: OFF"
        Btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        StatusText.Text = "Ожидание..."
        -- Если выключили в полете, возвращаем физику
        local char = LP.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.Anchored = false end
        end
    end
end)

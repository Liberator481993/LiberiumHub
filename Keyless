local function New(class, props, parent)
    local object = Instance.new(class)
    for property, value in pairs(props or {}) do object[property] = value end
    object.Parent = parent
    return object
end
local function Tween(object, duration, properties)
    if not object then return end
    local animation = TweenService:Create(object, TweenInfo.new(duration or 0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), properties)
    animation:Play() return animation
end
local function Round(object, radius) New("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, object) end
local function Outline(object, color, transparency, thickness) 
    local st = New("UIStroke", { Color = color or Theme.Border, Transparency = transparency or 0, Thickness = thickness or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, object)
    table.insert(UIElements.Strokes, st)
    return st
end
local function Text(parent, value, size, color, font) return New("TextLabel", { BackgroundTransparency = 1, Text = value, TextSize = size or 12, TextColor3 = color or Theme.White, Font = font or Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, 0, 1, 0) }, parent) end
local function Gradient(object, first, last, rotation) 
    local g = New("UIGradient", { Color = ColorSequence.new(first, last), Rotation = rotation or 0 }, object)
    table.insert(UIElements.Gradients, g)
    return g
end
local function MakeButton(parent, text, size) 
    local button = New("TextButton", { AutoButtonColor = false, Text = text, TextSize = 12, TextColor3 = Theme.Muted, Font = Enum.Font.GothamMedium, BackgroundColor3 = Theme.Card, BorderSizePixel = 0, Size = size }, parent)
    Round(button, 9) return button 
end


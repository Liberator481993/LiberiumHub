task.spawn(function()
    while true do
        if CFG.AutoFarm then
            collectSession()
            if CFG.AutoFarm then
                WaitForActivePhase(false)
                collectedCount = 0
                table.clear(Blacklist)
            end
        else
            task.wait(1)
        end
    end
end)


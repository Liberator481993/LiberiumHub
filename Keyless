local function createToggle(page, text, order, default, callback)
	local row = create("Frame", { Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = Theme.Panel, BorderSizePixel = 0, LayoutOrder = order }, page)
	addCorner(row, 10); addStroke(row, Theme.PanelLight, 1)
	create("TextLabel", { Size = UDim2.new(1, -80, 1, 0), Position = UDim2.fromOffset(14, 0), BackgroundTransparency = 1, Text = text, TextColor3 = Theme.Text, Font = Enum.Font.GothamMedium, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left }, row)
	local track = create("TextButton", { Size = UDim2.fromOffset(48, 26), Position = UDim2.new(1, -62, 0.5, -13), BackgroundColor3 = Theme.PanelLight, Text = "", AutoButtonColor = false }, row)
	addCorner(track, 13)
	local knob = create("Frame", { Size = UDim2.fromOffset(20, 20), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = Theme.Text, BorderSizePixel = 0 }, track)
	addCorner(knob, 10)
	local enabled = default
	local function render(anim) local c = enabled and Theme.Accent or Theme.PanelLight; local p = enabled and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3); if anim then tween(track, {BackgroundColor3 = c}); tween(knob, {Position = p}) else track.BackgroundColor3 = c; knob.Position = p end end
	render(false)
	track.MouseButton1Click:Connect(function() enabled = not enabled; render(true); if callback then safe(callback, enabled) end end)
end

local function createSlider(page, text, order, min, max, default, callback)
	local row = create("Frame", { Size = UDim2.new(1, 0, 0, 64), BackgroundColor3 = Theme.Panel, BorderSizePixel = 0, LayoutOrder = order }, page)
	addCorner(row, 10); addStroke(row, Theme.PanelLight, 1)
	create("TextLabel", { Size = UDim2.new(1, -90, 0, 24), Position = UDim2.fromOffset(14, 6), BackgroundTransparency = 1, Text = text, TextColor3 = Theme.Text, Font = Enum.Font.GothamMedium, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left }, row)
	local valLbl = create("TextLabel", { Size = UDim2.fromOffset(70, 24), Position = UDim2.new(1, -84, 0, 6), BackgroundTransparency = 1, Text = tostring(default), TextColor3 = Theme.Accent, Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Right }, row)
	local bar = create("TextButton", { Size = UDim2.new(1, -28, 0, 8), Position = UDim2.new(0, 14, 0, 44), BackgroundColor3 = Theme.PanelLight, Text = "", AutoButtonColor = false }, row)
	addCorner(bar, 4)
	local fill = create("Frame", { Size = UDim2.fromScale(math.clamp((default-min)/(max-min),0,1), 1), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0 }, bar)
	addCorner(fill, 4)
	local knob = create("Frame", { Size = UDim2.fromOffset(20, 20), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = Theme.Text, BorderSizePixel = 0, ZIndex = 2 }, fill)
	addCorner(knob, 10); addStroke(knob, Theme.Accent, 2)
	local dragging, active, last = false, nil, default
	local function update(x) local w = bar.AbsoluteSize.X; if w <= 0 then return end; local a = math.clamp((x - bar.AbsolutePosition.X)/w, 0, 1); local v = math.floor(min + (max-min)*a + 0.5); fill.Size = UDim2.fromScale(a, 1); valLbl.Text = tostring(v); if v ~= last then last = v; if callback then safe(callback, v) end end end
	bar.InputBegan:Connect(function(i) if isPress(i) then dragging = true; active = i; page.ScrollingEnabled = false; update(i.Position.X) end end)
	UserInputService.InputChanged:Connect(function(i) if dragging and isMove(i) and (i == active or i.UserInputType == Enum.UserInputType.MouseMovement) then update(i.Position.X) end end)
	UserInputService.InputEnded:Connect(function(i) if dragging and (i == active or isPress(i)) then dragging = false; active = nil; page.ScrollingEnabled = true end end)
end

local function makeDraggable(handle, target, scaleObj)
	local drag, active, start, startPos, moved = false, nil, Vector2.zero, target.Position, false
	handle.InputBegan:Connect(function(i) if isPress(i) then drag = true; active = i; moved = false; start = Vector2.new(i.Position.X, i.Position.Y); startPos = target.Position end end)
	UserInputService.InputChanged:Connect(function(i)
		if not drag or not isMove(i) then return end
		if i.UserInputType == Enum.UserInputType.Touch and i ~= active then return end
		safe(function() local d = Vector2.new(i.Position.X, i.Position.Y) - start; if d.Magnitude > 6 then moved = true end; if moved then local s = math.max(scaleObj.Scale, 0.01); target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X/s, startPos.Y.Scale, startPos.Y.Offset + d.Y/s) end end)
	end)
	UserInputService.InputEnded:Connect(function(i) if drag and (i == active or isPress(i)) then drag = false; active = nil end end)
	return { get moved() return moved end, set moved(v) moved = v end }
end


-- 2. UI
-- ==========================================
local Window = Slate:CreateWindow({ 
    Name = "Liberium Hub", 
    Subtitle = "MM2 Edition | No-Anim Farm", 
    Icon = "shield", 
    Logo = true, 
    Size = UDim2.fromOffset(550, 380), 
    ToggleKey = Enum.KeyCode.RightShift 
})

local uiscale = Instance.new("UIScale", Window.root)

local function getContainer()
    return Workspace:FindFirstChild("CoinContainer", true)
end

local function findNearest()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local closest, minDist = nil, math.huge
    local debugNames = {}

    -- 1. Сначала ищем Coin_Server (монеты), как ты и скидывал
    local container = getContainer()
    if container then
        for _, coin in ipairs(container:GetChildren()) do
            if coin.Name == "Coin_Server" and coin:IsA("BasePart") and not blacklist[coin] and coin.Transparency < 1 then
                local dist = (coin.Position - hrp.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    closest = coin
                end
            end
        end
    end

    -- 2. Если монет нет, ищем конфеты (все подряд в радиусе 50 стадов)
    if not closest then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if (obj:IsA("BasePart") or obj:IsA("Model")) and not blacklist[obj] then
                local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                local dist = (pos - hrp.Position).Magnitude
                
                if dist < 50 then -- Ищем только вблизи
                    local name = string.lower(obj.Name)
                    -- Проверяем, что это не часть персонажа и не стена
                    if not obj:IsDescendantOf(char) and (name:find("candy") or name:find("sweet") or name:find("halloween") or name:find("bag") or name:find("coin")) then
                        if dist < minDist then
                            minDist = dist
                            closest = obj
                        end
                    end
                end
            end
        end
    end
    return closest
end

-- Основной цикл
task.spawn(function()
    while task.wait(0.1) do
        if isFarming then
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            if not hrp or not hum or hum.Health <= 0 then
                StatusText.Text = "Мертв..."
                continue
            end

            if currentTarget and not currentTarget.Parent then
                currentTarget = nil
            end

            if not currentTarget then
                currentTarget = findNearest()
            end

            if currentTarget then
                -- ПОКАЗЫВАЕМ ИМЯ ЦЕЛИ
                StatusText.Text = "Цель найдена:\n" .. currentTarget.Name .. "\n(Класс: " .. currentTarget.ClassName .. ")"
                
                local targetPos = currentTarget:IsA("Model") and currentTarget:GetPivot().Position or currentTarget.Position
                hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 2.5, 0))
                
                pcall(function()
                    firetouchinterest(hrp, currentTarget, 0)
                    firetouchinterest(hrp, currentTarget, 1)
                end)
                for _, prompt in ipairs(currentTarget:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        pcall(function() fireproximityprompt(prompt) end)
                    end
                end
                
                blacklist[currentTarget] = true
                currentTarget = nil
            else
                StatusText.Text = "Ничего не найдено рядом (Ждем)"
            end
        end
    end
end)

Btn.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        Btn.Text = "FARM: ON"
        Btn.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
    else
        Btn.Text = "FARM: OFF"
        Btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        StatusText.Text = "Ожидание..."
    end
end)

task.spawn(function()
    while task.wait(5) do
        for obj in pairs(blacklist) do
            if not obj.Parent then blacklist[obj] = nil end
        end
    end
end)

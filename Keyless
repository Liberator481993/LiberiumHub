-- Логика открытия/закрытия
local function toggleMenu()
    CFG.MenuOpen = not CFG.MenuOpen
    if CFG.MenuOpen then
        pcall(function()
            if Window.root then Window.root.Visible = true end
            Window:Open() 
        end)
        UIStroke.Color = Color3.fromRGB(255, 60, 60)
    else
        pcall(function()
            Window:Close()
            if Window.root then Window.root.Visible = false end
        end)
        UIStroke.Color = Color3.fromRGB(0, 255, 102)
    end
end

IconBtn.MouseButton1Click:Connect(function()
    task.delay(0.1, function()
        if not dragging then toggleMenu() end
    end)
end)


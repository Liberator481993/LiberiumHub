        return { Gui = gui, Label = label, Stroke = stroke, Head = head, Shown = false, Level = 0, LastText = nil, Color = nil, ScreenX = 0, ScreenY = 0, AdjY = 0, Depth = 0 }
    end
    function OT.new(getRoleFunction, options)
        local opts = table.clone(DEFAULTS) for key, value in pairs(options or {}) do opts[key] = value end
        local self = setmetatable({ _getRoles = getRoleFunction, _options = opts, _roleColors = DEFAULT_ROLE_COLORS, _colorCache = {}, _records = {}, _connections = {}, _heartbeat = nil, _elapsed = 0, _visible = false, _destroyed = false, _lastRoles = {}, _scratch = {} }, OT)
        table.insert(self._connections, Players.PlayerAdded:Connect(function(player) self:_trackPlayer(player) end)) table.insert(self._connections, Players.PlayerRemoving:Connect(function(player) self:_untrackPlayer(player) end))
        for _, player in ipairs(Players:GetPlayers()) do self:_trackPlayer(player) end
        return self
    end
    function OT:_isCurrent(record, generation) return not self._destroyed and self._records[record.Player] == record and record.Generation == generation end
    function OT:_clearCharacter(record) record.Generation += 1 for _, connection in ipairs(record.CharConnections) do connection:Disconnect() end table.clear(record.CharConnections) local entry = record.Entry if entry then record.Entry = nil entry.Gui:Destroy() end end
    function OT:_setupCharacter(record, character)
        self:_clearCharacter(record) local generation = record.Generation
        task.spawn(function() local ok, err = pcall(function() local head = character:WaitForChild("Head", 10) if not head or not self:_isCurrent(record, generation) then return end local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5) if not self:_isCurrent(record, generation) then return end if humanoid and humanoid.Health <= 0 then return end record.Entry = createEntry(head, self._options) if humanoid then table.insert(record.CharConnections, humanoid.Died:Once(function() if self:_isCurrent(record, generation) then self:_clearCharacter(record) end end)) end end) end)
    end
    function OT:_trackPlayer(player) if player == LocalPlayer or self._records[player] or self._destroyed then return end local record = { Player = player, Entry = nil, Generation = 0, PlayerConnections = {}, CharConnections = {} } self._records[player] = record table.insert(record.PlayerConnections, player.CharacterAdded:Connect(function(character) self:_setupCharacter(record, character) end)) table.insert(record.PlayerConnections, player.CharacterRemoving:Connect(function() self:_clearCharacter(record) end)) if player.Character then self:_setupCharacter(record, player.Character) end end
    function OT:_untrackPlayer(player) local record = self._records[player] if not record then return end self._records[player] = nil self:_clearCharacter(record) for _, connection in ipairs(record.PlayerConnections) do connection:Disconnect() end table.clear(record.PlayerConnections) end
    function OT:_fetchRoles() local ok, result = pcall(self._getRoles) if ok and type(result) == "table" then self._lastRoles = result return result end return self._lastRoles end
    function OT:_colorFor(roleText) local color = self._colorCache[roleText] if not color then color = self._roleColors[string.lower(roleText)] or Color3.fromRGB(200,200,210) self._colorCache[roleText] = color end return color end
    
    function OT:_update()
        local opts = self._options local camera = workspace.CurrentCamera if not camera then return end
        local character = LocalPlayer.Character local root = character and character:FindFirstChild("HumanoidRootPart") local origin = root and root.Position or camera.CFrame.Position
        local roles = self:_fetchRoles() local maxDistance = opts.MaxDistance local onScreenEntries = self._scratch table.clear(onScreenEntries)
        for _, record in pairs(self._records) do
            local entry = record.Entry
            if entry then
                local head = entry.Head if not head.Parent then self:_clearCharacter(record) continue end
                local position = head.Position local distance = (position - origin).Magnitude
                local data = roles[record.Player.UserId] or roles[tostring(record.Player.UserId)] or roles[record.Player.Name] local role = type(data) == "table" and data.Role or data
                if distance > maxDistance or (role == nil and not CFG.ESP_Name) then setShown(entry, false) applyLevel(entry, 0) continue end
                
                local showName = CFG.ESP_Name
                local showDist = CFG.ESP_Distance
                local roleText = role and tostring(role) or "Unknown"
                local distText = math.floor(distance + 0.5) .. "m"
                
                if not showName and not showDist then setShown(entry, false) applyLevel(entry, 0) continue end
                
                local finalText = ""
                if showName and showDist then finalText = roleText .. " [" .. distText .. "]"
                elseif showName then finalText = roleText
                elseif showDist then finalText = distText end
                
                if entry.LastText ~= finalText then entry.LastText = finalText entry.Label.Text = finalText end
                
                local color = self:_colorFor(roleText) 
                if entry.Color ~= color then entry.Color = color entry.Label.TextColor3 = color entry.Stroke.Color = color end
                
                setShown(entry, true) 
                local screen, onScreen = camera:WorldToViewportPoint(position)
                if onScreen then entry.ScreenX = screen.X entry.ScreenY = screen.Y entry.Depth = screen.Z table.insert(onScreenEntries, entry) else applyLevel(entry, 0) end
            end
        end
        local count = #onScreenEntries if count == 0 then return end table.sort(onScreenEntries, byDepth)
        local width, height = opts.LabelSize.X, opts.LabelSize.Y local maxLevels = 4
        for i = 1, count do 
            local entry = onScreenEntries[i] local level = 0 
            while level < maxLevels do 
                local y = entry.ScreenY - level * height local blocked = false 
                for j = 1, i - 1 do local other = onScreenEntries[j] if math.abs(entry.ScreenX - other.ScreenX) < width and math.abs(y - other.AdjY) < height then blocked = true break end end 
                if not blocked then break end level += 1 
            end 
            entry.AdjY = entry.ScreenY - level * height applyLevel(entry, level) 
        end
    end
    function OT:_onHeartbeat(dt) self._elapsed += dt if self._elapsed < self._options.UpdateInterval then return end self._elapsed = 0 if not self._visible then return end local ok, err = pcall(self._update, self) end
    function OT:_hideAll() for _, record in pairs(self._records) do local entry = record.Entry if entry then setShown(entry, false) end end end
    function OT:Start() if self._destroyed or self._heartbeat then return end self._elapsed = self._options.UpdateInterval self._visible = true self._heartbeat = RunService.Heartbeat:Connect(function(dt) self:_onHeartbeat(dt) end) end
    function OT:Stop() if self._heartbeat then self._heartbeat:Disconnect() self._heartbeat = nil end self._visible = false self:_hideAll() end
    function OT:Destroy() if self._destroyed then return end self._destroyed = true if self._heartbeat then self._heartbeat:Disconnect() self._heartbeat = nil end for _, connection in ipairs(self._connections) do connection:Disconnect() end table.clear(self._connections) for player in pairs(table.clone(self._records)) do self:_untrackPlayer(player) end table.clear(self._scratch) table.clear(self._colorCache) self._lastRoles = {} self._getRoles = function() return {} end end
    return OT
end)()

local Stabilizer = (function()
    local CONFIG = { LinearThreshold = 1000, LinearSafe = 250, AngularThreshold = 1000, AngularSafe = 50, DampRate = 14, IgnoreVerticalInFreefall = true }
    local ignored = setmetatable({}, {__mode = "k"}) local damping = setmetatable({}, {__mode = "k"}) local API = {}
    local function damp(v, thr, sf, al, st, k, igY) local y = igY and v.Y or 0 local f = igY and Vector3.new(v.X,0,v.Z) or v local m = f.Magnitude if not st[k] then if m <= thr then return nil end st[k] = true end if m <= sf * 1.05 then st[k] = false return nil end local nm = m + (sf - m) * al local d = f.Unit * nm return igY and Vector3.new(d.X, y, d.Z) or d end
    local function step(dt) local char = LocalPlayer.Character if not char then return end local root = char:FindFirstChild("HumanoidRootPart") if not root or ignored[char] then return end local st = damping[root] or {linear=false, angular=false} damping[root] = st local al = 1 - math.exp(-CONFIG.DampRate * dt) local hum = char:FindFirstChildOfClass("Humanoid") local ff = CONFIG.IgnoreVerticalInFreefall and hum and hum:GetState() == Enum.HumanoidStateType.Freefall local l = damp(root.AssemblyLinearVelocity, CONFIG.LinearThreshold, CONFIG.LinearSafe, al, st, "linear", ff) if l then root.AssemblyLinearVelocity = l end local a = damp(root.AssemblyAngularVelocity, CONFIG.AngularThreshold, CONFIG.AngularSafe, al, st, "angular", false) if a then root.AssemblyAngularVelocity = a end end
    function API.Start() if not API._conn then API._conn = RunService.Heartbeat:Connect(step) end end
    function API.Stop() if API._conn then API._conn:Disconnect() API._conn = nil end end
    return API
end)()


local function getContainer()
    local gameW = Workspace:FindFirstChild("Game")
    if gameW and gameW:FindFirstChild("CoinContainer") then
        return gameW.CoinContainer
    end
    return Workspace:FindFirstChild("CoinContainer", true)
end

local function findNearest()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local container = getContainer()
    if not container then return nil end
    
    local closest, minDist = nil, math.huge
    for _, obj in ipairs(container:GetChildren()) do
        -- СТРОГИЙ ПОИСК: Только Coin_Server
        if obj.Name == "Coin_Server" and obj:IsA("BasePart") and not blacklist[obj] then
            local dist = (obj.Position - hrp.Position).Magnitude
            if dist < minDist then
                minDist = dist
                closest = obj
            end
        end
    end
    return closest
end

-- Основной цикл (Плавный полет с безопасной скоростью)
RunService.Heartbeat:Connect(function()
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if isFarming then
        -- Noclip (сквозь стены)
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        if not hum.PlatformStand then hum.PlatformStand = true end

        -- Физика
        if not bv or bv.Parent ~= hrp then
            if bv then bv:Destroy() end
            if bg then bg:Destroy() end
            bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.P = 1250
            bv.Parent = hrp
            bg = Instance.new("BodyGyro")
            bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bg.P = 1000
            bg.Parent = hrp
        end

        if currentTarget and not currentTarget.Parent then
            currentTarget = nil
        end

        if not currentTarget then
            currentTarget = findNearest()
        end

        if currentTarget then
            local targetPos = currentTarget.Position
            local distance = (hrp.Position - targetPos).Magnitude

            StatusText.Text = "Летим: Coin_Server (" .. math.floor(distance) .. " st)"

            if distance < 4 then
                -- Долетели, собираем
                bv.Velocity = Vector3.zero
                blacklist[currentTarget] = true
                
                pcall(function()
                    firetouchinterest(hrp, currentTarget, 0)
                    firetouchinterest(hrp, currentTarget, 1)
                end)
                for _, prompt in ipairs(currentTarget:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        pcall(function() fireproximityprompt(prompt) end)
                    end
                end
                
                currentTarget = nil
                task.wait(0.1) -- Микро-пауза для сервера
            else
                -- Летим (Скорость 40 - безопасно для античита)
                local dir = (targetPos - hrp.Position).Unit
                bv.Velocity = dir * 40
                bg.CFrame = CFrame.new(hrp.Position, targetPos)
            end
        else
            bv.Velocity = Vector3.zero
            StatusText.Text = "Нет монет (ждем раунд)"
        end
    else
        -- Выключено
        if bv then bv:Destroy(); bv = nil end
        if bg then bg:Destroy(); bg = nil end
        if hum.PlatformStand then hum.PlatformStand = false end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end
end)

-- Очистка
task.spawn(function()
    while task.wait(5) do
        for obj in pairs(blacklist) do
            if not obj.Parent then blacklist[obj] = nil end
        end
    end
end)


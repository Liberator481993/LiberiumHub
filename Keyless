-- Ссылки на физические объекты
local alignPos = nil
local alignOri = nil

local function setupPhysics(hrp)
    if alignPos then alignPos:Destroy() end
    if alignOri then alignOri:Destroy() end

    alignPos = Instance.new("AlignPosition")
    alignPos.Mode = Enum.PositionAlignmentMode.OneAttachment
    alignPos.MaxForce = math.huge
    alignPos.Responsiveness = 200 -- Скорость притяжения (чем выше, тем быстрее летит)
    alignPos.Attachment0 = hrp:FindFirstChild("RootAttachment") or Instance.new("Attachment", hrp)
    alignPos.Parent = hrp

    alignOri = Instance.new("AlignOrientation")
    alignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment
    alignOri.MaxTorque = math.huge
    alignOri.Responsiveness = 200
    alignOri.Attachment0 = alignPos.Attachment0
    alignOri.Parent = hrp
end

local function destroyPhysics()
    if alignPos then alignPos:Destroy(); alignPos = nil end
    if alignOri then alignOri:Destroy(); alignOri = nil end
end

local function setNoclip(state)
    local char = LP.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not state
        end
    end
end

local function getContainer()
    return Workspace:FindFirstChild("CoinContainer", true)
end

local function findNearest()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local container = getContainer()
    if not container then return nil end
    
    local closest, minDist = nil, math.huge
    for _, coin in ipairs(container:GetChildren()) do
        if coin.Name == "Coin_Server" and coin:IsA("BasePart") and not blacklist[coin] then
            local dist = (coin.Position - hrp.Position).Magnitude
            if dist < minDist then
                minDist = dist
                closest = coin
            end
        end
    end
    return closest
end

-- Главный цикл
task.spawn(function()
    while task.wait(0.1) do
        if isFarming then
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            if not char or not hum or hum.Health <= 0 then
                StatusText.Text = "Мертв..."
                continue
            end

            -- Если физика не настроена, настраиваем
            if not alignPos then
                setupPhysics(hrp)
                hum.PlatformStand = true
                setNoclip(true)
            end

            -- Если цель украли, ищем новую
            if currentTarget and not currentTarget.Parent then
                currentTarget = nil
            end

            -- Ищем новую цель
            if not currentTarget then
                currentTarget = findNearest()
                if currentTarget then
                    StatusText.Text = "Летим к монете!"
                else
                    StatusText.Text = "Монет нет..."
                    alignPos.Position = hrp.Position -- Висим на месте
                end
            end

            -- Летим
            if currentTarget then
                local targetPos = currentTarget.Position
                local distance = (hrp.Position - targetPos).Magnitude

                if distance < 3.5 then
                    -- Долетели
                    blacklist[currentTarget] = true
                    pcall(function()
                        firetouchinterest(hrp, currentTarget, 0)
                        firetouchinterest(hrp, currentTarget, 1)
                    end)
                    for _, prompt in ipairs(currentTarget:GetDescendants()) do
                        if prompt:IsA("ProximityPrompt") then
                            pcall(function() fireproximityprompt(prompt) end)
                        end
                    end
                    currentTarget = nil
                    task.wait(0.1)
                else
                    -- Тянем к цели
                    alignPos.Position = targetPos
                    alignOri.CFrame = CFrame.new(hrp.Position, targetPos)
                end
            end
        else
            -- Выключено
            if alignPos then
                destroyPhysics()
                setNoclip(false)
                local char = LP.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then hum.PlatformStand = false end
                end
            end
        end
    end
end)

-- Очистка
task.spawn(function()
    while task.wait(5) do
        for coin in pairs(blacklist) do
            if not coin.Parent then blacklist[coin] = nil end
        end
    end
end)


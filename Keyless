    end
    function CH:Destroy() if self._destroyed then return end self._destroyed = true self._flashToken += 1 self:_cancelTweens() if self._hideCursor then UserInputService.MouseIconEnabled = self._previousCursorState end pcall(function() self._gui:Destroy() end) end

local TabFarm = Window:CreateTab({ Name = "Farm", Icon = "coins" })
local TabMisc = Window:CreateTab({ Name = "Misc", Icon = "settings" })

-- ==========================================
-- 3. РОЛИ И ESP
-- ==========================================
local roles = {}
task.spawn(function()
    while task.wait(1) do
        pcall(function()
            local getData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
            if getData and getData:IsA("RemoteFunction") then
                local success, data = getData:InvokeServer()
                if success and type(data) == "table" then roles = data end
            end
        end)
    end
end)

local function getRoleColor(plr)
    local rData = roles[plr.Name]
    if rData and rData.Role then
        local r = rData.Role
        if r == "Murderer" or r == "Zombie" then return Color3.fromRGB(255, 50, 50) end
        if r == "Sheriff" then return Color3.fromRGB(50, 120, 255) end
        if r == "Survivor" then return Color3.fromRGB(255, 165, 0) end
    end
    return Color3.fromRGB(50, 255, 100)
end

RunService.RenderStepped:Connect(function()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local char = p.Character
            local ourHighlight = nil
            local toDestroy = {}
            for _, child in ipairs(char:GetChildren()) do
                if child:IsA("Highlight") then
                    if child.Name == "LibESP" and not ourHighlight then
                        ourHighlight = child
                    else
                        table.insert(toDestroy, child)
                    end
                end
            end
            for _, hl in ipairs(toDestroy) do hl:Destroy() end
            
            if CFG.ESP then
                if not ourHighlight then
                    ourHighlight = Instance.new("Highlight")
                    ourHighlight.Name = "LibESP"
                    ourHighlight.OutlineTransparency = 0
                    ourHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    ourHighlight.Parent = char
                end
                local c = getRoleColor(p)
                ourHighlight.FillColor = c
                ourHighlight.OutlineColor = c
            end
        end
    end
end)

-- ==========================================
-- 4. MOVEMENT
-- ==========================================
local originalCollide = setmetatable({}, {__mode = "k"})
RunService.Stepped:Connect(function()
    if (CFG.Noclip or CFG.AutoFarm) and LP.Character then
        for _, d in ipairs(LP.Character:GetDescendants()) do
            if d:IsA("BasePart") then
                if originalCollide[d] == nil then originalCollide[d] = d.CanCollide end
                d.CanCollide = false
            end
        end
    elseif not CFG.Noclip and not CFG.AutoFarm then
        for p, c in pairs(originalCollide) do 
            pcall(function() if p and p.Parent then p.CanCollide = c end end) 
        end
        table.clear(originalCollide)
    end
end)

RunService.Heartbeat:Connect(function()
    if LP.Character then
        local hum = LP.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.WalkSpeed ~= CFG.WalkSpeed and not CFG.AutoFarm then 
            hum.WalkSpeed = CFG.WalkSpeed 
        end
    end
end)

-- ==========================================
-- 5. AUTO FARM (БЕЗ АНИМАЦИИ БЕГА)
-- ==========================================
local currentTarget = nil
local blacklist = {}
local isMoving = false

local function findNearest()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local container = Workspace:FindFirstChild("CoinContainer", true)
    if not container then return nil end
    
    local closest, minDist = nil, math.huge
    for _, obj in ipairs(container:GetChildren()) do
        if obj.Name == "Coin_Server" and obj:IsA("BasePart") and not blacklist[obj] then
            local dist = (obj.Position - hrp.Position).Magnitude
            if dist < minDist then
                minDist = dist
                closest = obj
            end
        end
    end
    return closest
end

local function flyToAndCollect(coin)
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    isMoving = true
    blacklist[coin] = true
    
    -- 1. Отключаем анимации и физику бега
    hrp.Anchored = true
    hum.PlatformStand = true
    hum:ChangeState(Enum.HumanoidStateType.Physics) -- Убирает анимацию бега

    -- 2. Плавно летим
    local targetPos = coin.Position + Vector3.new(0, 2, 0)
    local distance = (hrp.Position - targetPos).Magnitude
    local travelTime = math.clamp(distance / CFG.FarmSpeed, 0.1, 0.5)
    
    local tween = TweenService:Create(hrp, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), { CFrame = CFrame.new(targetPos) })
    tween:Play()
    tween.Completed:Wait()

    -- 3. Собираем
    pcall(function()
        firetouchinterest(hrp, coin, 0)
        firetouchinterest(hrp, coin, 1)
    end)
    for _, prompt in ipairs(coin:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            pcall(function() fireproximityprompt(prompt) end)
        end
    end

    task.wait(0.2) -- Ждем удаления

    -- 4. Возвращаем физику и анимации
    hrp.Anchored = false
    hum.PlatformStand = false
    hum:ChangeState(Enum.HumanoidStateType.GettingUp) -- Возвращает анимацию бега
    isMoving = false
end

-- Главный цикл
task.spawn(function()
    while task.wait(0.1) do
        if CFG.AutoFarm and not isMoving then
            local char = LP.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not char or not hum or hum.Health <= 0 then continue end
            local coin = findNearest()
            if coin then
                flyToAndCollect(coin)
            end
        end
    end
end)

task.spawn(function()
    while task.wait(5) do
        for obj in pairs(blacklist) do
            if not obj.Parent then blacklist[obj] = nil end
        end
    end
end)


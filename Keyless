local function getRoleColor(plr)
    local rData = roles[plr.Name]
    if rData and rData.Role then
        local r = rData.Role
        if r == "Murderer" or r == "Zombie" then return Color3.fromRGB(255, 50, 50) end
        if r == "Sheriff" then return Color3.fromRGB(50, 120, 255) end
        if r == "Survivor" or r == "Innocent" then return Color3.fromRGB(255, 165, 0) end
    end
    return Color3.fromRGB(50, 255, 100)
end

local function canCollect()
    if not canFarmNow then return false end
    local s = currentSession
    if not s or s.destroyed or s.humanoid.Health <= 0 then return false end
    
    local myData = roles[player.Name]
    if not myData then return false end 
    if myData.Dead then return false end
    
    local r = myData.Role
    if not r or r == "Spectator" or r == "Lobby" or r == "None" then return false end

    local container = Workspace:FindFirstChild("CoinContainer", true)
    if not container or #container:GetChildren() == 0 then return false end
    
    return true
end


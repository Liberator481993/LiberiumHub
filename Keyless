local function CreateTab(name, title)
    local btn = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = C.panel,
        BackgroundTransparency = 1,
        Text = "  " .. title,
        TextColor3 = C.muted,
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Parent = TabHolder,
    })
    create("UICorner", {CornerRadius = UDim.new(0, 8)}, btn)

    local page = create("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        Parent = Content,
    })
    create("UIListLayout", {Padding = UDim.new(0, 8)}, page)
    Pages[name] = {Btn = btn, Page = page}

    btn.MouseButton1Click:Connect(function()
        for _, p in pairs(Pages) do
            p.Page.Visible = false
            TweenService:Create(p.Btn, TweenInfo.new(0.2), {TextColor3 = C.muted, BackgroundTransparency = 1}):Play()
        end
        page.Visible = true
        btn.TextColor3 = C.text
        btn.BackgroundTransparency = 0.8
        currentPage = name
    end)

    if not currentPage then
        currentPage = name
        page.Visible = true
        btn.TextColor3 = C.text
        btn.BackgroundTransparency = 0.8
    end
end

local function CreateToggle(parent, text, default, callback)
    local btn = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 45),
        BackgroundColor3 = C.panel,
        Text = "  " .. text,
        TextColor3 = C.text,
        Font = Enum.Font.Gotham,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Parent = parent,
    })
    create("UICorner", {CornerRadius = UDim.new(0, 8)}, btn)
    local isOn = default
    local ind = create("Frame", {
        Size = UDim2.new(0, 40, 0, 20),
        Position = UDim2.new(1, -50, 0.5, -10),
        BackgroundColor3 = isOn and C.accent or C.bg,
        Parent = btn,
    })
    create("UICorner", {CornerRadius = UDim.new(1, 0)}, ind)
    local circle = create("Frame", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = isOn and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
        BackgroundColor3 = Color3.new(1, 1, 1),
        Parent = ind,
    })
    create("UICorner", {CornerRadius = UDim.new(1, 0)}, circle)

    btn.MouseButton1Click:Connect(function()
        isOn = not isOn
        TweenService:Create(ind, TweenInfo.new(0.2), {BackgroundColor3 = isOn and C.accent or C.bg}):Play()
        TweenService:Create(circle, TweenInfo.new(0.2), {Position = isOn and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)}):Play()
        callback(isOn)
    end)
end


function Library:ToggleVisible()
    self.Visible = not self.Visible
    local blur = Lighting:FindFirstChild("LiberiumBlur")
    if self.Visible then 
        self.Root.Visible = true Tween(self.Root, 0.25, {BackgroundTransparency = 0.25}) self.OpenButton.Visible = false
        if blur then Tween(blur, 0.4, {Size = 15}) end
    else 
        Tween(self.Root, 0.25, {BackgroundTransparency = 1}) 
        if blur then Tween(blur, 0.4, {Size = 0}) end
        task.delay(0.25, function() if not self.Visible then self.Root.Visible = false self.OpenButton.Visible = true end end) 
    end
end


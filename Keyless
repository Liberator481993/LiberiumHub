local VisualOptimizer = (function()
    local VO = {} local EFFECT_CLASSES = { "ParticleEmitter", "Smoke", "Fire", "Sparkles" } local OPTIMIZED = { GlobalShadows = false, EnvironmentDiffuseScale = 0, WaterWaveSize = 0 } local BATCH_SIZE = 500 local isEnabled = false local runToken = 0 local effectCache = setmetatable({}, { __mode = "k" }) local settingsCache = nil local addedConnection = nil
    local function isEffect(inst) for _, className in ipairs(EFFECT_CLASSES) do if inst:IsA(className) then return true end end return false end
    local function disableEffect(inst) pcall(function() if effectCache[inst] == nil then effectCache[inst] = inst.Enabled end inst.Enabled = false end) end
    local function getTerrain() return Workspace:FindFirstChildOfClass("Terrain") end
    local function applyOptimized()
        runToken += 1 local myToken = runToken
        if not settingsCache then settingsCache = {} pcall(function() settingsCache.GlobalShadows = Lighting.GlobalShadows settingsCache.EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale end) pcall(function() local terrain = getTerrain() if terrain then settingsCache.WaterWaveSize = terrain.WaterWaveSize end end) end
        pcall(function() Lighting.GlobalShadows = OPTIMIZED.GlobalShadows Lighting.EnvironmentDiffuseScale = OPTIMIZED.EnvironmentDiffuseScale end) pcall(function() local terrain = getTerrain() if terrain then terrain.WaterWaveSize = OPTIMIZED.WaterWaveSize end end)
        addedConnection = Workspace.DescendantAdded:Connect(function(inst) if isEffect(inst) then disableEffect(inst) end end)
        task.spawn(function() local count = 0 for _, inst in ipairs(Workspace:GetDescendants()) do if runToken ~= myToken then return end if isEffect(inst) then disableEffect(inst) end count += 1 if count % BATCH_SIZE == 0 then task.wait() end end end)
    end
    local function restoreOriginal()
        runToken += 1 if addedConnection then addedConnection:Disconnect() addedConnection = nil end
        for inst, original in pairs(effectCache) do pcall(function() if inst.Parent then inst.Enabled = original end end) effectCache[inst] = nil end
        if settingsCache then pcall(function() if settingsCache.GlobalShadows ~= nil then Lighting.GlobalShadows = settingsCache.GlobalShadows end if settingsCache.EnvironmentDiffuseScale ~= nil then Lighting.EnvironmentDiffuseScale = settingsCache.EnvironmentDiffuseScale end end) pcall(function() local terrain = getTerrain() if terrain and settingsCache.WaterWaveSize ~= nil then terrain.WaterWaveSize = settingsCache.WaterWaveSize end end) settingsCache = nil end
    end
    function VO.OptimizeVisuals(enable) enable = enable == true if enable == isEnabled then return end isEnabled = enable if enable then applyOptimized() else restoreOriginal() end end
    function VO.IsEnabled() return isEnabled end
    return VO
end)()


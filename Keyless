local tabs = {}
local activeTab = nil
local function selectTab(name)
	for tabName, tab in pairs(tabs) do
		local active = tabName == name
		tween(tab.button, { BackgroundColor3 = active and Theme.Accent or Theme.PanelLight, TextColor3 = active and Theme.Text or Theme.Muted })
		tab.page.Visible = active
	end
	activeTab = name
end

local function createTab(name, order)

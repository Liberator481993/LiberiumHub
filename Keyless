local function setNoclip(char, state) if not char then return end for _, d in ipairs(char:GetDescendants()) do if d:IsA("BasePart") then if state then if originalCollide[d] == nil then originalCollide[d] = d.CanCollide end d.CanCollide = false else if originalCollide[d] ~= nil then d.CanCollide = originalCollide[d] originalCollide[d] = nil end end end end end

local function flyTo(target)
    local s = currentSession if not s or s.destroyed or s.humanoid.Health <= 0 or not target.Parent then return false end s.target = target
    local arrived = false local startTime = os.clock() local lastPos = s.root.Position local stuckCounter = 0
    local ok, err = pcall(function()
        s.humanoid.AutoRotate = false s.humanoid.PlatformStand = true setNoclip(s.character, true)
        local f = s.root.AssemblyMass * CFG.ForcePerMass s.bv.MaxForce = Vector3.new(f, f, f) s.bg.MaxTorque = Vector3.new(4e5, 4e5, 4e5)
        while not s.destroyed and s.humanoid.Health > 0 and target.Parent do
            RunService.Heartbeat:Wait() if s.destroyed then break end s.root.CanCollide = false
            if (s.root.Position - lastPos).Magnitude < 0.5 then stuckCounter = stuckCounter + 1 if stuckCounter > 10 then s.root.CFrame = CFrame.new(target.Position + Vector3.new(0, 2, 0)) s.root.AssemblyLinearVelocity = Vector3.zero stuckCounter = 0 end
            else stuckCounter = 0 lastPos = s.root.Position end
            local mRoot, mDist = getClosestMurderer(s.root.Position)
            if mRoot and mDist < CFG.AvoidRadius then Blacklist[target] = true local escapeDir = (s.root.Position - mRoot.Position).Unit s.bv.Velocity = Vector3.new(escapeDir.X, 0.8, escapeDir.Z) * (CFG.MaxSpeed * 1.5) task.wait(0.3)
            else local pos = s.root.Position local offset = target.Position - pos local dist = offset.Magnitude if dist <= 5 then arrived = true break end s.bv.Velocity = offset.Unit * math.min(CFG.MaxSpeed, dist * CFG.Gain) local flat = Vector3.new(offset.X, 0, offset.Z) if flat.Magnitude > 0.5 then s.bg.CFrame = CFrame.lookAt(pos, pos + flat) end end
            if os.clock() - startTime > 2.5 or s.humanoid.Health < lastHealth then Blacklist[target] = true break end if not target:IsDescendantOf(Workspace) then Blacklist[target] = true break end if not canCollect() then break end
        end
    end)
    if not ok then warn("flyTo error:", err) end
    if not s.destroyed then releaseForces(s) s.root.AssemblyLinearVelocity = Vector3.zero s.root.AssemblyAngularVelocity = Vector3.zero setNoclip(s.character, false) resetHumanoid(s) end
    s.target = nil return arrived
end
local COIN_PRIMARY = "Coin_Server" local COIN_FALLBACK = { Coin = true, Candy = true, Sweet = true } local coinCache, coinCacheTime, coinContainer = {}, 0, nil
local function findCoinContainer() return Workspace:FindFirstChild("CoinContainer", true) or Workspace:FindFirstChild("Coins", true) or Workspace:FindFirstChild("CoinFolder", true) end
local function isCoinName(name) if name == COIN_PRIMARY then return true end if COIN_FALLBACK[name] then return true end if name == "CoinVisual" then return false end local n = string.lower(name) return string.find(n, "coin", 1, true) ~= nil or string.find(n, "candy", 1, true) ~= nil or string.find(n, "sweet", 1, true) ~= nil end
local function isCoinAlive(c, container) if not c or not c.Parent or not c:IsDescendantOf(Workspace) then return false end if container and not c:IsDescendantOf(container) then return false end local vis = c:FindFirstChild("CoinVisual") if vis and vis:IsA("BasePart") and vis.Transparency >= 0.99 then return false end return true end
local function refreshCoinCache() local t = os.clock() if t - coinCacheTime < 1 then return end coinCacheTime = t coinCache = {} coinContainer = findCoinContainer() if coinContainer then for _, c in ipairs(coinContainer:GetChildren()) do if c:IsA("BasePart") and isCoinName(c.Name) then if not Blacklist[c] and isCoinAlive(c, coinContainer) then coinCache[#coinCache+1] = c elseif not isCoinAlive(c, coinContainer) then Blacklist[c] = true end end end end if #coinCache == 0 then for _, d in ipairs(Workspace:GetDescendants()) do if d:IsA("BasePart") and isCoinName(d.Name) and not Blacklist[d] and isCoinAlive(d, nil) then coinCache[#coinCache+1] = d end end end end
local function nearestPart() local s = currentSession if not s or s.destroyed then return nil end refreshCoinCache() local best, bestDist = nil, math.huge local pos = s.root.Position for _, c in ipairs(coinCache) do if c and c.Parent and not Blacklist[c] then local d = (c.Position - pos).Magnitude local _, mDist = getClosestMurderer(c.Position) if d < bestDist and (not mDist or mDist > CFG.AvoidRadius) then best, bestDist = c, d end else Blacklist[c] = true end end return best end
local function collectTarget(target) local s = currentSession if not s or s.destroyed or not target.Parent then return end Blacklist[target] = true collectedCount += 1 pcall(function() if typeof(firetouchinterest) == "function" then firetouchinterest(s.root, target, 0) firetouchinterest(s.root, target, 1) task.wait(0.05) firetouchinterest(s.root, target, 0) firetouchinterest(s.root, target, 1) end local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true) if prompt and prompt.Enabled and typeof(fireproximityprompt) == "function" then fireproximityprompt(prompt) end end) end
local function collectSession() while CFG.AutoFarm and canCollect() do if CFG.AutoReset and collectedCount >= CFG.MaxCoins then if currentSession and currentSession.humanoid then currentSession.humanoid.Health = 0 end break end local target = nearestPart() if not target then break end if flyTo(target) then collectTarget(target) task.wait(0.2) if target and target.Parent then Blacklist[target] = true end else task.wait(0.1) end end end

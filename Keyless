local function CreateUI()
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "LiberiumUI"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.DisplayOrder = 100
    ScreenGui.Parent = playerGui

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0, 500, 0, 350)
    MainFrame.Position = UDim2.new(0.5, -250, 0.5, -175)
    MainFrame.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
    MainFrame.BorderSizePixel = 0
    MainFrame.Active = true
    MainFrame.Parent = ScreenGui
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 8)
    local Stroke = Instance.new("UIStroke", MainFrame)
    Stroke.Color = Color3.fromRGB(45, 45, 55)
    Stroke.Thickness = 1

    -- Drag Logic (Mobile + PC)
    local dragging, dragStart, startPos
    MainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Header
    local Header = Instance.new("Frame", MainFrame)
    Header.Size = UDim2.new(1, 0, 0, 50)
    Header.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    Header.BorderSizePixel = 0
    Instance.new("UICorner", Header).CornerRadius = UDim.new(0, 8)
    local HeaderFix = Instance.new("Frame", Header)
    HeaderFix.Size = UDim2.new(1, 0, 0, 15)
    HeaderFix.Position = UDim2.new(0, 0, 1, -15)
    HeaderFix.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    HeaderFix.BorderSizePixel = 0

    local Title = Instance.new("TextLabel", Header)
    Title.Size = UDim2.new(1, -60, 1, 0)
    Title.Position = UDim2.new(0, 15, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text = "Liberium Hub"
    Title.TextColor3 = Color3.fromRGB(240, 240, 240)
    Title.TextSize = 18
    Title.Font = Enum.Font.GothamBold
    Title.TextXAlignment = Enum.TextXAlignment.Left

    local CloseBtn = Instance.new("TextButton", Header)
    CloseBtn.Size = UDim2.new(0, 30, 0, 30)
    CloseBtn.Position = UDim2.new(1, -40, 0.5, -15)
    CloseBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    CloseBtn.Text = "×"
    CloseBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    CloseBtn.TextSize = 20
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.BorderSizePixel = 0
    Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 6)
    CloseBtn.MouseButton1Click:Connect(function() MainFrame.Visible = false end)

    -- Sidebar
    local Sidebar = Instance.new("Frame", MainFrame)
    Sidebar.Size = UDim2.new(0, 120, 1, -60)
    Sidebar.Position = UDim2.new(0, 10, 0, 55)
    Sidebar.BackgroundTransparency = 1

    local TabList = Instance.new("UIListLayout", Sidebar)
    TabList.Padding = UDim.new(0, 5)

    -- Content Container
    local Content = Instance.new("Frame", MainFrame)
    Content.Size = UDim2.new(1, -150, 1, -70)
    Content.Position = UDim2.new(0, 140, 0, 60)
    Content.BackgroundTransparency = 1

    local Tabs = {}
    local CurrentTab = nil

    local UI = {}

    function UI:CreateTab(name)
        local btn = Instance.new("TextButton", Sidebar)
        btn.Size = UDim2.new(1, 0, 0, 35)
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
        btn.Text = "  " .. name
        btn.TextColor3 = Color3.fromRGB(150, 150, 160)
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 14
        btn.BorderSizePixel = 0
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

        local page = Instance.new("ScrollingFrame", Content)
        page.Size = UDim2.new(1, 0, 1, 0)
        page.BackgroundTransparency = 1
        page.BorderSizePixel = 0
        page.ScrollBarThickness = 3
        page.ScrollBarImageColor3 = Color3.fromRGB(100, 100, 120)
        page.Visible = false

        local layout = Instance.new("UIListLayout", page)
        layout.Padding = UDim.new(0, 8)
        layout.SortOrder = Enum.SortOrder.LayoutOrder

        local tab = { btn = btn, page = page }

        btn.MouseButton1Click:Connect(function()
            for _, t in ipairs(Tabs) do
                t.page.Visible = false
                t.btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
                t.btn.TextColor3 = Color3.fromRGB(150, 150, 160)
            end
            page.Visible = true
            btn.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
            btn.TextColor3 = Color3.fromRGB(240, 240, 240)
            CurrentTab = tab
        end)

        table.insert(Tabs, tab)
        if #Tabs == 1 then
            btn.MouseButton1Click:Fire() -- Lua doesn't have Fire, use function call or simulate
            page.Visible = true
            btn.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
            btn.TextColor3 = Color3.fromRGB(240, 240, 240)
            CurrentTab = tab
        end

        function tab:CreateSection(text)
            local lbl = Instance.new("TextLabel", page)
            lbl.Size = UDim2.new(1, 0, 0, 20)
            lbl.BackgroundTransparency = 1
            lbl.Text = text
            lbl.TextColor3 = Color3.fromRGB(120, 120, 130)
            lbl.TextSize = 12
            lbl.Font = Enum.Font.GothamBold
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            
            local sec = {}
            function sec:Toggle(opts)
                local row = Instance.new("Frame", page)
                row.Size = UDim2.new(1, -5, 0, 36)
                row.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
                row.BorderSizePixel = 0
                Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

                local txt = Instance.new("TextLabel", row)
                txt.Size = UDim2.new(1, -60, 1, 0)
                txt.Position = UDim2.new(0, 10, 0, 0)
                txt.BackgroundTransparency = 1
                txt.Text = opts.Name
                txt.TextColor3 = Color3.fromRGB(220, 220, 220)
                txt.TextSize = 13
                txt.Font = Enum.Font.Gotham
                txt.TextXAlignment = Enum.TextXAlignment.Left

                local state = opts.Default or false
                local toggleBg = Instance.new("Frame", row)
                toggleBg.Size = UDim2.new(0, 36, 0, 18)
                toggleBg.Position = UDim2.new(1, -46, 0.5, -9)
                toggleBg.BackgroundColor3 = state and Color3.fromRGB(100, 120, 255) or Color3.fromRGB(60, 60, 70)
                toggleBg.BorderSizePixel = 0
                Instance.new("UICorner", toggleBg).CornerRadius = UDim.new(0, 9)

                local knob = Instance.new("Frame", toggleBg)
                knob.Size = UDim2.new(0, 14, 0, 14)
                knob.Position = UDim2.new(0, state and 20 or 2, 0, 2)
                knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                knob.BorderSizePixel = 0
                Instance.new("UICorner", knob).CornerRadius = UDim.new(0, 7)

                local click = Instance.new("TextButton", row)
                click.Size = UDim2.new(1, 0, 1, 0)
                click.BackgroundTransparency = 1
                click.Text = ""
                click.MouseButton1Click:Connect(function()
                    state = not state
                    toggleBg.BackgroundColor3 = state and Color3.fromRGB(100, 120, 255) or Color3.fromRGB(60, 60, 70)
                    TweenService:Create(knob, TweenInfo.new(0.15), {Position = UDim2.new(0, state and 20 or 2, 0, 2)}):Play()
                    pcall(opts.Callback, state)
                end)
            end

            function sec:Slider(opts)
                local row = Instance.new("Frame", page)
                row.Size = UDim2.new(1, -5, 0, 50)
                row.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
                row.BorderSizePixel = 0
                Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

                local mn, mx = opts.Min or 0, opts.Max or 100
                local cur = opts.Default or mn

                local txt = Instance.new("TextLabel", row)
                txt.Size = UDim2.new(1, -20, 0, 20)
                txt.Position = UDim2.new(0, 10, 0, 5)
                txt.BackgroundTransparency = 1
                txt.Text = opts.Name .. " : " .. cur
                txt.TextColor3 = Color3.fromRGB(220, 220, 220)
                txt.TextSize = 13
                txt.Font = Enum.Font.Gotham
                txt.TextXAlignment = Enum.TextXAlignment.Left

                local track = Instance.new("Frame", row)
                track.Size = UDim2.new(1, -20, 0, 6)
                track.Position = UDim2.new(0, 10, 1, -15)
                track.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
                track.BorderSizePixel = 0
                Instance.new("UICorner", track).CornerRadius = UDim.new(0, 3)

                local fill = Instance.new("Frame", track)
                fill.Size = UDim2.new((cur - mn) / (mx - mn), 0, 1, 0)
                fill.BackgroundColor3 = Color3.fromRGB(100, 120, 255)
                fill.BorderSizePixel = 0
                Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 3)

                local click = Instance.new("TextButton", row)
                click.Size = UDim2.new(1, 0, 1, 0)
                click.BackgroundTransparency = 1
                click.Text = ""

                local dragging = false
                local function update(x)
                    local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
                    cur = math.floor(mn + rel * (mx - mn) + 0.5)
                    fill.Size = UDim2.new(rel, 0, 1, 0)
                    txt.Text = opts.Name .. " : " .. cur
                    pcall(opts.Callback, cur)
                end

                click.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        update(input.Position.X)
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        update(input.Position.X)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)
            end
            return sec
        end
        return tab
    end

    return UI
end

local UI = CreateUI()


local function getContainer()
    local gameW = Workspace:FindFirstChild("Game")
    if gameW and gameW:FindFirstChild("CoinContainer") then
        return gameW.CoinContainer
    end
    return Workspace:FindFirstChild("CoinContainer", true)
end

local function findNearest()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local container = getContainer()
    if not container then return nil end
    
    local closest, minDist = nil, math.huge
    for _, obj in ipairs(container:GetChildren()) do
        if obj.Name == "Coin_Server" and obj:IsA("BasePart") and not blacklist[obj] then
            local dist = (obj.Position - hrp.Position).Magnitude
            if dist < minDist then
                minDist = dist
                closest = obj
            end
        end
    end
    return closest
end

-- Основной цикл (Бег, а не полет)
task.spawn(function()
    while task.wait(0.1) do
        if isFarming then
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            if not hrp or not hum or hum.Health <= 0 then
                StatusText.Text = "Мертв..."
                continue
            end

            -- Включаем огромную скорость бега (античит на это не кикает)
            hum.WalkSpeed = 150

            if currentTarget and not currentTarget.Parent then
                currentTarget = nil
            end

            if not currentTarget then
                currentTarget = findNearest()
            end

            if currentTarget then
                local targetPos = currentTarget.Position
                local distance = (hrp.Position - targetPos).Magnitude

                StatusText.Text = "Бежим к монете (" .. math.floor(distance) .. " st)"

                if distance < 4 then
                    -- Долетели, собираем
                    hum:MoveTo(hrp.Position) -- Останавливаем
                    blacklist[currentTarget] = true
                    
                    pcall(function()
                        firetouchinterest(hrp, currentTarget, 0)
                        firetouchinterest(hrp, currentTarget, 1)
                    end)
                    for _, prompt in ipairs(currentTarget:GetDescendants()) do
                        if prompt:IsA("ProximityPrompt") then
                            pcall(function() fireproximityprompt(prompt) end)
                        end
                    end
                    
                    currentTarget = nil
                    task.wait(0.1)
                else
                    -- Даем команду бежать к цели
                    hum:MoveTo(targetPos)
                end
            else
                hum:MoveTo(hrp.Position)
                StatusText.Text = "Нет монет (ждем раунд)"
            end
        end
    end
end)

-- Выключение
Btn.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        Btn.Text = "FARM: ON"
        Btn.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
    else
        Btn.Text = "FARM: OFF"
        Btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        StatusText.Text = "Ожидание..."
        
        local char = LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = 16 -- Возвращаем нормальную скорость
                hum:MoveTo(char.HumanoidRootPart.Position) -- Останавливаем
            end
        end
    end
end)

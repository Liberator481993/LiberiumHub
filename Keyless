-- Обновление ролей
local roles = {}
task.spawn(function()
    while task.wait(2) do
        pcall(function()
            local getData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
            if getData and getData:IsA("RemoteFunction") then
                local success, data = getData:InvokeServer()
                if success and type(data) == "table" then roles = data end
            end
        end)
    end
end)

local function getRoleColor(plr)
    local rData = roles[plr.Name]
    if rData and rData.Role then
        if rData.Role == "Murderer" then return Color3.fromRGB(255, 50, 50) end
        if rData.Role == "Sheriff" then return Color3.fromRGB(50, 120, 255) end
    end
    return Color3.fromRGB(50, 255, 100)
end

-- ESP
local highlights = {}
RunService.RenderStepped:Connect(function()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            if CFG.ESP and p.Character then
                local hl = highlights[p]
                if not hl or hl.Parent ~= p.Character then
                    if hl then hl:Destroy() end
                    hl = Instance.new("Highlight")
                    hl.OutlineTransparency = 0
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = p.Character
                    highlights[p] = hl
                end
                local c = getRoleColor(p)
                hl.FillColor = c
                hl.OutlineColor = c
            else
                if highlights[p] then highlights[p]:Destroy(); highlights[p] = nil end
            end
        end
    end
end)

-- Aimbot & Silent Aim
local FOVCircle = Instance.new("Frame", Window.root)
FOVCircle.Size = UDim2.fromOffset(240, 240); FOVCircle.AnchorPoint = Vector2.new(0.5, 0.5); FOVCircle.Position = UDim2.new(0.5, 0, 0.5, 0)
FOVCircle.BackgroundTransparency = 1; FOVCircle.Visible = false
local UIStrokeFOV = Instance.new("UIStroke", FOVCircle); UIStrokeFOV.Color = Color3.fromRGB(150, 50, 255); UIStrokeFOV.Thickness = 1.5
local UICornerFOV = Instance.new("UICorner", FOVCircle); UICornerFOV.CornerRadius = UDim.new(1, 0)

local function getClosestTarget()
    local closest, dist = nil, 120
    local center = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local head = p.Character:FindFirstChild("Head")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 then
                local sp, onScreen = Cam:WorldToViewportPoint(head.Position)
                if onScreen then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d < dist then dist = d; closest = head end
                end
            end
        end
    end
    return closest
end

-- Хуки (Silent Aim)
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
local oldIndex = mt.__index
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if CFG.SilentAim and (method == "FireGun" or method == "ShootGun" or method == "HitKnife" or method == "KnifeHit") then
        local target = getClosestTarget()
        if target then return oldNamecall(self, target, ...) end
    end
    return oldNamecall(self, ...)
end)

mt.__index = newcclosure(function(self, key)
    if CFG.SilentAim and (key == "Hit" or key == "Target") then
        local target = getClosestTarget()
        if target then
            if key == "Hit" then return CFrame.new(target.Position) end
            if key == "Target" then return target end
        end
    end
    return oldIndex(self, key)
end)
setreadonly(mt, true)

-- Плавный Aimbot (Камера)
RunService.RenderStepped:Connect(function()
    if CFG.Aimbot then
        local target = getClosestTarget()
        if target then
            Cam.CFrame = Cam.CFrame:Lerp(CFrame.new(Cam.CFrame.Position, target.Position), 0.25)
        end
        FOVCircle.Visible = true
    else
        FOVCircle.Visible = false
    end
end)

-- Noclip & Speed
local originalCollide = setmetatable({}, {__mode = "k"})
RunService.Stepped:Connect(function()
    if CFG.Noclip and LP.Character then
        for _, d in ipairs(LP.Character:GetDescendants()) do
            if d:IsA("BasePart") then
                if originalCollide[d] == nil then originalCollide[d] = d.CanCollide end
                d.CanCollide = false
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if LP.Character then
        local hum = LP.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.WalkSpeed ~= CFG.WalkSpeed then hum.WalkSpeed = CFG.WalkSpeed end
    end
end)

-- УЛУЧШЕННЫЙ АВТОФАРМ
task.spawn(function()
    while task.wait(0.5) do
        if CFG.AutoFarm and LP.Character then
            pcall(function()
                local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                local closest, minDist = nil, 150
                
                -- Ищем по всей карте (включая Workspace)
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("BasePart") or obj:IsA("Model") then
                        local name = string.lower(obj.Name)
                        -- Ловим конфеты, монеты и мешки
                        if name:find("candy") or name:find("sweet") or name:find("coin") or name:find("bag") then
                            -- Игнорируем самого игрока и его части
                            if not obj:IsDescendantOf(LP.Character) then
                                local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                                local d = (pos - hrp.Position).Magnitude
                                if d < minDist then minDist = d; closest = obj end
                            end
                        end
                    end
                end
                
                if closest then
                    local pos = closest:IsA("Model") and closest:GetPivot().Position or closest.Position
                    hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
                end
            end)
        end
    end
end)


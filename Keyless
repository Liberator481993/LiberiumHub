-- Логика поиска
local function getContainer()
    local gameW = Workspace:FindFirstChild("Game")
    if gameW and gameW:FindFirstChild("CoinContainer") then
        return gameW.CoinContainer
    end
    return Workspace:FindFirstChild("CoinContainer", true)
end

local function findNearest()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local container = getContainer()
    if not container then return nil end
    
    local closest, minDist = nil, math.huge
    for _, obj in ipairs(container:GetChildren()) do
        if obj.Name == "Coin_Server" and obj:IsA("BasePart") and not blacklist[obj] then
            local dist = (obj.Position - hrp.Position).Magnitude
            if dist < minDist then
                minDist = dist
                closest = obj
            end
        end
    end
    return closest
end

-- Физика (AlignPosition)
local function setupPhysics(hrp)
    if alignPos then alignPos:Destroy() end
    if alignOri then alignOri:Destroy() end

    alignPos = Instance.new("AlignPosition")
    alignPos.Mode = Enum.PositionAlignmentMode.OneAttachment
    alignPos.MaxForce = math.huge
    alignPos.Attachment0 = hrp:FindFirstChild("RootAttachment") or Instance.new("Attachment", hrp)
    alignPos.Parent = hrp

    alignOri = Instance.new("AlignOrientation")
    alignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment
    alignOri.MaxTorque = math.huge
    alignOri.Attachment0 = alignPos.Attachment0
    alignOri.Parent = hrp
end

local function destroyPhysics()
    if alignPos then alignPos:Destroy(); alignPos = nil end
    if alignOri then alignOri:Destroy(); alignOri = nil end
end

-- Главный цикл (Noclip + Полет)
RunService.Heartbeat:Connect(function()
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if isFarming then
        -- 1. Жесткий Noclip (сквозь стены)
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        if not hum.PlatformStand then hum.PlatformStand = true end

        -- 2. Настройка физики (если нет)
        if not alignPos or alignPos.Parent ~= hrp then
            setupPhysics(hrp)
        end
        alignPos.Responsiveness = farmSpeed * 10 -- Скорость притяжения

        -- 3. Поиск и полет
        if currentTarget and not currentTarget.Parent then currentTarget = nil end
        if not currentTarget then currentTarget = findNearest() end

        if currentTarget then
            local targetPos = currentTarget.Position
            local distance = (hrp.Position - targetPos).Magnitude
            StatusText.Text = "Полет к монете (" .. math.floor(distance) .. " st)"

            if distance < 3.5 then
                -- Сбор
                blacklist[currentTarget] = true
                alignPos.Position = hrp.Position -- Остановка
                
                pcall(function()
                    firetouchinterest(hrp, currentTarget, 0)
                    firetouchinterest(hrp, currentTarget, 1)
                end)
                for _, prompt in ipairs(currentTarget:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        pcall(function() fireproximityprompt(prompt) end)
                    end
                end
                currentTarget = nil
                task.wait(0.05)
            else
                -- Тянем к цели
                alignPos.Position = targetPos
                alignOri.CFrame = CFrame.new(hrp.Position, targetPos)
            end
        else
            alignPos.Position = hrp.Position -- Стоим на месте
            StatusText.Text = "Нет монет (ждем)"
        end
    else
        -- Выключено
        if alignPos then destroyPhysics() end
        if hum.PlatformStand then hum.PlatformStand = false end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end
end)

-- Управление ползунком
SliderBg.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local function update(x)
            local percent = math.clamp((x - SliderBg.AbsolutePosition.X) / SliderBg.AbsoluteSize.X, 0, 1)
            farmSpeed = math.floor(percent * 24) + 1
            SliderFill.Size = UDim2.new(percent, 0, 1, 0)
            StatusText.Text = "Скорость: " .. farmSpeed
        end
        update(input.Position.X)
        
        local moveConn = game:GetService("UserInputService").InputChanged:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
                update(i.Position.X)
            end
        end)
        game:GetService("UserInputService").InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                if moveConn then moveConn:Disconnect() end
            end
        end)
    end
end)

Btn.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        Btn.Text = "FARM: ON"
        Btn.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
    else
        Btn.Text = "FARM: OFF"
        Btn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        StatusText.Text = "Скорость: " .. farmSpeed
    end
end)

task.spawn(function()
    while task.wait(5) do
        for obj in pairs(blacklist) do
            if not obj.Parent then blacklist[obj] = nil end
        end
    end
end)

    local CH = {} CH.__index = CH local DEFAULT_COLOR = Color3.fromRGB(255, 255, 255) local HIT_COLOR = Color3.fromRGB(255, 50, 50) local DEFAULT_SIZE = 20 local THICKNESS = 2 local DOT_SIZE = 3 local HIT_SPREAD = 4 local FLASH_TIME = 0.1 local FLASH_INFO = TweenInfo.new(FLASH_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

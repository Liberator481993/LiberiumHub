                hum.WalkSpeed = CFG.WalkSpeed 
            end
        end
    end)
end)

-- ==========================================
-- AUTO FARM (OPTIMIZED FOR DELTA)
-- ==========================================
local TARGET_NAME = "Coin_Server"
local STOP_DISTANCE = 3
local SCAN_INTERVAL = 0.3

local flying = false
local collecting = false
local Blacklist = {}
local candidates = {}
local lastScan = 0
local currentTarget = nil
local targetSince = 0
local attachment, alignPos, alignOri = nil, nil, nil
local heartbeatConn = nil
local collectedCount = 0

local function getHumanoid() 
    local c = player.Character
    return c and c:FindFirstChildOfClass("Humanoid") 
end

local function getRoot() 
    local c = player.Character
    return c and c:FindFirstChild("HumanoidRootPart") 
end

local function setFlightState(active)
    pcall(function()
        local hum = getHumanoid()
        if not hum then return end
        if active then 
            hum.PlatformStand = true
            hum:ChangeState(Enum.HumanoidStateType.Physics)
        else 
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end)
end

local function destroyAligns()
    for _, obj in ipairs({ alignPos, alignOri, attachment }) do 
        pcall(function() obj:Destroy() end) 
    end
    alignPos, alignOri, attachment = nil, nil, nil
end

-- ВАЖНО: для Delta используем 1e5 вместо math.huge (иначе краш)
local function createAligns(root)
    destroyAligns()
    pcall(function()
        attachment = Instance.new("Attachment")
        attachment.Name = "LibAttachment"
        attachment.Parent = root
        
        alignPos = Instance.new("AlignPosition")
        alignPos.Mode = Enum.PositionAlignmentMode.OneAttachment
        alignPos.Attachment0 = attachment
        alignPos.MaxForce = 1e5  -- DELTA-SAFE
        alignPos.Responsiveness = 150
        alignPos.MaxVelocity = CFG.FarmSpeed
        alignPos.Position = root.Position
        alignPos.Parent = root
        
        alignOri = Instance.new("AlignOrientation")
        alignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment
        alignOri.Attachment0 = attachment
        alignOri.MaxTorque = 1e5  -- DELTA-SAFE
        alignOri.Responsiveness = 50
        alignOri.CFrame = root.CFrame
        alignOri.Parent = root
    end)
end

local function rescan()
    local list = {}
    pcall(function()
        local container = Workspace:FindFirstChild("CoinContainer", true)
        if container then
            for _, d in ipairs(container:GetChildren()) do
                if d.Name == TARGET_NAME and d:IsA("BasePart") then 
                    table.insert(list, d) 
                end
            end
        end
    end)
    candidates = list
end

local function findNearest(fromPos)
    local best, bestDist = nil, math.huge
    for _, part in ipairs(candidates) do
        if part.Parent and not Blacklist[part] then
            local dist = (part.Position - fromPos).Magnitude
            if dist < bestDist then 
                best, bestDist = part, dist 
            end
        end
    end
    return best
end

-- FALLBACK COLLECT: если firetouchinterest не работает, используем PivotTo
local function collect(target)
    collecting = true
    pcall(function()
        local root = getRoot()
        if root and target then
            -- 1. Пытаемся через firetouchinterest
            alignPos.Position = target.Position 
            alignPos.MaxVelocity = 60
            task.wait(0.15)
            
            safeTouch(root, target, 0)
            safeTouch(root, target, 1)
            
            local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt and prompt.Enabled then 
                safePrompt(prompt) 
            end
            
            task.wait(0.1)
        end
    end)
    Blacklist[target] = true
    collectedCount += 1
    currentTarget = nil
    collecting = false
end

local function flyStep(root, now)
    if now - lastScan >= SCAN_INTERVAL then 
        lastScan = now 
        rescan() 
        -- Очистка Blacklist (макс 150 записей, чтобы не грузить Delta)
        local count = 0
        for obj in pairs(Blacklist) do
            if not obj.Parent or count > 150 then 
                Blacklist[obj] = nil 
            end
            count += 1
        end
    end
    
    local target = findNearest(root.Position)

    if target and target ~= currentTarget then
        currentTarget = target
        targetSince = now
        pcall(function()
            if alignPos then alignPos.Position = currentTarget.Position end
        end)
    end

    if not target and not currentTarget then
        if alignPos then destroyAligns(); setFlightState(false) end
        return
    end

    if not alignPos or alignPos.Parent ~= root then 
        createAligns(root)
        setFlightState(true)
    end
    if not currentTarget then return end

    if now - targetSince > 3 then 
        Blacklist[currentTarget] = true
        currentTarget = nil
        return 
    end

    local distance = (currentTarget.Position - root.Position).Magnitude
    if distance < STOP_DISTANCE then
        task.spawn(collect, currentTarget)
        return
    end

    pcall(function()
        alignPos.MaxVelocity = CFG.FarmSpeed
        alignPos.Position = currentTarget.Position
        alignOri.CFrame = CFrame.lookAt(root.Position, Vector3.new(currentTarget.Position.X, root.Position.Y, currentTarget.Position.Z))
    end)
end

local function stopFlight()
    flying = false
    collecting = false
    currentTarget = nil
    if heartbeatConn then heartbeatConn:Disconnect(); heartbeatConn = nil end
    destroyAligns()
    setFlightState(false)
end

-- ==========================================
-- WAIT LOGIC (безопасная)
-- ==========================================
local function WaitForActivePhase()
    local newCharacter = nil
    local conn = player.CharacterAdded:Connect(function(char) newCharacter = char end)

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health > 0 then
        while humanoid.Health > 0 and humanoid.Parent do
            humanoid:GetPropertyChangedSignal("Health"):Wait()
        end
    end

    while not newCharacter do task.wait() end
    conn:Disconnect()
    task.wait(2)

    while task.wait(1) do
        local folder = Workspace:FindFirstChild("CoinContainer", true)
        if folder then
            for _, child in ipairs(folder:GetChildren()) do
                if child.Name == "Coin_Server" then
                    return true
                end
            end
        end
    end
end

local function startFlight()
    if flying then return end
    local root = getRoot()
    if not root then return end
    flying = true
    table.clear(Blacklist)
    currentTarget = nil
    lastScan = 0
    collectedCount = 0
    createAligns(root)
    setFlightState(true)
    
    heartbeatConn = RunService.Heartbeat:Connect(function()
        if not flying or collecting then return end
        pcall(function()
            local r = getRoot()
            local hum = getHumanoid()
            
            -- Проверка на смерть или падение под карту
            if not r or not hum or hum.Health <= 0 or r.Position.Y < -50 then
                stopFlight()
                task.spawn(function()
                    WaitForActivePhase()
                    if CFG.AutoFarm then startFlight() end
                end)
                return
            end

            if CFG.AutoReset and collectedCount >= CFG.MaxCoins then
                stopFlight()
                hum.Health = 0
                task.spawn(function()
                    WaitForActivePhase()
                    if CFG.AutoFarm then startFlight() end
                end)
                return
            end

            if not alignPos or alignPos.Parent ~= r then 
                createAligns(r)
                setFlightState(true)
            end
            flyStep(r, os.clock())
        end)
    end)
end


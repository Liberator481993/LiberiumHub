function Sec:AddToggle(name, default, callback)
    local state = default == true
    local row = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 42), Text = "", AutoButtonColor = false,
        BackgroundColor3 = UI.Surface2, BackgroundTransparency = 0.18,
        BorderSizePixel = 0, Parent = self.Frame,
    })
    uiCorner(row, 9)
    uiStroke(row, UI.Border, 0.84, 1)
    local title = uiText(row, name, 12, UI.Text, Enum.Font.GothamMedium)
    title.Position = UDim2.fromOffset(11, 0)
    title.Size = UDim2.new(1, -74, 1, 0)

    local track = create("Frame", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(40, 22), BackgroundColor3 = state and UI.Violet or UI.Off,
        BorderSizePixel = 0, Parent = row,
    })
    uiCorner(track, 11)
    local knob = create("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0, Parent = track,
    })
    uiCorner(knob, 8)

    local object = {}
    function object:Set(value, silent)
        state = value == true
        tween(track, FAST, {BackgroundColor3 = state and UI.Violet or UI.Off})
        tween(knob, FAST, {Position = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)})
        if not silent and callback then task.spawn(callback, state) end
    end
    row.Activated:Connect(function() object:Set(not state) end)
    row.MouseEnter:Connect(function() if not state then tween(row, FAST, {BackgroundTransparency = 0.08}) end end)
    row.MouseLeave:Connect(function() tween(row, FAST, {BackgroundTransparency = 0.18}) end)
    return object
end

function Sec:AddSlider(name, minimum, maximum, default, callback, increment)
    increment = increment or 1
    local value = math.clamp(tonumber(default) or minimum, minimum, maximum)
    local row = create("Frame", {
        Size = UDim2.new(1, 0, 0, 58), BackgroundColor3 = UI.Surface2,
        BackgroundTransparency = 0.28, BorderSizePixel = 0, Parent = self.Frame,
    })
    uiCorner(row, 9)
    uiStroke(row, UI.Border, 0.88, 1)
    local title = uiText(row, name, 12, UI.Text, Enum.Font.GothamMedium)
    title.Position = UDim2.fromOffset(11, 5)
    title.Size = UDim2.new(1, -86, 0, 20)
    local valueLabel = uiText(row, tostring(value), 11, UI.Cyan, Enum.Font.GothamBold)
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Position = UDim2.new(1, -70, 0, 5)
    valueLabel.Size = UDim2.fromOffset(58, 20)
    local rail = create("TextButton", {
        Position = UDim2.new(0, 11, 1, -19), Size = UDim2.new(1, -22, 0, 10),
        Text = "", AutoButtonColor = false, BackgroundColor3 = UI.Off,
        BorderSizePixel = 0, Parent = row,
    })
    uiCorner(rail, 5)
    local fill = create("Frame", {
        Size = UDim2.fromScale((value - minimum) / math.max(maximum - minimum, 1), 1),
        BackgroundColor3 = UI.Violet, BorderSizePixel = 0, Parent = rail,
    })
    uiCorner(fill, 5)
    local function setValue(nextValue, silent)
        nextValue = tonumber(nextValue) or value
        value = math.clamp(math.floor(nextValue / increment + 0.5) * increment, minimum, maximum)
        valueLabel.Text = tostring(math.floor(value * 1000 + 0.5) / 1000)
        tween(fill, FAST, {Size = UDim2.fromScale((value - minimum) / math.max(maximum - minimum, 1), 1)})
        if not silent and callback then task.spawn(callback, value) end
    end
    local object = {Set = setValue}
    local dragging = false
    local function fromX(x)
        local width = rail.AbsoluteSize.X
        if width <= 0 then return end
        local alpha = math.clamp((x - rail.AbsolutePosition.X) / width, 0, 1)
        setValue(minimum + (maximum - minimum) * alpha)
    end
    rail.Activated:Connect(function(input)
        if input and input.Position then fromX(input.Position.X) end
    end)
    rail.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            fromX(input.Position.X)
        end
    end)
    table.insert(self.Win.Conns, UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            fromX(input.Position.X)
        end
    end))
    table.insert(self.Win.Conns, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end))
    return object
end

function Sec:AddButton(name, callback)
    local button = create("TextButton", {
        Text = name, Font = Enum.Font.GothamSemibold, TextSize = 12,
        TextColor3 = UI.Text, BackgroundColor3 = UI.Violet,
        BackgroundTransparency = 0.72, AutoButtonColor = false,
        Size = UDim2.new(1, 0, 0, 42), BorderSizePixel = 0, Parent = self.Frame,
    })
    uiCorner(button, 9)
    uiStroke(button, UI.Violet, 0.72, 1)
    button.MouseEnter:Connect(function() tween(button, FAST, {BackgroundTransparency = 0.58}) end)
    button.MouseLeave:Connect(function() tween(button, FAST, {BackgroundTransparency = 0.72}) end)
    button.Activated:Connect(function() if callback then task.spawn(callback) end end)
    return button
end

function Sec:AddDropdown(name, options, default, callback)
    return Dropdown.new(self.Frame, name, options, default, callback)
end



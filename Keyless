function Library:ChangeTheme(themeName)
    local t = Themes[themeName] if not t then return end
    Theme.Green = t.Green Theme.GreenDark = t.GreenDark Theme.Border = t.Border
    for _, obj in ipairs(self.Gui:GetDescendants()) do
        for _, prop in ipairs({"Color", "BackgroundColor3", "TextColor3"}) do
            local key = obj:GetAttribute("ThemeTarget_" .. prop)
            if key and Theme[key] then Tween(obj, 0.3, {[prop] = Theme[key]}) end
        end
    end
end

function Library:_SelectTab(tab)
    if tab == self.ActiveTab then return end
    self.ActiveTab = tab self.PageTitle.Text = tab.Name
    for _, t in ipairs(self.Tabs) do
        local active = t == tab
        Tween(t.Button, 0.2, { BackgroundColor3 = active and Theme.Card or Theme.Sidebar, TextColor3 = active and Theme.White or Theme.Muted })
        if t.Indicator then t.Indicator.Visible = active end
        if t.Grad then t.Grad.Enabled = active end
        for _, sub in ipairs(t.SubTabs) do if sub.Page then sub.Page.Visible = (t == tab and sub == tab.SubTabs[1]) end end
    end
    
    ClearGui(self.SubTabBar)
    for _, sub in ipairs(tab.SubTabs) do
        local b = New("TextButton", { BackgroundColor3 = Theme.Card, Text = sub.Icon .. "  " .. sub.Name, TextColor3 = Theme.Muted, Font = Enum.Font.GothamBold, TextSize = 12, Size = UDim2.fromOffset(90, 32), AutoButtonColor = false }, self.SubTabBar)
        Round(b, 16) local st = Stroke(b, Theme.Green, 1, 1) sub.Button = b sub.Stroke = st
        b.Activated:Connect(function() self:_SelectSub(tab, sub) end)

        if not sub.Page then
            local page = New("ScrollingFrame", { Name = sub.Name .. "Page", BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 1, 0), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Green, Visible = false }, self.PageHolder)
            TagTheme(page, "ScrollBarImageColor3", "Green")
            New("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }, page) 
            New("UIPadding", { PaddingBottom = UDim.new(0, 10), PaddingRight = UDim.new(0, 4) }, page)
            sub.Page = page
            for _, section in ipairs(sub.Sections) do self:_BuildSection(section, page) end
        end
    end
    if tab.SubTabs[1] then self:_SelectSub(tab, tab.SubTabs[1]) end
end

function Library:_SelectSub(tab, sub)
    tab.ActiveSub = sub
    for _, s in ipairs(tab.SubTabs) do
        if s.Button then 
            local active = s == sub 
            Tween(s.Button, 0.2, { BackgroundColor3 = active and Theme.Green or Theme.Card, TextColor3 = active and Theme.Background or Theme.Muted }) 
            Tween(s.Stroke, 0.2, { Transparency = active and 0 or 1 }) 
        end
        if s.Page then s.Page.Visible = s == sub end
    end
    self.PageTitle.Text = tab.Name .. " / " .. sub.Name
end

function Library:AddTab(name, icon)
    local tab = { Window = self, Name = name, Icon = icon or "•", SubTabs = {} }
    local b = New("TextButton", { BackgroundColor3 = Theme.Sidebar, Size = UDim2.new(1, 0, 0, 38), Text = "  " .. (icon or "•") .. "   " .. name, TextColor3 = Theme.Muted, Font = Enum.Font.GothamSemibold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 0, AutoButtonColor = false }, self.Nav)
    b.LayoutOrder = #self.Tabs + 1 Round(b, 10) New("UIPadding", { PaddingLeft = UDim.new(0, 12) }, b)
    
    local ind = New("Frame", { BackgroundColor3 = Theme.Green, Size = UDim2.fromOffset(3, 22), Position = UDim2.new(0, 0, 0.5, -11), Visible = false }, b)
    Round(ind, 2)
    local grad = Gradient(b, Color3.fromRGB(30,30,36), Color3.fromRGB(20,20,25), 0) grad.Enabled = false
    
    tab.Button = b tab.Indicator = ind tab.Grad = grad table.insert(self.Tabs, tab)
    
    b.MouseEnter:Connect(function() if self.ActiveTab ~= tab then Tween(b, 0.15, { BackgroundTransparency = 0, BackgroundColor3 = Theme.Card, TextColor3 = Theme.White }) end end)
    b.MouseLeave:Connect(function() if self.ActiveTab ~= tab then Tween(b, 0.15, { BackgroundTransparency = 1, TextColor3 = Theme.Muted }) end end)
    b.Activated:Connect(function() self:_SelectTab(tab) end) 
    if not self.ActiveTab then self.ActiveTab = tab self.PageTitle.Text = tab.Name if ind then ind.Visible = true end if grad then grad.Enabled = true end end
    
    return setmetatable(tab, {__index = {
        AddSubTab = function(t, subName, subIcon)
            local sub = { Tab = t, Name = subName, Icon = subIcon or "•", Sections = {} }
            table.insert(t.SubTabs, sub)
            return setmetatable(sub, {__index = {
                AddSection = function(s, sectionName)
                    local section = { Sub = s, Name = sectionName, Items = {} }
                    table.insert(s.Sections, section)
                    return setmetatable(section, {__index = {
                        AddToggle = function(sec, title, default, callback, desc) return self:_AddItem(sec, { Kind = "Toggle", Title = title, Value = default == true, Callback = callback, Desc = desc or "" }) end,
                        AddSlider = function(sec, title, min, max, default, callback, desc) return self:_AddItem(sec, { Kind = "Slider", Title = title, Min = min, Max = max, Value = math.clamp(default, min, max), Callback = callback, Desc = desc or "" }) end,
                        AddButton = function(sec, title, callback, desc) return self:_AddItem(sec, { Kind = "Button", Title = title, Callback = callback, Desc = desc or "" }) end,
                        AddDropdown = function(sec, title, options, default, callback) 
                            options = options or {"None"} if #options == 0 then options = {"None"} end
                            return self:_AddItem(sec, { Kind = "Dropdown", Title = title, Options = options, Value = default or options[1], Callback = callback, Desc = "" }) 
                        end,
                    }})
                end,
            }})
        end,
    }})
end
function Library:_AddItem(section, item) table.insert(section.Items, item) return item end

function Library:_BuildSection(section, page)
    local holder = New("Frame", { Name = section.Name, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, page) 
    local heading = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22) }, holder)
    local headingText = MakeLabel(heading, string.upper(section.Name), 11, Theme.Muted, Enum.Font.GothamBold)
    
    local itemsFrame = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, holder)
    
    if #section.Items == 1 then
        New("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, itemsFrame)
    else
        New("UIGridLayout", { CellSize = UDim2.new(0.5, -5, 0, 66), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }, itemsFrame) 
    end
    
    for _, item in ipairs(section.Items) do self:_BuildItem(item, itemsFrame, #section.Items == 1) end
end

function Library:_BuildItem(item, parent, isFullWidth)
    local isSlider = item.Kind == "Slider"
    local isButton = item.Kind == "Button"
    local hasDesc = item.Desc ~= ""
    local height = isSlider and 78 or (hasDesc and 66 or 56)
    
    local size = isFullWidth and UDim2.new(1, 0, 0, height) or UDim2.new(0.5, -5, 0, height)
    local card = New("Frame", { BackgroundColor3 = Theme.Card, BackgroundTransparency = 0.15, BorderSizePixel = 0, Size = size }, parent) 
    Round(card, 12) 
    local st1 = Stroke(card, Color3.new(0,0,0), 0.6, 2) -- Тень
    local st2 = Stroke(card, Theme.Green, 0.8, 1) TagTheme(st2, "Color", "Border")
    
    card.MouseEnter:Connect(function() Tween(card, 0.2, {BackgroundTransparency = 0, Size = size + UDim2.fromOffset(2, 2)}) Tween(st2, 0.2, {Transparency = 0.4}) end)
    card.MouseLeave:Connect(function() Tween(card, 0.2, {BackgroundTransparency = 0.15, Size = size}) Tween(st2, 0.2, {Transparency = 0.8}) end)

    local title = MakeLabel(card, item.Title, 13, Theme.White, Enum.Font.GothamMedium) title.Position = UDim2.fromOffset(12, 6) title.Size = UDim2.new(1, -55, 0, 17)
    if hasDesc and not isButton then
        local desc = MakeLabel(card, item.Desc, 10, Theme.Muted) desc.Position = UDim2.fromOffset(12, 25) desc.Size = UDim2.new(1, -24, 0, 14)
    end

    if item.Kind == "Toggle" then
        local track = New("Frame", { BackgroundColor3 = item.Value and Theme.Green or Theme.Track, Position = UDim2.new(1, -48, 0, hasDesc and 24 or 18), Size = UDim2.fromOffset(38, 20), BorderSizePixel = 0 }, card) Round(track, 15)
        local thumb = New("Frame", { BackgroundColor3 = Theme.White, Position = UDim2.fromOffset(item.Value and 20 or 2, 2), Size = UDim2.fromOffset(16, 16), BorderSizePixel = 0 }, track) Round(thumb, 12)
        local hit = New("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.fromScale(1, 1) }, track)
        local function setState(val)
            item.Value = val Tween(track, 0.2, { BackgroundColor3 = val and Theme.Green or Theme.Track }) Tween(thumb, 0.2, { Position = UDim2.fromOffset(val and 20 or 2, 2) })
            if val then track:SetAttribute("ThemeTarget_BackgroundColor3", "Green") else track:SetAttribute("ThemeTarget_BackgroundColor3", nil) end
            if item.Callback then task.spawn(item.Callback, val) end
        end
        hit.Activated:Connect(function() setState(not item.Value) end) 
        if item.Value then track:SetAttribute("ThemeTarget_BackgroundColor3", "Green") end
    elseif item.Kind == "Slider" then
        local valLabel = MakeLabel(card, tostring(item.Value), 12, Theme.Green, Enum.Font.GothamBold) valLabel.Position = UDim2.new(1, -45, 0, 6) valLabel.Size = UDim2.fromOffset(35, 17) valLabel.TextXAlignment = Enum.TextXAlignment.Right TagTheme(valLabel, "TextColor3", "Green")
        local track = New("Frame", { BackgroundColor3 = Theme.Track, Position = UDim2.new(0, 12, 0, 58), Size = UDim2.new(1, -54, 0, 5), BorderSizePixel = 0 }, card) Round(track, 5)
        local fill = New("Frame", { BackgroundColor3 = Theme.Green, Size = UDim2.new((item.Value - item.Min)/(item.Max - item.Min), 0, 1, 0), BorderSizePixel = 0 }, track) Round(fill, 5) TagTheme(fill, "BackgroundColor3", "Green")
        local thumb = New("Frame", { BackgroundColor3 = Theme.White, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14), BorderSizePixel = 0 }, track) Round(thumb, 10) Stroke(thumb, Theme.White, 0.2)
        local hit = New("TextButton", { BackgroundTransparency = 1, Text = "", Position = UDim2.new(0, -5, 0, -12), Size = UDim2.new(1, 10, 0, 30) }, track)
        
        local dragging = false
        local function setVal(value)
            local pct = math.clamp((value - item.Min) / math.max(0.001, item.Max - item.Min), 0, 1)
            fill.Size = UDim2.new(pct, 0, 1, 0) thumb.Position = UDim2.new(pct, 0, 0.5, 0) valLabel.Text = tostring(math.floor(value))
            item.Value = value if item.Callback then task.spawn(item.Callback, value) end
        end
        hit.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true setVal(item.Min + math.clamp((input.Position.X - track.AbsolutePosition.X)/track.AbsoluteSize.X, 0, 1) * (item.Max - item.Min)) end end)
        self:_Track(UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then setVal(item.Min + math.clamp((input.Position.X - track.AbsolutePosition.X)/track.AbsoluteSize.X, 0, 1) * (item.Max - item.Min)) end end))
        self:_Track(UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end))
    elseif item.Kind == "Button" then
        local btn = New("TextButton", { BackgroundColor3 = Theme.Card, Text = item.Title, TextColor3 = Theme.White, TextSize = 13, Font = Enum.Font.GothamBold, Size = UDim2.new(1, 0, 1, 0), AutoButtonColor = false }, card)

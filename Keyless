local function ApplyPhysicsImpulse(targetChar)
    if not targetChar or not targetChar.Parent then return end
    local hrp = targetChar:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local att = Instance.new("Attachment"); att.Parent = hrp
    local alignPos = Instance.new("AlignPosition")
    alignPos.Mode = Enum.PositionAlignmentMode.OneAttachment
    alignPos.Attachment0 = att
    alignPos.Position = hrp.Position + Vector3.new(1500, 1500, 1500)
    alignPos.MaxForce = math.huge; alignPos.Responsiveness = 200; alignPos.Parent = hrp
    local alignOri = Instance.new("AlignOrientation")
    alignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment
    alignOri.Attachment0 = att; alignOri.MaxTorque = math.huge; alignOri.Responsiveness = 200; alignOri.Parent = hrp
    task.delay(0.5, function()
        if alignPos then alignPos:Destroy() end
        if alignOri then alignOri:Destroy() end
        if att then att:Destroy() end
    end)
    if crosshairObj then crosshairObj:FlashHit() end
end

local function getClosestMurderer(pos) 
    local cr, cd = nil, math.huge 
    for _, p in ipairs(Players:GetPlayers()) do 
        if p ~= LocalPlayer and p.Character then 
            local data = roles[p.UserId] or roles[tostring(p.UserId)] or roles[p.Name] 
            local role = type(data) == "table" and data.Role or data
            if role and isKillerRole(role) then 
                local pr = p.Character:FindFirstChild("HumanoidRootPart") 
                if pr then 
                    local d = (pr.Position - pos).Magnitude 
                    if d < cd then cr, cd = pr, d end 
                end 
            end 
        end 
    end 
    return cr, cd 
end


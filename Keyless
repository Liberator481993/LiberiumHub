function Win:_Select(t)
    if self.Active==t then return end self.Active=t
    for _, v in ipairs(self.Tabs) do local a = v==t tween(v.Btn,FAST,{BackgroundTransparency=a and 0.8 or 1}) tween(v.Lbl,FAST,{TextColor3=a and THEME.Text or THEME.SubText}) if not a then v.Cont.Visible=false v.Cont.BackgroundTransparency=1 end end
    t.Cont.Position=UDim2.fromOffset(0,8) t.Cont.Visible=true tween(t.Cont,SLOW,{BackgroundTransparency=1,Position=UDim2.fromOffset(0,0)})
end


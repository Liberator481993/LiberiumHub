-- ==========================================
-- БИБЛИОТЕКА UI (ОТ КЛОДА)
-- ==========================================
local Library = (function()
    local Theme = {
        Background = Color3.fromHex("#121212"), Header = Color3.fromHex("#0D0D0D"),
        Sidebar = Color3.fromHex("#161616"), Section = Color3.fromHex("#1E1E1E"),
        Border = Color3.fromHex("#2C2C2C"), TabActive = Color3.fromHex("#2A2A2A"),
        Accent = Color3.fromHex("#4A90E2"), Text = Color3.fromHex("#FFFFFF"),
        TextDim = Color3.fromHex("#9A9A9A"), SwitchOff = Color3.fromHex("#3A3A3C"),
        Danger = Color3.fromHex("#E25555"),
    }
    local BASE_W, BASE_H = 560, 340
    local HEADER_H, SIDEBAR_W, TOUCH_H = 44, 140, 48
    local TWEEN = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    local function create(class, props, children)
        local inst = Instance.new(class)
        local parent = props.Parent
        props.Parent = nil
        for k, v in pairs(props) do inst[k] = v end
        if children then for _, child in ipairs(children) do child.Parent = inst end end
        inst.Parent = parent
        return inst
    end
    local function tween(inst, goal, info) TweenService:Create(inst, info or TWEEN, goal):Play() end
    local function corner(r) return create("UICorner", { CornerRadius = UDim.new(0, r) }) end
    local function padding(p) return create("UIPadding", { PaddingTop = UDim.new(0, p), PaddingBottom = UDim.new(0, p), PaddingLeft = UDim.new(0, p), PaddingRight = UDim.new(0, p) }) end
    local function formatNumber(n) return tostring(math.floor(n * 10000 + 0.5) / 10000) end

    local Library, Window, Tab, Section = {}, {}, {}, {}
    Window.__index, Tab.__index, Section.__index = Window, Tab, Section

    function Library.new(title, parent)
        local self = setmetatable({}, Window)
        self._conns, self.Tabs, self.ActiveTab = {}, {}, nil
        local gui = create("ScreenGui", { Name = "MobileUILib", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 100, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = parent or player:WaitForChild("PlayerGui") })
        self.Gui = gui
        local main = create("Frame", { Name = "Main", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(BASE_W, BASE_H), BackgroundColor3 = Theme.Background, BorderSizePixel = 0, ClipsDescendants = true, Parent = gui }, { corner(12), create("UIStroke", { Color = Theme.Border, Thickness = 1 }) })
        self.Main = main

        local uiScale = create("UIScale", { Parent = main })
        local function updateScale()
            local cam = workspace.CurrentCamera
            if cam then local vp = cam.ViewportSize; uiScale.Scale = math.max(math.min(vp.X * 0.92 / BASE_W, vp.Y * 0.88 / BASE_H, 1.25), 0.4) end
        end
        updateScale()
        if workspace.CurrentCamera then table.insert(self._conns, workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)) end

        local header = create("Frame", { Size = UDim2.new(1, 0, 0, HEADER_H), BackgroundColor3 = Theme.Header, BorderSizePixel = 0, Parent = main })
        create("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(16, 0), Size = UDim2.new(1, -72, 1, 0), Font = Enum.Font.GothamBold, Text = title or "Window", TextColor3 = Theme.Text, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left, Parent = header })
        
        local closeBtn = create("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.fromOffset(36, 36), BackgroundColor3 = Theme.Section, AutoButtonColor = false, Font = Enum.Font.GothamBold, Text = "X", TextColor3 = Theme.TextDim, TextSize = 16, Parent = header }, { corner(8) })
        table.insert(self._conns, closeBtn.Activated:Connect(function() self:Destroy() end))

        local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
        table.insert(self._conns, header.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; dragInput = input; dragStart = input.Position; startPos = main.Position end
        end))
        table.insert(self._conns, UserInputService.InputChanged:Connect(function(input)
            if dragging and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
                local d = input.Position - dragStart
                main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end))
        table.insert(self._conns, UserInputService.InputEnded:Connect(function(input)
            if dragging and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseButton1) then dragging = false end
        end))

        self.Sidebar = create("ScrollingFrame", { Position = UDim2.fromOffset(0, HEADER_H), Size = UDim2.new(0, SIDEBAR_W, 1, -HEADER_H), BackgroundColor3 = Theme.Sidebar, BorderSizePixel = 0, ScrollBarThickness = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y, Parent = main }, { padding(8), create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
        create("Frame", { Position = UDim2.fromOffset(SIDEBAR_W, HEADER_H), Size = UDim2.new(0, 1, 1, -HEADER_H), BackgroundColor3 = Theme.Border, BorderSizePixel = 0, Parent = main })
        self.Content = create("Frame", { Position = UDim2.fromOffset(SIDEBAR_W + 1, HEADER_H), Size = UDim2.new(1, -(SIDEBAR_W + 1), 1, -HEADER_H), BackgroundTransparency = 1, Parent = main })
        return self
    end

    function Window:CreateTab(name)
        local tab = setmetatable({}, Tab)
        tab.Window, tab.Name, tab._sections = self, name, 0
        local button = create("TextButton", { Size = UDim2.new(1, 0, 0, TOUCH_H), BackgroundColor3 = Theme.TabActive, BackgroundTransparency = 1, AutoButtonColor = false, Text = "", LayoutOrder = #self.Tabs + 1, Parent = self.Sidebar }, { corner(8) })
        local indicator = create("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 4, 0.5, 0), Size = UDim2.fromOffset(3, 0), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Parent = button }, { corner(2) })
        local label = create("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(16, 0), Size = UDim2.new(1, -20, 1, 0), Font = Enum.Font.GothamMedium, Text = name, TextColor3 = Theme.TextDim, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = button })
        local page = create("ScrollingFrame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Border, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y, Visible = false, Parent = self.Content }, { padding(10), create("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }) })
        tab.Button, tab.Indicator, tab.Label, tab.Page = button, indicator, label, page
        
        table.insert(self._conns, button.Activated:Connect(function() self:_select(tab) end))
        table.insert(self.Tabs, tab)
        if not self.ActiveTab then self:_select(tab, true) end
        return tab
    end

    function Window:_select(tab, instant)
        local info = instant and TweenInfo.new(0) or TWEEN
        for _, t in ipairs(self.Tabs) do
            local active = (t == tab)
            t.Page.Visible = active
            tween(t.Button, { BackgroundTransparency = active and 0 or 1 }, info)
            tween(t.Label, { TextColor3 = active and Theme.Text or Theme.TextDim }, info)
            tween(t.Indicator, { Size = UDim2.fromOffset(3, active and 22 or 0) }, info)
        end
        self.ActiveTab = tab
    end

    function Window:Destroy()
        for _, c in ipairs(self._conns) do c:Disconnect() end
        self.Gui:Destroy()
    end

    function Tab:CreateSection(name)
        local section = setmetatable({}, Section)
        section.Window, section.Page, section._order = self.Window, self.Page, 0
        self._sections += 1
        local frame = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.Section, BorderSizePixel = 0, LayoutOrder = self._sections, Parent = self.Page }, { corner(10), create("UIStroke", { Color = Theme.Border, Thickness = 1, Transparency = 0.3 }), padding(10), create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }) })
        create("TextLabel", { Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = string.upper(name), TextColor3 = Theme.Accent, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 0, Parent = frame })
        section.Frame = frame
        return section
    end

    function Section:_nextOrder() self._order += 1; return self._order end

    function Section:AddToggle(opts)
        local state = opts.Default == true
        local row = create("TextButton", { Size = UDim2.new(1, 0, 0, TOUCH_H), BackgroundTransparency = 1, AutoButtonColor = false, Text = "", LayoutOrder = self:_nextOrder(), Parent = self.Frame })
        create("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, -66, 1, 0), Font = Enum.Font.GothamMedium, Text = opts.Name or "Toggle", TextColor3 = Theme.Text, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
        local switch = create("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(52, 30), BackgroundColor3 = state and Theme.Accent or Theme.SwitchOff, BorderSizePixel = 0, Parent = row }, { corner(15) })
        local thumb = create("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = state and UDim2.new(1, -27, 0.5, 0) or UDim2.new(0, 3, 0.5, 0), Size = UDim2.fromOffset(24, 24), BackgroundColor3 = Theme.Text, BorderSizePixel = 0, Parent = switch }, { corner(12) })
        
        local function render(anim)
            local info = anim and TWEEN or TweenInfo.new(0)
            tween(thumb, { Position = state and UDim2.new(1, -27, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) }, info)
            tween(switch, { BackgroundColor3 = state and Theme.Accent or Theme.SwitchOff }, info)
        end
        table.insert(self.Window._conns, row.Activated:Connect(function() state = not state; render(true); pcall(opts.Callback, state) end))
    end

    function Section:AddSlider(opts)
        local min, max = opts.Min or 0, opts.Max or 100
        local inc = opts.Increment or 1
        local value = math.clamp(opts.Default or min, min, max)
        local row = create("Frame", { Size = UDim2.new(1, 0, 0, 66), BackgroundTransparency = 1, LayoutOrder = self:_nextOrder(), Parent = self.Frame })
        create("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, -70, 0, 26), Font = Enum.Font.GothamMedium, Text = opts.Name or "Slider", TextColor3 = Theme.Text, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
        local valueLabel = create("TextLabel", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(64, 26), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = formatNumber(value), TextColor3 = Theme.Accent, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Right, Parent = row })
        local hit = create("Frame", { Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, Active = true, Parent = row })
        local track = create("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0), Size = UDim2.new(1, -24, 0, 6), BackgroundColor3 = Theme.SwitchOff, BorderSizePixel = 0, Parent = hit }, { corner(3) })
        local alpha0 = (value - min) / (max - min)
        local fill = create("Frame", { Size = UDim2.new(alpha0, 0, 1, 0), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Parent = track }, { corner(3) })
        local thumb = create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(alpha0, 0, 0.5, 0), Size = UDim2.fromOffset(22, 22), BackgroundColor3 = Theme.Text, BorderSizePixel = 0, Parent = track }, { corner(11) })
        
        local function apply(v, silent)
            v = math.clamp(math.floor((v - min) / inc + 0.5) * inc + min, min, max)
            local a = (max == min) and 0 or (v - min) / (max - min)
            value = v
            fill.Size = UDim2.new(a, 0, 1, 0)
            thumb.Position = UDim2.new(a, 0, 0.5, 0)
            valueLabel.Text = formatNumber(value)
            if not silent then task.spawn(opts.Callback, value) end
        end
        local function fromX(x) apply(min + math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1) * (max - min)) end
        
        local dragging, dragInput = false, nil
        table.insert(self.Window._conns, hit.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; dragInput = input; self.Page.ScrollingEnabled = false; fromX(input.Position.X) end end))
        table.insert(self.Window._conns, UserInputService.InputChanged:Connect(function(input) if dragging and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement) then fromX(input.Position.X) end end))
        table.insert(self.Window._conns, UserInputService.InputEnded:Connect(function(input) if dragging and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseButton1) then dragging = false; self.Page.ScrollingEnabled = true end end))
    end
    return Library
end)()


        self:_refreshIcon()
        self:_bindButtonInput()
        self:_connect(gui:GetPropertyChangedSignal("AbsoluteSize"), function()
            self:_setButtonPosition(button.AbsolutePosition)
        end)
        self:_connect(UserInputService:GetPropertyChangedSignal("TouchEnabled"), function()
            gui.Enabled = UserInputService.TouchEnabled or opts.AlwaysShowButton
        end)
    end
    function UT:_bindButtonInput()
        local button = self._button
        local threshold = self._options.DragThreshold
        local activeInput = nil
        local dragStart = Vector3.zero
        local buttonStart = Vector2.zero
        local moved = false
        self:_connect(button.InputBegan, function(input)
            if activeInput then return end
            local it = input.UserInputType
            if it ~= Enum.UserInputType.MouseButton1 and it ~= Enum.UserInputType.Touch then return end
            activeInput = input; dragStart = input.Position
            buttonStart = button.AbsolutePosition; moved = false
            self:_tweenScale(0.9)
        end)
        self:_connect(UserInputService.InputChanged, function(input)
            if not activeInput then return end
            local isTouch = input == activeInput
            local isMouseDrag = activeInput.UserInputType == Enum.UserInputType.MouseButton1
                and input.UserInputType == Enum.UserInputType.MouseMovement
            if not (isTouch or isMouseDrag) then return end
            local delta = input.Position - dragStart
            if not moved and delta.Magnitude >= threshold then moved = true end
            if moved then self:_setButtonPosition(buttonStart + Vector2.new(delta.X, delta.Y)) end
        end)
        self:_connect(UserInputService.InputEnded, function(input)
            if not activeInput then return end
            local isTouch = input == activeInput
            local isMouseUp = activeInput.UserInputType == Enum.UserInputType.MouseButton1
                and input.UserInputType == Enum.UserInputType.MouseButton1
            if not (isTouch or isMouseUp) then return end
            local wasTap = not moved
            activeInput = nil; moved = false
            self:_tweenScale(1)
            if wasTap then self:Toggle() end
        end)
    end
    function UT.new(mainGui, options)
        local opts = table.clone(DEFAULTS)
        for k, v in pairs(options or {}) do opts[k] = v end
        local self = setmetatable({
            _mainGui = mainGui, _options = opts, _connections = {}, _destroyed = false,
            _gui = nil, _button = nil, _stroke = nil, _slash = nil, _scale = nil, _scaleTween = nil,
        }, UT)
        self:_connect(UserInputService.InputBegan, function(input, gameProcessed)
            if gameProcessed then return end
            if input.KeyCode == opts.Keybind then self:Toggle() end
        end)
        self:_connect(mainGui:GetPropertyChangedSignal("Enabled"), function()
            self:_refreshIcon()
            if typeof(opts.OnToggle) == "function" then opts.OnToggle(mainGui.Enabled) end
        end)
        self:_connect(mainGui.Destroying, function() self:Destroy() end)
        local ok, err = pcall(self._buildButton, self)
        if not ok then warn("[UIToggle] button build failed: " .. tostring(err)) end
        return self
    end
    function UT:SetVisible(visible)
        if self._destroyed then return end
        pcall(function() self._mainGui.Enabled = visible end)
    end
    function UT:Toggle()
        if self._destroyed then return end
        self:SetVisible(not self._mainGui.Enabled)
    end
    function UT:Destroy()
        if self._destroyed then return end
        self._destroyed = true
        for _, c in ipairs(self._connections) do c:Disconnect() end
        table.clear(self._connections)
        if self._scaleTween then self._scaleTween:Cancel() self._scaleTween = nil end
        if self._gui then self._gui:Destroy() end
        self._gui, self._button, self._stroke, self._slash, self._scale = nil, nil, nil, nil, nil
        self._options.OnToggle = nil
    end
    return UT
end)()

-- 7. OVERHEAD TRACKER (ESP 2.0)
OverheadTracker = (function()
    local OT = {}
    OT.__index = OT
    local RED = Color3.fromRGB(255, 70, 70)
    local BLUE = Color3.fromRGB(70, 140, 255)
    local GREEN = Color3.fromRGB(70, 220, 110)
    local UNKNOWN_COLOR = Color3.fromRGB(200, 200, 210)

    local DEFAULT_ROLE_COLORS = {
        murderer = RED, killer = RED, zombie = RED,
        sheriff = BLUE, hero = BLUE,
        innocent = GREEN, survivor = GREEN,
    }
    local DEFAULTS = {
        MaxDistance = 150, UpdateInterval = 0.2, AlwaysOnTop = true, AutoStart = true,
        LabelSize = Vector2.new(130, 24), HeadOffset = Vector3.new(0, 2.5, 0),
        TextSize = 14, Font = Enum.Font.GothamBold, DistanceUnit = "m", StudsPerUnit = 1,
        MaxStackLevels = 4, StackDirection = 1, ShowUnknownRoles = true, RoleColors = nil,
    }
    local function byDepth(a, b) return a.Depth < b.Depth end
    local function setShown(entry, shown)
        if entry.Shown ~= shown then entry.Shown = shown entry.Gui.Enabled = shown end
    end
    local function applyLevel(entry, level, direction)
        if entry.Level ~= level then
            entry.Level = level
            entry.Gui.SizeOffset = Vector2.new(0, level * direction)
        end
    end
    local function createEntry(head, opts)
        local gui = Instance.new("BillboardGui")
        gui.Name = "OverheadTracker"; gui.Adornee = head; gui.AlwaysOnTop = opts.AlwaysOnTop
        gui.Size = UDim2.fromOffset(opts.LabelSize.X, opts.LabelSize.Y)
        gui.StudsOffset = opts.HeadOffset; gui.LightInfluence = 0
        gui.ResetOnSpawn = false; gui.ClipsDescendants = false
        gui.Active = false; gui.Enabled = false; gui.Parent = head
        local label = Instance.new("TextLabel")
        label.Name = "Label"; label.Size = UDim2.fromScale(1, 1)
        label.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
        label.BackgroundTransparency = 0.45; label.BorderSizePixel = 0
        label.Font = opts.Font; label.TextSize = opts.TextSize
        label.TextColor3 = UNKNOWN_COLOR; label.TextXAlignment = Enum.TextXAlignment.Center
        label.TextYAlignment = Enum.TextYAlignment.Center; label.Text = ""; label.Parent = gui
        local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 6); corner.Parent = label
        local stroke = Instance.new("UIStroke")
        stroke.Color = UNKNOWN_COLOR; stroke.Thickness = 1.5
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; stroke.Parent = label
        return {
            Gui = gui, Label = label, Stroke = stroke, Head = head,
            Shown = false, Level = 0, LastRole = nil, LastDistance = nil, Color = nil,
            ScreenX = 0, ScreenY = 0, AdjY = 0, Depth = 0,
        }
    end
    function OT.new(getRoleFunction, options)
        local opts = table.clone(DEFAULTS)
        for key, value in pairs(options or {}) do opts[key] = value end
        local roleColors = table.clone(DEFAULT_ROLE_COLORS)
        if opts.RoleColors then
            for role, color in pairs(opts.RoleColors) do roleColors[string.lower(role)] = color end
        end
        local self = setmetatable({
            _getRoles = getRoleFunction, _options = opts, _roleColors = roleColors,
            _colorCache = {}, _records = {}, _connections = {}, _heartbeat = nil,
            _elapsed = 0, _visible = true, _destroyed = false, _lastRoles = {},
            _warnedProvider = false, _warnedUpdate = false, _scratch = {},
        }, OT)
        table.insert(self._connections, Players.PlayerAdded:Connect(function(player) self:_trackPlayer(player) end))
        table.insert(self._connections, Players.PlayerRemoving:Connect(function(player) self:_untrackPlayer(player) end))
        for _, player in ipairs(Players:GetPlayers()) do self:_trackPlayer(player) end
        if opts.AutoStart then self:Start() end
        return self
    end
    function OT:_isCurrent(record, generation) return not self._destroyed and self._records[record.Player] == record and record.Generation == generation end
    function OT:_clearCharacter(record)
        record.Generation += 1
        for _, connection in ipairs(record.CharConnections) do connection:Disconnect() end
        table.clear(record.CharConnections)
        local entry = record.Entry
        if entry then record.Entry = nil entry.Gui:Destroy() end
    end
    function OT:_setupCharacter(record, character)
        self:_clearCharacter(record)
        local generation = record.Generation
        task.spawn(function()
            local ok, err = pcall(function()
                local head = character:WaitForChild("Head", 10)
                if not head or not self:_isCurrent(record, generation) then return end
                local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
                if not self:_isCurrent(record, generation) then return end
                if humanoid and humanoid.Health <= 0 then return end
                record.Entry = createEntry(head, self._options)
                if humanoid then
                    table.insert(record.CharConnections, humanoid.Died:Once(function()
                        if self:_isCurrent(record, generation) then self:_clearCharacter(record) end
                    end))
                end
            end)
            if not ok then warn("[OverheadTracker] Character setup failed: " .. tostring(err)) end
        end)
    end
    function OT:_trackPlayer(player)
        if player == LocalPlayer or self._records[player] or self._destroyed then return end
        local record = { Player = player, Entry = nil, Generation = 0, PlayerConnections = {}, CharConnections = {} }
        self._records[player] = record
        table.insert(record.PlayerConnections, player.CharacterAdded:Connect(function(character) self:_setupCharacter(record, character) end))
        table.insert(record.PlayerConnections, player.CharacterRemoving:Connect(function() self:_clearCharacter(record) end))
        if player.Character then self:_setupCharacter(record, player.Character) end
    end
    function OT:_untrackPlayer(player)
        local record = self._records[player]
        if not record then return end
        self._records[player] = nil
        self:_clearCharacter(record)
        for _, connection in ipairs(record.PlayerConnections) do connection:Disconnect() end
        table.clear(record.PlayerConnections)
    end
    function OT:_fetchRoles()
        local ok, result = pcall(self._getRoles)
        if ok and type(result) == "table" then self._lastRoles = result return result end
        if not ok and not self._warnedProvider then
            self._warnedProvider = true
            warn("[OverheadTracker] Role provider errored: " .. tostring(result))
        end
        return self._lastRoles
    end
    function OT:_colorFor(roleText)
        local color = self._colorCache[roleText]
        if not color then
            color = self._roleColors[string.lower(roleText)] or UNKNOWN_COLOR
            self._colorCache[roleText] = color
        end
        return color
    end
    function OT:_update()
        local opts = self._options
        local camera = workspace.CurrentCamera
        if not camera then return end
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local origin = root and root.Position or camera.CFrame.Position
        local roles = self:_fetchRoles()
        local maxDistance = opts.MaxDistance
        local invUnit = 1 / opts.StudsPerUnit
        local unit = opts.DistanceUnit
        local onScreenEntries = self._scratch
        table.clear(onScreenEntries)
        for _, record in pairs(self._records) do
            local entry = record.Entry
            if entry then
                local head = entry.Head
                if not head.Parent then
                    self:_clearCharacter(record)
                    continue
                end
                local position = head.Position
                local distance = (position - origin).Magnitude
                local data = roles[record.Player.UserId] or roles[tostring(record.Player.UserId)] or roles[record.Player.Name]
                local role = type(data) == "table" and data.Role or data
                if distance > maxDistance or (role == nil and not opts.ShowUnknownRoles) then
                    setShown(entry, false)
                    applyLevel(entry, 0, opts.StackDirection)
                    continue
                end
                local roleText = role == nil and "Unknown" or tostring(role)
                local displayDistance = math.floor(distance * invUnit + 0.5)
                if entry.LastRole ~= roleText or entry.LastDistance ~= displayDistance then
                    entry.LastRole = roleText
                    entry.LastDistance = displayDistance
                    entry.Label.Text = string.format("%s [%d%s]", roleText, displayDistance, unit)
                end
                local color = self:_colorFor(roleText)
                if entry.Color ~= color then
                    entry.Color = color
                    entry.Label.TextColor3 = color
                    entry.Stroke.Color = color
                end
                setShown(entry, true)
                local screen, onScreen = camera:WorldToViewportPoint(position)
                if onScreen then
                    entry.ScreenX = screen.X
                    entry.ScreenY = screen.Y
                    entry.Depth = screen.Z
                    table.insert(onScreenEntries, entry)
                else
                    applyLevel(entry, 0, opts.StackDirection)
                end
            end
        end
        local count = #onScreenEntries
        if count == 0 then return end
        table.sort(onScreenEntries, byDepth)
        local width, height = opts.LabelSize.X, opts.LabelSize.Y
        local maxLevels = opts.MaxStackLevels
        for i = 1, count do
            local entry = onScreenEntries[i]
            local level = 0
            while level < maxLevels do
                local y = entry.ScreenY - level * height
                local blocked = false
                for j = 1, i - 1 do
                    local other = onScreenEntries[j]
                    if math.abs(entry.ScreenX - other.ScreenX) < width and math.abs(y - other.AdjY) < height then
                        blocked = true
                        break
                    end
                end
                if not blocked then break end
                level += 1
            end
            entry.AdjY = entry.ScreenY - level * height
            applyLevel(entry, level, opts.StackDirection)
        end
    end
    function OT:_onHeartbeat(dt)
        self._elapsed += dt
        if self._elapsed < self._options.UpdateInterval then return end
        self._elapsed = 0
        if not self._visible then return end
        local ok, err = pcall(self._update, self)
        if not ok and not self._warnedUpdate then
            self._warnedUpdate = true
            warn("[OverheadTracker] Update failed: " .. tostring(err))
        end
    end
    function OT:_hideAll()
        for _, record in pairs(self._records) do
            local entry = record.Entry
            if entry then setShown(entry, false) end
        end
    end
    function OT:Start()
        if self._destroyed or self._heartbeat then return end
        self._elapsed = self._options.UpdateInterval
        self._heartbeat = RunService.Heartbeat:Connect(function(dt) self:_onHeartbeat(dt) end)
    end
    function OT:Stop()
        if self._heartbeat then self._heartbeat:Disconnect() self._heartbeat = nil end
        self:_hideAll()
    end
    function OT:SetVisible(visible)
        if self._destroyed then return end
        self._visible = visible
        if visible then
            self._elapsed = self._options.UpdateInterval
        else
            self:_hideAll()
        end
    end
    function OT:SetMaxDistance(studs)
        if type(studs) == "number" and studs > 0 then
            self._options.MaxDistance = studs
            self._elapsed = self._options.UpdateInterval
        end
    end
    function OT:Destroy()
        if self._destroyed then return end
        self._destroyed = true
        if self._heartbeat then self._heartbeat:Disconnect() self._heartbeat = nil end
        for _, connection in ipairs(self._connections) do connection:Disconnect() end
        table.clear(self._connections)
        for player in pairs(table.clone(self._records)) do self:_untrackPlayer(player) end
        table.clear(self._scratch)
        table.clear(self._colorCache)
        self._lastRoles = {}
        self._getRoles = function() return {} end
    end
    return OT
end)()


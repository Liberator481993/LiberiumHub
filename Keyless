-- Перетаскивание иконки (работает и на ПК, и на мобилках)
local dragging, dragInput, dragStart, startPos
IconBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = IconBtn.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

IconBtn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UIS.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        IconBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Логика открытия/закрытия меню (фикс для мобилок)
local function toggleMenu()
    if not CFG.MenuOpen then
        local ok = pcall(function() Window:Open() end)
        if not ok then
            pcall(function() Window:Toggle(true) end)
        end
        CFG.MenuOpen = true
        UIStroke.Color = Color3.fromRGB(255, 60, 60)
    else
        local ok = pcall(function() Window:Close() end)
        if not ok then
            pcall(function() Window:Toggle(false) end)
        end
        CFG.MenuOpen = false
        UIStroke.Color = Color3.fromRGB(0, 255, 102)
    end
end

-- Срабатывает на тап/клик (InputBegan надежнее для мобилок, чем MouseButton1Click)
IconBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        -- Небольшая задержка, чтобы отличить клик от перетаскивания
        task.delay(0.1, function()
            if not dragging then
                toggleMenu()
            end
        end)
    end
end)


-- 1. Загружаем библиотеку Slate
local Slate = loadstring(game:HttpGet("https://raw.githubusercontent.com/PulseZax/Slate/refs/heads/main/.lua"))()

-- 2. Создаем окно с идеальным размером под телефон
local Window = Slate:CreateWindow({
    Name = "Liberium Hub",
    Subtitle = "MM2 Edition",
    Icon = "shield",
    Logo = true,
    Size = UDim2.fromOffset(550, 380), -- Оптимальный компактный размер
    ToggleKey = Enum.KeyCode.RightShift,
})

-- 3. Добавляем авто-масштабирование (если экран маленький, окно уменьшится)
local uiscale = Instance.new("UIScale")
uiscale.Parent = Window.root
local function updateScale()
    local cam = workspace.CurrentCamera
    if cam then
        -- Уменьшаем, если экран меньше 600x420
        uiscale.Scale = math.min(1, cam.ViewportSize.X / 600, cam.ViewportSize.Y / 420)
    end
end
updateScale()
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)

-- 4. Создаем вкладки
local TabCombat = Window:CreateTab({ Name = "Combat", Icon = "crosshair" })
local TabVisuals = Window:CreateTab({ Name = "Visuals", Icon = "eye" })
local TabMovement = Window:CreateTab({ Name = "Movement", Icon = "move" })

-- 5. Заполняем Combat
local secCombat = TabCombat:CreateSection({ Name = "Player Targeting" })
secCombat:Toggle({
    Name = "Silent Aim",
    Default = false,
    Callback = function(v) print("Silent Aim:", v) end
})
secCombat:Toggle({
    Name = "Aimbot (Hold)",
    Default = false,
    Callback = function(v) print("Aimbot:", v) end
})

-- 6. Заполняем Visuals
local secVisuals = TabVisuals:CreateSection({ Name = "ESP Settings" })
secVisuals:Toggle({
    Name = "Player ESP",
    Default = false,
    Callback = function(v) print("ESP:", v) end
})
secVisuals:Slider({
    Name = "ESP Fill %",
    Min = 0, Max = 100, Default = 50,
    Callback = function(v) print("Fill:", v) end
})

-- 7. Заполняем Movement
local secMovement = TabMovement:CreateSection({ Name = "Player Physics" })
secMovement:Toggle({
    Name = "Noclip",
    Default = false,
    Callback = function(v) print("Noclip:", v) end
})
secMovement:Slider({
    Name = "WalkSpeed",
    Min = 16, Max = 150, Default = 16,
    Callback = function(v) print("Speed:", v) end
})

print("Slate UI загружен с адаптивным размером!")

-- физика
local function bindCharacter(character)
    currentChar = nil
    local root = character:WaitForChild("HumanoidRootPart", 10)
    local humanoid = character:WaitForChild("Humanoid", 10)
    if not (root and humanoid) or player.Character ~= character then return end
    collectedCount = 0; table.clear(Blacklist)
    pcall(function() humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false) end)
    pcall(function() humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false) end)
    local oldBv = root:FindFirstChildOfClass("BodyVelocity")
    local oldBg = root:FindFirstChildOfClass("BodyGyro")
    if oldBv then oldBv:Destroy() end
    if oldBg then oldBg:Destroy() end
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.zero; bv.Velocity = Vector3.zero; bv.P = 3000; bv.Parent = root
    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.zero; bg.P = 6000; bg.D = 500; bg.CFrame = root.CFrame; bg.Parent = root
    currentChar = { character = character, root = root, humanoid = humanoid, bv = bv, bg = bg }
end

player.CharacterAdded:Connect(bindCharacter)
if player.Character then task.spawn(bindCharacter, player.Character) end

RunService.Stepped:Connect(function()
    if (CFG.Noclip or CFG.AutoFarm) and player.Character then
        for _, d in ipairs(player.Character:GetDescendants()) do
            if d:IsA("BasePart") then
                if originalCollide[d] == nil then originalCollide[d] = d.CanCollide end
                d.CanCollide = false
            end
        end
    elseif not CFG.Noclip and not CFG.AutoFarm then
        for p, c in pairs(originalCollide) do pcall(function() if p and p.Parent then p.CanCollide = c end end) end
        table.clear(originalCollide)
    end
end)

-- поиск конфет
local COIN_PRIMARY = "Coin_Server"
local COIN_FALLBACK = { Coin = true, Candy = true, Sweet = true }
local coinCache, coinCacheTime, coinContainer = {}, 0, nil

local function findCoinContainer()
    return Workspace:FindFirstChild("CoinContainer", true)
        or Workspace:FindFirstChild("Coins", true)
        or Workspace:FindFirstChild("CoinFolder", true)
end

local function isCoinName(name)
    if name == COIN_PRIMARY then return true end
    if COIN_FALLBACK[name] then return true end
    if name == "CoinVisual" then return false end
    local n = string.lower(name)
    return string.find(n, "coin", 1, true) ~= nil
        or string.find(n, "candy", 1, true) ~= nil
        or string.find(n, "sweet", 1, true) ~= nil
end

local function isCoinAlive(c, container)
    if not c or not c.Parent then return false end
    if not c:IsDescendantOf(Workspace) then return false end
    if container and not c:IsDescendantOf(container) then return false end
    local vis = c:FindFirstChild("CoinVisual")
    if vis and vis:IsA("BasePart") and vis.Transparency >= 0.99 then return false end
    return true
end

local function refreshCoinCache()
    local t = os.clock()
    if t - coinCacheTime < 1 then return end
    coinCacheTime = t; coinCache = {}; coinContainer = findCoinContainer()
    if coinContainer then
        for _, c in ipairs(coinContainer:GetChildren()) do
            if c:IsA("BasePart") and isCoinName(c.Name) then
                if not Blacklist[c] and isCoinAlive(c, coinContainer) then
                    coinCache[#coinCache + 1] = c
                elseif not isCoinAlive(c, coinContainer) then
                    Blacklist[c] = true
                end
            end
        end
    end
    if #coinCache == 0 then
        for _, d in ipairs(Workspace:GetDescendants()) do
            if d:IsA("BasePart") and isCoinName(d.Name) and not Blacklist[d] and isCoinAlive(d, nil) then
                coinCache[#coinCache + 1] = d
            end
        end
    end
    D("coinCache:", #coinCache, "container:", coinContainer and coinContainer:GetFullName() or "NONE")
end

local function isCoinGuarded(pos)
    local r = CFG.AvoidRadius
    if r <= 0 then return false end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local pRoot = plr.Character:FindFirstChild("HumanoidRootPart")
            if pRoot and (pRoot.Position - pos).Magnitude < r then return true end
        end
    end
    return false
end

local function nearestPart()
    if not currentChar then return nil end
    refreshCoinCache()
    local best, bestDist = nil, math.huge
    local pos = currentChar.root.Position
    for _, c in ipairs(coinCache) do
        if c and c.Parent and not Blacklist[c] then
            local d = (c.Position - pos).Magnitude
            if d < bestDist and not isCoinGuarded(c.Position) then best, bestDist = c, d end
        else Blacklist[c] = true end
    end
    return best
end

local function flyTo(target)
    local c = currentChar
    if not c or not canCollect() or not target or not target.Parent then return false end
    local origAR = c.humanoid.AutoRotate
    local origPS = c.humanoid.PlatformStand
    local arrived = false
    local startTime = os.clock()
    local MAX_FLIGHT = 4.0
    local ok, err = pcall(function()
        c.humanoid.AutoRotate = false
        c.humanoid.PlatformStand = true
        local mass = math.max(1, c.root.AssemblyMass)
        local f = mass * CFG.ForcePerMass
        c.bv.MaxForce = Vector3.new(f, f, f)
        c.bg.MaxTorque = Vector3.new(4e5, 4e5, 4e5)
        while c.humanoid.Health > 0 and c.root.Parent do
            RunService.Heartbeat:Wait()
            if not target.Parent or not target:IsDescendantOf(Workspace) then Blacklist[target] = true; break end
            if os.clock() - startTime > MAX_FLIGHT then Blacklist[target] = true; break end
            if not canCollect() then break end
            local offset = target.Position - c.root.Position
            local dist = offset.Magnitude
            if dist <= 3 then arrived = true; break end
            local speed = math.min(CFG.MaxSpeed, dist * CFG.Gain)
            c.bv.Velocity = offset.Unit * speed
            local flat = Vector3.new(offset.X, 0, offset.Z)
            if flat.Magnitude > 0.5 then
                c.bg.CFrame = CFrame.lookAt(c.root.Position, c.root.Position + flat)
            end
        end
    end)
    if not ok then warn("[Liberium flyTo]", err) end
    c.bv.MaxForce = Vector3.zero; c.bv.Velocity = Vector3.zero; c.bg.MaxTorque = Vector3.zero
    if c.root.Parent then
        c.root.AssemblyLinearVelocity = Vector3.zero
        c.root.AssemblyAngularVelocity = Vector3.zero
        local _, yaw = c.root.CFrame:ToOrientation()
        c.root.CFrame = CFrame.new(c.root.Position) * CFrame.Angles(0, yaw, 0)
    end
    if c.humanoid.Parent and c.humanoid.Health > 0 then
        c.humanoid.AutoRotate = origAR
        c.humanoid.PlatformStand = origPS
        c.humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
    return arrived
end

local function collectTarget(target)
    local c = currentChar
    if not c or not target.Parent then return end
    Blacklist[target] = true; collectedCount += 1
    pcall(function()
        if typeof(firetouchinterest) == "function" then
            firetouchinterest(c.root, target, 0)
            firetouchinterest(c.root, target, 1)
        end
        local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt and prompt.Enabled and typeof(fireproximityprompt) == "function" then
            fireproximityprompt(prompt)
        end
    end)
    D("collected:", target:GetFullName(), "total=", collectedCount)
end

local function collectSession()
    D("session start")
    while CFG.AutoFarm and canCollect() do
        if CFG.AutoReset and collectedCount >= CFG.MaxCoins then
            if currentChar and currentChar.humanoid then currentChar.humanoid.Health = 0 end
            break
        end
        local target = nearestPart()
        if not target then D("no target"); break end
        if flyTo(target) then
            collectTarget(target); task.wait(0.1)
        else D("flyTo failed") end
    end
    D("session end total=", collectedCount)
end

task.spawn(function()
    while true do
        if CFG.AutoFarm and canCollect() then collectSession() end
        task.wait(1)
    end
end)


-- ============ ROLES ============
local roles = {}
local function setRoles()
    local getData = RS:FindFirstChild("GetPlayerData", true)
    if getData and getData:IsA("RemoteFunction") then
        local success, data = pcall(function() return getData:InvokeServer() end)
        if success and type(data) == "table" then roles = data end
    end
end
task.spawn(function() while task.wait(5) do setRoles() end end)

local function getRole(plr)
    local roleData = roles[plr.Name]
    if roleData then return roleData.Role or roleData[1] end
    return "Innocent"
end

local function getChar(plr)
    local c = plr.Character
    if not c then return nil end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then return c, hrp, hum end
    return nil
end

-- ============ DRAWING 2D BOX ESP ============
local ESPFolder = Instance.new("Folder", game:GetService("CoreGui"))
ESPFolder.Name = "LiberiumESP"

local espDrawings = {}

local function GetBox(plr)
    if espDrawings[plr] then return espDrawings[plr] end

    local box = Drawing.new("Square")
    box.Thickness = 1
    box.Filled = false
    box.Transparency = 1
    box.Color = Color3.fromRGB(255, 255, 255)
    box.Visible = false

    local name = Drawing.new("Text")
    name.Size = 14
    name.Center = true
    name.Outline = true
    name.OutlineColor = Color3.new(0, 0, 0)
    name.Color = Color3.fromRGB(255, 255, 255)
    name.Visible = false

    local dist = Drawing.new("Text")
    dist.Size = 12
    dist.Center = true
    dist.Outline = true
    dist.OutlineColor = Color3.new(0, 0, 0)
    dist.Color = Color3.fromRGB(255, 255, 255)
    dist.Visible = false

    espDrawings[plr] = { Box = box, Name = name, Dist = dist }
    return espDrawings[plr]
end

local function UpdateESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local char, hrp, hum = getChar(plr)
        local data = espDrawings[plr]
        
        if char and CFG.ESP then
            data = data or GetBox(plr)
            local role = getRole(plr)
            
            local pos, onScreen = Cam:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local head = char:FindFirstChild("Head")
                if head then
                    local headPos = Cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                    local legPos = Cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                    
                    local height = math.abs(headPos.Y - legPos.Y)
                    local width = height / 2
                    
                    data.Box.Size = Vector2.new(width, height)
                    data.Box.Position = Vector2.new(pos.X - width/2, pos.Y - height/2)
                    data.Box.Visible = true

                    if role == "Murderer" then
                        data.Box.Color = Color3.fromRGB(255, 50, 50)
                        data.Name.Color = Color3.fromRGB(255, 50, 50)
                    elseif role == "Sheriff" then
                        data.Box.Color = Color3.fromRGB(50, 150, 255)
                        data.Name.Color = Color3.fromRGB(50, 150, 255)
                    else
                        data.Box.Color = Color3.fromRGB(50, 255, 50)
                        data.Name.Color = Color3.fromRGB(50, 255, 50)
                    end

                    data.Name.Text = plr.Name .. " [" .. role .. "]"
                    data.Name.Position = Vector2.new(pos.X, pos.Y - height/2 - 16)
                    data.Name.Visible = true
                    
                    local distance = math.floor((hrp.Position - Cam.CFrame.Position).Magnitude)
                    data.Dist.Text = tostring(distance) .. "m"
                    data.Dist.Position = Vector2.new(pos.X, pos.Y + height/2 + 2)
                    data.Dist.Visible = true
                end
            else
                data.Box.Visible = false
                data.Name.Visible = false
                data.Dist.Visible = false
            end
        else
            if data then
                data.Box.Visible = false
                data.Name.Visible = false
                data.Dist.Visible = false
            end
        end
    end
end
RunService.RenderStepped:Connect(UpdateESP)


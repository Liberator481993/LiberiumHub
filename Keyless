-- LIBERIUM HUB TEMPORARY DIAGNOSTIC | MM2 COLLECTIBLE DETECTIVE v1.0
-- READ-ONLY: no collecting, teleporting, or world/property changes.
-- Run in an active MM2 round when candies/collectibles are visible.
local Workspace = game:GetService("Workspace")
local MAX_CANDIDATES, MAX_CONTAINERS, MAX_CHILDREN, MAX_ANCESTORS = 70, 25, 10, 5
local keywords = {"candy","candies","coin","coins","collect","collectible","pickup","loot","token","sweet","treat","pumpkin","present","egg","gem","cash","drop"}
local containerWords = {"container","collect","loot","spawn","item","pickup","coin","candy","map","round","drop"}
local function hasWord(text, words)
 text = string.lower(tostring(text or ""))
 for _, word in ipairs(words) do if string.find(text, word, 1, true) then return true, word end end
 return false
end
local function pathOf(inst)
 local parts, cur, hops = {}, inst, 0
 while cur and cur ~= Workspace and hops < 80 do
  table.insert(parts, 1, cur.Name .. "[" .. cur.ClassName .. "]")
  cur, hops = cur.Parent, hops + 1
 end
 return "Workspace." .. table.concat(parts, ".")
end
local function posOf(inst)
 local ok, value = pcall(function()
  if inst:IsA("BasePart") then return tostring(inst.Position) end
  if inst:IsA("Model") then return tostring(inst:GetPivot().Position) end
  local p = inst:FindFirstChildWhichIsA("BasePart", true)
  return p and (tostring(p.Position) .. " (descendant BasePart)") or "unavailable"
 end)
 return ok and value or "unavailable"
end
local function ancestorsOf(inst)
 local out, cur = {}, inst.Parent
 for _ = 1, MAX_ANCESTORS do
  if not cur or cur == Workspace then break end
  table.insert(out, cur.Name .. " (" .. cur.ClassName .. ")")
  cur = cur.Parent
 end
 return #out > 0 and table.concat(out, " <- ") or "(direct child of Workspace)"
end
local function baseParts(inst)
 local n = inst:IsA("BasePart") and 1 or 0
 local ok, ds = pcall(function() return inst:GetDescendants() end)
 if ok then for _, d in ipairs(ds) do if d:IsA("BasePart") then n = n + 1 end end end
 return n
end
local function childrenOf(inst)
 local out, kids = {}, inst:GetChildren()
 for i, ch in ipairs(kids) do
  if i > MAX_CHILDREN then table.insert(out, "... +" .. (#kids - MAX_CHILDREN) .. " more"); break end
  table.insert(out, ch.Name .. " (" .. ch.ClassName .. ")")
 end
 return #out > 0 and table.concat(out, "; ") or "(none)"
end
local all = Workspace:GetDescendants()
local candidates, containers, seenC, seenF, counts = {}, {}, {}, {}, {}
for _, inst in ipairs(all) do
 local hit, word = hasWord(inst.Name, keywords)
 local ancestorWord, cur = nil, inst.Parent
 for _ = 1, MAX_ANCESTORS do
  if not cur or cur == Workspace then break end
  local h, w = hasWord(cur.Name, keywords)
  if h then ancestorWord = w; break end
  cur = cur.Parent
 end
 if hit and (inst:IsA("BasePart") or inst:IsA("Model") or inst:IsA("Folder") or inst:IsA("Tool")) then
  if not seenC[inst] then
   seenC[inst] = true
   table.insert(candidates, {obj=inst, reason="name contains '" .. word .. "'"})
   counts[inst.Name] = (counts[inst.Name] or 0) + 1
  end
 elseif ancestorWord and (inst:IsA("BasePart") or inst:IsA("Model") or inst:IsA("Tool")) then
  if not seenC[inst] then
   seenC[inst] = true
   table.insert(candidates, {obj=inst, reason="inside ancestor containing '" .. ancestorWord .. "'"})
   counts[inst.Name] = (counts[inst.Name] or 0) + 1
  end
 end
 local ch, cw = hasWord(inst.Name, containerWords)
 if ch and (inst:IsA("Folder") or inst:IsA("Model") or inst:IsA("Configuration")) and not seenF[inst] then
  seenF[inst] = true
  table.insert(containers, {obj=inst, reason="name contains '" .. cw .. "'"})
 end
end
table.sort(candidates, function(a,b)
 local an,bn = string.lower(a.obj.Name),string.lower(b.obj.Name)
 local ac = string.find(an,"candy",1,true) and 0 or 1
 local bc = string.find(bn,"candy",1,true) and 0 or 1
 if ac ~= bc then return ac < bc end
 return an < bn
end)
table.sort(containers,function(a,b) return string.lower(a.obj.Name)<string.lower(b.obj.Name) end)
print("========== MM2 COLLECTIBLE DETECTIVE v1.0 ==========")
print("READ-ONLY | Workspace descendants: "..#all)
print("Candidates: "..#candidates.." | container-like objects: "..#containers)
print("========== NAME COUNTS ==========")
local rows = {}
for name,n in pairs(counts) do table.insert(rows,{name=name,n=n}) end
table.sort(rows,function(a,b) return a.n>b.n end)
for i=1,math.min(#rows,35) do print(rows[i].name.." = "..rows[i].n) end
if #rows==0 then print("(no keyword matches)") end
print("========== CANDIDATE DETAILS ==========")
for i=1,math.min(#candidates,MAX_CANDIDATES) do
 local e,o=candidates[i],candidates[i].obj
 print("--- Candidate "..i.." ---")
 print("Name: "..o.Name)
 print("ClassName: "..o.ClassName)
 print("Path: "..pathOf(o))
 print("Parent: "..(o.Parent and (o.Parent.Name.." ("..o.Parent.ClassName..")") or "nil"))
 print("Position: "..posOf(o))
 print("Ancestors: "..ancestorsOf(o))
 print("BasePartCountIncludingDescendants: "..baseParts(o))
 print("Reason: "..e.reason)
 print("Children: "..childrenOf(o))
end
if #candidates>MAX_CANDIDATES then print("Omitted candidates: "..(#candidates-MAX_CANDIDATES)) end
print("========== CONTAINER DETAILS ==========")
for i=1,math.min(#containers,MAX_CONTAINERS) do
 local e,o=containers[i],containers[i].obj
 print("--- Container "..i.." ---")
 print("Name: "..o.Name)
 print("ClassName: "..o.ClassName)
 print("Path: "..pathOf(o))
 print("DirectChildCount: "..#o:GetChildren())
 print("Reason: "..e.reason)
 print("Children: "..childrenOf(o))
end
if #containers>MAX_CONTAINERS then print("Omitted containers: "..(#containers-MAX_CONTAINERS)) end
print("========== END DETECTIVE ==========")
print("Send the output above. Run while candy/collectibles are visible.")

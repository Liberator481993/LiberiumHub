local Players = game:GetService("Players")
local pg = Players.LocalPlayer:WaitForChild("PlayerGui")

local sg = Instance.new("ScreenGui")
sg.Name = "LibDiag"
sg.ResetOnSpawn = false
sg.IgnoreGuiInset = true
sg.DisplayOrder = 999
sg.Parent = pg

local f = Instance.new("Frame")
f.Size = UDim2.new(1, -40, 0, 250)
f.Position = UDim2.new(0, 20, 0, 60)
f.BackgroundColor3 = Color3.fromRGB(10, 10, 15)
f.BorderSizePixel = 0
f.Parent = sg

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(0, 255, 100)
stroke.Thickness = 2
stroke.Parent = f

local t = Instance.new("TextLabel")
t.Size = UDim2.new(1, -20, 1, -20)
t.Position = UDim2.new(0, 10, 0, 10)
t.BackgroundTransparency = 1
t.TextColor3 = Color3.fromRGB(0, 255, 100)
t.TextXAlignment = Enum.TextXAlignment.Left
t.TextYAlignment = Enum.TextYAlignment.Top
t.TextWrapped = true
t.Font = Enum.Font.Code
t.TextSize = 14
t.Parent = f

local info = ""
local function add(str) info = info .. str .. "\n" end

local okExec, execName = pcall(function() return identifyexecutor() end)
add("EXECUTOR: " .. tostring(okExec and execName or "Unknown"))

add("table.clone: " .. (type(table.clone) == "function" and "YES" or "NO"))
add("table.freeze: " .. (type(table.freeze) == "function" and "YES" or "NO"))
add("CanvasGroup: " .. (pcall(function() Instance.new("CanvasGroup") end) and "YES" or "NO"))
add("writefile: " .. (type(writefile) == "function" and "YES" or "NO"))
add("readfile: " .. (type(readfile) == "function" and "YES" or "NO"))
add("getfenv: " .. (type(getfenv) == "function" and "YES" or "NO"))
add("ScreenInsets: " .. (pcall(function() local x = Instance.new("ScreenGui"); local y = x.ScreenInsets; x:Destroy(); return y end) and "YES" or "NO"))

local h = 5
local sign = -1
if h >= 0 then sign = 1 end
add("Inline if (if x then y else z): " .. (sign == 1 and "YES" or "NO"))

t.Text = info

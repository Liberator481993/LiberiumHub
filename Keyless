-- 3. STABILIZER (От Клода - анти-флинг)
-- ==========================================
local Stabilizer = (function()
    local CONFIG = { LinearThreshold = 1000, LinearSafe = 250, AngularThreshold = 1000, AngularSafe = 50, DampRate = 14, IgnoreVerticalInFreefall = true }
    local localPlayer = Players.LocalPlayer
    local connection
    local ignored = setmetatable({}, {__mode = "k"})
    local damping = setmetatable({}, {__mode = "k"})
    local API = {}

    local function dampVector(vec, threshold, safe, alpha, state, key, ignoreY)
        local y = ignoreY and vec.Y or 0
        local flat = ignoreY and Vector3.new(vec.X, 0, vec.Z) or vec
        local mag = flat.Magnitude
        if not state[key] then if mag <= threshold then return nil end state[key] = true end
        if mag <= safe * 1.05 then state[key] = false return nil end
        local newMag = mag + (safe - mag) * alpha
        local damped = flat.Unit * newMag
        return ignoreY and Vector3.new(damped.X, y, damped.Z) or damped
    end

    local function step(dt)
        local character = localPlayer.Character if not character then return end
        local root = character:FindFirstChild("HumanoidRootPart")
        if not root or ignored[character] then return end
        local state = damping[root] or {linear = false, angular = false} damping[root] = state
        local alpha = 1 - math.exp(-CONFIG.DampRate * dt)
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local freefall = CONFIG.IgnoreVerticalInFreefall and humanoid and humanoid:GetState() == Enum.HumanoidStateType.Freefall
        local lin = dampVector(root.AssemblyLinearVelocity, CONFIG.LinearThreshold, CONFIG.LinearSafe, alpha, state, "linear", freefall)
        if lin then root.AssemblyLinearVelocity = lin end
        local ang = dampVector(root.AssemblyAngularVelocity, CONFIG.AngularThreshold, CONFIG.AngularSafe, alpha, state, "angular", false)
        if ang then root.AssemblyAngularVelocity = ang end
    end

    function API.Start() if not connection then connection = RunService.Heartbeat:Connect(step) end end
    function API.Stop() if connection then connection:Disconnect() connection = nil end end
    return API
end)()


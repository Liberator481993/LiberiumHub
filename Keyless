function Window:_SelectTab(tab)
    if self.ActiveTab == tab then return end
    self.ActiveTab = tab
    for _, t in ipairs(self.Tabs) do
        local active = t == tab
        tween(t.Button, FAST, {BackgroundTransparency = active and 0.8 or 1})
        tween(t.NameLabel, FAST, {TextColor3 = active and THEME.Text or THEME.SubText})
        if not active then t.Container.Visible = false t.Container.GroupTransparency = 1 end
    end
    tab.Container.Position = UDim2.fromOffset(0, 8) tab.Container.Visible = true
    tween(tab.Container, SLOW, {GroupTransparency = 0, Position = UDim2.fromOffset(0, 0)})
end


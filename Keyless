    pcall(function() local oldBlur = Lighting:FindFirstChild("LiberiumUIBlur") if oldBlur then oldBlur:Destroy() end self.Blur = create("BlurEffect", { Name = "LiberiumUIBlur", Size = 7, Enabled = true }, Lighting) end)

    self.OpenButton = create("ImageButton", { Name = "OpenWindow", Position = UDim2.new(0, 80, 0.5, -28), Size = UDim2.fromOffset(56, 56), BackgroundColor3 = Theme.Panel, Image = "rbxassetid://93999324301796", ScaleType = Enum.ScaleType.Crop, Visible = false, AutoButtonColor = false }, self.Gui)
    addCorner(self.OpenButton, 28) addStroke(self.OpenButton, Theme.Green, 0.25, 1.4)
    

-- Логика поиска
local function getContainer()
    return Workspace:FindFirstChild("CoinContainer", true)
end

local function findNearest()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local container = getContainer()
    if not container then return nil end
    
    local closest, minDist = nil, math.huge
    for _, coin in ipairs(container:GetChildren()) do
        if coin.Name == "Coin_Server" and coin:IsA("BasePart") and not blacklist[coin] then
            local dist = (coin.Position - hrp.Position).Magnitude
            if dist < minDist then
                minDist = dist
                closest = coin
            end
        end
    end
    return closest
end

-- Основной цикл (Физика)
RunService.Heartbeat:Connect(function()
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if isFarming then
        -- 1. Включаем проход сквозь стены
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end

        -- 2. Отключаем стандартную физику ходьбы
        if not hum.PlatformStand then hum.PlatformStand = true end

        -- 3. Создаем физику полета
        if not bv or bv.Parent ~= hrp then
            bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.P = 1250
            bv.Parent = hrp
            bg = Instance.new("BodyGyro")
            bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bg.P = 1000
            bg.Parent = hrp
        end

        -- 4. Если цель удалена, сбрасываем
        if currentTarget and not currentTarget.Parent then
            currentTarget = nil
        end

        -- 5. Ищем новую, если нет
        if not currentTarget then
            currentTarget = findNearest()
            if currentTarget then
                StatusText.Text = "Цель найдена!"
            else
                StatusText.Text = "Нет монет..."
                bv.Velocity = Vector3.zero
            end
        end

        -- 6. Летим к цели
        if currentTarget then
            local targetPos = currentTarget.Position
            local distance = (hrp.Position - targetPos).Magnitude

            -- Если расстояние меньше 3 стадов, значит мы у цели
            if distance < 3 then
                -- Останавливаемся
                bv.Velocity = Vector3.zero
                
                -- Собираем
                blacklist[currentTarget] = true
                pcall(function()
                    firetouchinterest(hrp, currentTarget, 0)
                    firetouchinterest(hrp, currentTarget, 1)
                end)
                for _, prompt in ipairs(currentTarget:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        pcall(function() fireproximityprompt(prompt) end)
                    end
                end

                -- ЖДЕМ, пока сервер удалит монету (античит не спалит)
                local timeout = 0
                while currentTarget.Parent and timeout < 0.3 do
                    task.wait(0.05)
                    timeout += 0.05
                end
                currentTarget = nil
                task.wait(0.1) -- Пауза перед следующей
            else
                -- Летим (Скорость ограничена ползунком)
                local dir = (targetPos - hrp.Position).Unit
                bv.Velocity = dir * farmSpeed
                bg.CFrame = CFrame.new(hrp.Position, targetPos)
            end
        end
    else
        -- Выключено
        if bv then bv:Destroy(); bv = nil end
        if bg then bg:Destroy(); bg = nil end
        if hum.PlatformStand then hum.PlatformStand = false end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end
end)

-- Управление ползунком (Тач)
SliderBg.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local function update(x)
            local percent = math.clamp((x - SliderBg.AbsolutePosition.X) / SliderBg.AbsoluteSize.X, 0, 1)
            farmSpeed = math.floor(percent * 24) + 1
            SliderFill.Size = UDim2.new(percent, 0, 1, 0)
            StatusText.Text = "Скорость: " .. farmSpeed
        end
        update(input.Position.X)
        
        local moveConn
        moveConn = game:GetService("UserInputService").InputChanged:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
                update(i.Position.X)
            end
        end)
        game:GetService("UserInputService").InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                if moveConn then moveConn:Disconnect() end
            end
        end)
    end
end)

-- Очистка
task.spawn(function()
    while task.wait(5) do
        for coin in pairs(blacklist) do
            if not coin.Parent then blacklist[coin] = nil end
        end
    end
end)


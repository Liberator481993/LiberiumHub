local function createNav(name, iconText, order)
    local btn = make("TextButton", {Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = C.panel, BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = order, BorderSizePixel = 0}, nav)
    round(btn, 8)
    local accent = make("Frame", {Position = UDim2.new(0, 0, 0.5, -10), Size = UDim2.new(0, 3, 0, 20), BackgroundColor3 = C.green, BackgroundTransparency = 1, BorderSizePixel = 0}, btn)
    round(accent, 3)
    local ico = label(btn, iconText, 16, C.muted, Enum.Font.GothamBold)
    ico.Position = UDim2.new(0, 10, 0, 4); ico.Size = UDim2.new(0, 25, 0, 28); ico.TextXAlignment = Enum.TextXAlignment.Center
    local txt = label(btn, name, 12, C.muted, Enum.Font.GothamMedium)
    txt.Position = UDim2.new(0, 38, 0, 4); txt.Size = UDim2.new(1, -42, 0, 28)

    buttons[name] = {button = btn, accent = accent, icon = ico, text = txt}

    btn.MouseButton1Click:Connect(function()
        currentPage = name
        for n, item in pairs(buttons) do
            local active = n == name
            tween(item.button, 0.18, {BackgroundTransparency = active and 0 or 1, BackgroundColor3 = active and C.greenDark or C.panel})
            tween(item.accent, 0.18, {BackgroundTransparency = active and 0 or 1})
            item.icon.TextColor3 = active and C.green or C.muted
            item.text.TextColor3 = active and C.white or C.muted
        end
        pageTitle.Text = name
        renderPage(name)
    end)
end

for i, name in ipairs(pageNames) do createNav(name, pageIcons[i], i) end


    self.HeaderSearch = create("TextBox", { Name = "HeaderSearch", PlaceholderText = "Search tabs...", Text = "", ClearTextOnFocus = false, Position = UDim2.new(1, -230, 0, 17), Size = UDim2.new(0, 170, 0, 34), BackgroundColor3 = Theme.Card, TextColor3 = Theme.Text, PlaceholderColor3 = Theme.Muted, TextSize = 11, Font = Enum.Font.Gotham, BorderSizePixel = 0 }, self.Header)

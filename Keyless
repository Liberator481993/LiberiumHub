-- 1. CONFIG MANAGER
local ConfigManager = (function()
    local DEFAULT_FOLDER = "DashboardConfig" local DEFAULT_FILE = "settings"
    local ConfigManager = {} ConfigManager.__index = ConfigManager
    local function hasFunction(name) local ok, v = pcall(function() return getfenv()[name] end) return ok and typeof(v) == "function" end
    local function callGlobal(name, ...) return getfenv()[name](...) end
    local function isFiniteNumber(n) return n == n and n ~= math.huge and n ~= -math.huge end
    local function isArray(t) local count = 0 for key in pairs(t) do if type(key) ~= "number" or key < 1 or key % 1 ~= 0 then return false end count += 1 end return count == #t end
    local function sanitize(value, depth, seen)
        local vType = typeof(value)
        if vType == "string" or vType == "boolean" then return value
        elseif vType == "number" then return isFiniteNumber(value) and value or nil
        elseif vType == "Color3" then return { __type = "Color3", R = value.R, G = value.G, B = value.B }
        elseif vType == "Vector2" then return { __type = "Vector2", X = value.X, Y = value.Y }
        elseif vType == "table" then
            if depth >= 32 or seen[value] then return nil end
            seen[value] = true local res = {}
            if isArray(value) then for i = 1, #value do res[i] = sanitize(value[i], depth + 1, seen) or false end
            else for k, v in pairs(value) do if type(k) == "string" or type(k) == "number" then local c = sanitize(v, depth + 1, seen) if c ~= nil then res[tostring(k)] = c end end end end
            seen[value] = nil return res
        end return nil
    end
    local function restore(value, depth)
        if type(value) ~= "table" or depth >= 32 then return value end
        if value.__type == "Color3" then return Color3.new(value.R, value.G, value.B)
        elseif value.__type == "Vector2" then return Vector2.new(value.X, value.Y) end
        local res = {} for k, v in pairs(value) do res[k] = restore(v, depth + 1) end return res
    end
    function ConfigManager.new() local self = setmetatable({}, ConfigManager) self._folder = DEFAULT_FOLDER self._memory = {} self._canWrite = hasFunction("writefile") self._canRead = hasFunction("readfile") self._canMakeFolder = hasFunction("makefolder") self._canCheckFolder = hasFunction("isfolder") return self end
    function ConfigManager:_normalizeName(fileName) local name = type(fileName) == "string" and fileName or DEFAULT_FILE name = name:gsub("[^%w_%-%.]", "_") if name == "" or name == "." or name == ".." then name = DEFAULT_FILE end if name:sub(-5):lower() ~= ".json" then name ..= ".json" end return name end
    function ConfigManager:_path(name) return self._folder .. "/" .. name end
    function ConfigManager:_ensureFolder() if not self._canMakeFolder then return end pcall(function() if not (hasFunction("isfolder") and callGlobal("isfolder", self._folder)) then callGlobal("makefolder", self._folder) end end) end
    function ConfigManager:Save(tbl, fileName)
        local clean = sanitize(tbl, 0, {}) if not clean then return false end
        local ok, json = pcall(HttpService.JSONEncode, HttpService, clean) if not ok then return false end
        local name = self:_normalizeName(fileName) self._memory[name] = json
        if not self._canWrite then return false end self:_ensureFolder()
        local okW = pcall(function() callGlobal("writefile", self:_path(name), json) end) return okW
    end
    function ConfigManager:Load(fileName)
        local name = self:_normalizeName(fileName)
        if self._canRead then
            local ok, contents = pcall(function() local p = self:_path(name) if hasFunction("isfile") and not callGlobal("isfile", p) then return nil end return callGlobal("readfile", p) end)
            if ok and type(contents) == "string" and contents ~= "" then
                local okD, dec = pcall(HttpService.JSONDecode, HttpService, contents)
                if okD and type(dec) == "table" then local okR, rest = pcall(restore, dec, 0) if okR and type(rest) == "table" then self._memory[name] = contents return rest end end
            end
        end
        local cached = self._memory[name] if cached then local okD, dec = pcall(HttpService.JSONDecode, HttpService, cached) if okD then return restore(dec, 0) end end
        return {}
    end
    return ConfigManager
end)()

-- 2. INTERCEPT SOLVER
local InterceptSolver = (function()
    local API = {}
    function API.solve(targetPos, targetVel, originPos, speed)
        if speed <= 0 then return nil, nil end
        local speedSq = speed * speed local velSq = targetVel:Dot(targetVel) local D = targetPos - originPos
        local a = velSq - speedSq local h = D:Dot(targetVel) local c = D:Dot(D)
        if c < 1e-6 then return targetPos, 0 end
        local t
        if math.abs(a) < 1e-6 then
            if h >= 0 then return nil, nil end t = -c / (2 * h)
        else
            local disc = h * h - a * c if disc < 0 then return nil, nil end
            local sign = if h >= 0 then 1 else -1 local q = -(h + sign * math.sqrt(disc))
            local t1 = q / a local t2 = c / q
            local best = math.huge
            if t1 > 0 and t1 < best then best = t1 end
            if t2 > 0 and t2 < best then best = t2 end
            if best == math.huge then return nil, nil end
            t = best
        end
        return targetPos + targetVel * t, t
    end
    return API
end)()

-- 3. OBJECT TRACKER
local ObjectTracker = (function()
    local Workspace = game:GetService("Workspace") local Tracker = {} Tracker.__index = Tracker
    function Tracker:_add(inst) if self._index[inst] then return end local isModel = inst:IsA("Model") if not inst:IsA("BasePart") and not isModel then return end if not (self._filter and string.find(inst.Name, self._filter) or not self._filter) then return end local n = #self._objs + 1 self._objs[n] = inst self._isModel[n] = isModel self._index[inst] = n end
    function Tracker:_remove(inst) local i = self._index[inst] if not i then return end local last = #self._objs if i ~= last then local moved = self._objs[last] self._objs[i] = moved self._isModel[i] = self._isModel[last] self._index[moved] = i end self._objs[last] = nil self._isModel[last] = nil self._index[inst] = nil end
    function Tracker:_detach() for _, c in ipairs(self._folderConns) do c:Disconnect() end table.clear(self._folderConns) self._folder = nil table.clear(self._objs) table.clear(self._isModel) table.clear(self._index) end
    function Tracker:_attach(folder) self:_detach() self._folder = folder table.insert(self._folderConns, folder.DescendantAdded:Connect(function(i) self:_add(i) end)) table.insert(self._folderConns, folder.DescendantRemoving:Connect(function(i) self:_remove(i) end)) table.insert(self._folderConns, folder.AncestryChanged:Connect(function() if folder.Parent ~= self._parent then self:_detach() end end)) for _, i in ipairs(folder:GetDescendants()) do self:_add(i) end end
    function Tracker.new(folderName, nameFilter, options) local self = setmetatable({}, Tracker) self._folderName = folderName self._filter = nameFilter self._parent = (options and options.Parent) or Workspace self._objs = {} self._isModel = {} self._index = {} self._folder = nil self._folderConns = {} self._parentConn = self._parent.ChildAdded:Connect(function(child) if child.Name == self._folderName and self._folder == nil then self:_attach(child) end end) local ex = self._parent:FindFirstChild(folderName, true) if ex then self:_attach(ex) end return self end
    function Tracker:GetClosest(origin, maxDist) if #self._objs == 0 then return nil, nil end local best, bestSq = nil, maxDist and maxDist^2 or math.huge for i = 1, #self._objs do local obj = self._objs[i] if obj.Parent then local p = self._isModel[i] and obj:GetPivot().Position or (obj :: BasePart).Position local sq = (p - origin).Magnitude^2 if sq < bestSq then bestSq = sq best = obj end end end return best, bestSq and math.sqrt(bestSq) end
    function Tracker:Destroy() self._parentConn:Disconnect() self:_detach() end
    return Tracker
end)()

-- 4. ROLE HUD
local RoleHUD = (function()
    local API = {} API.__index = API
    local C = { Killer = Color3.fromRGB(255, 50, 50), Zombie = Color3.fromRGB(255, 50, 50), Sheriff = Color3.fromRGB(50, 120, 255), Innocent = Color3.fromRGB(50, 255, 100), Survivor = Color3.fromRGB(50, 255, 100) }
    function API.new(provider) local s = setmetatable({}, API) s._provider = provider s._hl = {} s._state = {} s._conns = {} s._running = false s._container = nil return s end
    function API:_getHl(p) local hl = self._hl[p] if hl then return hl end hl = Instance.new("Highlight") hl.Name = "LibHUD" hl.Enabled = false hl.FillTransparency = 0.5 hl.OutlineTransparency = 0 hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop hl.Parent = self._container self._hl[p] = hl self._state[p] = { Enabled = false, Color = nil } return hl end
    function API:_setHidden(p) local hl = self._hl[p] if hl and self._state[p].Enabled then self._state[p].Enabled = false hl.Enabled = false end end
    function API:_setVisible(p, color) local hl = self:_getHl(p) local st = self._state[p] if st.Color ~= color then st.Color = color hl.FillColor = color hl.OutlineColor = color end if not st.Enabled then st.Enabled = true hl.Enabled = true end end
    function API:_update(p, tbl) local data = tbl[p.UserId] or tbl[p.Name] if type(data) ~= "table" then self:_setHidden(p) return end local color = C[data.Role] if not color then self:_setHidden(p) return end local char = p.Character local hum = char and char:FindFirstChildOfClass("Humanoid") if data.Dead == true or not hum or hum.Health <= 0 then self:_setHidden(p) return end local hl = self:_getHl(p) if hl.Adornee ~= char then hl.Adornee = char end self:_setVisible(p, color) end
    function API:_step() local ok, tbl = pcall(self._provider) if not ok or type(tbl) ~= "table" then return end for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then self:_update(p, tbl) end end end
    function API:Start() if self._running then return end self._running = true self._container = self._container or Instance.new("Folder") self._container.Name = "LibHUD" self._container.Parent = Workspace table.insert(self._conns, Players.PlayerAdded:Connect(function(p) end)) table.insert(self._conns, Players.PlayerRemoving:Connect(function(p) if self._hl[p] then self._hl[p]:Destroy() self._hl[p] = nil self._state[p] = nil end end)) task.spawn(function() while self._running do self:_step() task.wait(0.5) end end) end
    function API:Stop() self._running = false for _, c in ipairs(self._conns) do c:Disconnect() end table.clear(self._conns) for p in pairs(self._hl) do self:_setHidden(p) end end
    return API
end)()

-- 5. STABILIZER
local Stabilizer = (function()
    local CONFIG = { LinearThreshold = 1000, LinearSafe = 250, AngularThreshold = 1000, AngularSafe = 50, DampRate = 14, IgnoreVerticalInFreefall = true }
    local ignored = setmetatable({}, {__mode = "k"}) local damping = setmetatable({}, {__mode = "k"}) local API = {}
    local function damp(v, thr, sf, al, st, k, igY) local y = igY and v.Y or 0 local f = igY and Vector3.new(v.X,0,v.Z) or v local m = f.Magnitude if not st[k] then if m <= thr then return nil end st[k] = true end if m <= sf * 1.05 then st[k] = false return nil end local nm = m + (sf - m) * al local d = f.Unit * nm return igY and Vector3.new(d.X, y, d.Z) or d end
    local function step(dt) local char = LocalPlayer.Character if not char then return end local root = char:FindFirstChild("HumanoidRootPart") if not root or ignored[char] then return end local st = damping[root] or {linear=false, angular=false} damping[root] = st local al = 1 - math.exp(-CONFIG.DampRate * dt) local hum = char:FindFirstChildOfClass("Humanoid") local ff = CONFIG.IgnoreVerticalInFreefall and hum and hum:GetState() == Enum.HumanoidStateType.Freefall local l = damp(root.AssemblyLinearVelocity, CONFIG.LinearThreshold, CONFIG.LinearSafe, al, st, "linear", ff) if l then root.AssemblyLinearVelocity = l end local a = damp(root.AssemblyAngularVelocity, CONFIG.AngularThreshold, CONFIG.AngularSafe, al, st, "angular", false) if a then root.AssemblyAngularVelocity = a end end
    function API.Start() if not API._conn then API._conn = RunService.Heartbeat:Connect(step) end end
    function API.Stop() if API._conn then API._conn:Disconnect() API._conn = nil end end
    return API
end)()


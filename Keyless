-- ==========================================
-- AUTO FARM (Идеально плавный полет через PlatformStand)
-- ==========================================
local currentTarget = nil
local bv = nil
local bg = nil

local function findNearestItem()
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local closest, minDist = nil, 9999
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "Coin_Server" and obj:IsA("BasePart") then
            local d = (obj.Position - hrp.Position).Magnitude
            if d < minDist then minDist = d; closest = obj end
        end
    end
    return closest
end

task.spawn(function()
    while task.wait(0.5) do
        if CFG.AutoFarm then 
            currentTarget = findNearestItem() 
        else 
            currentTarget = nil 
        end
    end
end)

-- Сброс полета при смерти или выключении
local function resetFarm()
    local char = LP.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
    if bv then bv:Destroy(); bv = nil end
    if bg then bg:Destroy(); bg = nil end
end

LP.CharacterAdded:Connect(function()
    currentTarget = nil
    resetFarm()
end)

RunService.Heartbeat:Connect(function()
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if CFG.AutoFarm and currentTarget and currentTarget.Parent then
        -- Отключаем контроль гуманоида, чтобы он не мешал лететь (убираем рывки)
        hum.PlatformStand = true

        if not bv or bv.Parent ~= hrp then
            bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.P = 1250
            bv.Parent = hrp
            bg = Instance.new("BodyGyro")
            bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bg.P = 1000
            bg.Parent = hrp
        end

        local targetPos = currentTarget.Position
        local distance = (hrp.Position - targetPos).Magnitude

        if distance < 2 then
            -- Долетели
            resetFarm()
            hum.PlatformStand = false
            for _, prompt in ipairs(currentTarget:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") then
                    pcall(function() fireproximityprompt(prompt) end)
                end
            end
            currentTarget = nil
            task.wait(0.1)
        else
            -- Летим
            local speed = CFG.FarmSpeed * 3 
            local dir = (targetPos - hrp.Position).Unit
            bv.Velocity = dir * speed
            bg.CFrame = CFrame.new(hrp.Position, targetPos)
        end
    else
        -- Если выключили
        if bv then resetFarm(); hum.PlatformStand = false end
    end
end)


local roles = {}
task.spawn(function()
    while task.wait(1) do
        pcall(function()
            local getData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
            if getData and getData:IsA("RemoteFunction") then
                local success, data = getData:InvokeServer()
                if success and type(data) == "table" then roles = data end
            end
        end)
    end
end)

local function getRoleColor(plr)
    local rData = roles[plr.Name]
    if rData and rData.Role then
        local r = rData.Role
        if r == "Murderer" or r == "Zombie" then return Color3.fromRGB(255, 50, 50) end
        if r == "Sheriff" then return Color3.fromRGB(50, 120, 255) end
        if r == "Survivor" then return Color3.fromRGB(255, 165, 0) end
    end
    return Color3.fromRGB(50, 255, 100)
end

RunService.RenderStepped:Connect(function()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local char = p.Character
            local ourHighlight = nil
            local toDestroy = {}
            for _, child in ipairs(char:GetChildren()) do
                if child:IsA("Highlight") then
                    if child.Name == "LibESP" and not ourHighlight then
                        ourHighlight = child
                    else
                        table.insert(toDestroy, child)
                    end
                end
            end
            for _, hl in ipairs(toDestroy) do hl:Destroy() end
            
            if CFG.ESP then
                if not ourHighlight then
                    ourHighlight = Instance.new("Highlight")
                    ourHighlight.Name = "LibESP"
                    ourHighlight.OutlineTransparency = 0
                    ourHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    ourHighlight.Parent = char
                end
                local c = getRoleColor(p)
                ourHighlight.FillColor = c
                ourHighlight.OutlineColor = c
            end
        end
    end
end)


local roles = {}
local function updateRoles()
    pcall(function()
        local getData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
        if getData and getData:IsA("RemoteFunction") then
            local success, data = getData:InvokeServer()
            if success and type(data) == "table" then roles = data end
        end
    end)
end
task.spawn(function() while task.wait(1) do updateRoles() end end)

local function getRoleColor(plr)
    local rData = roles[plr.Name]
    if rData and rData.Role then
        local r = rData.Role
        if r == "Murderer" or r == "Zombie" then return Color3.fromRGB(255, 50, 50) end
        if r == "Sheriff" then return Color3.fromRGB(50, 120, 255) end
        if r == "Survivor" then return Color3.fromRGB(255, 165, 0) end
    end
    local function checkTools(container)
        if not container then return nil end
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") then
                local n = string.lower(tool.Name)
                if n:find("knife") or n:find("dagger") then return Color3.fromRGB(255, 50, 50) end
                if n:find("gun") or n:find("revolver") then return Color3.fromRGB(50, 120, 255) end
            end
        end
        return nil
    end
    if plr.Character then local c = checkTools(plr.Character); if c then return c end end
    if plr:FindFirstChild("Backpack") then local c = checkTools(plr:FindFirstChild("Backpack")); if c then return c end end
    return Color3.fromRGB(50, 255, 100)
end


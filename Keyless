local function FlingTarget(targetRoot)
    local s = currentSession if not s or s.destroyed or s.humanoid.Health <= 0 or not targetRoot then return end
    local myRoot = s.root local oldCFrame = myRoot.CFrame local oldAnchored = myRoot.Anchored myRoot.Anchored = true
    pcall(function() if setnetworkowner then pcall(setnetworkowner, targetRoot, Player) end myRoot.CFrame = targetRoot.CFrame local spin = Instance.new("BodyAngularVelocity") spin.AngularVelocity = Vector3.new(1e5, 1e5, 1e5) spin.MaxTorque = Vector3.new(1e9, 1e9, 1e9) spin.Parent = targetRoot local push = Instance.new("BodyVelocity") push.Velocity = Vector3.new(1e5, 1e5, 1e5) push.MaxForce = Vector3.new(1e9, 1e9, 1e9) push.Parent = targetRoot task.wait(0.1) spin:Destroy() push:Destroy() end)
    myRoot.CFrame = oldCFrame myRoot.Anchored = oldAnchored if s.bv then s.bv.Velocity = Vector3.zero s.bv.MaxForce = Vector3.zero end if s.bg then s.bg.MaxTorque = Vector3.zero s.bg.CFrame = oldCFrame end
end
